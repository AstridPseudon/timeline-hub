{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.local/schemas/change-contract/edit-command.schema.json",
  "title": "EditCommand v1 — M0 design contract",
  "description": "Proposed canonical successor to OpCall. M0 design artifact; no main producer emits this version yet. Runtime ABI containers reference these semantic leaves. Per-operation argument schemas remain registry-owned.",
  "type": "object",
  "required": ["schema_version", "op", "version", "select", "args"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "op": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
    "version": {"type": "string", "minLength": 1},
    "select": {"type": ["string", "null"]},
    "args": {"type": "object"},
    "resolved": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expect": {"type": "object", "additionalProperties": {"$ref": "#/$defs/AgentState"}},
    "bindings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "created": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authorship": {"type": "object", "additionalProperties": {"enum": ["direct", "consequence"]}},
    "reads": {"type": "array", "items": {"$ref": "#/$defs/AgentRead"}},
    "selections": {"type": "array", "items": {"$ref": "#/$defs/AgentSelection"}},
    "intent": {
      "type": "object",
      "properties": {
        "ripple": {"enum": ["none", "selected", "include-concurrent"]},
        "anchor": {"enum": ["follow", "fixed"]},
        "ownership": {"enum": ["shared", "occurrence"]},
        "position": {"enum": ["absolute", "relative"]}
      },
      "required": [],
      "additionalProperties": false
    },
    "group_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"op": {"const": "timeline.inverse"}}},
      "then": {
        "properties": {
          "version": {"const": "1"},
          "select": {"type": "null"},
          "args": {
            "type": "object",
            "properties": {
              "publications": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["publications"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"op": {"const": "timeline.restore"}}},
      "then": {
        "properties": {
          "version": {"const": "1"},
          "select": {"type": "null"},
          "args": {
            "type": "object",
            "properties": {
              "revision_id": {"type": "string", "minLength": 1},
              "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "required": ["revision_id", "content_digest"],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "AgentState": {
      "type": "object",
      "oneOf": [
        {"required": ["state"], "properties": {"state": {"const": "absent"}}, "additionalProperties": false},
        {
          "required": ["state", "value"],
          "properties": {"state": {"const": "present"}, "value": {}},
          "additionalProperties": false
        }
      ]
    },
    "AgentRead": {
      "type": "object",
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}},
        "state": {"$ref": "#/$defs/AgentState"}
      },
      "required": ["ref", "path", "state"],
      "additionalProperties": false
    },
    "AgentWrite": {
      "type": "object",
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}},
        "before": {"$ref": "#/$defs/AgentState"},
        "after": {"$ref": "#/$defs/AgentState"}
      },
      "required": ["ref", "path", "before", "after"],
      "additionalProperties": false
    },
    "AgentSelection": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "query_version": {"type": "integer", "minimum": 1},
        "owner": {"type": "string", "minLength": 1},
        "members": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "order": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "policy": {"enum": ["guard-membership", "include-concurrent"]}
      },
      "required": ["key", "query_version", "owner", "members", "order", "boundaries", "policy"],
      "additionalProperties": false
    },
    "AgentBinding": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "policy": {"enum": ["follow", "fixed"]},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["key", "ref", "policy", "dependencies"],
      "additionalProperties": false
    },
    "AgentCreatedID": {
      "type": "object",
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]}
      },
      "required": ["ref", "kind", "owner"],
      "additionalProperties": false
    },
    "AgentDependency": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "kind": {"enum": ["entity", "media", "transcript", "source", "time-map", "authority"]},
        "pin": {"type": "object"},
        "policy": {"enum": ["exact", "follow-identity"]}
      },
      "required": ["key", "kind", "pin", "policy"],
      "additionalProperties": false
    },
    "AgentDerivedWrite": {
      "type": "object",
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "array", "items": {"type": "string"}},
        "before": {"$ref": "#/$defs/AgentState"},
        "after": {"$ref": "#/$defs/AgentState"},
        "cause": {"type": "integer", "minimum": 0}
      },
      "required": ["ref", "path", "before", "after", "cause"],
      "additionalProperties": false
    }
  }
}
