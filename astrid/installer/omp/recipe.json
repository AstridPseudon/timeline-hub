            "start": 996,
            "old": [
              "\t\t\t\tconst sessions = await SessionManager.list(cwd);\n"
            ],
            "new": [
              "\t\t\t\tconst sessions = await this.#listStoredSessions(cwd);\n"
            ]
          },
          {
            "start": 2017,
            "old": [
              "\t\tconst sessions = cwd ? await SessionManager.list(cwd) : await SessionManager.listAll();\n"
            ],
            "new": [
              "\t\t// Resolving the default directory can migrate legacy stores. An explicit\n",
              "\t\t// directory must remain authoritative, including before any live session\n",
              "\t\t// exists and when recovering a session written under an older cwd.\n",
              "\t\tconst sessions =\n",
              "\t\t\tthis.#sessionDir !== undefined\n",
              "\t\t\t\t? await SessionManager.list(cwd ?? process.cwd(), this.#sessionDir)\n",
              "\t\t\t\t: cwd\n",
              "\t\t\t\t\t? await SessionManager.list(cwd)\n",
              "\t\t\t\t\t: await SessionManager.listAll();\n"
            ]
          },
          {
            "start": 2288,
            "old": [
              "\t\tif (Array.isArray(content)) {\n"
            ],
            "new": [
              "\t\tif (typeof content === \"string\" && content.length > 0) {\n",
              "\t\t\treplay.push({ type: \"text\", text: content });\n",
              "\t\t} else if (Array.isArray(content)) {\n"
            ]
          }
