              "\tconstructor(\n",
              "\t\tconnection: AgentSideConnection,\n",
              "\t\tcreateSession: CreateAcpSession,\n",
              "\t\tinitialSession?: AgentSession,\n",
              "\t\toptions: AcpAgentOptions = {},\n",
              "\t) {\n"
            ]
          },
          {
            "start": 486,
            "old": [],
            "new": [
              "\t\tthis.#sessionDir = options.sessionDir;\n"
            ]
          },
          {
            "start": 957,
            "old": [
              "\t\t\t\tconst sessions = await SessionManager.listAll();\n"
            ],
            "new": [
              "\t\t\t\tconst sessions = await this.#listStoredSessions();\n"
            ]
          },
          {
            "start": 965,
            "old": [
              "\t\t\t\tconst sessions = await SessionManager.listAll();\n"
            ],
            "new": [
              "\t\t\t\tconst sessions = await this.#listStoredSessions();\n"
