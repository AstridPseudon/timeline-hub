{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./test-dist",
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "isolatedModules": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "tests/**/*.test.ts"],
  "exclude": ["dist", "node_modules"]
}
