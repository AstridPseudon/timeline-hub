#!/usr/bin/env python3
"""Bounded import preflight for an already selected child interpreter.

This command probes installed requirements and canonical missing-name diagnostics.
It is deliberately not a launcher, installer, Store registrar, or proof of a
registered child. Static enumeration has an explicit dynamic-import limit.
"""
from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

KNOWN_LOCAL = {"astrid", "astrid_runtime", "astrid_runtime_client", "runtime_protocol"}
OPTIONAL_NAMES = {"numpy", "torch", "cv2"}
TEST_PARTS = {"test", "tests", "fixtures", "conftest.py"}
# Agent 2149 packet, independently authenticated by final census review 2216.
CANONICAL_SCHEMA = "timeline.d139.input-census/v1"
CANONICAL_SHA256 = "be9e8bc9c6d2411809da2d99126a9b3eef72678de2066bb6ad196d5d16ebcd30"
CANONICAL_TUPLE = ("4c4ee35d5687c4cd40a0e5395efda53aa56f939d",
                   "ab1e4f6141987706132916e2da16477f5a019464")


def _canonical_census(value: dict, raw: bytes) -> tuple[list[dict], dict]:
    if value.get("schema") != CANONICAL_SCHEMA:
        raise ValueError("unsupported canonical census schema")
    if (value.get("agent_commit"), value.get("runtime_commit")) != CANONICAL_TUPLE:
        raise ValueError("canonical census source tuple mismatch")
    imports = value.get("imports")
    if not isinstance(imports, list) or len(imports) != 1146:
        raise ValueError("canonical census requires all 1146 import rows")
    required = {"module", "category", "distribution", "occurrences",
                "resolved_local", "source_owner"}
    categories = {"internal_source_carrier", "stdlib", "optional_manual",
                  "missing", "unconditional_required", "tested_conditional"}
    for item in imports:
        if (not isinstance(item, dict) or set(item) != required
                or not isinstance(item["module"], str)
                or not isinstance(item["category"], str)
                or item["category"] not in categories
                or not isinstance(item["occurrences"], list)):
            raise ValueError("malformed canonical census import row")
    digest = hashlib.sha256(raw).hexdigest()
    if digest != CANONICAL_SHA256:
        raise ValueError("canonical census provenance hash mismatch")
    rows = []
    for item in imports:
        category = item["category"]
        rows.append({**item, "name": item["module"], "classification": category,
                     "applicable": category == "unconditional_required",
                     "probe_policy": "required" if category == "unconditional_required"
                     else "diagnostic_missing" if category == "missing" else "not_probed"})
    return rows, {"schema": CANONICAL_SCHEMA, "sha256": digest,
                  "metadata": {key: data for key, data in value.items() if key != "imports"}}


def _parents(tree: ast.AST) -> dict[ast.AST, ast.AST]:
    result = {}
    for parent in ast.walk(tree):
        for child in ast.iter_child_nodes(parent):
            result[child] = parent
    return result


def _guard_kind(tree: ast.AST, node: ast.AST) -> str:
    """Return a source-backed, conservative guard classification."""
    parents = _parents(tree)
    current = node
    while current in parents:
        current = parents[current]
        if isinstance(current, ast.Try) and current.handlers:
            return "optional"
        if isinstance(current, ast.If) and isinstance(current.test, ast.Compare):
            return "platform-conditional"
    return "applicable"


def _package_parts(path: Path, roots: list[Path]) -> tuple[str, ...]:
    for root in roots:
        try:
            relative = path.relative_to(root)
        except ValueError:
            continue
        package = [root.name] if (root / "__init__.py").is_file() else []
        cursor = root
        for part in relative.parent.parts:
            cursor /= part
            if (cursor / "__init__.py").is_file():
                package.append(part)
            else:
                package = []
        return tuple(package)
    return ()


def _relative_name(path: Path, module: str | None, level: int,
                   roots: list[Path]) -> str | None:
    package = _package_parts(path, roots)
    if level < 1 or level > len(package) + 1:
        return None
    base = package[:len(package) - level + 1]
    return ".".join((*base, *(module.split(".") if module else ()))) or "."


def _is_test_helper(path: Path) -> bool:
    return any(part in TEST_PARTS or part.startswith("test_") for part in path.parts)


def _imports(path: Path, roots: list[Path]) -> list[dict[str, object]]:
    try:
        tree = ast.parse(path.read_text(), filename=str(path))
    except (OSError, SyntaxError) as error:
        return [{"file": str(path), "line": 0, "name": "<parse>",
                 "kind": "parse-error", "classification": "parse-error",
                 "applicable": False, "error": str(error)}]
    rows = []
    for node in ast.walk(tree):
        names: list[tuple[str, str]] = []
        if isinstance(node, ast.Import):
            names = [(item.name, "static") for item in node.names]
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                names = [(_relative_name(path, node.module, node.level, roots)
                          or "<relative-unresolved>", "relative")]
            elif node.module:
                names = [(node.module, "static")]
        elif isinstance(node, ast.Call):
            dynamic = False
            if isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name):
                dynamic = (node.func.value.id == "importlib"
                           and node.func.attr == "import_module") or (
                               node.func.value.id == "builtins"
                               and node.func.attr == "__import__")
            elif isinstance(node.func, ast.Name):
                dynamic = node.func.id == "__import__"
            if dynamic:
                if node.args and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
                    names = [(node.args[0].value, "dynamic-literal")]
                else:
                    names = [("<dynamic>", "dynamic-unresolved")]
        for name, kind in names:
            top = name.split(".", 1)[0].lstrip(".")
            guard = _guard_kind(tree, node)
            if kind == "relative":
                classification, applicable = "relative_source", False
            elif kind == "dynamic-unresolved":
                classification, applicable = "dynamic_unresolved", False
            elif _is_test_helper(path):
                classification, applicable = "test_helper", False
            elif top in set(getattr(sys, "stdlib_module_names", ())) | {"__future__"}:
                classification, applicable = "stdlib", False
            elif top in KNOWN_LOCAL or any(top == root.name for root in roots):
                classification, applicable = "our_source", False
            elif guard == "platform-conditional":
                classification, applicable = "static_conditional", False
            elif top in OPTIONAL_NAMES and guard != "applicable":
                classification, applicable = "platform_optional", False
            else:
                classification, applicable = "installed_distribution", True
            rows.append({"file": str(path), "line": getattr(node, "lineno", 0),
                         "name": name, "top_level": top, "kind": kind,
                         "guard": guard, "classification": classification,
                         "applicable": applicable})
    return rows


def _census(roots: list[Path], launcher: Path) -> list[dict[str, object]]:
    files = [launcher]
    for root in roots:
        files.extend(sorted(path for path in root.rglob("*.py") if path.is_file()))
    rows = []
    for path in dict.fromkeys(files):
        rows.extend(_imports(path, roots))
    return rows


def _external_census(path: Path) -> tuple[list[dict[str, object]], dict]:
    raw = path.read_bytes()
    value = json.loads(raw)
    if isinstance(value, dict) and ("schema" in value or "agent_commit" in value
                                    or "runtime_commit" in value):
        return _canonical_census(value, raw)
    if isinstance(value, dict):
        value = value.get("census", value.get("imports"))
    if not isinstance(value, list):
        raise ValueError("census file must contain a list or census/imports list")
    rows = []
    for item in value:
        if isinstance(item, str):
            item = {"name": item}
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            raise ValueError("census rows require a string name")
        row = dict(item)
        row.setdefault("classification", "installed_distribution")
        row.setdefault("applicable", row["classification"] == "installed_distribution")
        row.setdefault("kind", "merged-census")
        rows.append(row)
    return rows, {"schema": "unverified-legacy-census"}


def _probe(child: Path, names: list[str]) -> dict[str, object]:
    code = """
import importlib, json, sys
results = []
for name in json.loads(sys.stdin.read()):
    try:
        importlib.import_module(name)
    except BaseException as error:
        results.append({'name': name, 'ok': False,
                        'error': type(error).__name__ + ': ' + str(error)})
    else:
        results.append({'name': name, 'ok': True})
print(json.dumps(results, sort_keys=True))
"""
    env = {"PATH": os.environ.get("PATH", ""), "PYTHONNOUSERSITE": "1"}
    completed = subprocess.run([str(child), "-I", "-B", "-P", "-c", code],
                               input=json.dumps(names), text=True,
                               capture_output=True, env=env, timeout=300)
    if completed.returncode != 0:
        return {"child_returncode": completed.returncode,
                "child_stderr": completed.stderr[-4000:], "results": []}
    try:
        results = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        return {"child_returncode": completed.returncode,
                "child_stderr": completed.stderr[-4000:],
                "probe_error": str(error), "results": []}
    return {"child_returncode": completed.returncode,
            "child_stderr": completed.stderr[-4000:], "results": results}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--child", required=True, type=Path)
    parser.add_argument("--launcher", required=True, type=Path)
    parser.add_argument("--root", action="append", type=Path, default=[])
    parser.add_argument("--imports-file", type=Path)
    parser.add_argument("--census-file", type=Path)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    sources = "imports-file" if args.imports_file else "census-file" if args.census_file else "source"
    provenance = None
    if args.imports_file:
        requested = json.loads(args.imports_file.read_text())
        if not isinstance(requested, list) or any(not isinstance(item, str) for item in requested):
            parser.error("--imports-file must contain a JSON list of module names")
        rows = [{"name": name, "classification": "installed_distribution",
                 "applicable": True, "kind": "bounded-control"}
                for name in dict.fromkeys(requested)]
    elif args.census_file:
        try:
            rows, provenance = _external_census(args.census_file)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            parser.error(str(error))
    else:
        rows = _census(args.root, args.launcher)
    probed = [row for row in rows if (row.get("applicable")
              and row.get("classification") == "installed_distribution")
              or (provenance and provenance["schema"] == CANONICAL_SCHEMA
                  and row["classification"] in {"unconditional_required", "missing"})]
    names = list(dict.fromkeys(str(row["name"]) for row in probed))
    probe = _probe(args.child, names)
    by_name = {result["name"]: result for result in probe.get("results", [])}
    failures = []
    for row in probed:
        result = by_name.get(row["name"], {"ok": False, "error": "not returned"})
        row["probe"] = result
        if not result.get("ok"):
            failures.append({**result, "classification": row["classification"]})
    if probe.get("child_returncode") != 0 or probe.get("probe_error"):
        failures.append({"name": "<child-probe>",
                         "error": probe.get("probe_error") or probe.get("child_stderr")})
    result = {
        "schema": "timeline.ops.child-import-check/v2",
        "child": str(args.child.resolve()), "launcher": str(args.launcher.resolve()),
        "scope": {"roots": [str(root.resolve()) for root in args.root],
                  "census_source": sources,
                  "dynamic_boundary": "literal importlib.import_module and __import__ calls only; computed runtime names are dynamic_unresolved"},
        "census_provenance": provenance,
        "census": rows, "attempted_modules": names,
        "missing_installed_distributions": sorted({row["name"] for row in failures
                                                    if row.get("classification") in {
                                                        "installed_distribution", "unconditional_required"}}),
        "missing_census_modules": sorted({row["name"] for row in failures
                                          if row.get("classification") == "missing"}),
        "failures": failures,
        "status": "passed" if not failures else "failed",
    }
    encoded = json.dumps(result, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.write_text(encoded)
    print(encoded, end="")
    return 0 if not failures else 1


if __name__ == "__main__":
    raise SystemExit(main())
