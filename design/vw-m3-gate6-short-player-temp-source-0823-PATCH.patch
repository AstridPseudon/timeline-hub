+async function playerBrowserEnvironment(): Promise<NodeJS.ProcessEnv> {
+  const candidate = process.env.VIEWING_PLAYER_TMPDIR;
+  const uid = process.getuid?.();
+  if (!candidate || !isAbsolute(candidate) || uid === undefined) {
+    throw new Error('Player launch requires the run-owned short temp directory');
+  }
+  const info = await lstat(candidate).catch(() => null);
+  const canonical = await realpath(candidate).catch(() => null);
+  if (!info || info.isSymbolicLink() || !info.isDirectory() || canonical !== candidate
+    || info.uid !== uid || (info.mode & 0o077) !== 0) {
+    throw new Error('Player launch short temp directory failed custody checks');
+  }
+  const env = { ...process.env };
+  delete env.VIEWING_PLAYER_TMPDIR;
+  return { ...env, TMPDIR: candidate, TMP: candidate, TEMP: candidate };
+}
