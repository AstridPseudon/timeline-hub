+import {expect, it} from 'vitest';
+import {
+  applyAudioEnvelope, compileAudioEnvelope, computeMediaTrim, getSanitizedPlaybackRate,
+} from '@banodoco/timeline-composition/evaluation';
+
+// Test-only demonstration of the existing derived envelope representation.
+// The Agent owner must supply the admitted original at the real transform;
+// this is neither source admission nor an alternative envelope compiler.
+const translate = (envelope, delta) => ({
+  ...envelope,
+  keyframes: envelope.keyframes.map(point => ({...point, at: point.at - delta})),
+  ...(envelope.multiply && {multiply: envelope.multiply.map(child => translate(child, delta))}),
+  ...(envelope.minimum && {minimum: envelope.minimum.map(child => translate(child, delta))}),
+});
+
+it.each([
+  [30, 0, 1, 'linear'],
+  [30, 0, 1, 'equal-power'],
+  [30, 0.05, 1.5, 'equal-power'],
+  [30000 / 1001, 0.05, 1.5, 's-curve'],
+])('translates public phase without changing PCM origin at fps=%s from=%s speed=%s curve=%s', (fps, from, speed, curve) => {
+  const original = {id: 'sound', asset: 'sound', track: 'A1', at: 0, from, to: 2,
+    speed, params: {fadeIn: 0.5, fadeOut: 0.5, fadeInCurve: curve, fadeOutCurve: curve}};
+  const sliced = {...original, at: 0, from: from + 0.5 * speed, to: Math.min(original.to, from + 1.5 * speed)};
+  const q0 = computeMediaTrim(original, fps).trimBefore / fps;
+  const q1 = computeMediaTrim(sliced, fps).trimBefore / fps;
+  const rate = getSanitizedPlaybackRate(original.speed);
+  const envelope = compileAudioEnvelope(original, fps);
+  const before = JSON.stringify(envelope);
+  const derived = translate(envelope, (q1 - q0) / rate);
+  const compiled = compileAudioEnvelope({...sliced, audio: {envelope: derived}}, fps);
+  expect(compiled).toEqual(derived);
+  expect(JSON.stringify(envelope)).toBe(before);
+  const whole = [new Float32Array(90000).fill(0.25)];
+  const part = [new Float32Array(90000).fill(0.25)];
+  applyAudioEnvelope(whole, 30000, envelope, q0, rate);
+  applyAudioEnvelope(part, 30000, compiled, q1, rate);
+  // Same seven-decimal precision as the existing attempt-PCM tests. These
+  // compare the full source, with no slicing, padding or per-clip alignment.
+  for (let sample = 0; sample < whole[0].length; sample++) {
+    expect(part[0][sample]).toBeCloseTo(whole[0][sample], 7);
+  }
+  if (from === 0 && rate === 1) {
+    expect(part[0][15000]).toBe(0.25); // exact .5s slice must not restart fade
+    expect(derived.multiply[0].keyframes[0].at).toBe(-0.5);
+  }
+});
