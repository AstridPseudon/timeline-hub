#!/bin/sh
# Astrid's bootstrap. Install policy and recovery live in astrid.installer.
set -eu
umask 077
UV_VERSION=0.8.22
PYTHON_VERSION=3.11.13
case "$(uname -s)" in
    Darwin) log="$HOME/Library/Logs/Astrid Runtime/install.log" ;;
    Linux) log="${XDG_STATE_HOME:-$HOME/.local/state}/astrid-runtime/logs/install.log" ;;
    *) echo 'Use https://astrid.haus/install.ps1 on Windows.' >&2; exit 1 ;; esac
bootstrap="$HOME/.local/share/astrid/bootstrap"
mkdir -p "$bootstrap" "$(dirname "$log")"
tmp=$(mktemp -d "$bootstrap/tmp.XXXXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl --fail --silent --show-error --location "$1" --output "$2"
    else
        wget -q "$1" -O "$2"
    fi
}
fail() { echo 'Astrid could not get ready.' >&2; echo "Details: $log" >&2; exit 1; }
fetch https://astrid.haus/install-manifest.json "$tmp/manifest.json" 2>>"$log" || fail
uv="$bootstrap/uv"
if [ ! -x "$uv" ] || [ "$("$uv" --version 2>>"$log")" != "uv $UV_VERSION" ]; then
    fetch "https://astral.sh/uv/$UV_VERSION/install.sh" "$tmp/uv.sh" 2>>"$log" || fail
    UV_UNMANAGED_INSTALL="$bootstrap" UV_NO_MODIFY_PATH=1 sh "$tmp/uv.sh" >>"$log" 2>&1 || fail
fi
export UV_PYTHON_INSTALL_DIR="$bootstrap/python"
export ASTRID_INSTALL_UV="$uv"
"$uv" python install "$PYTHON_VERSION" >>"$log" 2>&1 || fail
# This only resolves manifest pins and hands off; the package owns every step.
"$uv" run --no-project --python "$PYTHON_VERSION" python -I -c '
import json, os, re, subprocess, sys
manifest, *flags = sys.argv[1:]
with open(manifest, encoding="utf-8") as stream: pins = json.load(stream)
if pins["tools"]["uv"]["version"] != "0.8.22" or pins["tools"]["python"]["version"] != "3.11.13":
    raise SystemExit("The bootstrap and manifest tool pins disagree.")
args = [os.environ["ASTRID_INSTALL_UV"], "run", "--no-project", "--python", pins["tools"]["python"]["version"]]
for name in ("runtime", "agent"):
    sha = pins[name]["sha"]
    if not re.fullmatch("[0-9a-f]{40}", sha): raise SystemExit("Invalid source pin")
    url = "https://github.com/banodoco/astrid-" + name + "/archive/" + sha + ".tar.gz"
    args += ["--with", url]
args += ["python", "-I", "-m", "astrid", "install", "--manifest", manifest, *flags]
raise SystemExit(subprocess.call(args))
' "$tmp/manifest.json" "$@" 2>>"$log" || fail
