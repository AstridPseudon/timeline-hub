+@contextlib.contextmanager
+def owner_fixture(module: Any, target: Path | None, observations: list[dict[str, Any]]):
+    if target is None:
+        yield
+        return
+    assert target.is_absolute() and target.is_relative_to(HERE / "tmp")
+    original = Path.lstat
+    actual = original(target)
+    assert actual.st_uid == os.geteuid() and actual.st_uid != 65534
+
+    class OwnerStat:
+        st_uid = 65534
+
+        def __init__(self, value: Any):
+            self.actual = value
+
+        def __getattr__(self, name: str) -> Any:
+            return getattr(self.actual, name)
+
+    class FixturePath(type(target)):
+        def lstat(self) -> Any:
+            value = original(self)
+            if self != target:
+                return value
+            changed = OwnerStat(value)
+            # Every other stat field delegates to this actual lstat result.
+            assert all(getattr(changed, name) == getattr(value, name)
+                       for name in dir(value) if name.startswith("st_") and name != "st_uid")
+            observations.append({"path": str(self), "field": "Path.lstat().st_uid",
+                                 "module_scope": module.__name__,
+                                 "actual": value.st_uid, "observed": changed.st_uid,
+                                 "actual_mode": oct(value.st_mode), "actual_inode": value.st_ino,
+                                 "all_other_stat_fields_real": True})
+            return changed
+
+    try:
+        with patch.object(module, "Path", FixturePath):
+            yield
+    finally:
+        assert original(target).st_uid == actual.st_uid
+        assert observations, "owner fixture was never observed by the real guard"
+
+
+def run_process(command: list[str], root: Path) -> subprocess.CompletedProcess[str]:
+    root.mkdir(mode=0o700)
+    write_json(root / "request.json", {"command": command, "start": time.time(),
+                                      "TMPDIR": os.environ.get("TMPDIR")})
+    with (root / "stdout.txt").open("xb") as stdout, (root / "stderr.txt").open("xb") as stderr:
+        proc = subprocess.Popen(command, cwd="/", stdout=stdout, stderr=stderr,
+                                env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
+        write_json(root / "pid.json", {"pid": proc.pid, "pgid": os.getpgid(proc.pid)})
+        code = proc.wait()
+    write_json(root / "return.json", {"pid": proc.pid, "returncode": code,
+                                     "end": time.time(), "explicit_wait_reaped": True})
+    return subprocess.CompletedProcess(command, code, (root / "stdout.txt").read_text(),
+                                       (root / "stderr.txt").read_text())
+
