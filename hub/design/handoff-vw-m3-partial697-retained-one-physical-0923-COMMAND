  mkdir "$control/foreign" "$control/target"
  if retention_guard "$control/foreign" "$control/expected"; then
    echo 'foreign destination was accepted' >&2
    exit 1
  fi
  ln -s "$control/target" "$control/symlink"
  if retention_guard "$control/symlink" "$control/symlink"; then
    echo 'symlink destination was accepted' >&2
    exit 1
  fi
  ln -s "$control/target" "$control/linked-parent"
  if retention_guard "$control/linked-parent/result" "$control/linked-parent/result"; then
