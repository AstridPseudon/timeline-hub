retention_guard() {
  local candidate=$1 expected=$2 parent
  [[ "$candidate" = "$expected" ]] || return 1
  [[ ! -L "$candidate" ]] || return 1
  parent=$(dirname -- "$candidate")
  [[ -d "$parent" ]] || return 1
  [[ "$(realpath -- "$parent")" = "$parent" ]] || return 1
  [[ ! -e "$candidate" && ! -L "$candidate" ]] || return 1
}

