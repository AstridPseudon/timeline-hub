UNAPPLIED APP SHARED-SEAM PROPOSAL

This is a flat, App-owned follow-up patch. It is intentionally not applied in
the worker tree: commitSession, useTimelineCommandSession, useTimelineOps,
the door/outbox, and the Elements panel/adapter are App-owned shared seams.
The producer this patch consumes is:

  src/tools/video-editor/commands/elementCapture.ts

The only truthful command-backed operation currently available is an existing
clip's `clip.set-element` revision replacement, plus `clip.set-params` literal
top-level set/clear. The latter preserves unmentioned and unknown keys. The
producer refuses a selected project-pack ref unless the exact retained
`schema_source` DocumentPin is supplied from the authored bundle; a catalog
descriptor is not a retained pin.

--- a/src/tools/video-editor/commands/commitSession.ts
+++ b/src/tools/video-editor/commands/commitSession.ts
@@
 import { captureClipParams, finishClipParams } from './clipParamsCapture.ts';
+import { captureClipElement, finishClipElement, captureClipElementParams,
+  finishClipElementParams } from './elementCapture.ts';
@@
 // Add an App-owned port beside clipParamsPort. Its capture() must snapshot
 // the raw authored bundle and the displayed scoped clip identity. Its
 // finish() must use the original basis, re-check the current raw closure,
 // and place { commands, before, after, preview } in the existing prepared
 // map. submit() must accept only the exact prepared command and exact
 // params-only/revision-only TimelinePatch, then call enqueue() with the
 // existing outbox basis. Do not call saveTimeline/saveTimelineAtHead.
+const elementPort: ElementCapturePort = {
+  capture({ clipId, current }) { /* same head/owner checks as clipParamsPort */ },
+  finish(basis, args) { /* captureClipElement or captureClipElementParams;
+    preview only the existing clip's elementRef/params */ },
+  submit(input) { /* exact prepared command + enqueue() */ },
+};
@@
 return {
   ...,
   clipParamsPort,
+  elementPort,
 };

--- a/src/tools/video-editor/hooks/useTimelineCommandSession.ts
+++ b/src/tools/video-editor/hooks/useTimelineCommandSession.ts
@@
 // Import the ElementCapturePort and expose session.elementPort with the same
 // legacy-clean barrier as clipParamsPort. The barrier must cover capture,
 // finish, and submit. Recovery must replay the stored command and preview;
 // it must never recapture from the ACK or resolved projection.
+const elementPort = session.elementPort;
+session.elementPort = {
+  capture(input) { requireCleanElementEdit(); return elementPort.capture(input); },
+  finish(basis, args) { requireCleanElementEdit(); return elementPort.finish(basis, args); },
+  submit(input) { requireCleanElementEdit(); elementPort.submit(input); },
+};

