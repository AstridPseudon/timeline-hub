+def _add_error(errors: list[str], message: str) -> None:
+    if message not in errors:
+        errors.append(message)
+
+
+def _reference_error(field: str) -> str:
+    return f"{field} reference must be a string"
+
+
+def _validate_ref_fields(value: Any, fields: Sequence[str], errors: list[str]) -> None:
+    if not isinstance(value, Mapping):
+        return
+    for field in fields:
+        if field in value and not isinstance(value[field], str):
+            _add_error(errors, _reference_error(field))
+
+
+def _rows(value: Any) -> Sequence[Any]:
+    return value if isinstance(value, list) else ()
+
+
+def _validate_closure_refs(document: Mapping[str, Any], errors: list[str]) -> None:
+    _validate_ref_fields(document, ("project_id", "timeline_id"), errors)
+    parent = document.get("parent_revision")
+    _validate_ref_fields(parent, ("project_id", "timeline_id", "revision_id"), errors)
+
+    for row in _rows(document.get("shot_revisions")):
+        _validate_ref_fields(
+            row,
+            ("shot_id", "revision_id", "internal_timeline_revision_id", "parent_document_id"),
+            errors,
+        )
+    for row in _rows(document.get("internal_timeline_revisions")):
+        _validate_ref_fields(row, ("revision_id",), errors)
+
+    if not isinstance(parent, Mapping) or not isinstance(parent.get("payload"), Mapping):
+        return
+    payload = parent["payload"]
+    _validate_ref_fields(payload, ("project_id", "timeline_id"), errors)
+    for occurrence in _rows(payload.get("occurrences")):
+        _validate_ref_fields(
+            occurrence,
+            ("occurrence_id", "shot_id", "shot_revision_id", "revision_id", "parent_document_id"),
+            errors,
+        )
+
+    def validate_clips(clips: Any) -> None:
+        if not isinstance(clips, list):
+            return
+        for clip in clips:
+            _validate_ref_fields(
+                clip,
+                ("id", "track", "asset", "asset_id", "media_id", "object_id"),
+                errors,
+            )
+            element_ref = clip.get("elementRef") if isinstance(clip, Mapping) else None
+            _validate_ref_fields(element_ref, ("id", "kind", "packId"), errors)
+
+    validate_clips(payload.get("clips"))
+    config = payload.get("config")
+    if not isinstance(config, Mapping):
+        config = {}
+    for track in _rows(config.get("tracks")):
+        _validate_ref_fields(track, ("id",), errors)
+    validate_clips(config.get("clips"))
+
+    for revision in _rows(document.get("internal_timeline_revisions")):
+        if not isinstance(revision, Mapping) or not isinstance(revision.get("payload"), Mapping):
+            continue
+        revision_payload = revision["payload"]
+        for track in _rows(revision_payload.get("tracks")):
+            _validate_ref_fields(track, ("id",), errors)
+        validate_clips(revision_payload.get("clips"))
+
+
+def _sanitize_ref_value(
+    field: str, value: Any, errors: list[str], *, allow_none: bool = True
+) -> str | None:
+    if value is None and allow_none:
+        return None
+    if not isinstance(value, str):
+        _add_error(errors, _reference_error(field))
+        return None
+    return value
+
+
+def _sanitize_refs(refs: Mapping[str, Any], errors: list[str]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for field in _REFERENCE_FIELDS:
+        if field not in refs or refs[field] is None:
+            continue
+        value = _sanitize_ref_value(field, refs[field], errors)
+        if value is not None:
+            result[field] = value
+    for field in _REFERENCE_LIST_FIELDS:
+        if field not in refs or refs[field] is None:
+            continue
+        value = refs[field]
+        if not isinstance(value, (list, tuple)):
+            _add_error(errors, f"{field} references must be strings")
+            continue
+        valid = [item for item in value if isinstance(item, str)]
+        if len(valid) != len(value):
+            _add_error(errors, f"{field} references must be strings")
+        result[field] = valid
+    return result
+
