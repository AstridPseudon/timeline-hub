#!/usr/bin/env bash
set -eu

ORCH=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
BUILDER="$ORCH/bin/delivery-build"
SCANNER="$ORCH/design/handoff-vw-m4-owner-scanner-delivery-payload-scanner-v1.0.8.zip"
INSTRUCTIONS="$ORCH/design/handoff-vw-m4-owner-scanner-delivery-payload-owner-film-differences.md"
E7_PATCH="$ORCH/workers/vw-m4-composition-e7-delivery-refresh/delivery/composition-origin-main-to-e7ef7a072.patch"
E7_BUNDLE="$ORCH/workers/vw-m4-composition-e7-delivery-refresh/delivery/composition-origin-main-to-e7ef7a072.bundle"
E7_MANIFEST="$ORCH/design/handoff-vw-m4-composition-e7-delivery-refresh-manifest.json"
E7_PROOF="$ORCH/design/handoff-vw-m4-composition-e7-delivery-refresh-REPORT.md"

# These checks are read-only. They must pass before the one final builder call.
test -f "$ORCH/delivery/README.template.md"
test -f "$ORCH/delivery/gate-results.md"
test "$(sha256sum "$BUILDER" | cut -d' ' -f1)" = \
  3dfd5c28a9be9ab809e6c1fe1e9a83fbf8417ea888afc1b10eec5f751023e990
test "$(sha256sum "$SCANNER" | cut -d' ' -f1)" = \
  204a7aac78177824219954574f67fcaf4c56ac81620d533ecb376030340c93ee
test "$(sha256sum "$INSTRUCTIONS" | cut -d' ' -f1)" = \
  969fe3034ca1e7b7aab061ff16575fe7f7d973d9c9ec1f81c347464c4d9da220
test "$(sha256sum "$E7_PATCH" | cut -d' ' -f1)" = \
  12f8361a3f4d6f1c1edcf684600bc5e0fcf2276f5136a27c4b93d0095c71a440
test "$(sha256sum "$E7_BUNDLE" | cut -d' ' -f1)" = \
  46de26e1082485028a915d8693ec0484326e78c13a67c6d1ee03fb22702b8af3
test "$(unzip -Z1 "$SCANNER" | tr '\n' ' ')" = \
  'README.md owner_film_cliplook_scan.py '

# One final build command. The four repo outputs are generated by --repos;
# the explicit extras preserve the exact reviewed scanner/instructions and e7
# patch/bundle/proof alongside those canonical outputs. This command is not run
# by this worker.
GIT_CONFIG_GLOBAL=/dev/null \
TIMELINE_DELIVERY_SCRIPT_SHA=3dfd5c28a9be9ab809e6c1fe1e9a83fbf8417ea888afc1b10eec5f751023e990 \
python3 "$BUILDER" --repos "agent runtime app composition" \
  --extra "extras/owner_film_cliplook_scan-v1.0.8.zip=$SCANNER" \
  --extra "extras/owner-film-differences.md=$INSTRUCTIONS" \
  --extra "extras/composition-e7/composition-origin-main-to-e7ef7a072.patch=$E7_PATCH" \
  --extra "extras/composition-e7/composition-origin-main-to-e7ef7a072.bundle=$E7_BUNDLE" \
  --extra "extras/composition-e7/manifest.json=$E7_MANIFEST" \
  --extra "extras/composition-e7/REPORT.md=$E7_PROOF"
