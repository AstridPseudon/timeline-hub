diff --git a/scripts/check-agent-default-theme.mjs b/scripts/check-agent-default-theme.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f57ec49de1db27beb3eb1c9ea974c279861087e7
--- /dev/null
+++ b/scripts/check-agent-default-theme.mjs
@@ -0,0 +1,30 @@
+// Opt-in cross-product check. Run after npm run build; no Agent dependency in npm test.
+import assert from 'node:assert/strict';
+import {execFile} from 'node:child_process';
+import {resolve} from 'node:path';
+import {promisify} from 'node:util';
+import * as root from '@banodoco/timeline-composition';
+import * as api from '@banodoco/timeline-composition/theme-api';
+
+const [agentCheckout, python] = process.argv.slice(2);
+assert.ok(agentCheckout && python,
+  'Usage: node scripts/check-agent-default-theme.mjs AGENT_CHECKOUT PYTHON');
+const {stdout} = await promisify(execFile)(python, ['-c', `
+import json
+import sys
+from pathlib import Path
+checkout = Path(sys.argv[1]).resolve()
+sys.path.insert(0, str(checkout))
+import astrid.core.theme._schema as schema
+assert Path(schema.__file__).resolve() == checkout / "astrid/core/theme/_schema.py"
+theme = schema.builtin_theme()
+assert theme == schema.BUILTIN_DEFAULT_THEME
+assert schema.validate_theme_document(theme) == theme
+print(json.dumps({"module": schema.__file__, "theme": theme}))
+`, resolve(agentCheckout)], {
+  encoding: 'utf8', env: {...process.env, PYTHONDONTWRITEBYTECODE: '1'},
+});
+const agent = JSON.parse(stdout);
+assert.strictEqual(root.DEFAULT_THEME, api.DEFAULT_THEME);
+assert.deepStrictEqual(root.DEFAULT_THEME, agent.theme);
+console.log(JSON.stringify({result: 'PASS', agentModule: agent.module, defaultTheme: root.DEFAULT_THEME}, null, 2));
diff --git a/scripts/gen-registry.test.mjs b/scripts/gen-registry.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f2c82696753a0ba3296c8617b249a47f067a8148
--- /dev/null
+++ b/scripts/gen-registry.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import {cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {spawnSync} from 'node:child_process';
+import {join} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {test} from 'node:test';
+
+const sourceRoot = fileURLToPath(new URL('..', import.meta.url));
+
+test('package generation ignores installed host themes and checks all local registries', () => {
+  const packageRoot = mkdtempSync(join(tmpdir(), 'composition-registry-'));
+  for (const path of ['scripts', 'typescript/src', 'package.json']) {
+    cpSync(join(sourceRoot, path), join(packageRoot, path), {recursive: true});
+  }
+  const generated = ['registry', 'effects', 'animations', 'transitions']
+    .map(name => join(packageRoot, 'typescript', 'src', `${name}.generated.ts`));
+  const themeDir = join(packageRoot, 'node_modules', '@banodoco', `timeline-theme-test-${process.pid}`);
+  const originals = generated.map(path => readFileSync(path, 'utf8'));
+  mkdirSync(join(themeDir, 'src', 'effects', 'host-only'), {recursive: true});
+  writeFileSync(join(themeDir, 'package.json'), JSON.stringify({name: '@banodoco/timeline-theme-test'}));
+  writeFileSync(join(themeDir, 'theme.json'), JSON.stringify({id: 'test'}));
+  writeFileSync(join(themeDir, 'src', 'effects', 'host-only', 'component.tsx'), 'export default () => null;');
+  const run = (...args) => spawnSync(process.execPath, ['--import', import.meta.resolve('tsx'), 'scripts/gen-registry.ts', ...args], {
+    cwd: packageRoot, encoding: 'utf8',
+  });
+  try {
+    const result = run();
+    assert.equal(result.status, 0, result.stderr);
+    generated.forEach((path, index) => assert.equal(readFileSync(path, 'utf8'), originals[index]));
+    for (const path of generated) {
+      writeFileSync(path, readFileSync(path, 'utf8') + '// drift\n');
+      const stale = run('--check');
+      assert.equal(stale.status, 1);
+      assert.match(stale.stderr, /is stale/);
+      writeFileSync(path, originals[generated.indexOf(path)]);
+    }
+    assert.equal(run('--check').status, 0);
+  } finally {
+    rmSync(packageRoot, {recursive: true, force: true});
+  }
+});
