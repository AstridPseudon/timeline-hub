diff --git a/tests/packs/rendering/presenter_crop_default_partial_capture.mjs b/tests/packs/rendering/presenter_crop_default_partial_capture.mjs
new file mode 100644
--- /dev/null
+++ b/tests/packs/rendering/presenter_crop_default_partial_capture.mjs
@@ -0,0 +1,45 @@
+// Central-only: two new cases, two real stills per case.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import {bundle} from '@remotion/bundler';
+import {openBrowser, renderStill, selectComposition} from '@remotion/renderer';
+import {basis, eraseRegion, params, prepareRoot, propsFor, seriesInspection} from './presenter_crop_geometry.mjs';
+import {remotionPrimitiveAliasesFor} from './webpack-alias.mjs';
+
+assert.equal(process.env.VIEWING_CROP_CENTRAL, '1');
+const browserExecutable = process.env.ASTRID_CROP_BROWSER ?? '/opt/google/chrome/chrome';
+const output = process.argv[2];
+assert.ok(path.isAbsolute(output));
+const cases = {
+  default: {params: {...params, mouth: undefined}, frames: [0, 3]},
+  partial: {params: {...params, mouth: {x: 151, y: 104}}, frames: [0, 3]},
+};
+const buildDir = path.join(output, 'bundle');
+const serveUrl = await bundle({entryPoint: path.join(process.cwd(), 'presenter_crop_entry.mjs'),
+  outDir: buildDir, webpackOverride: remotionPrimitiveAliasesFor(process.cwd()),
+  enableCaching: false});
+let browser;
+try {
+  browser = await openBrowser('chrome', {browserExecutable, logLevel: 'error'});
+  for (const [caseName, selected] of Object.entries(cases)) {
+    const props = propsFor(selected.params);
+    const scene = prepareRoot(props, basis, {});
+    const zero = seriesInspection(scene, props);
+    const rows = [{...zero, erase: eraseRegion(selected.params, 0, basis.fps)}];
+    const target = path.join(output, caseName);
+    fs.mkdirSync(target, {recursive: true});
+    const composition = await selectComposition({serveUrl, id: 'presenter-crop', inputProps: props,
+      puppeteerInstance: browser, browserExecutable, logLevel: 'error'});
+    assert.deepEqual([composition.width, composition.height, composition.fps, composition.durationInFrames],
+      [1920, 1080, 30, 60]);
+    for (const frame of selected.frames) await renderStill({serveUrl, composition, inputProps: props,
+      frame, imageFormat: 'png', output: path.join(target, `frame-${frame}.png`), scale: 1 / 3,
+      puppeteerInstance: browser, browserExecutable, logLevel: 'error'});
+    fs.writeFileSync(path.join(target, 'inspection.json'), JSON.stringify({basis, caseName,
+      frames: selected.frames, props, rows, size: [640, 360], scale: 1 / 3}));
+  }
+} finally {
+  if (browser) await browser.close({silent: true});
+  fs.rmSync(buildDir, {recursive: true, force: true});
+}
