+def test_native_host_uses_exact_assets_and_runtime_theme(native_host):
+    clip = {"id": "media", "track": "plate", "clipType": "image", "asset": "P", "at": 0, "hold": 1}
+    basis = {"width": 200, "height": 100, "fps": 30000 / 1001}
