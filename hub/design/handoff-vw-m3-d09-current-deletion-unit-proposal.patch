+        return {str(p.relative_to(package)): hashlib.sha256(p.read_bytes()).hexdigest()
+                for p in package.rglob("*") if p.is_file()}
+    before = hashes()
+    assert len(before) == 77
+    yield project, pack
+    assert hashes() == before
+
