+++ b/remotion/tests/normal-audio-sources.test.mjs
@@ -0,0 +1,58 @@
+import {mkdtempSync, rmSync, writeFileSync} from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {createElement} from 'react';
+import {renderToStaticMarkup} from 'react-dom/server';
+import {afterEach, beforeEach, expect, it, vi} from 'vitest';
+import {TimelineComposition, compileCanonicalTransitions, DEFAULT_THEME} from '@banodoco/timeline-composition';
+import {audioEnvelopeWav} from '@banodoco/timeline-composition/evaluation';
+import {prepareNormalAudioSources} from '../normal-audio-sources.mjs';
+
+const host = vi.hoisted(() => ({endpoints: []}));
+vi.mock('remotion', async importOriginal => ({
+  ...await importOriginal(),
+  AbsoluteFill: ({children}) => children,
+  Sequence: ({children}) => children,
+  useCurrentFrame: () => 0,
+  useVideoConfig: () => ({fps: 30, width: 32, height: 32}),
+  getRemotionEnvironment: () => ({isPlayer: false, isRendering: true}),
+  useBufferState: () => ({}),
+  Audio: props => { host.endpoints.push(props); return null; },
+}));
+
+let attemptDirectory, prepared;
+const clip = {id: 'sound', asset: 'sound', track: 'A1', at: 0.25, from: 0.05,
+  to: 0.55, speed: 1.5, volume: 3, params: {fadeIn: 0.1, fadeOut: 0.1}};
+beforeEach(() => {
+  attemptDirectory = mkdtempSync(path.join(os.tmpdir(), 'normal-audio-proposal-'));
+  const source = path.join(attemptDirectory, 'original.wav');
+  writeFileSync(source, Buffer.from(audioEnvelopeWav([new Float32Array(30000).fill(0.25)], 30000)));
+  [prepared] = prepareNormalAudioSources({clips: [{clip, source}], fps: 30, attemptDirectory});
+  host.endpoints.length = 0;
+});
+afterEach(() => rmSync(attemptDirectory, {recursive: true, force: true}));
+
+const render = source => renderToStaticMarkup(createElement(TimelineComposition, {
+  timeline: {tracks: [{id: 'A1', kind: 'audio', volume: 0.5}],
+    clips: [{...clip, audio: {render_source: source}}]},
+  assets: {assets: {sound: {type: 'audio/wav', file: 'http://attempt.invalid/original.wav'}}},
+  compiledTransitions: compileCanonicalTransitions([], 30, DEFAULT_THEME),
+}));
+const metadata = () => ({file: 'http://attempt.invalid/envelope/source.wav',
+  envelope_key: prepared.envelope_key, source_from: prepared.source_from,
+  playback_rate: prepared.playback_rate});
+
+it('hands actual generated WAV metadata to public AudioTrack; gain/trim/rate stay downstream', () => {
+  render(metadata());
+  expect(host.endpoints).toHaveLength(1);
+  expect(host.endpoints[0]).toMatchObject({src: metadata().file,
+    trimBefore: 2, trimAfter: 17, playbackRate: 1.5, volume: 1.5});
+});
+it.each([
+  ['raw unrounded origin', {source_from: 0.05}],
+  ['forged rate', {playback_rate: 2}],
+  ['forged envelope', {envelope_key: '{"keyframes":[{"at":0,"value":1}]}'}],
+])('rejects %s at the actual public consumer', (_, forged) => {
+  expect(() => render({...metadata(), ...forged})).toThrow('ENVELOPE_UNRENDERED');
+  expect(host.endpoints).toHaveLength(0);
+});
