+def metadata_diagnostic_ref(distribution, metadata_rel):
+    raw = f'{distribution}:{metadata_rel}'
+    safe_chars = frozenset('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/-:')
+    safe = ''.join(char if char in safe_chars else '_' for char in raw)
+    digest = hashlib.sha256(raw.encode('utf-8', 'surrogatepass')).hexdigest()[:12]
+    if raw and len(raw) <= 96 and safe == raw:
+        return raw
+    prefix_length = 96 - len(digest) - 1
+    return safe[:prefix_length] + '~' + digest
+
+def fail_unowned_metadata(distribution, metadata_rel):
+    fail('unowned local distribution metadata: ' + metadata_diagnostic_ref(distribution, metadata_rel))
