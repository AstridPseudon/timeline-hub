+def test_child_start_forwards_only_parent_owned_browser_selector(tmp_path, monkeypatch):
+    manager, _ = owner(tmp_path)
+    env = environment(tmp_path)
+    selector = "ASTRID_REMOTION_BROWSER_EXECUTABLE"
+    env[selector] = "/caller/browser"
+    env["ASTRID_UNLISTED_BASE"] = "must-not-reach-child"
+    monkeypatch.setenv(selector, "/parent/browser")
+    observed = []
+
+    def start(argv, **kwargs):
+        observed.append(kwargs["env"])
+        raise RuntimeError("before native allocation")
+
+    monkeypatch.setattr(host, "popen_owned_group", start)
+    lease = manager.lease(env, attempt=tmp_path)
+    try:
+        with pytest.raises(RuntimeError, match="before native allocation"):
+            manager.request(lease, request(env))
+        assert observed[0][selector] == "/parent/browser"
+        assert "ASTRID_UNLISTED_BASE" not in observed[0]
+
+        caller_override = request(env)
+        caller_override["request"]["environment"] = {selector: "/request/browser"}
+        with pytest.raises(ValueError, match="outside admitted projection"):
+            manager.request(lease, caller_override)
+        assert len(observed) == 1
+    finally:
+        lease.close()
+        manager.close()
+
+
