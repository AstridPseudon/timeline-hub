+    assert State(replay(plan, head, verified_media=verified).bundle).entity(CHILD)['at'] == child['at']
+
+
+@pytest.mark.parametrize('kind', ['image', 'video'])
+def test_the_saved_preferred_track_wins_with_a_present_anchor(kind):
