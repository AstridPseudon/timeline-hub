+                                       invocation_path=route_path(project, 'film'), authorize=authorize)
+
+    def inverse(result):
+        return {'schema_version': 1, 'op': 'timeline.inverse', 'version': '1', 'select': None,
+                'args': {'publications': [result['receipt']['receipt_id']]}}
