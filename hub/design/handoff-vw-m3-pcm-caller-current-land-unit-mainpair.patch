@@ -0,0 +1,251 @@
+"""Instrumented authored-state primitives. Handlers never manufacture records."""
+from __future__ import annotations
+
+import copy
+
+from ._collections import KINDS, arrange, insertion_boundary, order, rows
+from ._command_state import ABSENT, CommandError, State, equal, present, spelling
+from ._common import AUDIO_KINDS
+
+
+def active(row):
+    return (row.get('enabled') is not False and row.get('active') is not False
+            and not any(row.get(key) is True for key in ('disabled', 'hidden', 'deleted')))
+
+
+def selection(state, key, owner, members=()):
+    boundaries = None
+    if key == "move.target":
+        result = [ref for ref in members if state.entity(ref, optional=True) is not None]
+    elif key in KINDS:
+        result = ([] if owner != 'parent' and state.entity(owner, optional=True) is None
+                  else order(state, owner, KINDS[key]))
+        if key.endswith('.after'):
+            return {"key": key, "query_version": 1, "owner": owner, "members": list(members),
+                    "order": result, "boundaries": insertion_boundary(result, members),
+                    "policy": "guard-membership"}
+    elif key == 'placement.owners':
+        shot = state.occurrence(owner)['shot_id']
+        result = ['occurrence:' + row['occurrence_id'] for row in state.bundle['placements']
+                  if row['shot_id'] == shot]
+        boundaries = ['shot:' + shot]
+    elif key == "move.blockers":
+        origin = state.occurrence(owner)
+        lane = (origin.get('placement') or {}).get('track', origin.get('track'))
+        track = state.entity('parent/track:' + lane, optional=True) if isinstance(lane, str) else None
+        output = track is None or (track.get('kind') not in AUDIO_KINDS
+                                   and track.get('role') not in AUDIO_KINDS and active(track))
+        result = []
+        for row in state.bundle['placements']:
+            if output and active(row) and (row.get('placement') or {}).get('track', row.get('track')) == lane:
+                result.append('occurrence:' + row['occurrence_id'])
+    else:
+        raise CommandError(f"unsupported recorded query {key!r}")
+    return {"key": key, "query_version": 1, "owner": owner, "members": result,
+            "order": list(result), "boundaries": list(result) if boundaries is None else boundaries,
+            "policy": "guard-membership"}
+
+
+class Recording:
+    def __init__(self, bundle, command, ordinal, *, closures=None, verified_media=(),
+                 schema_inputs=(), realm_id=None):
+        self.state = State(bundle, closures=closures)
+        self.verified_media = copy.deepcopy(verified_media)
+        self.schema_inputs, self.realm_id = schema_inputs, realm_id
+        self.input_state = None
+        self.command_input = State(copy.deepcopy(bundle), closures=closures)
+        parent = bundle['parent']
+        config = parent.get('config')
+        self.mirrored_clips = (isinstance(parent.get('clips'), list)
+                               and isinstance(config, dict) and isinstance(config.get('clips'), list)
+                               and equal(parent['clips'], config['clips']))
+        self.record = {"ordinal": ordinal, "command": copy.deepcopy(command), "writes": [],
+                       "reads": [], "selections": [], "bindings": [], "created": [],
+                       "dependencies": [], "derived_writes": []}
+
+    def capture_input(self):
+        """Keep inverse claims on its immutable head, separate from reverse stages."""
+        self.input_state = State(copy.deepcopy(self.state.bundle), closures=self.state.closures)
+
+    def read(self, ref, path=()):
+        value = self.state.get(ref, path)
+        captured = self.input_state.get(ref, path) if self.input_state is not None else value
+        read = {"ref": ref, "path": list(path), "state": captured}
+        if not any(equal(read, prior) for prior in self.record['reads']):
+            self.record['reads'].append(read)
+        return copy.deepcopy(value.get('value'))
+
+    def select(self, key, owner, members=()):
+        value = selection(self.input_state or self.state, key, owner, members)
+        if value not in self.record['selections']:
+            if key.startswith('collection.'):
+                self.read(owner + '/collection:' + KINDS[key])
+                if owner != 'parent':
+                    self.read(owner, ['occurrence_id'])
+                    self.read(owner + '/shot', ['shot_id'])
+                    self.bind('collection.owner:' + key, owner)
+            self.record['selections'].append(value)
+        return value['members']
+
+    def bind(self, key, ref, *, dependencies=()):
+        self.record['bindings'].append({"key": key, "ref": ref, "policy": "fixed",
+                                        "dependencies": list(dependencies)})
+
+    def dependency(self, key, kind, pin):
+        self.record['dependencies'].append({"key": key, "kind": kind,
+                                            "pin": copy.deepcopy(pin), "policy": "exact"})
+
+    def assign(self, ref, path, after):
+        if after['state'] == 'absent':
+            for end in range(1, len(path)):
+                ancestor = self.state.get(ref, path[:end])
+                if ancestor == ABSENT or ancestor == present(None):
+                    # A missing leaf must not erase its ancestor's tagged presence.
+                    self.read(ref, path[:end])
+                    break
+        before = self.state.get(ref, path)
+        self.record['writes'].append({"ref": ref, "path": list(path),
+                                       "before": before, "after": copy.deepcopy(after)})
+        self.state.set(ref, path, after)
+
+    def write(self, ref, path, value):
+        self.assign(ref, path, present(value))
+
+    def clear(self, ref, path):
+        self.assign(ref, path, ABSENT)
+
+    def object(self, ref, path):
+        value = self.state.get(ref, path)
+        if value['state'] == 'present' and isinstance(value['value'], dict):
+            return
+        self.read(ref, path)
+        if value['state'] == 'present' and value['value'] is not None:
+            raise CommandError("intent container must be object or null", ref=ref, path=path)
+        self.write(ref, path, {})
+
+    def create(self, owner, kind, row, *, restoring=False, after=None):
+        rows(self.state, owner, kind, check_mirrors=not restoring)
+        if not restoring and any(s['owner'] == owner and s['key'] == 'collection.' + kind + 's.after'
+               for s in self.record['selections']):
+            raise CommandError('create-after requires a single scoped creation')
+        ordered = None
+        if after is not None:
+            if restoring or kind not in ('clip', 'track') or any(
+                    item['owner'] == owner and item['kind'] == kind for item in self.record['created']):
+                raise CommandError('create-after requires a single scoped creation')
+            self.select('collection.' + kind + 's.after', owner, [after])
+            ordered = order(self.state, owner, kind)
+        if owner != 'parent':
+            self.read(owner, ['occurrence_id'])
+            self.read(owner + '/shot', ['shot_id'])
+            self.bind('create.owner', owner)
+        if not restoring and after is None:
+            self.select('track.create' if kind == 'track' else 'collection.' + kind + 's', owner)
+        ref = owner + '/' + kind + ':' + row['id']
+        if self.state.get(ref, []) != ABSENT:
+            raise CommandError("created identity is occupied", kind="identity_collision", ref=ref)
+        self.read(ref)
+        self.write(ref, [], row)
+        self.record['created'].append({"ref": ref, "kind": kind, "owner": owner})
+        if ordered is not None:
+            ordered.insert(ordered.index(after) + 1, ref)
+            arrange(self.state, owner, kind, ordered)
+        return ref
+
+    def create_entity(self, ref, *, kind, owner, value, restoring=False):
+        from ._command_state import root_identity
+
+        root = root_identity(ref)
+        if (root is None or root[0] != kind
+                or owner != (None if kind == 'shot' else 'parent')):
+            raise CommandError('invalid created root scope', ref=ref)
+        self.state.validate_root(ref, value)
+        document = self.state.bundle['source_mapping'].get('_runtime_document', {})
+        occupied = (any(row['shot_id'] == root[1] for row in document.get('shot_revisions', []))
+                    if kind == 'shot' else any(row['occurrence_id'] == root[1] for row in
+                        document.get('parent_revision', {}).get('payload', {}).get('occurrences', [])))
+        if not document:
+            mapping = self.state.bundle['source_mapping']
+            occupied = (any(row['shot_id'] == root[1] for row in mapping['shots'].values())
+                        if kind == 'shot' else root[1] in mapping['placements'])
+        if (occupied and not restoring) or self.state.get(ref, []) != ABSENT or any(
+                item['ref'] == ref for item in self.record['created']):
+            raise CommandError('created identity is occupied', kind='identity_collision', ref=ref)
+        self.read(ref)
+        self.write(ref, [], value)
+        if kind == 'shot' and root[1] not in self.state.bundle['source_mapping']['shots']:
+            self.state.bundle['shots'][root[1]]['_created'] = True
+        self.record['created'].append({'ref': ref, 'kind': kind, 'owner': owner})
+        return ref
+
+    def create_asset(self, owner, identity, value):
+        ref = owner + '/asset:' + identity
+        if owner != 'parent':
+            self.read(owner, ['occurrence_id'])
+            self.read(owner + '/shot', ['shot_id'])
+        if self.state.get(ref, []) != ABSENT:
+            raise CommandError('created identity is occupied', kind='identity_collision', ref=ref)
+        self.read(ref)
+        self.write(ref, [], value)
+        self.record['created'].append({'ref': ref, 'kind': 'asset', 'owner': owner})
+        return ref
+
+    def compile_inputs(self):
+        # The compiler retains this immutable input closure. These pins do not
+        # imply that the move evaluated an anchor or any document settings.
+        mapping = self.state.bundle.get('source_mapping', {})
+        retained = mapping.get('_runtime_document', {}).get('dependency_manifest', {}).get('documents', [])
+        from astrid.core.timeline.authoring_bundle import _digest
+        for capture in mapping.get('pinned_documents', []):
+            pin = capture['pin']
+            if pin in retained:
+                kind = 'transcript' if capture['document']['kind'] == 'media.transcript' else 'source'
+                self.dependency('compile.document:' + _digest(pin), kind, pin)
+
+    def compile_mirrors(self):
+        parent = self.state.bundle['parent']
+        if self.mirrored_clips:
+            before = self.state.get('parent', ['config', 'clips'])
+            after = present(parent['clips'])
+            if not equal(before, after):
+                self.record['derived_writes'].append({
+                    "ref": "parent", "path": ['config', 'clips'], "before": before,
+                    "after": after, "cause": self.record['ordinal']})
+                self.state.set('parent', ['config', 'clips'], after)
+
+    def finish(self, *, capture=False):
+        command = self.record['command']
+        if capture:
+            # Public replay guards describe the input; the record retains actual
+            # observations made between the deterministic recipe's own writes.
+            command['reads'], command['selections'] = [], []
+            for read in self.record['reads']:
+                claim = {**read, 'state': self.command_input.get(read['ref'], read['path'])}
+                if not any(equal(claim, prior) for prior in command['reads']):
+                    command['reads'].append(claim)
+            for selected in self.record['selections']:
+                claim = selection(self.command_input, selected['key'], selected['owner'], selected['members'])
+                if claim not in command['selections']:
+                    command['selections'].append(claim)
+            command['bindings'] = {b['key']: b['ref'] for b in self.record['bindings']
+                                   if '/clip:' in b['ref'] or '/track:' in b['ref']
+                                   or (b['ref'].startswith('occurrence:') and '/' not in b['ref'])}
+            command['created'] = [item['ref'] for item in self.record['created']]
+            command['expect'], command['authorship'] = {}, {}
+            for write in self.record['writes']:
+                # Whole-closure guards use the schema's general read refs. The
+                # legacy authored-property TargetKey cannot spell this scope.
+                if write['ref'] == 'timeline':
+                    continue
+                key = write['ref'] + '::' + spelling(write['path'])
+                before = self.command_input.get(write['ref'], write['path'])
+                command['expect'].setdefault(key, copy.deepcopy(before))
+                command['authorship'][key] = 'direct'
+        return self.record
+
+
+def guard(state, ref, path, expected, *, kind='dependency_changed'):
+    actual = state.get(ref, path)
+    if not state.matches(ref, path, expected):
+        raise CommandError("original authored guard changed", kind=kind, ref=ref, path=path,
+                           base=expected, theirs=actual)
diff --git a/astrid/sdk/timeline/_root_inverse.py b/astrid/sdk/timeline/_root_inverse.py
new file mode 100644
index 000000000..84ecaee64
--- /dev/null
+++ b/astrid/sdk/timeline/_root_inverse.py
@@ -0,0 +1,93 @@
+"""Restore removed placement order and immutable inputs from accepted boundaries."""
+from __future__ import annotations
+
+import copy
+
+from ._collections import AcceptedRecords
+from ._command_state import ABSENT, CommandError, equal, root_identity
+
+
+def recover_source(state, value, source):
+    """Reopen a missing compiler input, without creating or editing shot content."""
+    identity, occurrence = value['shot_id'], value['occurrence_id']
+    if identity in state.bundle['shots'] and (
+            occurrence in state.bundle['base_placements'] or identity not in state.bundle['source_mapping']['shots']):
+        return
+    if (identity not in source['shots'] or identity not in source['source_mapping']['shots']
+            or not any(row['occurrence_id'] == value['occurrence_id'] and row['shot_id'] == identity
+                       for row in source['placements'])):
+        raise CommandError('removed occurrence source is unavailable', kind='history_unavailable')
+    if identity not in state.bundle['shots']:
+        state.bundle['shots'][identity] = copy.deepcopy(source['shots'][identity])
+        state.bundle['source_mapping']['shots'][identity] = copy.deepcopy(source['source_mapping']['shots'][identity])
+    for target, original in ((state.bundle['base_placements'], source['base_placements']),
+                             (state.bundle['source_mapping']['placements'], source['source_mapping']['placements'])):
+        if occurrence not in target and occurrence in original:
+            target[occurrence] = copy.deepcopy(original[occurrence])
+
+
+def occurrence_orders(state, records, changes):
+    """Only absent-to-present reversals need an authenticated insertion position."""
+    removed = {w['ref'] for w in changes if not w['path'] and w['before'] != ABSENT
+               and w['after'] == ABSENT and root_identity(w['ref']) is not None
+               and w['ref'].startswith('occurrence:')
+               and not any(other['ref'] == 'shot:' + w['before']['value']['shot_id']
+                           and not other['path'] for other in changes)}
+    needed = {id(record) for record in records if any(
+        w['ref'] in removed and not w['path'] and w['before'] != ABSENT and w['after'] == ABSENT
+        for w in record['writes'])}
+    if not needed:
+        return {}
+    if not isinstance(records, AcceptedRecords):
+        raise CommandError('removed occurrence needs accepted order/source boundaries', kind='history_unavailable')
+    result = {}
+    offset = 0
+    for entry in records.entries:
+        count = len(entry['records']['commands'])
+        commands = records[offset:offset + count]
+        offset += count
+        if not equal(commands, entry['records']['commands']):
+            raise CommandError('root inverse records differ from accepted history', kind='history_unavailable')
+        if not any(id(record) in needed for record in commands):
+            continue
+        before, after = records.load_boundary(entry)
+        ordered = [row['occurrence_id'] for row in before['placements']]
+        for record in commands:
+            original = list(ordered)
+            for write in record['writes']:
+                if root_identity(write['ref']) is None or not write['ref'].startswith('occurrence:') or write['path']:
+                    continue
+                identity = write['ref'].removeprefix('occurrence:')
+                if write['before'] != ABSENT and write['after'] == ABSENT:
+                    if id(record) in needed:
+                        source = next((image for image in (before, after)
+                                       if any(equal(row, write['before']['value']) for row in image['placements'])), None)
+                        if source is None:
+                            raise CommandError('removed occurrence boundary changed', kind='history_unavailable')
+                        recover_source(state, write['before']['value'], source)
+                    ordered.remove(identity)
+                elif write['before'] == ABSENT and write['after'] != ABSENT:
+                    ordered.append(identity)
+            if id(record) in needed:
+                result[id(record)] = original
+    if set(result) != needed:
+        raise CommandError('removed occurrence order is unavailable', kind='history_unavailable')
+    return result
+
+
+def arrange_restored(state, record, original):
+    """Insert restored rows relative to surviving history; leave other rows alone."""
+    if original is None:
+        return
+    rows = state.bundle['placements']
+    restored = {w['before']['value']['occurrence_id'] for w in record['writes']
+                if w['ref'].startswith('occurrence:') and '/' not in w['ref']
+                and not w['path'] and w['before'] != ABSENT and w['after'] == ABSENT}
+    for identity in reversed(original):
+        if identity not in restored:
+            continue
+        row = next(row for row in rows if row['occurrence_id'] == identity)
+        rows.remove(row)
+        following = set(original[original.index(identity) + 1:])
+        index = next((i for i, other in enumerate(rows) if other['occurrence_id'] in following), len(rows))
+        rows.insert(index, row)
diff --git a/astrid/sdk/timeline/_scalar_commands.py b/astrid/sdk/timeline/_scalar_commands.py
new file mode 100644
index 000000000..7e01c74e1
--- /dev/null
+++ b/astrid/sdk/timeline/_scalar_commands.py
@@ -0,0 +1,164 @@
+"""Scoped literal scalar edits, using the native recorder for every write."""
+from __future__ import annotations
+
+import copy
+import re
+
+from jsonschema import Draft202012Validator
+from referencing import Registry
+from referencing.exceptions import Unresolvable
+
+from ._command_state import CommandError, equal, present
+
+
+def _target(ctx, command, kind):
+    ref = command['select']
+    if not isinstance(ref, str) or not re.fullmatch(
+            rf'(?:parent|occurrence:[^/]+)/{kind}:[^/]+', ref) or '::' in ref:
+        raise CommandError(f"{command['op']} requires a parent or occurrence {kind} identity")
+    owner = ref.rsplit('/', 1)[0]
+    if ctx.read(ref, ['id']) is None:
+        raise CommandError('scalar target disappeared', kind='identity_conflict', ref=ref)
+    pin = {'parent': copy.deepcopy(ctx.state.bundle.get('base_parent', {}))}
+    if owner != 'parent':
+        ctx.read(owner, ['occurrence_id'])
+        ctx.read(owner + '/shot', ['shot_id'])
+        shot = ctx.state.occurrence(owner)['shot_id']
+        pin['source'] = copy.deepcopy(ctx.state.bundle['source_mapping']['shots'][shot])
+        ctx.bind('scalar.owner', owner)
+    ctx.dependency('scalar.images', 'entity', pin)
+    ctx.bind('scalar.target', ref, dependencies=['scalar.images'])
+    return ref
+
+
+def _changes(command):
+    values, clear = command['args']['values'], command['args']['clear']
+    if any(not isinstance(key, str) for key in values):
+        raise CommandError('parameter keys must be JSON strings')
+    if set(values).intersection(clear):
+        raise CommandError('a scalar key cannot be both set and cleared')
+    return values, clear
+
+
+def track_set(ctx, command):
+    ref = _target(ctx, command, 'track')
+    values, clear = _changes(command)
+    for key in sorted(values):
+        ctx.write(ref, [key], values[key])
+    for key in sorted(clear):
+        ctx.clear(ref, [key])
+
+
+def _clip_basis(ctx, ref):
+    identity = {key: ctx.read(ref, [key]) for key in (
+        'clipType', 'clip_type', 'asset', 'asset_id', 'media_id', 'object_id',
+        'elementRef', 'element_ref')}
+    # A type/asset label can stay fixed while its exact element or media changes.
+    # Match main's selector precedence; retain literal tagged reads, not a digest
+    # of the entire registry (unrelated assets can still change independently).
+    selector = next((key for key in ('asset', 'asset_id', 'media_id', 'object_id')
+                     if key in ctx.state.entity(ref)), None)
+    if selector in ('asset', 'asset_id') and isinstance(identity[selector], str):
+        registry_ref = ref.rsplit('/', 1)[0] + '/registry'
+        for key in ('media_id', 'object_id', 'digest', 'content_digest'):
+            ctx.read(registry_ref, ['assets', identity[selector], key])
+    return identity
+
+
+def clip_set_params(ctx, command):
+    from astrid.sdk.timeline_address import element_schema
+
+    ref = _target(ctx, command, 'clip')
+    values, clear = _changes(command)
+    identity = _clip_basis(ctx, ref)
+    element = identity['clipType'] or identity['clip_type'] or 'media'
+    if not isinstance(element, str):
+        raise CommandError('clip type must be a string', ref=ref)
+    # These are stored JSON values, not human expressions or canvas-unit input.
+    # Reuse the element's declared value schemas without parsing or coercion.
+    changed = {key: value for key, value in values.items()
+               if not equal(ctx.state.get(ref, ['params', key]), present(value))}
+    selected = identity['elementRef'] or identity['element_ref']
+    if isinstance(selected, dict) and selected.get('packId'):
+        schema = (_selected_schema(ctx, command, ref, selected)
+                  if changed or 'schema_source' in command['args'] else {})
+    else:
+        if 'schema_source' in command['args']:
+            raise CommandError('schema_source requires a selected project pack element', ref=ref)
+        schema = element_schema(element)
+    _validate_param_values(ref, changed, schema)
+    if values:
+        ctx.object(ref, ['params'])
+    for key in sorted(values):
+        ctx.write(ref, ['params', key], values[key])
+    for key in sorted(clear):
+        ctx.clear(ref, ['params', key])
+
+
+def _selected_schema(ctx, command, ref, selected):
+    from astrid.core.element.project_packs import admitted_element_snapshot_descriptor
+
+    pin = command['args'].get('schema_source')
+    if pin is None:
+        raise CommandError('selected project pack requires exact schema_source', ref=ref)
+    if not isinstance(ctx.realm_id, str):
+        raise CommandError('selected pack capture requires the scoped realm identity', ref=ref)
+    matches = [(verified, snapshot) for verified, snapshot in ctx.schema_inputs
+               if verified.get('pin') == pin]
+    if len(matches) != 1:
+        raise CommandError('selected pack snapshot input unavailable', ref=ref)
+    verified, snapshots = matches[0]
+    admissions = verified.get('document', {}).get('content', {}).get('admissions', [])
+    admission = next((item for item in admissions if all(
+        item.get(key) == selected.get(key) for key in ('id', 'kind', 'revision'))), {})
+    snapshot = snapshots.get(admission.get('snapshot_object', {}).get('object_id'))
+    try:
+        descriptor = admitted_element_snapshot_descriptor(
+            ctx.realm_id, ctx.state.bundle['project_id'], selected, verified, snapshot)
+    except ValueError as exc:
+        raise CommandError(str(exc), ref=ref) from exc
+    ctx.dependency('params.schema', 'source', pin)
+    ctx.dependency('params.snapshot', 'entity', {
+        'source': pin, 'element': selected,
+        'object': admission['snapshot_object']})
+    ctx.bind('params.element', ref, dependencies=['params.schema', 'params.snapshot'])
+    captures = ctx.state.bundle['source_mapping'].setdefault('pinned_documents', [])
+    if not any(capture['pin'] == pin for capture in captures):
+        captures.append(copy.deepcopy(verified))
+    return descriptor['schema']
+
+
+def _validate_param_values(ref, values, schema):
+    """Check only changed known properties, preserving literal opaque values."""
+    properties = schema.get('properties', {})
+    validator = Draft202012Validator(schema, registry=Registry())
+    for key, value in values.items():
+        if key in properties:
+            try:
+                errors = list(validator.evolve(schema=properties[key]).iter_errors(value))
+            except Unresolvable as exc:
+                raise CommandError('parameter schema reference is unavailable', ref=ref,
+                                   path=['params', key]) from exc
+            if errors:
+                raise CommandError(errors[0].message, ref=ref, path=['params', key])
+
+
+def capture_track_set(bundle, select, *, values=None, clear=()):
+    return _capture(bundle, 'track.set', select, values, clear)
+
+
+def capture_clip_set_params(bundle, select, *, values=None, clear=(), schema_source=None,
+                            schema_inputs=(), realm_id=None):
+    return _capture(bundle, 'clip.set-params', select, values, clear,
+                    schema_source=schema_source, schema_inputs=schema_inputs, realm_id=realm_id)
+
+
+def _capture(bundle, op, select, values, clear, *, schema_source=None, schema_inputs=(), realm_id=None):
+    from .commands import execute
+
+    args = {'values': copy.deepcopy({} if values is None else values), 'clear': list(clear)}
+    if schema_source is not None:
+        args['schema_source'] = copy.deepcopy(schema_source)
+    return execute(bundle, [{'schema_version': 1, 'op': op, 'version': '1',
+                             'select': select, 'args': args}], schema_inputs=schema_inputs,
+                   realm_id=realm_id).commands[0]
