+    assert clip(undone.bundle)['opaque'] == {'note': 'parent/track:c'}
+    for path, value in [(['track'], 'c'), (['at'], 4)]:
+        with pytest.raises(CommandError) as error:
+            inverse(head, plan.records, [later('parent/clip:direct', path, value)])
