+)
+
+OWNER = 'occurrence:occ-a'
+SOURCE = OWNER + '/source'
+FIXTURE = Path(__file__).parent / 'fixtures' / 'recipe_m2_shot_pool.json'
+SCHEMA = Path(__file__).parents[2] / 'astrid/core/timeline/schema/edit-command.schema.json'
+
