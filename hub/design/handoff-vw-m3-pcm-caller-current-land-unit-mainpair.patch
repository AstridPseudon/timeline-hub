@@ -0,0 +1,54 @@
+"""Independent copy of one canonical placement under explicit reserved identities."""
+from __future__ import annotations
+
+import copy
+
+from ._command_state import CommandError, root_identity
+
+OCCURRENCE_INTENT = {'ownership': 'occurrence'}
+
+
+def occurrence_duplicate(ctx, command):
+    owner = command['select']
+    if root_identity(owner) is None or not owner.startswith('occurrence:'):
+        raise CommandError('duplicate requires one explicit occurrence', kind='unsupported_ownership')
+    if ctx.read('parent', ['config', 'pinnedShotGroups']) not in (None, []):
+        raise CommandError('legacy groups require recorded migration', kind='migration_needed')
+    row = ctx.read(owner)
+    if not isinstance(row, dict):
+        raise CommandError('duplicate source disappeared', kind='identity_conflict', ref=owner)
+    source_shot = ctx.read(owner + '/shot', ['shot_id'])
+    ctx.select('collection.clips', owner)
+    ctx.select('collection.tracks', owner)
+    internal = ctx.read(owner + '/source')
+    payload = ctx.read(owner + '/shot', ['payload'])
+    occurrence_id, shot_id = command['args']['occurrence_id'], command['args']['shot_id']
+    if occurrence_id == row['occurrence_id'] or shot_id == source_shot:
+        raise CommandError('duplicate requires reserved identities distinct from the source',
+                           kind='identity_collision', ref=owner)
+    from astrid.core.timeline.authoring_bundle import _copy_shot_for_placement
+    bundle = ctx.state.bundle
+    copied, remap = _copy_shot_for_placement(
+        payload, project_id=bundle['project_id'], timeline_id=bundle['timeline_id'],
+        occurrence_id=occurrence_id, authoring_shot_id=shot_id, source_shot_id=source_shot)
+    occupied = {item.get('item_id', item.get('id')) for shot in bundle['shots'].values()
+                for item in shot['payload'].get('items', [])}
+    if occupied & set(remap.values()):
+        raise CommandError('duplicate item identity is occupied', kind='identity_collision', ref=owner)
+    ctx.bind('duplicate.owner', owner)
+    ctx.create_entity('shot:' + shot_id, kind='shot', owner=None,
+                      value={'payload': copied, 'internal_timeline': copy.deepcopy(internal)})
+    created = copy.deepcopy(row)
+    created.pop('shot_revision_id', None)
+    created.pop('revision_id', None)
+    created.update(occurrence_id=occurrence_id, shot_id=shot_id)
+    ctx.create_entity('occurrence:' + occurrence_id, kind='occurrence', owner='parent', value=created)
+
+
+def capture_occurrence_duplicate(bundle, owner, occurrence_id, shot_id):
+    """Capture a copy of the raw canonical owner with caller-reserved target identities."""
+    from .commands import execute
+
+    return execute(bundle, [{'schema_version': 1, 'op': 'occurrence.duplicate', 'version': '1',
+                             'select': owner, 'args': {'occurrence_id': occurrence_id, 'shot_id': shot_id},
+                             'intent': OCCURRENCE_INTENT}]).commands[0]
diff --git a/astrid/sdk/timeline/native_occurrence_media_commands.py b/astrid/sdk/timeline/native_occurrence_media_commands.py
new file mode 100644
index 000000000..bcc3708f8
--- /dev/null
+++ b/astrid/sdk/timeline/native_occurrence_media_commands.py
@@ -0,0 +1,184 @@
+"""Occurrence-only media recipes over raw children and detached Runtime inputs."""
+from __future__ import annotations
+
+import copy
+import re
+
+from ._command_state import ABSENT, CommandError, equal
+from ._media_inputs import _verified
+from ._recording import active
+from .capture import MAP_FIELDS, RELATIONS, number, occurrence_start, rate
+
+MEDIA_INTENT = {'ownership': 'occurrence'}
+
+
+def _owner(ctx, ref, *, child=False):
+    pattern = r'occurrence:(?!.*::)[^/]+' + (r'/clip:(?!.*::)[^/]+' if child else '')
+    if not isinstance(ref, str) or not re.fullmatch(pattern, ref):
+        raise CommandError('media edit requires explicit occurrence/raw child ownership')
+    owner = ref.rsplit('/', 1)[0] if child else ref
+    ctx.select('collection.occurrences', 'parent')
+    ctx.read(owner, ['occurrence_id'])
+    ctx.read(owner + '/shot', ['shot_id'])
+    for path in MAP_FIELDS:
+        ctx.read(owner, path)
+    row = ctx.state.occurrence(owner)
+    occurrence_start(row)
+    if (not active(row) or isinstance(row.get('source_offset'), bool) or isinstance(row.get('speed'), bool)
+            or row.get('source_offset') not in (None, 0)
+            or row.get('speed') not in (None, 1)
+            or any(row.get(key) is not None for key in ('time_map', 'timeMap'))):
+        raise CommandError('media edit requires an active translation-only occurrence', kind='unsupported_map')
+    number(row.get('duration_ms'), 'occurrence.duration_ms', positive=True)
+    fps = rate(ctx.read('parent', ['config', 'output', 'fps']))
+    if rate(ctx.read(owner + '/source', ['output', 'fps'])) != fps:
+        raise CommandError('parent and child fps differ', kind='unsupported_timing')
+    if ctx.read(owner + '/source', ['source_window']) is not None:
+        raise CommandError('internal source_window is unsupported', kind='unsupported_map')
+    ctx.bind('media.owner', owner)
+    return owner, row['duration_ms'] / 1000
+
+
+def _exclusive(ctx, owner):
+    if ctx.select('placement.owners', owner) != [owner]:
+        raise CommandError('shared authored placement is unsupported', kind='unsupported_ownership', ref=owner)
+
+
+def _consume(ctx, owner, ids):
+    """Guard automatic placement's timing and lane inputs, including absent fields."""
+    members = ctx.select('collection.clips', owner)
+    for clip_id in ids:
+        ref = owner + '/clip:' + clip_id
+        if ref not in members:
+            raise CommandError('consumed clip is not in the occurrence', kind='identity_conflict', ref=ref)
+        # _end_frame supplies at/at_ms to duration.py, which validates speed
+        # and uses numeric hold before from/to. Track selects/inherits the lane.
+        for field in ('at', 'at_ms', 'track', 'hold', 'from', 'to', 'speed'):
+            ctx.read(ref, [field])
+
+
+def _binding(pin, kind):
+    return {'media_id': pin['object_id'], 'type': kind,
+            'generationId': pin['generation_id'], 'variantId': pin['variant_id']}
+
+
+def _registry(ctx, owner, pin, kind, *, create=False, alias=None):
+    identity = pin['asset'] if alias is None else alias
+    if not isinstance(identity, str) or not re.fullmatch(r'(?!.*::)[^/]+', identity):
+        raise CommandError('media requires a reserved raw asset alias')
+    # Containers must already exist. Never replace null/opaque registry state.
+    registry = ctx.state.config(owner).get('registry')
+    if not isinstance(registry, dict) or not isinstance(registry.get('assets'), dict):
+        raise CommandError('media edit requires an authored asset registry')
+    ref = owner + '/asset:' + identity
+    expected = _binding(pin, kind)
+    entry = ctx.read(ref)
+    if ctx.state.get(ref, []) == ABSENT and create:
+        ctx.create_asset(owner, identity, expected)
+    elif create:
+        if not equal(entry, expected):
+            raise CommandError('existing registry binding differs from exact selection', kind='dependency_changed')
+    elif (not isinstance(entry, dict) or entry.get('media_id') != pin['object_id']
+          or entry.get('type') != kind
+          or any(key in entry and entry[key] != value for key, value in expected.items())):
+        raise CommandError('old registry binding differs from selection', kind='dependency_changed')
+    if not create and any(key in entry for key in ('object_id', 'digest', 'content_digest', 'content_sha256',
+                                                  'file', 'path', 'local_path', 'src', 'source', 'format')):
+        raise CommandError('unsupported old registry identity codec', kind='unsupported_media')
+    ctx.dependency('media.new' if create else 'media.old', 'media', pin)
+    return ref
+
+
+def _clip(ctx, owner, row, limit, kind, verified):
+    if row.get('clipType') not in ('media', kind) or not isinstance(row.get('asset'), str):
+        raise CommandError('media edit requires one matching media clip')
+    if any(key in row for key in ('asset_id', 'media_id', 'object_id', 'clip_type')):
+        raise CommandError('media edit requires one asset selector')
+    for key in ('time_map', 'timeMap', 'clips', 'children', 'from_ms', 'to_ms', 'at_ms',
+                'duration', 'duration_ms', 'source', 'sourceURL', 'sourceUrl', 'source_url',
+                'src', 'source_uuid', 'anchor', 'transition'):
+        if row.get(key) is not None:
+            raise CommandError(f'media edit does not support {key}', kind='unsupported_timing')
+    app = row.get('app')
+    nested = app.get('astrid') if isinstance(app, dict) else None
+    for container in (row, app, nested):
+        if container is not None and not isinstance(container, dict):
+            raise CommandError('intent container must be object or null')
+        if isinstance(container, dict) and any(container.get(key) is not None for key in (
+                *RELATIONS, 'beats', 'word', 'words', 'transcript', 'source_id', 'standin', 'standin_intent')):
+            raise CommandError('media edit requires literal child timing', kind='unsupported_timing')
+    at = number(row.get('at'), 'clip.at')
+    hold = number(row.get('hold'), 'clip.hold', positive=True)
+    speed = number(row.get('speed', 1), 'clip.speed', positive=True)
+    if at < 0 or at + hold / speed > limit:
+        raise CommandError('child interval exceeds occurrence', kind='occurrence_boundary')
+    if kind == 'image':
+        if speed != 1 or any(row.get(key) is not None for key in ('from', 'to')):
+            raise CommandError('image requires hold without a source window', kind='unsupported_timing')
+    else:
+        left, right = number(row.get('from'), 'clip.from'), number(row.get('to'), 'clip.to')
+        if left < 0 or right <= left or not equal(right - left, hold) or any(
+                right > value['duration_seconds'] for value in verified):
+            raise CommandError('source window differs from hold or exceeds media', kind='unsupported_timing')
+    track = owner + '/track:' + str(row.get('track'))
+    ctx.select('collection.tracks', owner)
+    value = ctx.read(track)
+    if (not isinstance(value, dict) or value.get('kind') != 'visual'
+            or value.get('role', 'output') != 'output' or not active(value)):
+        raise CommandError('media edit requires an active raw visual child track')
+    ctx.bind('media.track', track)
+
+
+def add_media(ctx, command):
+    owner, limit = _owner(ctx, command['select'])
+    _exclusive(ctx, owner)
+    # Automatic births also depend on promotion and legacy-group eligibility.
+    # Keep absent fields guarded even when no pool removal follows the birth.
+    ctx.read(owner + '/source', ['app', 'astrid', 'pool'])
+    ctx.read('parent', ['config', 'pinnedShotGroups'])
+    row, pin = command['args']['row'], command['args']['media']
+    _consume(ctx, owner, command['args'].get('consumed', ()))
+    value, kind = _verified(ctx, pin)
+    if row.get('asset') != pin['asset']:
+        raise CommandError('child asset must equal the reserved selection alias')
+    _clip(ctx, owner, row, limit, kind, [value])
+    _registry(ctx, owner, pin, kind, create=True)
+    ctx.create(owner, 'clip', row)
+
+
+def swap_media(ctx, command):
+    ref = command['select']
+    owner, limit = _owner(ctx, ref, child=True)
+    ctx.select('collection.clips', owner)
+    row = ctx.read(ref)
+    if not isinstance(row, dict):
+        raise CommandError('missing raw child identity', kind='identity_conflict')
+    old, pin = command['args']['old_media'], command['args']['media']
+    previous, old_kind = _verified(ctx, old)
+    value, kind = _verified(ctx, pin)
+    if old_kind != kind:
+        raise CommandError('media swap preserves media kind', kind='unsupported_media')
+    _clip(ctx, owner, row, limit, kind, [previous, value])
+    _registry(ctx, owner, old, kind, alias=row['asset'])
+    _registry(ctx, owner, pin, kind, create=True)
+    ctx.bind('media.target', ref, dependencies=['media.old', 'media.new'])
+    ctx.write(ref, ['asset'], pin['asset'])
+
+
+def capture_occurrence_add_media(bundle, owner, row, media, *, verified_media, consumed=()):
+    """Caller keeps the selected asset alias and allocates row.id before capture."""
+    from .commands import execute
+    args = {'row': copy.deepcopy(row), 'media': copy.deepcopy(media)}
+    if consumed:
+        args['consumed'] = list(consumed)
+    return execute(bundle, [{'schema_version': 1, 'op': 'occurrence.add-media', 'version': '1',
+                             'select': owner, 'args': args, 'intent': MEDIA_INTENT}], verified_media=verified_media).commands[0]
+
+
+def capture_occurrence_swap_media(bundle, select, old_media, media, *, verified_media):
+    """Select an unprojected child; display occurrence:clip IDs are not raw IDs."""
+    from .commands import execute
+    return execute(bundle, [{'schema_version': 1, 'op': 'occurrence.swap-media', 'version': '1',
+                             'select': select, 'args': {'old_media': copy.deepcopy(old_media),
+                                                       'media': copy.deepcopy(media)},
+                             'intent': MEDIA_INTENT}], verified_media=verified_media).commands[0]
diff --git a/astrid/sdk/timeline/native_placement_commands.py b/astrid/sdk/timeline/native_placement_commands.py
new file mode 100644
index 000000000..0822eec0f
--- /dev/null
+++ b/astrid/sdk/timeline/native_placement_commands.py
@@ -0,0 +1,152 @@
+"""Explicit-owner placement using the existing absolute clip.move recipe.
+
+This changes an existing clip's start, preserving its media and source window.
+It does not implement the App's legacy generation placement/pooling algorithm.
+
+placement.create and placement.unplace add and remove one occurrence-owned image
+expression. They reuse occurrence media birth and bounded clip removal; there is
+no pooling, auto-position, collision shifting or registry removal.
+"""
+from __future__ import annotations
+
+import copy
+import re
+from fractions import Fraction
+
+from astrid.core.timeline.duration import clip_start_frame
+
+from ._command_state import CommandError
+from ._delete_commands import RELATIONS, _unrelated
+from ._media_inputs import _verified
+from .capture import _duration, move, move_intent, number, occurrence_start, rate
+from .native_occurrence_media_commands import _exclusive, _owner, add_media
+
+PLACEMENT_INTENT = {'ownership': 'occurrence'}
+
+
+def placement_move(ctx, command):
+    ref = command['select']
+    owner = ref.rsplit('/', 1)[0]
+    if owner != 'parent':
+        if ctx.select('placement.owners', owner) != [owner]:
+            raise CommandError('shared authored placement is unsupported',
+                               kind='unsupported_ownership', ref=owner)
+    clip = ctx.state.entity(ref)
+    asset = clip.get('asset', clip.get('asset_id'))
+    if asset is not None:
+        # Guard the entire existing binding, including opaque selection pins.
+        # Read raw paths so accepted source writes also protect against ABA.
+        if owner == 'parent':
+            ctx.read('parent', ['registry', 'assets', str(asset)])
+            ctx.read('parent', ['config', 'registry', 'assets', str(asset)])
+        else:
+            ctx.read(owner + '/source', ['registry', 'assets', str(asset)])
+    move(ctx, command)
+    if owner != 'parent':
+        extent = number(ctx.read(owner, ['duration_ms']), 'occurrence.duration_ms', positive=True) / 1000
+        moved = ctx.state.entity(ref)
+        start = moved['at'] if 'at' in moved else moved['at_ms'] / 1000
+        if start + _duration(moved) > extent + 1e-9:
+            raise CommandError('placed interval exceeds occurrence duration',
+                               kind='occurrence_boundary', ref=owner)
+
+
+def capture_placement(bundle, owner, clip_id, on, *, ownership):
+    """Capture global seconds on the original bundle, before local preview.
+
+    owner is parent or occurrence:<raw ID>; clip_id is the raw child ID.
+    ownership must explicitly match that scope. Shared authoring, pooling,
+    automatic positioning, track changes and media selection are unsupported.
+    The result is placement.move v1, with its authoritative capture.
+    """
+    if ownership == 'shared':
+        raise CommandError('shared placement is unsupported', kind='unsupported_ownership')
+    expected = ('parent' if owner == 'parent' else 'occurrence'
+                if isinstance(owner, str) and re.fullmatch(r'occurrence:[^/]+', owner)
+                and '::' not in owner else None)
+    if expected is None or ownership != expected:
+        raise CommandError('placement requires matching explicit parent or occurrence ownership',
+                           kind='unsupported_ownership')
+    if (not isinstance(clip_id, str) or not clip_id.strip()
+            or '/' in clip_id or '::' in clip_id):
+        raise CommandError('placement requires a raw clip identity', kind='identity_conflict')
+    from .commands import execute
+
+    ref = owner + '/clip:' + clip_id
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.move', 'version': '1',
+                             'select': ref, 'args': {'on': on},
+                             'intent': move_intent(ref)}]).commands[0]
+
+
+def placement_create(ctx, command):
+    """Image-only expression at an absolute time; the wrapper adds no media semantics."""
+    owner, _ = _owner(ctx, command['select'])
+    _exclusive(ctx, owner)
+    args = command['args']
+    _, kind = _verified(ctx, args['media'])
+    if kind != 'image':
+        raise CommandError('placement.create v1 requires verified image media', kind='unsupported_media')
+    row = ctx.state.occurrence(owner)
+    lane = (row.get('placement') or {}).get('track', row.get('track'))
+    if not isinstance(lane, str):
+        raise CommandError('placement requires a referenced lane', kind='unsupported_timing', ref=owner)
+    fps = rate(ctx.read('parent', ['config', 'output', 'fps']))
+    frame = clip_start_frame({'at': number(args['on'], 'on'), 'hold': 1}, float(fps))
+    at = float(Fraction(frame, 1) / fps) - occurrence_start(row)
+    clip = {'id': args['id'], 'clipType': 'image', 'asset': args['media']['asset'], 'track': lane,
+            'at': at, 'hold': args['hold']}
+    add_media(ctx, {'select': owner, 'args': {'row': clip, 'media': args['media'],
+                                                  'consumed': args.get('consumed', [])}})
+
+
+def placement_unplace(ctx, command):
+    """Remove one placed image expression; its registry binding is guarded and survives."""
+    ref = command['select']
+    owner = ref.rsplit('/', 1)[0]
+    _exclusive(ctx, owner)
+    if ref not in ctx.select('collection.clips', owner):
+        raise CommandError('placement target disappeared', kind='identity_conflict', ref=ref)
+    row = ctx.read(ref)
+    if row.get('clipType') not in ('media', 'image') or not isinstance(row.get('asset'), str):
+        raise CommandError('unplace requires one placed media clip', kind='unsupported_media', ref=ref)
+    if any(row.get(key) is not None for key in ('clips', 'children', 'time_map', 'timeMap')):
+        raise CommandError('unplace does not support nested or mapped clips', kind='unsupported_map', ref=ref)
+    # Guard the whole binding the removed expression pointed at, including ABA.
+    ctx.read(owner + '/source', ['registry', 'assets', str(row['asset'])])
+    for member in ctx.select('collection.clips', owner):
+        _unrelated(ctx, member, [[]], ('transition',))
+        _unrelated(ctx, member, [['app'], ['app', 'astrid']], RELATIONS)
+    ctx.clear(ref, [])
+
+
+def _explicit_occurrence(owner, ownership):
+    if ownership != 'occurrence' or not isinstance(owner, str) or re.fullmatch(r'occurrence:(?!.*::)[^/]+', owner) is None:
+        raise CommandError('placement requires explicit occurrence ownership', kind='unsupported_ownership')
+
+
+def _raw_clip_id(clip_id):
+    if not isinstance(clip_id, str) or not clip_id.strip() or '/' in clip_id or '::' in clip_id:
+        raise CommandError('placement requires a raw clip identity', kind='identity_conflict')
+    return clip_id
+
+
+def capture_placement_create(bundle, owner, clip_id, media, on, hold, *, ownership, verified_media,
+                             consumed=()):
+    """Caller reserves clip_id and supplies the exact five-field Runtime media selection."""
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    args = {'id': _raw_clip_id(clip_id), 'on': on, 'hold': hold, 'media': copy.deepcopy(media)}
+    if consumed:
+        args['consumed'] = list(consumed)
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.create', 'version': '1',
+                             'select': owner, 'args': args, 'intent': dict(PLACEMENT_INTENT)}], verified_media=verified_media).commands[0]
+
+
+def capture_placement_unplace(bundle, owner, clip_id, *, ownership):
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.unplace', 'version': '1',
+                             'select': owner + '/clip:' + _raw_clip_id(clip_id), 'args': {},
+                             'intent': dict(PLACEMENT_INTENT)}]).commands[0]
diff --git a/astrid/sdk/timeline/native_shot_pool_commands.py b/astrid/sdk/timeline/native_shot_pool_commands.py
new file mode 100644
index 000000000..4ef199234
--- /dev/null
+++ b/astrid/sdk/timeline/native_shot_pool_commands.py
@@ -0,0 +1,76 @@
+"""Shot pool membership: an ordered list of asset aliases the shot holds without a clip.
+
+The pool lives on the shot's internal timeline at app.astrid.pool. An absent list means
+pool membership was never authored here (a migrated group's legacy poolGenerationIds stay
+untouched in the occurrence provenance until they are adopted with explicit adds); an empty
+list is an authored empty pool. Removing the last member leaves [] and never clears the key.
+
+shot.pool add binds the exact media in the shot registry (as placement does) and appends its
+alias; remove drops the alias and keeps the binding. A member is never also a placed clip.
+Writes replace the whole list, so an inverse restores the exact order and position.
+"""
+from __future__ import annotations
+
+import copy
+
+from ._command_state import ABSENT, CommandError
+from ._media_inputs import _verified
+from .native_occurrence_media_commands import _registry
+from .native_placement_commands import _exclusive, _explicit_occurrence
+
+POOL_INTENT = {'ownership': 'occurrence'}
+POOL = ['app', 'astrid', 'pool']
+
+
+def _members(state):
+    if state == ABSENT:
+        return None
+    members = state.get('value')
+    if not isinstance(members, list) or any(not isinstance(item, str) for item in members):
+        raise CommandError('shot pool must be a list of asset aliases', kind='unsupported_pool')
+    return members
+
+
+def shot_pool(ctx, command):
+    owner = command['select']
+    ctx.read(owner, ['occurrence_id'])
+    ctx.read(owner + '/shot', ['shot_id'])
+    ctx.state.occurrence(owner)
+    ctx.bind('pool.owner', owner)
+    _exclusive(ctx, owner)
+    ctx.read('parent', ['config', 'pinnedShotGroups'])
+    action, pin = command['args']['action'], command['args']['media']
+    alias = pin['asset']
+    _, kind = _verified(ctx, pin)
+    source = owner + '/source'
+    ctx.read(source, POOL)
+    members = _members(ctx.state.get(source, POOL))
+    if action == 'add':
+        if members is not None and alias in members:
+            raise CommandError('media is already pooled', kind='identity_collision', ref=owner)
+        for ref in ctx.select('collection.clips', owner):
+            for key in ('asset', 'asset_id'):
+                ctx.read(ref, [key])
+            row = ctx.state.entity(ref)
+            if alias in (row.get('asset'), row.get('asset_id')):
+                raise CommandError('media is already placed in the shot', kind='identity_conflict', ref=ref)
+        _registry(ctx, owner, pin, kind, create=True)
+        if members is None:
+            ctx.object(source, POOL[:1])
+            ctx.object(source, POOL[:2])
+        ctx.write(source, POOL, [*(members or []), alias])
+    else:
+        if members is None or alias not in members:
+            raise CommandError('media is not pooled', kind='identity_conflict', ref=owner)
+        _registry(ctx, owner, pin, kind)
+        ctx.write(source, POOL, [item for item in members if item != alias])
+
+
+def capture_shot_pool(bundle, owner, action, media, *, ownership, verified_media):
+    """Caller supplies the exact five-field Runtime selection; action is add or remove."""
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    return execute(bundle, [{'schema_version': 1, 'op': 'shot.pool', 'version': '1', 'select': owner,
+                             'args': {'action': action, 'media': copy.deepcopy(media)},
+                             'intent': dict(POOL_INTENT)}], verified_media=verified_media).commands[0]
diff --git a/astrid/sdk/timeline/outbox.py b/astrid/sdk/timeline/outbox.py
new file mode 100644
index 000000000..d97a3124c
--- /dev/null
+++ b/astrid/sdk/timeline/outbox.py
@@ -0,0 +1,56 @@
+"""Atomic storage for unsent commands and one exact in-flight request."""
+from __future__ import annotations
+
+import fcntl
+import json
+import os
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+
+def request_bytes(value):
+    # Match the generated commit_timeline serializer, including insertion order.
+    return json.dumps(value, separators=(",", ":"), allow_nan=False).encode()
+
+
+class Outbox:
+    def __init__(self, path: Path):
+        self.path = Path(path)
+
+    @contextmanager
+    def locked(self):
+        missing, directory = [], self.path.parent
+        while not directory.exists():
+            missing.append(directory)
+            directory = directory.parent
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        for directory in reversed(missing):
+            descriptor = os.open(directory.parent, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(descriptor)
+            finally:
+                os.close(descriptor)
+        with self.path.with_suffix(self.path.suffix + ".lock").open("a") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            yield
+
+    def read(self):
+        return json.loads(self.path.read_bytes()) if self.path.exists() else None
+
+    def write(self, state):
+        descriptor, name = tempfile.mkstemp(prefix=".outbox-", dir=self.path.parent)
+        try:
+            with os.fdopen(descriptor, "wb") as stream:
+                stream.write(request_bytes(state))
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(name, self.path)
+            directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+        finally:
+            if os.path.exists(name):
+                os.unlink(name)
