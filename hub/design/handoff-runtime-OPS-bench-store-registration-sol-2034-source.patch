+    def _registration_lock(self, index, exclusive=False):
+        check('registration_cutover' in index,
+              'legacy cutover unknown: no pre-birth caller custody; owner supervisor boundary required')
+        path = self.root / 'locks' / 'registration-cutover'
+        fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
+        try:
+            info = os.fstat(fd)
+            check(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
+                  and info.st_nlink == 1 and not info.st_mode & 0o022
+                  and [info.st_dev, info.st_ino] == inode(path) == index['registration_cutover'],
+                  'registration lease inode changed/foreign')
+            fcntl.flock(fd, (fcntl.LOCK_EX | fcntl.LOCK_NB) if exclusive else fcntl.LOCK_SH)
+            os.set_inheritable(fd, True)
+            return fd
+        except BaseException:
+            os.close(fd)
+            raise
+
+    @contextlib.contextmanager
+    def prelease_suite(self, repo, suite):
+        # Called before suite/env use; supervisor inherits custody through descendants.
+        fd = None
+        try:
+            with self.mutex():
+                index = self._load()
+                if repo == 'agent' and suite in {name + '-nodes' for name in self.UNREGISTER}:
+                    check(suite[:-6] not in index['retired'], 'registration was unregistered')
+                    fd = self._registration_lock(index)
+            yield [] if fd is None else [fd]
+        finally:
+            if fd is not None:
+                os.close(fd)
+
+    def _unregister_projections(self, before, suites, envs):
+        check(set(envs) == set(self.UNREGISTER), 'exact seven registration names required')
+        check(not set(envs) & (set(before['registrations']) | set(before['retired'])),
+              'managed or already retired registration protected')
+        rows = suites.splitlines(keepends=True)
+        targets = []
+        for name, expected in self.UNREGISTER.items():
+            pair = ['agent', name + '-nodes']
+            matches = [row for row in rows if row.split(None, 2)[:2] == pair]
+            check(len(matches) == 1 and digest(matches[0]) == expected['suite_sha256'],
+                  'suite absent, ambiguous or changed: ' + name)
+            check(isinstance(envs[name], str) and digest(envs[name]) == expected['env_sha256'],
+                  'env absent or changed: ' + name)
+            targets.append(matches[0])
+        outside = ''.join(row for row in rows if row not in targets)
+        check(not any(name in outside for name in envs), 'outside suite reference protected')
+        return {'suites.conf': [suites, outside],
+                **{name + '.env': [envs[name], None] for name in sorted(envs)}}
+
+    def _validate_unregistration(self, journal):
+        before, after = journal['before'], journal['after']
+        check(journal['new'] is None and journal['victims'] == sorted(self.UNREGISTER),
+              'unregistration has no payload authority')
+        check('registration_cutover' in before, 'legacy cutover unknown in journal')
+        projections = journal['projections']
+        check(set(projections) == {'suites.conf', *(name + '.env' for name in self.UNREGISTER)},
+              'unregistration projection names')
+        expected = self._unregister_projections(before, projections['suites.conf'][0],
+                                              {name: projections[name + '.env'][0] for name in self.UNREGISTER})
+        check(projections == expected, 'unregistration projection authority/hash mismatch')
+        desired = json.loads(canonical(before))
+        desired['retired'].extend(sorted(self.UNREGISTER))
+        for name in sorted(self.UNREGISTER):
+            pair = ['agent', name + '-nodes']
+            if pair not in desired['retired_suites']:
+                desired['retired_suites'].append(pair)
+        check(after == desired, 'unregistration index authority')
+
+    def _registration_snapshot(self):
+        check(self.tests.stat().st_uid == os.getuid() and not self.tests.stat().st_mode & 0o022,
+              'unsafe registration directory')
+        return {p.name: (inode(p), read(p)) for p in self.tests.iterdir()
+                if p.name == 'suites.conf' or p.name.endswith('.env')}
+
+    def _apply_unregistration(self, projections):
+        snapshot = self._registration_snapshot()
+        for name, values in projections.items():
+            check(snapshot.get(name, (None, None))[1] in values, 'projection changed while pending')
+        for name, (_, value) in snapshot.items():
+            if name != 'suites.conf' and name not in projections:
+                check(not any(target in value for target in self.UNREGISTER),
+                      'outside env reference protected: ' + name)
+        for name, values in projections.items():
+            self._checkpoint('unregistration:publish:' + name)
+            check(self._registration_snapshot() == snapshot, 'registration raced during publication')
+            self._apply_projection({name: values}, True)
+            current = self._registration_snapshot()
+            check(current.get(name, (None, None))[1] == values[1], 'publication changed')
+            check({k: v for k, v in current.items() if k != name}
+                  == {k: v for k, v in snapshot.items() if k != name}, 'outside registration raced')
+            snapshot = current
+        return snapshot
+
+    def unregister(self, request):
+        check(isinstance(request, dict) and set(request) == {'names', 'suites_sha256'},
+              'unregistration request schema')
+        check(request['names'] == self.UNREGISTER, 'exact original seven identities required')
+        with self.mutex():
+            before = self._load()
+            self._verify_projection(before)
+            fd = self._registration_lock(before, True)
+            try:
+                snapshot = self._registration_snapshot()
+                suites = snapshot['suites.conf'][1]
+                check(digest(suites) == request['suites_sha256'], 'stale suite baseline')
+                envs = {name: snapshot.get(name + '.env', (None, None))[1] for name in self.UNREGISTER}
+                projections = self._unregister_projections(before, suites, envs)
+                for name, (_, value) in snapshot.items():
+                    if name != 'suites.conf' and name not in projections:
+                        check(not any(target in value for target in self.UNREGISTER),
+                              'outside env reference protected: ' + name)
+                after = json.loads(canonical(before))
+                after['retired'].extend(sorted(self.UNREGISTER))
+                for name in sorted(self.UNREGISTER):
+                    pair = ['agent', name + '-nodes']
+                    if pair not in after['retired_suites']:
+                        after['retired_suites'].append(pair)
+                journal = {'version': 1, 'owner': self.owner['id'], 'kind': 'unregistration',
+                           'before': before, 'after': after, 'projections': projections,
+                           'victims': sorted(self.UNREGISTER), 'new': None}
+                self._validate_unregistration(journal)
+                self._checkpoint('unregistration:validated')
+                check(self._registration_snapshot() == snapshot, 'registration raced before journal')
+                self._save_journal(journal)
+                self._checkpoint('unregistration:journal')
+                check(self._registration_snapshot() == snapshot, 'registration raced after journal')
+                self._roll(journal, True)
+            finally:
+                os.close(fd)
+
