+runtime_sha=$RUNTIME_SHA
+runtime_tree=$(git -C "$RUNTIME_PATH" rev-parse HEAD^{tree})
+runtime_parents=$(git -C "$RUNTIME_PATH" rev-list --parents -n 1 HEAD)
+runtime_path=$RUNTIME_PATH
