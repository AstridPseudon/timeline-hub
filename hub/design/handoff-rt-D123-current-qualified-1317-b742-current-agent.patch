+    clips[0]["app"]["on"] = "end of c1"
+    clips[1]["app"]["on"] = "c1"
+    with pytest.raises(TimingCycleError) as error:
+        compile_timing(TimingInputs(bundle))
+    assert ("cut", "c01", "end") in error.value.path
+    assert ("cut", "c02", "start") in error.value.path
