+@pytest.mark.parametrize("damage", ["parent_digest", "shot_digest", "internal_digest", "missing_shot",
+                                    "missing_internal", "orphan", "link", "scope", "manifest"])
+def test_inconsistent_saved_closure_refuses(damage):
