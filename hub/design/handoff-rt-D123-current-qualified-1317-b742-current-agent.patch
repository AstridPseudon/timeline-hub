+@pytest.mark.parametrize("error", [RuntimeError("consumer failed"), KeyboardInterrupt(), subprocess.TimeoutExpired("consumer", 1)])
+def test_normal_consumer_failure_cancel_and_timeout_release_attempt(normal_run, error):
