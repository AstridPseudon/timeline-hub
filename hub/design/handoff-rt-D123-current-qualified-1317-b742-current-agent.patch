+            step['patch'] = effects
+            step['dependencies'] = dependencies
+        for cause, effect in self.compiler_effects:
+            destination = self.step(cause)
+            ref, path = canonical_site(self.closures[cause], effect['ref'], effect['path'])
+            for step in self.steps:
