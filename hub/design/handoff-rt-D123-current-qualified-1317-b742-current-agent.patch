@@ -0,0 +1,168 @@
+"""P4's collected note-04 conflict and public callback rerun case."""
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from typing import Any
+
+from astrid.sdk import timeline
+from astrid.sdk.timeline.commit import _digest, bundle_from_document
+from astrid_runtime_client import ApiError
+from tests.sdk.test_timeline_commit_provider_document import document_fixture
+from tests.sdk.test_timeline_sync import connected as connected_fixture  # noqa: F401
+
+ROOT = Path(__file__).parents[2]
+CASES = ROOT / "tests/sdk/fixtures/p4_commit_cases/cases.json"
+NOTE_PATH = ["clips", "id:clip-a", "app", "org.example", "p4_note", "note-04"]
+SUFFIX = " — reviewed"
+
+
+def _case() -> dict[str, Any]:
+    data = json.loads(CASES.read_text(encoding="utf-8"))
+    return next(case for case in data["cases"] if case["id"] == "ten-notes-one-commit")
+
+
+def _notes() -> dict[str, str]:
+    return {note["id"]: note["text"] for note in _case()["notes"]}
+
+
+def _set_note(bundle: dict[str, Any], value: str) -> None:
+    for clips in (bundle["parent"]["clips"], bundle["parent"]["config"]["clips"]):
+        clip = next(row for row in clips if row["id"] == "clip-a")
+        clip["app"]["org.example"].setdefault("p4_note", {})["note-04"] = value
+
+
+def _note(bundle: dict[str, Any]) -> str | None:
+    values = []
+    for clips in (bundle["parent"]["clips"], bundle["parent"]["config"]["clips"]):
+        clip = next(row for row in clips if row["id"] == "clip-a")
+        values.append(clip["app"]["org.example"].get("p4_note", {}).get("note-04"))
+    assert values[0] == values[1]
+    return values[0]
+
+
+def _seed_document() -> dict[str, Any]:
+    case_notes = _notes()
+    document = document_fixture(shared=True)
+    document.update(project_id="p", timeline_id="t")
+    document["parent_revision"]["revision_id"] = "r0"
+    payload = document["parent_revision"]["payload"]
+    original_notes = {note_id: value for note_id, value in case_notes.items() if note_id != "note-04"}
+    for clips in (payload["clips"], payload["config"]["clips"]):
+        clip = next(row for row in clips if row["id"] == "clip-a")
+        clip["app"]["org.example"]["p4_note"] = copy.deepcopy(original_notes)
+    document["parent_revision"]["content_digest"] = _digest(payload)
+    return document
+
+
+def _open_real_document(connected_fixture) -> tuple[Any, Any, dict[str, Any]]:  # noqa: F811
+    client, generated, path = connected_fixture
+    document = _seed_document()
+    generated.bundles = {"r0": bundle_from_document(document)}
+    generated.head = {"revision_id": "r0", "publication_id": "pub0"}
+    generated.publications["peer-revision"] = "peer-publication"
+    return timeline.open("p", "t", client=client, outbox_path=path), generated, document
+
+
+def test_p4_note_conflict_reruns_public_function_from_verified_peer_document(connected_fixture, monkeypatch):  # noqa: F811
+    tl, generated, original_document = _open_real_document(connected_fixture)
+    client, _, path = connected_fixture
+    case = _case()
+    note_values = _notes()
+    peer_value = case["conflict"]["peer_edit"]["value"]
+    base_bundle = copy.deepcopy(generated.bundles["r0"])
+    evaluations: list[tuple[dict[str, str], str | None]] = []
+    sent: list[tuple[dict[str, Any], str]] = []
+    original_commit = generated.commit_timeline
+
+    def conflict_then_accept(*args, **kwargs):
+        body = copy.deepcopy(args[2])
+        sent.append((body, kwargs["idempotency_key"]))
+        if len(sent) == 1:
+            peer_bundle = copy.deepcopy(base_bundle)
+            _set_note(peer_bundle, peer_value)
+            generated.bundles["peer-revision"] = peer_bundle
+            generated.head = {"revision_id": "peer-revision", "publication_id": "peer-publication"}
+            raise ApiError(409, "conflict", "changed", details={
+                "status": "conflict",
+                "reason": "value_conflict",
+                "code": "value_conflict",
+                "path": NOTE_PATH,
+                "hint": "read the returned peer head",
+                "suggested_command": "timeline show",
+                "current": copy.deepcopy(generated.head),
+            })
+        return original_commit(*args, **kwargs)
+
+    monkeypatch.setattr(generated, "commit_timeline", conflict_then_accept)
+
+    def append_review_suffix(working):
+        current = _note(working.bundle)
+        evaluations.append((working.head, current))
+        source = current if current is not None else note_values["note-04"]
+        _set_note(working.bundle, source + SUFFIX)
+
+    result = tl.commit(append_review_suffix, idempotency_key="p4-note-original")
+
+    assert len(evaluations) == 2
+    assert [head["revision_id"] for head, _ in evaluations] == ["r0", "peer-revision"]
+    assert [value for _, value in evaluations] == [None, peer_value]
+    assert [key for _, key in sent][0] == "p4-note-original"
+    assert sent[1][1] != sent[0][1]
+    assert [body["base_revision_id"] for body, _ in sent] == ["r0", "peer-revision"]
+    assert [body["base_publication_id"] for body, _ in sent] == ["pub0", "peer-publication"]
+    assert client.reads == ["r0", "r0", "peer-revision"]
+
+    first_body, second_body = (body for body, _ in sent)
+    assert first_body["api_version"] == second_body["api_version"] == 1
+    assert first_body["project_id"] == second_body["project_id"] == "p"
+    assert first_body["timeline_id"] == second_body["timeline_id"] == "t"
+    assert first_body["label"] == second_body["label"] == "append_review_suffix"
+    assert first_body["merge"] == second_body["merge"] == "atomic"
+    assert "reads" not in first_body and "reads" not in second_body
+    assert first_body["source"] == second_body["source"] == {"via": "python"}
+    assert first_body["dry_run"] is second_body["dry_run"] is False
+
+    first_change = first_body["commands"][0]["args"]["changes"]
+    second_change = second_body["commands"][0]["args"]["changes"]
+    assert first_body["commands"][0]["op"] == second_body["commands"][0]["op"] == "doc.patch"
+    assert first_change == [{
+        "op": "set", "ref": "parent", "path": NOTE_PATH,
+        "before": {"state": "absent"}, "value": note_values["note-04"] + SUFFIX,
+    }]
+    assert second_change == [{
+        "op": "set", "ref": "parent", "path": NOTE_PATH,
+        "before": {"state": "present", "value": peer_value}, "value": peer_value + SUFFIX,
+    }]
+    for body, change in ((first_body, first_change), (second_body, second_change)):
+        assert body["steps"] == [{
+            "id": "step-1", "label": "Edit document", "intent": "", "tags": [],
+            "command_ordinals": [0], "patch": change,
+            "reads": [{"kind": "scope", "ref": "timeline", "path": []}],
+        }]
+
+    assert result["data"]["status"] == "accepted"
+    assert len(generated.accepted) == 1
+    canonical = result["data"]["canonical_document"]
+    expected_bundle = copy.deepcopy(generated.bundles["peer-revision"])
+    _set_note(expected_bundle, peer_value + SUFFIX)
+    landed_bundle = generated.bundles[result["data"]["accepted_revision_id"]]
+    assert landed_bundle == expected_bundle
+    parent = canonical["parent_revision"]["payload"]
+    expected_parent = expected_bundle["parent"]
+    assert {key: parent[key] for key in ("config", "clips", "registry", "name", "unknown")} == {
+        key: expected_parent[key] for key in ("config", "clips", "registry", "name", "unknown")
+    }
+    assert _note(landed_bundle) == peer_value + SUFFIX
+    assert parent["clips"][0]["app"]["org.example"]["literal"] == "clip-a"
+    assert parent["clips"][0]["app"]["org.example"]["clear"] is None
+    assert parent["config"]["opaque"] == {"timestamp": "authored timestamp", "v": [None, False, 0]}
+    assert canonical["shot_revisions"]
+    assert canonical["internal_timeline_revisions"]
+    assert canonical["shot_revisions"][0]["payload"]["unknown"] == {"keep": None}
+    assert canonical["internal_timeline_revisions"][0]["payload"]["unknown"] == [1, 2]
+    assert canonical["dependency_manifest"]["media"] == original_document["dependency_manifest"]["media"]
+    assert original_document["parent_revision"]["payload"]["unknown"] == expected_parent["unknown"]
+    assert json.loads(path.read_text(encoding="utf-8"))["pending"] == []
+    assert json.loads(path.read_text(encoding="utf-8"))["flight"] is None
diff --git a/tests/sdk/test_p4_ten_note_provider.py b/tests/sdk/test_p4_ten_note_provider.py
new file mode 100644
index 0000000000000000000000000000000000000000..1ed257c4604552793d2eaabfc117babe93c5b445
--- /dev/null
+++ b/tests/sdk/test_p4_ten_note_provider.py
@@ -0,0 +1,206 @@
+"""P4's ten-note commit and guarded per-step undo through the Python provider."""
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from astrid.sdk.timeline.commit import (
+    _digest,
+    bundle_from_document,
+    create_runtime_commit_service,
+)
+from astrid.sdk.timeline.emitter import emit_document_commands
+from tests.sdk.test_timeline_commit_provider import (
+    CommitRejected,
+    DetachedPort,
+    DetachedRealm,
+    detached,
+    inverse,
+)
+from tests.sdk.test_timeline_commit_provider import runtime_abi as runtime_abi
+from tests.sdk.test_timeline_commit_provider_document import document_fixture
+
+ROOT = Path(__file__).parents[2]
+CASES = ROOT / "tests" / "sdk" / "fixtures" / "p4_commit_cases" / "cases.json"
+
+
+def _notes() -> list[dict[str, Any]]:
+    data = json.loads(CASES.read_text(encoding="utf-8"))
+    case = next(case for case in data["cases"] if case["id"] == "ten-notes-one-commit")
+    return case["notes"]
+
+
+NOTES = _notes()
+NOTE_IDS = [note["id"] for note in NOTES]
+NOTE_VALUES = {note["id"]: note["text"] for note in NOTES}
+NOTE_PATH_PREFIX = ["clips", "id:clip-a", "app", "org.example", "p4_note"]
+
+
+def _reload(value: Any) -> Any:
+    """Use the existing JSON boundary without implying Runtime persistence."""
+    return json.loads(json.dumps(value, allow_nan=False))
+
+
+def _seed_document() -> dict[str, Any]:
+    document = document_fixture()
+    payload = document["parent_revision"]["payload"]
+    for clips in (payload["clips"], payload["config"]["clips"]):
+        clips[0]["app"]["org.example"]["p4_note"] = {}
+    document["parent_revision"]["content_digest"] = _digest(payload)
+    return _reload(document)
+
+
+def _set_note(bundle: dict[str, Any], note_id: str, value: Any) -> None:
+    for clips in (bundle["parent"]["clips"], bundle["parent"]["config"]["clips"]):
+        clips[0]["app"]["org.example"]["p4_note"][note_id] = value
+
+
+def _note_values(document: dict[str, Any]) -> dict[str, Any]:
+    payload = document["parent_revision"]["payload"]
+    clip = payload["clips"][0]
+    notes = copy.deepcopy(clip["app"]["org.example"]["p4_note"])
+    assert payload["config"]["clips"][0]["app"]["org.example"]["p4_note"] == notes
+    return notes
+
+
+def _submit(realm: DetachedRealm, calls: list[dict[str, Any]], *, steps=None):
+    context = realm.context(calls)
+    context["request"].update({
+        "label": "Add ten review notes",
+        "merge": "fields",
+        "reads": [],
+        "steps": steps,
+    })
+    context["invocation"]["body"] = copy.deepcopy(context["request"])
+    context["request_hash"] = _digest(context["invocation"])
+    return create_runtime_commit_service().commit(context, DetachedPort(realm, context))
+
+
+def _step(note: dict[str, Any], ordinal: int, command: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "id": note["id"],
+        "label": note["id"],
+        "intent": note["text"],
+        "tags": ["review"],
+        "command_ordinals": [ordinal],
+        "patch": copy.deepcopy(command["args"]["changes"]),
+    }
+
+
+def _ten_note_commit() -> tuple[DetachedRealm, dict[str, Any], dict[str, Any]]:
+    original = _seed_document()
+    realm = DetachedRealm(_reload(original))
+    bundle = bundle_from_document(realm.documents[realm.head["revision_id"]])
+    calls: list[dict[str, object]] = []
+    steps: list[dict[str, object]] = []
+    for ordinal, note in enumerate(NOTES):
+        before = copy.deepcopy(bundle)
+        after = copy.deepcopy(bundle)
+        _set_note(after, note["id"], note["text"])
+        emitted = emit_document_commands(before, after)
+        assert len(emitted) == 1
+        call = emitted[0]
+        assert call["args"]["changes"][0]["path"] == [*NOTE_PATH_PREFIX, note["id"]]
+        assert call["args"]["changes"][0]["before"] == {"state": "absent"}
+        calls.append(call)
+        steps.append(_step(note, ordinal, call))
+        bundle = after
+
+    assert len(calls) == len(steps) == 10
+    result = _submit(realm, calls, steps=steps)
+    assert result["data"]["status"] == "accepted"
+    return realm, original, result
+
+
+def _without_notes(document: dict[str, Any]) -> dict[str, Any]:
+    value = copy.deepcopy(document["parent_revision"]["payload"])
+    for clips in (value["clips"], value["config"]["clips"]):
+        clips[0]["app"]["org.example"].pop("p4_note", None)
+    return value
+
+
+def _assert_note_only_change(document: dict[str, Any], original: dict[str, Any]) -> None:
+    assert _without_notes(document) == _without_notes(original)
+    for key in ("shot_revisions", "internal_timeline_revisions", "dependency_manifest"):
+        assert document[key] == original[key]
+
+
+def _assert_original_history(realm: DetachedRealm, original_entry: dict[str, Any]) -> None:
+    assert realm.entries[1] == original_entry
+    assert [entry["publication_id"] for entry in realm.entries].count(original_entry["publication_id"]) == 1
+
+
+@pytest.mark.parametrize("selected_note", NOTE_IDS)
+def test_ten_note_commit_independently_undoes_each_step_and_redoes(selected_note: str) -> None:
+    realm, original, landed = _ten_note_commit()
+    original_entry = detached(realm.entries[-1])
+    stored_steps = original_entry["records"]["steps"]
+    assert original_entry["records"]["label"] == "Add ten review notes"
+    assert original_entry["records"]["merge_mode"] == "fields"
+    assert len(original_entry["records"]["commands"]) == 10
+    assert len(stored_steps) == 10
+    assert [step["id"] for step in stored_steps] == NOTE_IDS
+    assert [step["label"] for step in stored_steps] == NOTE_IDS
+    assert [step["intent"] for step in stored_steps] == [note["text"] for note in NOTES]
+    assert [step["tags"] for step in stored_steps] == [["review"]] * 10
+    assert [step["command_ordinals"] for step in stored_steps] == [[index] for index in range(10)]
+    assert all(step["patch"] and step["dependencies"] for step in stored_steps)
+    assert [step["patch"][0]["path"][-1] for step in stored_steps] == NOTE_IDS
+    assert [step["patch"][0]["value"] for step in stored_steps] == [note["text"] for note in NOTES]
+    assert _note_values(landed["data"]["canonical_document"]) == NOTE_VALUES
+
+    original_record_count = len(realm.entries)
+    undo_call = inverse([landed["receipt"]["receipt_id"]])
+    undo_call["args"]["steps"] = {landed["receipt"]["receipt_id"]: [selected_note]}
+    undo_result = realm.call([undo_call])
+    assert undo_result["data"]["status"] == "accepted"
+    # The provider stores the authenticated selection, not a caller-supplied inverse patch.
+    assert realm.prepared[-1]["records"]["undo_steps"] == {
+        landed["receipt"]["receipt_id"]: [selected_note]
+    }
+    expected_remaining = {note_id: text for note_id, text in NOTE_VALUES.items() if note_id != selected_note}
+    undone_document = undo_result["data"]["canonical_document"]
+    assert _note_values(undone_document) == expected_remaining
+    _assert_note_only_change(undone_document, original)
+    assert len(realm.entries) == original_record_count + 1
+    assert len(realm.accepted) == 2
+    _assert_original_history(realm, original_entry)
+
+    reloaded_undo = _reload(undone_document)
+    assert reloaded_undo == undone_document
+    redo_result = realm.call([inverse([undo_result["receipt"]["receipt_id"]])])
+    assert redo_result["data"]["status"] == "accepted"
+    assert _note_values(redo_result["data"]["canonical_document"]) == NOTE_VALUES
+    _assert_note_only_change(redo_result["data"]["canonical_document"], original)
+    assert len(realm.accepted) == 3
+    _assert_original_history(realm, original_entry)
+
+
+def _emitted_note_change(realm: DetachedRealm, note_id: str, value: Any) -> dict[str, Any]:
+    before = bundle_from_document(realm.documents[realm.head["revision_id"]])
+    after = copy.deepcopy(before)
+    _set_note(after, note_id, value)
+    commands = emit_document_commands(before, after)
+    assert len(commands) == 1
+    return commands[0]
+
+
+def test_same_note_later_write_aba_refuses_without_partial_acceptance() -> None:
+    realm, _original, landed = _ten_note_commit()
+    original_entry = detached(realm.entries[-1])
+    note_id = "note-04"
+    realm.call([_emitted_note_change(realm, note_id, "Peer reviewer owns this note")])
+    realm.call([_emitted_note_change(realm, note_id, NOTE_VALUES[note_id])])
+    before = (detached(realm.head), detached(realm.entries), detached(realm.documents))
+
+    with pytest.raises(CommitRejected) as error:
+        realm.call([inverse([landed["receipt"]["receipt_id"]])])
+
+    assert error.value.failure["details"]["reason"] in {"intervening_write", "inverse_conflict"}
+    assert (realm.head, realm.entries, realm.documents) == before
+    assert realm.entries[1] == original_entry
+    assert len(realm.accepted) == 3
diff --git a/tests/sdk/test_remote_timeline_owner_scope.py b/tests/sdk/test_remote_timeline_owner_scope.py
