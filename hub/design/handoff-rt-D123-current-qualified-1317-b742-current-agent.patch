+    elif damage == 'stage-writes':
+        commands[0]['writes'] = copy.deepcopy(commands[0]['writes'])
+        commands[0]['writes'][-1]['before']['value']['payload']['name'] = 'Wrong'
+    elif damage in ('native-before', 'native-after'):
