+def captured():
+    raw = zlib.decompress(base64.b85decode(_CAPTURE))
+    assert hashlib.sha256(raw).hexdigest() == '16d87e20b1dc37be2246c8f9db0e61d3af12069c42acd03a980a9cd68a94c970'
+    return json.loads(raw)
