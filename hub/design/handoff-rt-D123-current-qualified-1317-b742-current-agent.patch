+    candidate['placements'].pop()
+    candidate['shots']['unplaced']['payload']['name'] = 'local only'
+    candidate['shots'][local]['payload']['unknown']['keep'] = 'reachable'
+    result = publish_authoring_candidate(candidate, writer, idempotency_key='filter')
