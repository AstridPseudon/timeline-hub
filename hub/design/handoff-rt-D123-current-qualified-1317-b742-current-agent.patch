+    assert.equal(s.diagnostics.mouth.status, 'known'); // normalized footprint, not occupied pixels
+    assert.equal(querySceneFrame(prepareHostScene(props, basis, {}), 0).coverage, 'UNKNOWN');
+    for (const missing of [{asset: 'missing'}, {params: {...c.params, src: '/not-a-presenter-asset.png'}}]) {
+      const other = {...c, ...missing};
+      assert.deepEqual(support(other, 0), s);
+      assert.equal(query(other, 0).diagnostics.face, undefined);
+    }
+    for (const ramps of [{mosaicIn: {frames: 8}}, {mosaicOut: {frames: 8}},
+      {mosaicIn: {frames: 8, steps: [48, 6]}}]) {
+      const m = clip({...ramps, mouth: {x: 151, y: 104, w: 19}, words, chrome: 'none', blinkEvery: 0});
+      for (const frame of [0, 1, 3, 4, 6, 7, 8, 52, 53, 54, 55, 56, 57, 58, 59]) {
+        const layer = query(m, frame);
+        assertMotion(m, frame, basis, layer);
+        const direct = support(m, frame);
+        assert.deepEqual(layer.diagnostics.mouth, direct.diagnostics.mouth);
+        if (layer.diagnostics.mouth.status === 'unknown') {
+          assert.match(layer.diagnostics.mouth.reason, /mosaic/);
+          assert.equal(drawnOverlay(m, frame), drawnOverlay(c, 0));
+        }
+      }
+    }
+    const mosaic = {mosaicIn: {frames: 8}, mouth: {x: 151, y: 104, w: 19}};
+    assert.equal(query(clip(mosaic), 0).diagnostics.mouth.status, 'unknown');
+    assert.equal(query(clip(mosaic), 6).diagnostics.mouth.status, 'known');
+    for (const extra of [{cropLeft: .1}, {entrance: 'fade-up'}, {exit: 'fade-up'},
+      {modifiers: [{id: 'unknown', element: {packId: 'missing', kind: 'modifier', id: 'missing'}, params: {}}]}]) {
+      const outer = query({...c, ...extra}, 2);
+      assert.equal(outer.diagnostics.mouth.status, 'unknown');
+      assertMotion({...c, ...extra}, 2, basis, outer);
+    }
+  }
+
+  if (mode === 'clock') {
+    for (const fps of [30, 24000 / 1001]) for (const speed of [.5, 1, 2]) {
+      const b = {...basis, fps};
+      const outgoing = clip({chrome: 'none'}, {id: 'out', hold: 1});
+      const incoming = clip({words, bob: 1, punchAt: [2, 8], chrome: 'none', blinkEvery: 0},
+        {id: 'in', at: 1, from: 17, to: 18, hold: 1, speed, transition: {type: 'fade', duration: .4}});
+      const props = propsFor([outgoing, incoming], b);
+      const scene = prepareHostScene(props, b, {});
+      let preroll = false;
+      let remapDistinguished = speed === 1;
+      const end = getTimelineDurationInFrames(props.timeline, fps);
+      for (let frame = 0; frame <= end; frame++) {
+        const row = querySceneFrame(scene, frame);
+        const html = render(props, frame, b);
+        for (const c of [outgoing, incoming]) {
+          const layer = row.layers.find(l => l.clipId === c.id);
+          assert.equal(html.includes(`data-clip-id="${c.id}"`), Boolean(layer));
+          if (!layer) continue;
+          const supplied = Math.floor(layer.contentFrame * (c.speed ?? 1));
+          assertMotion(c, frame, b, layer, supplied);
+          assert.ok(html.includes(drawnOverlay(c, supplied, b)), `actual draw clock ${fps}:${speed}:${frame}`);
+          if (c === incoming && frame < Math.round(c.at * fps)) preroll = true;
+          if (c === incoming && supplied !== layer.contentFrame
+            && motionAt(c.params, supplied, fps).mouth !== motionAt(c.params, layer.contentFrame, fps).mouth) remapDistinguished = true;
+        }
+      }
+      assert.equal(preroll, true);
+      assert.equal(remapDistinguished, true);
+      assert.ok(querySceneFrame(scene, end - 1).layers.some(layer => layer.clipId === 'in'));
+      assert.equal(querySceneFrame(scene, end).layers.length, 0);
+    }
+  }
+
+  if (mode === 'registration') {
+    const c = clip();
+    assert.equal(query(c, 0).diagnostics.motion.mouth, 0);
+    assert.deepEqual(query({...c, elementRef: undefined}, 2).diagnostics, query(c, 2).diagnostics);
+    assert.throws(() => query({...c, elementRef: {...owner, packId: 'missing'}}, 0), /Unknown effect owner/);
+    assert.throws(() => query({...c, elementRef: {...owner, packId: 'rendering'}}, 0), /Unknown effect owner/);
+    // The normal owner-qualified dispatch forwards the actual component's hook.
+    assert.deepEqual(query(c, 2).diagnostics, support(c, 2).diagnostics);
+    const props = propsFor([c]);
+    const tracks = props.timeline.tracks.map(track => ({track, clips: props.timeline.clips}));
+    const scene = prepareCompositionScene(tracks, props.assets, 30, runtimeTheme, 1920, 1080,
+      undefined, undefined, {}, '', {}, registries, props.compiledTransitions);
+    assert.deepEqual(querySceneFrame(scene, 2).layers[0].diagnostics, query(c, 2).diagnostics);
+  }
+  console.log(JSON.stringify({ok: true, case: mode}));
+}
diff --git a/tests/packs/rendering/presenter_selected_cut_query.mjs b/tests/packs/rendering/presenter_selected_cut_query.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8e22ae405416801a50907e4d4389644960394c8e
--- /dev/null
+++ b/tests/packs/rendering/presenter_selected_cut_query.mjs
@@ -0,0 +1,41 @@
+// Read-only query of the exact retained four-still Root. No capture or SSR.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createHash} from 'node:crypto';
+import {querySceneFrame} from '@banodoco/timeline-composition/evaluation';
+import {basis, prepareRoot, propsFor, seriesInspection} from './presenter_crop_geometry.mjs';
+
+const retained = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
+assert.deepEqual(retained.frames, [0, 3, 4, 5]);
+assert.deepEqual(retained.basis, basis);
+// The retained explicit public10 theme stays exact when querying public13.
+assert.equal(createHash('sha256').update(fs.readFileSync(process.argv[2])).digest('hex'),
+  'eabcc179baa4b97b6bdf1c8343ca270ef090e1306ab8791ee32787c3226385af');
+assert.deepEqual(retained.props.timeline, propsFor().timeline);
+assert.deepEqual(retained.props.assets, propsFor().assets);
+const original = JSON.stringify(retained);
+const scene = prepareRoot(retained.props, retained.basis, {});
+// seriesInspection resolves this exact compiled ID and registered owner,
+// checks the DrawPlan's component zero, then makes its one public ROI query.
+const zero = seriesInspection(scene, retained.props);
+const answers = retained.frames.map(frame => querySceneFrame(scene, frame));
+const {erase, ...expected} = retained.rows[0];
+// inspection.json is the capture's JSON boundary, which serializes -0 as 0.
+// Match that same boundary; no geometry, pixel or threshold is normalized.
+assert.deepEqual(JSON.parse(JSON.stringify(zero)), expected);
+
+// Invalid selections refuse before the helper reaches querySceneFrame.
+const controls = [];
+const refuse = (name, props, id) => {
+  assert.throws(() => seriesInspection(scene, props, id));
+  controls.push(name);
+};
+refuse('missing-compiled-id', retained.props, 'missing');
+refuse('ambiguous-compiled-id', {...retained.props, timeline: {...retained.props.timeline,
+  clips: [...retained.props.timeline.clips, retained.props.timeline.clips[0]]}});
+const changed = patch => ({...retained.props, timeline: {...retained.props.timeline,
+  clips: [{...retained.props.timeline.clips[0], ...patch}]}});
+refuse('foreign-owner', changed({elementRef: {kind: 'effect', id: 'am-presenter', packId: 'probe'}}));
+refuse('stale-params', changed({params: {...retained.props.timeline.clips[0].params, seed: 9}}));
+assert.equal(JSON.stringify(retained), original);
+console.log(JSON.stringify({zero, answers, controls}));
diff --git a/tests/packs/rendering/presenter_series_inspection.mjs b/tests/packs/rendering/presenter_series_inspection.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..91c8e0e7740d9f1a30fac058279063f4f5f9c8f9
--- /dev/null
+++ b/tests/packs/rendering/presenter_series_inspection.mjs
@@ -0,0 +1,41 @@
+// Pure queries of the actual generated host; no capture or source admission.
+import assert from 'node:assert/strict';
+import {basis, params, prepareRoot, propsFor, seriesInspection} from './presenter_crop_geometry.mjs';
+
+const props = propsFor();
+const original = JSON.stringify(props);
+const scene = prepareRoot(props, basis, {});
+let reads = 0;
+for (const capability of Object.values(scene.capabilities.components)) {
+  const frame = capability.frame;
+  capability.frame = contentFrame => { reads++; return frame(contentFrame); };
+}
+const zero = seriesInspection(scene, props);
+assert.equal(reads, 1);
+assert.equal(zero.frame, 0);
+assert.equal(zero.componentFrame, 0);
+assert.deepEqual(zero.mouth.rect, {x: 894, y: 606, width: 138, height: 48});
+assert.equal(JSON.stringify(props), original);
+
+// Selection failures never read another region or silently choose a presenter.
+assert.throws(() => seriesInspection(scene, props, 'missing'));
+assert.throws(() => seriesInspection(scene, {...props, timeline: {...props.timeline,
+  clips: [...props.timeline.clips, props.timeline.clips[0]]}}));
+assert.throws(() => seriesInspection(scene, propsFor(params,
+  {elementRef: {kind: 'effect', id: 'am-presenter', packId: 'probe'}})));
+assert.throws(() => seriesInspection(scene, propsFor({...params, seed: 9})));
+assert.equal(reads, 1);
+
+// The public clock, not authored zero or a guessed source offset, locates zero.
+const delayed = propsFor(params, {at: 5, from: 17, to: 18, speed: 2});
+assert.equal(seriesInspection(prepareRoot(delayed, basis, {}), delayed).frame, 150);
+const clipped = propsFor(params, {at: -1});
+assert.throws(() => seriesInspection(prepareRoot(clipped, basis, {}), clipped));
+
+// Unknown diagnostics and an empty scene cannot become a known replacement ROI.
+const unknown = propsFor({...params, mosaicIn: {frames: 8}});
+assert.throws(() => seriesInspection(prepareRoot(unknown, basis, {}), unknown));
+const empty = {...props, timeline: {...props.timeline, clips: []}};
+assert.throws(() => seriesInspection(prepareRoot(empty, basis, {}), empty));
+assert.throws(() => seriesInspection(undefined, props));
+console.log(JSON.stringify({ok: true, reads, zero}));
