+def _snapshot(parent: str | None, *, selection: str = "explicit_historical_render", **metadata):
+    canonical = {}
+    if parent is not None:
+        canonical["parent_revision_id"] = parent
+    return {
+        "metadata": {
+            "selection": selection,
+            "canonical_timeline": canonical,
+            **metadata,
+        }
+    }
