+case "${1:-full}" in
+  boot) printf '%s\n' 'D21 CANONICAL LAUNCHER BOOT PASS'; exit 0;;
+  preflight|cohort|full|post-g5-2225) ;;
+  *) printf '%s\n' 'invalid harness mode' >&2; exit 2;;
