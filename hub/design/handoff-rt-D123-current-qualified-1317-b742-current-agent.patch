+BINDING = "fa141364-9d4d-57ca-b7dc-9a23d259312e"
+TRANSCRIPT_MEDIA = "sha256:fef50eab9e9b23b75133cf7553faee605c3ff14d993599c8d2c551030f0bcb3d"
+MEDIA = (
