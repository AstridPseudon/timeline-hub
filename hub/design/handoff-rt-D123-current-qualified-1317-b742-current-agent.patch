+  exit 2
+fi
+export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$HARNESS"
+export D21_EVIDENCE_DIR="${D21_EVIDENCE_DIR:-$TMPDIR/d21-observer-evidence}"
