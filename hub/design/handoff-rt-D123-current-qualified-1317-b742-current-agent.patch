+        for clips in (after["parent"]["clips"], after["parent"]["config"]["clips"]):
+            clip = next(row for row in clips if row["id"] == "clip-a")
+            clip["app"]["org.example"]["p4_note"][note["id"]] = note["text"]
+        commands = emit_document_commands(before, after)
