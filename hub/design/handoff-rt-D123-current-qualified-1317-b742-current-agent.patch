+    plan = sheet.preview(property_cell(sheet.text, REF, 'trim', '2..10'))
+    assert plan.commands == [capture_clip_trim(original, REF, in_s=2, out_s=10)]
+    assert inverse(plan.bundle, plan.records).bundle == original
+
