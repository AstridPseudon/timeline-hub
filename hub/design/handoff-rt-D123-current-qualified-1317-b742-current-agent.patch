+@pytest.mark.parametrize(
+    ('initial', 'values', 'clear', 'expected'),
+    [(None, {'label': 'Picture'}, [], 'Picture'),
+     ('Existing', {'label': ''}, [], ''),
+     ('Existing', {}, ['label'], None)],
