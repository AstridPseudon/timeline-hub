+            source_id = binding.get('object_id')
+            if source_id in roles:
+                roles[source_id].add('audio/wav')
+        for item in payload.get('items', []):
+            source_id = item.get('media_id')
+            if source_id in roles:
+                roles[source_id].add(
+                    'audio/wav' if item.get('metadata', {}).get('role') == 'voiceover'
+                    else 'image/png')
