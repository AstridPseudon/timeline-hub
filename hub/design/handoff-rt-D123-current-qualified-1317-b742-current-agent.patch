+    bundle_digest = "sha256:" + hashlib.sha256(bundle.read_bytes()).hexdigest()
+    entrypoints = {
+        "manifest": "filmstrip-view/manifest.json",
+        "scene": "filmstrip-view/scene-answers.json",
+        "bundle": "filmstrip-bundle.zip",
+    }
