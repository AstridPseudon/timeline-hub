+def live(editing, binding=VOICE):
+    rows = editing.service.list_project_shot_text_bindings(editing.project, kind=binding['kind'],
+                                                         slot=binding['slot'])['items']
+    return next(row for row in rows if row['shot_id'] == 'shot-1')
