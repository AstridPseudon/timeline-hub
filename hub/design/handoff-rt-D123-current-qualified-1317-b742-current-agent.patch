+    parent['occurrences'] = [dict(copy.deepcopy(first), occurrence_id='occ-' + str(i)) for i in range(count)]
+    if shared_shot:
+        for row in parent['occurrences']:
+            row['shot_revision_id'] = 'shot-1'
+    document['parent_revision']['content_digest'] = _digest(parent)
+    return document
