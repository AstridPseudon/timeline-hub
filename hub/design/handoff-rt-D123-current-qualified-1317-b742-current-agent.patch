+    bundle = bundle_from_document(document('source'))
+    add = capture_occurrence_add_media(bundle, 'occurrence:one',
+        {'id': 'image', 'clipType': 'hold', 'asset': media['asset'], 'track': 'picture',
+         'at': 0, 'hold': 2, 'opaque': [None, False, {'literal': 'shared'}]},
