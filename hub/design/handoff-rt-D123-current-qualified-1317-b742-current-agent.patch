+    tl.clip('a').params['text'] = 'uncaptured'
+    with pytest.raises(TimelineEditError, match='unqueued local changes'):
+        tl.clip('a').on(1)
+    with pytest.raises(TimelineEditError, match='unqueued local changes'):
+        tl.flush()
+    assert pending(connected)['pending'] == []
+    assert connected[1].calls == []
