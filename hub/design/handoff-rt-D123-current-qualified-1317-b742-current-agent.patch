+OWNER = 'occurrence:occ-a'
+CHILD = OWNER + '/clip:placed'
+NEW = 'sha256:' + '2' * 64
+ON, HOLD = 9.0, 4
+FIXTURE = Path(__file__).parent / 'fixtures' / 'recipe_m2_placement_create_unplace.json'
