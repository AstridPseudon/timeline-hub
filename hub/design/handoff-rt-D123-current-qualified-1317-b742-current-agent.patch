+    html = sprite_ssr(p, [38, 46])
+    assert 'left:-5400px' in html[0] and 'left:1800px;top:120px;transform:scale(6)' in html[1]
+    assert 'left:25272px' in html[0] and 'left:25800px' in html[1]
