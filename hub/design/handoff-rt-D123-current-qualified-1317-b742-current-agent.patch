@@ -0,0 +1,203 @@
+"""Production reservation checks require the entire native ABI-1 binding set."""
+from __future__ import annotations
+
+import copy
+
+import pytest
+
+from astrid.sdk.timeline import commit
+from tests.editing_conformance.test_doc_patch_v2 import submit
+from tests.editing_conformance.test_provider_occurrence_fork import fork
+from tests.editing_conformance.test_recipe_occurrence_fork import fork_document
+from tests.sdk.test_timeline_commit_provider import (
+    CommitRejected,
+    DetachedRealm,
+    inverse,
+)
+from tests.sdk.test_timeline_commit_provider import runtime_abi as runtime_abi
+
+
+@pytest.mark.parametrize('legacy', [False, True])
+@pytest.mark.parametrize('damage', [
+    'reviewer-stripped-v2', 'partial', 'missing', 'duplicate', 'malformed',
+    'policy', 'dependencies', 'ref', 'phase', 'extra',
+])
+def test_production_refuses_incomplete_abi1_and_mixed_v2(monkeypatch, legacy, damage):
+    realm = DetachedRealm(fork_document())
+    call = fork(realm)
+    before = copy.deepcopy((realm.head, realm.entries, realm.documents, realm.prepared))
+    check = commit._check_reservations
+    observed = []
+
+    def corrupt(port, plan, current, rejected, base):
+        bindings = plan.records[0]['bindings']
+        collection = bindings[0]
+        assert collection['key'] == 'collection.owner:collection.clips'
+        if damage == 'reviewer-stripped-v2':
+            # Exact independent1350 attack: strip physical_ref everywhere,
+            # reduce only fork.source/fork.owner to the four-key ABI-1 shape.
+            for binding in bindings:
+                binding.pop('physical_ref', None)
+                if binding['key'] in ('fork.source', 'fork.owner'):
+                    native = {key: binding[key] for key in ('key', 'ref', 'policy', 'dependencies')}
+                    binding.clear()
+                    binding.update(native)
+            if legacy:
+                collection['boundary'] = {'phase': 'input'}
+        elif damage == 'partial':
+            collection['physical_ref'] = 'parent' if legacy else None
+        elif damage == 'missing':
+            bindings.remove(collection)
+        elif damage == 'duplicate':
+            bindings.append(copy.deepcopy(collection))
+        elif damage == 'malformed':
+            bindings.append(None)
+        elif damage == 'policy':
+            collection['policy'] = 'caller'
+        elif damage == 'dependencies':
+            collection['dependencies'] = ['unproven']
+        elif damage == 'ref':
+            collection['ref'] = 'occurrence:occ-1'
+        elif damage == 'phase':
+            collection.setdefault('boundary', {})['phase'] = 'effect'
+        else:
+            bindings.append({'key': 'unknown', 'ref': 'parent', 'policy': 'fixed', 'dependencies': []})
+        observed.append(damage)
+        return check(port, plan, current, rejected, base)
+
+    monkeypatch.setattr(commit, '_check_reservations', corrupt)
+    with pytest.raises(CommitRejected):
+        submit(realm, call, **({} if legacy else {'reads': []}))
+    assert observed == [damage]
+    assert (realm.head, realm.entries, realm.documents, realm.prepared) == before
+
+
+def test_authentic_complete_abi1_binding_set_survives_history_and_inverse(monkeypatch):
+    document = fork_document()
+    realm = DetachedRealm(document)
+    check = commit._check_reservations
+    observed = []
+
+    def observe(port, plan, current, rejected, base):
+        record = plan.records[0]
+        if record['command']['op'] == 'occurrence.fork':
+            assert record['bindings'] == [
+                {'key': key, 'ref': ref, 'policy': 'fixed', 'dependencies': []}
+                for key, ref in (
+                    ('collection.owner:collection.clips', 'occurrence:occ-0'),
+                    ('collection.owner:collection.tracks', 'occurrence:occ-0'),
+                    ('fork.source', 'occurrence:occ-0/source'),
+                    ('fork.owner', 'occurrence:occ-0'))]
+            observed.append(True)
+        return check(port, plan, current, rejected, base)
+
+    monkeypatch.setattr(commit, '_check_reservations', observe)
+    # Omit v2 controls on the real production caller; no rewritten legacy flag.
+    created = submit(realm, fork(realm))
+    assert created['data']['status'] == 'accepted'
+    undone = submit(realm, inverse([created['receipt']['receipt_id']]))
+    assert undone['data']['canonical_document'] == document
+    redone = submit(realm, inverse([undone['receipt']['receipt_id']]))
+    assert redone['data']['canonical_document'] == created['data']['canonical_document']
+    assert observed == [True]
+
+
+def _accepted_fork(*, v2=True):
+    realm = DetachedRealm(fork_document())
+    submit(realm, fork(realm), **({'reads': []} if v2 else {}))
+    return realm, realm.entries[-1]
+
+
+def _strip_bindings(entry, *, partial=False):
+    bindings = entry['records']['commands'][0]['bindings']
+    roles = {'collection.owner:collection.clips', 'collection.owner:collection.tracks',
+             'fork.source', 'fork.owner'}
+    bindings[:] = [{key: item[key] for key in ('key', 'ref', 'policy', 'dependencies')}
+                  if item['key'] in roles and (not partial or item['key'] == 'fork.source')
+                  else item for item in bindings if partial or item['key'] in roles]
+
+
+@pytest.mark.parametrize('recorder_abi,v2', [('absent', False), (1, False), (2, True)])
+def test_authenticated_history_abi_preserves_original_fork_proofs(recorder_abi, v2):
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm, entry = _accepted_fork(v2=v2)
+    if recorder_abi != 'absent':
+        entry['recorder_abi'] = recorder_abi
+    assert submit(realm, track_create(), reads=[])['data']['status'] == 'accepted'
+
+
+@pytest.mark.parametrize('partial', [False, True])
+@pytest.mark.parametrize('forged', [False, True])
+def test_authenticated_abi2_refuses_fullrewrite_and_partial_stripping(partial, forged):
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm, entry = _accepted_fork()
+    entry['recorder_abi'] = 2
+    _strip_bindings(entry, partial=partial)
+    # Neither a public request nor caller annotations can downgrade custody.
+    entry['source'] = {'via': 'python', 'recorder_abi': 1}
+    entry['rationale'] = 'recorder_abi=1'
+    before = copy.deepcopy((realm.head, realm.entries, realm.documents, realm.prepared))
+    controls = ({'source': {'via': 'python', 'detail': 'recorder_abi=1'},
+                 'rationale': 'recorder_abi=1'} if forged else {})
+    with pytest.raises(CommitRejected) as error:
+        submit(realm, track_create(), reads=[], **controls)
+    assert error.value.failure['details']['reason'] == 'history_unavailable'
+    assert (realm.head, realm.entries, realm.documents, realm.prepared) == before
+
+
+@pytest.mark.parametrize('metadata', [None, True, False, 0, 3, '1', '2', 1.0, 2.0,
+                                     [], {}, {'recorder_abi': 2}])
+def test_malformed_authenticated_recorder_abi_fails_closed(metadata):
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm, entry = _accepted_fork(v2=False)
+    entry['recorder_abi'] = metadata
+    before = copy.deepcopy((realm.head, realm.entries, realm.documents, realm.prepared))
+    with pytest.raises(CommitRejected) as error:
+        submit(realm, track_create(), reads=[])
+    assert error.value.failure['details']['reason'] == 'history_unavailable'
+    assert (realm.head, realm.entries, realm.documents, realm.prepared) == before
+
+
+def test_caller_annotations_and_recorder_schema_do_not_supply_history_abi():
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm, entry = _accepted_fork(v2=False)
+    assert entry['records']['schema_version'] == 1
+    entry['source'] = {'via': 'python', 'recorder_abi': 2}
+    entry['rationale'] = 'recorder_abi=2'
+    entry['receipt']['result']['recorder_abi'] = 2
+    assert submit(realm, track_create(), reads=[], source={'via': 'python',
+                  'detail': 'recorder_abi=2'}, rationale='recorder_abi=2')[
+        'data']['status'] == 'accepted'
+
+
+@pytest.mark.parametrize('metadata', [1, 2])
+def test_caller_forged_recorder_abi_control_is_invalid(metadata):
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm = DetachedRealm(fork_document())
+    before = copy.deepcopy((realm.head, realm.entries, realm.documents, realm.prepared))
+    with pytest.raises(CommitRejected) as error:
+        submit(realm, track_create(), reads=[], recorder_abi=metadata)
+    assert error.value.failure['details']['reason'] == 'invalid_edit_command'
+    assert (realm.head, realm.entries, realm.documents, realm.prepared) == before
+
+
+def test_history_page_supplies_abi_even_when_request_base_entry_is_legacy():
+    from tests.sdk.test_timeline_commit_provider import track_create
+
+    realm = DetachedRealm(fork_document())
+    base = copy.deepcopy(realm.head)
+    submit(realm, fork(realm), reads=[])
+    realm.entries[-1]['recorder_abi'] = 2
+    _strip_bindings(realm.entries[-1])
+    realm.page_size = 1
+    assert 'recorder_abi' not in realm.entries[0]
+    before = copy.deepcopy((realm.head, realm.entries, realm.documents, realm.prepared))
+    with pytest.raises(CommitRejected) as error:
+        submit(realm, track_create(), base=base, reads=[])
+    assert error.value.failure['details']['reason'] == 'history_unavailable'
+    assert (realm.head, realm.entries, realm.documents, realm.prepared) == before
diff --git a/tests/editing_conformance/test_fork_historical_source_boundary.py b/tests/editing_conformance/test_fork_historical_source_boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad8b42f123f2d37852cc50f3ce1dfef625ec21dc
--- /dev/null
+++ b/tests/editing_conformance/test_fork_historical_source_boundary.py
@@ -0,0 +1,183 @@
+"""Historical fork reads use their own authenticated input without relaxing State."""
+from __future__ import annotations
+
+import copy
+import json
+
+import pytest
+
+from astrid.sdk.timeline import inverse as inverse_module
+from astrid.sdk.timeline._command_state import CommandError, State
+from astrid.sdk.timeline.commit import _digest, _manifest
+from tests.editing_conformance.test_doc_patch_v2 import step, submit
+from tests.editing_conformance.test_provider_occurrence_fork import fork
+from tests.editing_conformance.test_recipe_occurrence_fork import fork_document
+from tests.sdk.test_timeline_commit_provider import CommitRejected, DetachedRealm, inverse
+from tests.sdk.test_timeline_commit_provider import runtime_abi as runtime_abi
+
+OWNER = 'occurrence:occ-0'
+
+
+def document():
+    value = fork_document()
+    shot, = value['shot_revisions']
+    shot['payload']['items'].append({**copy.deepcopy(shot['payload']['items'][0]), 'item_id': 'second'})
+    shot['content_digest'] = _digest(shot['payload'])
+    value['dependency_manifest'] = _manifest(value['shot_revisions'], value['internal_timeline_revisions'],
+                                            value['dependency_manifest']['media'], [])
+    return value
+
+
+@pytest.mark.parametrize('count', [1, 2])
+@pytest.mark.parametrize('dry_run', [False, True])
+def test_production_undo_authenticates_restored_source_without_changing_publication(
+        monkeypatch, request, count, dry_run):
+    baseline = fork_document(count=count)
+    realm = DetachedRealm(baseline)
+    call = fork(realm)
+    created = submit(realm, call, reads=[], steps=[step('fork', 0, call)])
+    accepted = created['data']['canonical_document']
+    captured = []
+    validate = inverse_module._validate_inputs
+
+    def observe(state, record, records):
+        if record['command']['op'] == 'occurrence.fork':
+            before, after = records.load_boundary(records.entries[0])
+            original = State(before)
+            shot = original.occurrence(OWNER)['shot_id']
+            assert state.occurrence(OWNER)['shot_id'] == shot
+            assert state.bundle['source_mapping']['shots'][shot] == before['source_mapping']['shots'][shot]
+            assert after['source_mapping']['_runtime_document'] == accepted
+            assert state.bundle['source_mapping']['_runtime_document'] == accepted
+            # Ordinary state still refuses this historical source/publication pair.
+            with pytest.raises(CommandError, match='shot item source changed'):
+                state.get(OWNER + '/shot', ['payload'])
+            snapshot = copy.deepcopy(state.bundle)
+            validate(state, record, records)
+            assert state.bundle == snapshot
+            captured.append({'publication_id': records.entries[0]['publication_id'],
+                'command_ordinal': record['ordinal'], 'source': before['source_mapping']['shots'][shot],
+                'input_revision': baseline['parent_revision']['revision_id'],
+                'accepted_revision': accepted['parent_revision']['revision_id']})
+            return
+        if record['command']['op'] == 'timeline.inverse':
+            shot = state.occurrence(OWNER)['shot_id']
+            assert shot == 'shot-fork' and shot not in state.bundle['source_mapping']['shots']
+            assert state.bundle['shots'][shot]['_created'] is True
+            snapshot = copy.deepcopy(state.bundle)
+            validate(state, record, records)
+            assert state.bundle == snapshot
+            return
+        validate(state, record, records)
+
+    monkeypatch.setattr(inverse_module, '_validate_inputs', observe)
+    head = copy.deepcopy((realm.head, realm.entries))
+    undone = submit(realm, inverse([created['receipt']['receipt_id']]), reads=[], dry_run=dry_run)
+    assert captured
+    request.node.user_properties.append(('authenticated_source_boundary', json.dumps(captured, sort_keys=True)))
+    assert undone['data']['canonical_document'] == baseline
+    if dry_run:
+        assert undone['receipt'] is None and undone['data']['would_status'] == 'accepted'
+        assert (realm.head, realm.entries) == head
+    else:
+        redone = submit(realm, inverse([undone['receipt']['receipt_id']]), reads=[])
+        assert redone['data']['canonical_document'] == accepted
+
+
+@pytest.mark.parametrize('damage', ['shot_id', 'revision_id', 'content_digest', 'internal_timeline_id',
+    'internal_timeline_revision_id', 'internal_timeline_content_digest', 'foreign-map', 'empty-map',
+    'extra-map', 'nonbijective', 'wrong-owner', 'missing-item', 'duplicate-item', 'order'])
+def test_production_historical_read_refuses_corruption_atomically(monkeypatch, damage):
+    realm = DetachedRealm(document())
+    created = submit(realm, fork(realm), reads=[])
+    head = copy.deepcopy((realm.head, realm.entries, realm.documents))
+    validate = inverse_module._validate_inputs
+    corrupted = []
+
+    def corrupt(state, record, records):
+        if record['command']['op'] == 'occurrence.fork':
+            shot = state.occurrence(OWNER)['shot_id']
+            source = state.bundle['source_mapping']['shots'][shot]
+            rows = state.bundle['shots'][shot]['payload']['items']
+            if damage == 'foreign-map':
+                sibling = state.occurrence('occurrence:occ-1')['shot_id']
+                source['item_id_map'] = copy.deepcopy(state.bundle['source_mapping']['shots'][sibling]['item_id_map'])
+            elif damage == 'empty-map':
+                source['item_id_map'] = {}
+            elif damage == 'extra-map':
+                source['item_id_map']['foreign'] = 'unbound'
+            elif damage == 'nonbijective':
+                source['item_id_map']['second'] = source['item_id_map']['item-1']
+            elif damage == 'wrong-owner':
+                state.occurrence(OWNER)['shot_id'] = state.occurrence('occurrence:occ-1')['shot_id']
+            elif damage == 'missing-item':
+                rows.pop()
+            elif damage == 'duplicate-item':
+                rows[1]['item_id'] = rows[0]['item_id']
+            elif damage == 'order':
+                rows.reverse()
+            else:
+                source[damage] = 'unverified'
+            corrupted.append(damage)
+        validate(state, record, records)
+
+    monkeypatch.setattr(inverse_module, '_validate_inputs', corrupt)
+    with pytest.raises(CommitRejected):
+        submit(realm, inverse([created['receipt']['receipt_id']]), reads=[])
+    assert corrupted == [damage]
+    assert (realm.head, realm.entries, realm.documents) == head
+
+
+def test_historical_read_requires_accepted_boundary(monkeypatch):
+    realm = DetachedRealm(fork_document())
+    created = submit(realm, fork(realm), reads=[])
+    validate = inverse_module._validate_inputs
+    checked = []
+
+    def without_boundary(state, record, records):
+        if record['command']['op'] == 'occurrence.fork':
+            with pytest.raises(CommandError, match='shot item source changed'):
+                validate(state, record, list(records))
+            with pytest.raises(CommandError, match='shot item source changed'):
+                validate(state, copy.deepcopy(record), records)
+            checked.append(True)
+        validate(state, record, records)
+
+    monkeypatch.setattr(inverse_module, '_validate_inputs', without_boundary)
+    undone = submit(realm, inverse([created['receipt']['receipt_id']]), reads=[])
+    assert checked and undone['data']['canonical_document'] == fork_document()
+
+
+@pytest.mark.parametrize('damage', ['not-created', 'content', 'missing-item', 'item-order', 'foreign-item'])
+def test_production_redo_codec_requires_exact_recorded_root(monkeypatch, damage):
+    realm = DetachedRealm(document())
+    created = submit(realm, fork(realm), reads=[])
+    undone = submit(realm, inverse([created['receipt']['receipt_id']]), reads=[])
+    head = copy.deepcopy((realm.head, realm.entries, realm.documents))
+    validate = inverse_module._validate_inputs
+    corrupted = []
+
+    def corrupt(state, record, records):
+        assert record['command']['op'] == 'timeline.inverse'
+        shot = state.occurrence(OWNER)['shot_id']
+        assert shot == 'shot-fork' and shot not in state.bundle['source_mapping']['shots']
+        root = state.bundle['shots'][shot]
+        rows = root['payload']['items']
+        if damage == 'not-created':
+            root['_created'] = False
+        elif damage == 'content':
+            root['payload']['name'] = 'unrecorded'
+        elif damage == 'missing-item':
+            rows.pop()
+        elif damage == 'item-order':
+            rows.reverse()
+        else:
+            rows[0]['item_id'] = 'unrecorded'
+        corrupted.append(damage)
+        validate(state, record, records)
+
+    monkeypatch.setattr(inverse_module, '_validate_inputs', corrupt)
+    with pytest.raises(CommitRejected):
+        submit(realm, inverse([undone['receipt']['receipt_id']]), reads=[])
+    assert corrupted == [damage]
+    assert (realm.head, realm.entries, realm.documents) == head
