+                       'command_ordinals': list(range(len(commands))),
+                       'patch': changes, 'reads': []}],
+            'merge': 'atomic', 'reads': [], 'dry_run': False,
+            'source': {'via': 'python'},
+            'rationale': 'Prepare the owned parent variant.',
+            'group_id': 'D86-owned-move8',
+        }
+        return service.commit_timeline(
