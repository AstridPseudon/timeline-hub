+    projected = host_module._launch_worker_probe_environments((tmp_path,), environment)
+    observed = []
+
+    class ReachedLaunch(Exception):
+        pass
+
+    def launch(_argv, **kwargs):
+        observed.append(dict(kwargs['env']))
