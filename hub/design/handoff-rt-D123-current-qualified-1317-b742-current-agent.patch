+@pytest.mark.parametrize("field,value", [("timeline_id", "foreign"), ("parent_revision_id", "newer"),
+                                         ("parent_content_digest", "sha256:" + "0" * 64)])
+def test_forged_authority_cannot_replace_admitted_ref(tmp_path, field, value):
