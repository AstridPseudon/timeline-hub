+@pytest.mark.parametrize('relevant_peer', [False, True], ids=['disjoint-rebase-undo', 'relevant-conflict'])
+def test_cli_trim_exact_retry_restart_dependent_suffix_and_peer(film, tmp_path, capsys, relevant_peer):
