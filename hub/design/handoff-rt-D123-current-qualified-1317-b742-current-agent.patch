+    before = copy.deepcopy(value)
+    validate_final_candidate(value)
+    assert value == before
+    assert clip["from"] is None
+    clip["to"] = 3
+    with pytest.raises(AuthoringBundleError, match="source interval exceeds"):
+        validate_final_candidate(value)
