+    before = copy.deepcopy(payload(original))
+    command = capture_shot_set(original, REF, values={
+        'name': '', 'settings': {'selectedModel': 'b', 'motionMode': 'advanced', 'advancedMode': True}},
+        clear=['settings.customWidth'])
