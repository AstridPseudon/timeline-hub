+            segments = [(ordinal, first, second) for ordinal in step['command_ordinals']
+                        for first, second in self.inverse_stages.get(ordinal, [])]
+            if segments:
+                effects = []
+                previous = before
+                for ordinal, first, second in segments:
+                    effects.extend(effect_diff(previous, first))
