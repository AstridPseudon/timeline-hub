+@pytest.mark.parametrize("damage", ["missing-entry", "wrong-revision", "wrong-receipt"])
+def test_current_fetch_requires_exact_publication_history_entry(reader, monkeypatch, damage):
+    _, client = reader
+    original = client.timelines.history
+
