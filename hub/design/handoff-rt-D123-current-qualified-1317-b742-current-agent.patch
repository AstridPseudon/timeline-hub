+
+def undo(publication, *steps):
+    call = inverse([publication])
+    if steps:
+        call['args']['steps'] = {publication: list(steps)}
+    return call
+
+
+def parent(result):
+    return result['data']['canonical_document']['parent_revision']['payload']
