+@pytest.mark.parametrize('owner,ownership', [('parent', 'occurrence'), ('occurrence:occ-a', 'parent'),
+    ('shot:chapter-shot', 'shared'), ('occurrence:occ-a', 'shared'), ('parent', 'shared'),
