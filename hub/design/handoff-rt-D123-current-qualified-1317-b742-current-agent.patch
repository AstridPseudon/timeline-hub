+def detached(value):
+    return json.loads(json.dumps(value, allow_nan=False))
+
+
+def refusal(reason):
+    return CommitRejected({"http_status": 409, "code": "conflict", "message": reason,
+                           "details": {"status": "refused", "reason": reason,
+                                       "base": None, "current": None, "conflicts": []}})
+
