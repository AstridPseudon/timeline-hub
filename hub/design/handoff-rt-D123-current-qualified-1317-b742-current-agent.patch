+    if (node == null || typeof node !== 'object') return;
+    if (Array.isArray(node)) {
+      node.forEach(walkTree);
+      return;
+    }
+    if (node.type === Composition) return node.type(node.props);
+    if (typeof node.type === 'function') {
+      walkTree(node.type(node.props));
