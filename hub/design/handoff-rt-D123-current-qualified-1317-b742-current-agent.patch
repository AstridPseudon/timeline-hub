+++ b/astrid/sdk/timeline/_scalar_commands.py
@@ -0,0 +1,164 @@
+"""Scoped literal scalar edits, using the native recorder for every write."""
+from __future__ import annotations
+
+import copy
+import re
+
+from jsonschema import Draft202012Validator
+from referencing import Registry
+from referencing.exceptions import Unresolvable
+
+from ._command_state import CommandError, equal, present
+
+
+def _target(ctx, command, kind):
+    ref = command['select']
+    if not isinstance(ref, str) or not re.fullmatch(
+            rf'(?:parent|occurrence:[^/]+)/{kind}:[^/]+', ref) or '::' in ref:
+        raise CommandError(f"{command['op']} requires a parent or occurrence {kind} identity")
+    owner = ref.rsplit('/', 1)[0]
+    if ctx.read(ref, ['id']) is None:
+        raise CommandError('scalar target disappeared', kind='identity_conflict', ref=ref)
+    pin = {'parent': copy.deepcopy(ctx.state.bundle.get('base_parent', {}))}
+    if owner != 'parent':
+        ctx.read(owner, ['occurrence_id'])
+        ctx.read(owner + '/shot', ['shot_id'])
+        shot = ctx.state.occurrence(owner)['shot_id']
+        pin['source'] = copy.deepcopy(ctx.state.bundle['source_mapping']['shots'][shot])
+        ctx.bind('scalar.owner', owner)
+    ctx.dependency('scalar.images', 'entity', pin)
+    ctx.bind('scalar.target', ref, dependencies=['scalar.images'])
+    return ref
+
+
+def _changes(command):
+    values, clear = command['args']['values'], command['args']['clear']
+    if any(not isinstance(key, str) for key in values):
+        raise CommandError('parameter keys must be JSON strings')
+    if set(values).intersection(clear):
+        raise CommandError('a scalar key cannot be both set and cleared')
+    return values, clear
+
+
+def track_set(ctx, command):
+    ref = _target(ctx, command, 'track')
+    values, clear = _changes(command)
+    for key in sorted(values):
+        ctx.write(ref, [key], values[key])
+    for key in sorted(clear):
+        ctx.clear(ref, [key])
+
+
+def _clip_basis(ctx, ref):
+    identity = {key: ctx.read(ref, [key]) for key in (
+        'clipType', 'clip_type', 'asset', 'asset_id', 'media_id', 'object_id',
+        'elementRef', 'element_ref')}
+    # A type/asset label can stay fixed while its exact element or media changes.
+    # Match main's selector precedence; retain literal tagged reads, not a digest
+    # of the entire registry (unrelated assets can still change independently).
+    selector = next((key for key in ('asset', 'asset_id', 'media_id', 'object_id')
+                     if key in ctx.state.entity(ref)), None)
+    if selector in ('asset', 'asset_id') and isinstance(identity[selector], str):
+        registry_ref = ref.rsplit('/', 1)[0] + '/registry'
+        for key in ('media_id', 'object_id', 'digest', 'content_digest'):
+            ctx.read(registry_ref, ['assets', identity[selector], key])
+    return identity
+
+
+def clip_set_params(ctx, command):
+    from astrid.sdk.timeline_address import element_schema
+
+    ref = _target(ctx, command, 'clip')
+    values, clear = _changes(command)
+    identity = _clip_basis(ctx, ref)
+    element = identity['clipType'] or identity['clip_type'] or 'media'
+    if not isinstance(element, str):
+        raise CommandError('clip type must be a string', ref=ref)
+    # These are stored JSON values, not human expressions or canvas-unit input.
+    # Reuse the element's declared value schemas without parsing or coercion.
+    changed = {key: value for key, value in values.items()
+               if not equal(ctx.state.get(ref, ['params', key]), present(value))}
+    selected = identity['elementRef'] or identity['element_ref']
+    if isinstance(selected, dict) and selected.get('packId'):
+        schema = (_selected_schema(ctx, command, ref, selected)
+                  if changed or 'schema_source' in command['args'] else {})
+    else:
+        if 'schema_source' in command['args']:
+            raise CommandError('schema_source requires a selected project pack element', ref=ref)
+        schema = element_schema(element)
+    _validate_param_values(ref, changed, schema)
+    if values:
+        ctx.object(ref, ['params'])
+    for key in sorted(values):
+        ctx.write(ref, ['params', key], values[key])
+    for key in sorted(clear):
+        ctx.clear(ref, ['params', key])
+
+
+def _selected_schema(ctx, command, ref, selected):
+    from astrid.core.element.project_packs import admitted_element_snapshot_descriptor
+
+    pin = command['args'].get('schema_source')
+    if pin is None:
+        raise CommandError('selected project pack requires exact schema_source', ref=ref)
+    if not isinstance(ctx.realm_id, str):
+        raise CommandError('selected pack capture requires the scoped realm identity', ref=ref)
+    matches = [(verified, snapshot) for verified, snapshot in ctx.schema_inputs
+               if verified.get('pin') == pin]
+    if len(matches) != 1:
+        raise CommandError('selected pack snapshot input unavailable', ref=ref)
+    verified, snapshots = matches[0]
+    admissions = verified.get('document', {}).get('content', {}).get('admissions', [])
+    admission = next((item for item in admissions if all(
+        item.get(key) == selected.get(key) for key in ('id', 'kind', 'revision'))), {})
+    snapshot = snapshots.get(admission.get('snapshot_object', {}).get('object_id'))
+    try:
+        descriptor = admitted_element_snapshot_descriptor(
+            ctx.realm_id, ctx.state.bundle['project_id'], selected, verified, snapshot)
+    except ValueError as exc:
+        raise CommandError(str(exc), ref=ref) from exc
+    ctx.dependency('params.schema', 'source', pin)
+    ctx.dependency('params.snapshot', 'entity', {
+        'source': pin, 'element': selected,
+        'object': admission['snapshot_object']})
+    ctx.bind('params.element', ref, dependencies=['params.schema', 'params.snapshot'])
+    captures = ctx.state.bundle['source_mapping'].setdefault('pinned_documents', [])
+    if not any(capture['pin'] == pin for capture in captures):
+        captures.append(copy.deepcopy(verified))
+    return descriptor['schema']
+
+
+def _validate_param_values(ref, values, schema):
+    """Check only changed known properties, preserving literal opaque values."""
+    properties = schema.get('properties', {})
+    validator = Draft202012Validator(schema, registry=Registry())
+    for key, value in values.items():
+        if key in properties:
+            try:
+                errors = list(validator.evolve(schema=properties[key]).iter_errors(value))
+            except Unresolvable as exc:
+                raise CommandError('parameter schema reference is unavailable', ref=ref,
+                                   path=['params', key]) from exc
+            if errors:
+                raise CommandError(errors[0].message, ref=ref, path=['params', key])
+
+
+def capture_track_set(bundle, select, *, values=None, clear=()):
+    return _capture(bundle, 'track.set', select, values, clear)
+
+
+def capture_clip_set_params(bundle, select, *, values=None, clear=(), schema_source=None,
+                            schema_inputs=(), realm_id=None):
+    return _capture(bundle, 'clip.set-params', select, values, clear,
+                    schema_source=schema_source, schema_inputs=schema_inputs, realm_id=realm_id)
+
+
+def _capture(bundle, op, select, values, clear, *, schema_source=None, schema_inputs=(), realm_id=None):
+    from .commands import execute
+
+    args = {'values': copy.deepcopy({} if values is None else values), 'clear': list(clear)}
+    if schema_source is not None:
+        args['schema_source'] = copy.deepcopy(schema_source)
+    return execute(bundle, [{'schema_version': 1, 'op': op, 'version': '1',
+                             'select': select, 'args': args}], schema_inputs=schema_inputs,
+                   realm_id=realm_id).commands[0]
diff --git a/astrid/sdk/timeline/_selected_param_authority.py b/astrid/sdk/timeline/_selected_param_authority.py
new file mode 100644
index 0000000000000000000000000000000000000000..a431df6898bf6048dbab19eda6252d4e9b3820b5
--- /dev/null
+++ b/astrid/sdk/timeline/_selected_param_authority.py
@@ -0,0 +1,220 @@
+"""Selected PARAM provenance from the existing accepted publication chain."""
+from __future__ import annotations
+
+import copy
+from functools import lru_cache
+
+from ._command_state import CommandError, State, equal
+
+
+def _bound(record, expected):
+    bindings = [b for b in record['bindings'] if b['key'] == expected['key']]
+    if len(bindings) != 1:
+        return False
+    return equal(bindings[0], expected)
+
+
+def _association(record, select, source=None, boundary=None):
+    from .commit import _document_pin
+
+    def bound(expected):
+        if source is not None:
+            from ._commit_patch import canonical_site
+
+            physical, path = canonical_site(source, expected['ref'], [])
+            expected = {**expected, **source.binding(expected['ref'], physical, **boundary),
+                        'path': path}
+        return _bound(record, expected)
+
+    command = record['command']
+    if command['select'] != select:
+        return None
+    schemas = [d for d in record['dependencies'] if d['key'] == 'params.schema']
+    snapshots = [d for d in record['dependencies'] if d['key'] == 'params.snapshot']
+    if len(schemas) != 1 or len(snapshots) != 1 or not bound({
+            'key': 'params.element', 'ref': select, 'policy': 'fixed',
+            'dependencies': ['params.schema', 'params.snapshot']}):
+        return None
+    owner = select.rsplit('/', 1)[0]
+    required = [{'key': 'scalar.target', 'ref': select, 'policy': 'fixed',
+                 'dependencies': ['scalar.images']}]
+    if owner != 'parent':
+        required.append({'key': 'scalar.owner', 'ref': owner, 'policy': 'fixed', 'dependencies': []})
+    if any(not bound(expected) for expected in required):
+        return None
+    schema, snapshot = schemas[0], snapshots[0]
+    pin = snapshot['pin']
+    if (schema['kind'] != 'source' or schema['policy'] != 'exact'
+            or snapshot['kind'] != 'entity' or snapshot['policy'] != 'exact'
+            or set(pin) != {'source', 'element', 'object'}
+            or schema['pin'] != pin['source']
+            or command['args'].get('schema_source') != pin['source']
+            or set(pin['element']) != {'packId', 'id', 'kind', 'revision'}):
+        return None
+    _document_pin(pin['source'])
+    if command['op'] == 'clip.set-params':
+        reads = {r['path'][0]: r['state'].get('value') for r in record['reads']
+                 if r['ref'] == select and r['path'] in (['elementRef'], ['element_ref'])}
+        if (reads.get('elementRef') or reads.get('element_ref')) != pin['element']:
+            return None
+    return pin
+
+
+def resolve_selected_param_source(port, *, context, through, select, staged=()):
+    """Return the proven P/E/O association, or permanently refuse this edit.
+
+    Publication identity orders effects even when complete revision bytes are
+    equal. No mutable admission binding or manifest order selects an old pin.
+    Unsupported structural producers deliberately leave authority unavailable.
+    """
+    from .commit import _history, _load, _records
+
+    def rejected(failure):
+        return CommandError(failure['message'], kind='history_unavailable', ref=select)
+
+    entries = _history(port, through, None, rejected, through)
+    indices = {e['publication_id']: i for i, e in enumerate(entries)}
+    owner = select.rsplit('/', 1)[0]
+
+    @lru_cache(None)
+    def state(index):
+        return State(_load(port, context, entries[index]['revision_id']))
+
+    def relevant(record, index):
+        for write in record['writes']:
+            ref, path = write['ref'], write['path']
+            if ref == select and (not path or path[0] in (
+                    'params', 'elementRef', 'element_ref', 'id', 'clipType', 'clip_type',
+                    'asset', 'asset_id', 'media_id', 'object_id', 'file', 'src', 'source')):
+                return True
+            if ref == 'timeline' or ref == owner and (not path or path[0] in (
+                    'clips', 'occurrence_id', 'shot_id', 'shot_revision_id', 'internal_timeline_revision_id')):
+                return True
+            if owner == 'parent' and ref == 'parent' and path[:2] == ['config', 'clips']:
+                return True
+            if owner != 'parent' and ref in (owner + '/source', owner + '/shot'):
+                return True
+            if owner != 'parent' and ref.startswith('shot:'):
+                current = state(min(index, len(entries) - 1))
+                shot = (current.entity(owner + '/shot')
+                        if current.entity(owner, optional=True) is not None else None)
+                if shot and ref == 'shot:' + shot['shot_id']:
+                    return True
+        return record['command']['select'] == select and record['command']['op'] in (
+            'clip.set-element', 'clip.set-params')
+
+    def physical_context(records, record, index, envelope):
+        from ._commit_patch import normalize_steps
+        from ._doc_patch import Closure
+
+        staged = index == len(entries)
+        request = context['request'] if staged else entries[index]['receipt']['result']
+        v2 = (any(key in request for key in ('label', 'steps', 'merge', 'reads'))
+              or any(call['op'] == 'doc.patch' for call in request['commands'])
+              if staged else any('physical_ref' in binding and binding['key'] in (
+                  'params.element', 'scalar.target', 'scalar.owner', 'commit.effect')
+                  for item in records for binding in item['bindings']))
+        if not v2:
+            return None, None
+        head = through if staged else entries[index]['previous']
+        steps = (normalize_steps(request, request['commands'])[1] if staged else envelope['steps'])
+        step, = [step for step in steps if record['ordinal'] in step['command_ordinals']]
+        boundary = {key: request[key] for key in ('base_revision_id', 'base_publication_id')}
+        boundary.update(evaluated_head=copy.deepcopy(head), step_id=step['id'],
+                        command_ordinal=record['ordinal'], phase='input')
+        current = State(copy.deepcopy(_load(port, context, head['revision_id'])))
+        mapping = current.bundle['source_mapping']
+        mapping['_copy_manifest'] = copy.deepcopy(mapping['_runtime_document']['dependency_manifest'])
+        # Project recorder effects over the sealed input, without executing
+        # handlers or trusting an image/owner claimed by a binding. Each command
+        # may legitimately have a different physical revision from the head.
+        for ordinal, prior in enumerate(records[:record['ordinal']]):
+            if prior['ordinal'] != ordinal:
+                raise ValueError('unordered staged records')
+            for write in [*prior['writes'], *prior['derived_writes']]:
+                if not current.matches(write['ref'], write['path'], write['before']):
+                    raise ValueError('staged input differs from recorded before value')
+                current.set(write['ref'], write['path'], write['after'])
+            for dependency in prior['dependencies']:
+                if dependency['kind'] in ('source', 'transcript'):
+                    documents = mapping['_copy_manifest']['documents']
+                    if dependency['pin'] not in documents:
+                        documents.append(copy.deepcopy(dependency['pin']))
+        return Closure(current.bundle), boundary
+
+    def effect(value, record, index, envelope=None, records=()):
+        if not relevant(record, index):
+            return value
+        command = record['command']
+        if command['op'] in ('clip.set-element', 'clip.set-params'):
+            source, boundary = physical_context(records, record, index, envelope)
+            association = _association(record, select, source, boundary)
+            if association is None:
+                return None
+            element = association['element']
+            if command['op'] == 'clip.set-element':
+                return association if command['args']['elementRef'] == element else None
+            # Accepted PARAM records are retained selection proof, including
+            # records predating enforcement. New PARAM is checked by the caller
+            # before it can produce such a record.
+            return association
+        if command['op'] == 'timeline.inverse':
+            publications = command['args']['publications']
+            if envelope is not None and envelope['undo_of'] != publications:
+                return None
+            for publication in reversed(publications):
+                target = indices.get(publication)
+                if target is None or target >= index:
+                    return None
+                entry = entries[target]
+                if port.history_entry(publication) != entry or entry['previous'] is None:
+                    return None
+                records = _records([entry], rejected, through, through)
+                if any(relevant(r, target) for r in records):
+                    value = at(target - 1)
+            return value
+        if command['op'] == 'timeline.restore':
+            pin = command['args']
+            if envelope is None or envelope['restored_from'] != pin:
+                return None
+            candidates = [i for i in range(index) if entries[i]['revision_id'] == pin['revision_id']]
+            values = [at(i) for i in candidates if state(i).bundle['source_mapping'][
+                '_runtime_document']['parent_revision']['content_digest'] == pin['content_digest']]
+            return values[0] if values and all(v == values[0] for v in values) else None
+        return None
+
+    @lru_cache(None)
+    def at(end):
+        value = None
+        for index in range(end + 1):
+            entry = entries[index]
+            if entry.get('intent') != 'recorded':
+                value = None
+                continue
+            records = _records([entry], rejected, through, through)
+            if index and owner != 'parent':
+                before, after = state(index - 1), state(index)
+                # State.matches admits only the compiler's exact occurrence
+                # materialization, never an ID prefix or equal sibling JSON.
+                if (before.entity(owner, optional=True) is None
+                        or after.entity(owner, optional=True) is None
+                        or not after.matches(owner + '/shot', ['shot_id'],
+                                             before.get(owner + '/shot', ['shot_id']))):
+                    value = None
+            for record in records:
+                value = effect(value, record, index, entry['records'], records)
+            row = state(index).entity(select, optional=True)
+            element = (row.get('elementRef') or row.get('element_ref')) if row else None
+            if value is not None and element != value['element']:
+                value = None
+        return value
+
+    try:
+        value = at(len(entries) - 1)
+        for record in staged:
+            value = effect(value, record, len(entries), records=staged)
+    except (KeyError, TypeError, ValueError, IndexError) as exc:
+        raise CommandError('selected PARAM history is malformed', kind='history_unavailable', ref=select) from exc
+    if value is None:
+        raise CommandError('selected PARAM authority is unavailable', kind='history_unavailable', ref=select)
+    return value
diff --git a/astrid/sdk/timeline/_shot_commands.py b/astrid/sdk/timeline/_shot_commands.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7d71ee6963dd532e3516ffe58e364e8db9fc4e9
--- /dev/null
+++ b/astrid/sdk/timeline/_shot_commands.py
@@ -0,0 +1,50 @@
+"""Occurrence-owned shot name and bounded settings edits on the raw shot payload."""
+from __future__ import annotations
+
+import copy
+import re
+
+from ._command_state import CommandError
+
+SHOT_INTENT = {'ownership': 'occurrence'}
+
+
+def shot_set(ctx, command):
+    ref = command['select']
+    if not isinstance(ref, str) or not re.fullmatch(r'occurrence:(?!.*::)[^/]+/shot', ref):
+        raise CommandError('shot.set requires an explicit occurrence shot identity')
+    owner = ref.removesuffix('/shot')
+    if ctx.read(owner, ['occurrence_id']) is None:
+        raise CommandError('shot owner disappeared', kind='identity_conflict', ref=owner)
+    ctx.read(ref, ['shot_id'])
+    shot = ctx.state.occurrence(owner)['shot_id']
+    source = ctx.state.bundle['source_mapping']['shots'].get(shot)
+    if source is not None:
+        ctx.dependency('shot.source', 'entity', {'source': copy.deepcopy(source)})
+    ctx.bind('shot.owner', owner)
+    values, clear = command['args']['values'], command['args']['clear']
+    settings = values.get('settings', {})
+    paths = {('name',): 'name' in values, **{('settings', key): True for key in settings}}
+    for entry in clear:
+        path = tuple(entry.split('.'))
+        if paths.get(path):
+            raise CommandError('a shot field cannot be both set and cleared', ref=ref, path=path)
+    # Intent stays scoped to this occurrence's own shot root, whether or not its
+    # source shot is shared; sharing is resolved by the authoring bundle.
+    if 'name' in values:
+        ctx.write(ref, ['payload', 'name'], values['name'])
+    if settings:
+        ctx.object(ref, ['payload', 'settings'])
+    for key in sorted(settings):
+        ctx.write(ref, ['payload', 'settings', key], settings[key])
+    for entry in sorted(clear):
+        ctx.clear(ref, ['payload', *entry.split('.')])
+
+
+def capture_shot_set(bundle, select, *, values=None, clear=()):
+    """Set or clear the selected occurrence's own shot name/settings fields."""
+    from .commands import execute
+
+    args = {'values': copy.deepcopy({} if values is None else values), 'clear': list(clear)}
+    return execute(bundle, [{'schema_version': 1, 'op': 'shot.set', 'version': '1',
+                             'select': select, 'args': args, 'intent': dict(SHOT_INTENT)}]).commands[0]
