index 0000000000000000000000000000000000000000..9306507c032e546640df3d7bd2c2dd6df361363a
--- /dev/null
+++ b/astrid/sdk/timeline/native_placement_commands.py
@@ -0,0 +1,151 @@
+"""Explicit-owner placement using the existing absolute clip.move recipe.
+
+This changes an existing clip's start, preserving its media and source window.
+It does not implement the App's legacy generation placement/pooling algorithm.
+
+placement.create adds an image; placement.unplace removes an occurrence-owned
+image or video expression. They reuse media birth and bounded clip removal; there is
+no pooling, auto-position, collision shifting or registry removal.
+"""
+from __future__ import annotations
+
+import copy
+import re
+from fractions import Fraction
+
+from astrid.core.timeline.duration import clip_start_frame
+
+from ._command_state import CommandError
+from ._delete_commands import _unreferenced
+from ._media_inputs import _verified
+from .capture import _duration, move, move_intent, number, occurrence_start, rate
+from .native_occurrence_media_commands import _exclusive, _owner, add_media
+
+PLACEMENT_INTENT = {'ownership': 'occurrence'}
+
+
+def placement_move(ctx, command):
+    ref = command['select']
+    owner = ref.rsplit('/', 1)[0]
+    if owner != 'parent':
+        if ctx.select('placement.owners', owner) != [owner]:
+            raise CommandError('shared authored placement is unsupported',
+                               kind='unsupported_ownership', ref=owner)
+    clip = ctx.state.entity(ref)
+    asset = clip.get('asset', clip.get('asset_id'))
+    if asset is not None:
+        # Guard the entire existing binding, including opaque selection pins.
+        # Read raw paths so accepted source writes also protect against ABA.
+        if owner == 'parent':
+            ctx.read('parent', ['registry', 'assets', str(asset)])
+            ctx.read('parent', ['config', 'registry', 'assets', str(asset)])
+        else:
+            ctx.read(owner + '/source', ['registry', 'assets', str(asset)])
+    move(ctx, command)
+    if owner != 'parent':
+        extent = number(ctx.read(owner, ['duration_ms']), 'occurrence.duration_ms', positive=True) / 1000
+        moved = ctx.state.entity(ref)
+        start = moved['at'] if 'at' in moved else moved['at_ms'] / 1000
+        if start + _duration(moved) > extent + 1e-9:
+            raise CommandError('placed interval exceeds occurrence duration',
+                               kind='occurrence_boundary', ref=owner)
+
+
+def capture_placement(bundle, owner, clip_id, on, *, ownership):
+    """Capture global seconds on the original bundle, before local preview.
+
+    owner is parent or occurrence:<raw ID>; clip_id is the raw child ID.
+    ownership must explicitly match that scope. Shared authoring, pooling,
+    automatic positioning, track changes and media selection are unsupported.
+    The result is placement.move v1, with its authoritative capture.
+    """
+    if ownership == 'shared':
+        raise CommandError('shared placement is unsupported', kind='unsupported_ownership')
+    expected = ('parent' if owner == 'parent' else 'occurrence'
+                if isinstance(owner, str) and re.fullmatch(r'occurrence:[^/]+', owner)
+                and '::' not in owner else None)
+    if expected is None or ownership != expected:
+        raise CommandError('placement requires matching explicit parent or occurrence ownership',
+                           kind='unsupported_ownership')
+    if (not isinstance(clip_id, str) or not clip_id.strip()
+            or '/' in clip_id or '::' in clip_id):
+        raise CommandError('placement requires a raw clip identity', kind='identity_conflict')
+    from .commands import execute
+
+    ref = owner + '/clip:' + clip_id
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.move', 'version': '1',
+                             'select': ref, 'args': {'on': on},
+                             'intent': move_intent(ref)}]).commands[0]
+
+
+def placement_create(ctx, command):
+    """Image-only expression at an absolute time; the wrapper adds no media semantics."""
+    owner, _ = _owner(ctx, command['select'])
+    _exclusive(ctx, owner)
+    args = command['args']
+    _, kind = _verified(ctx, args['media'])
+    if kind != 'image':
+        raise CommandError('placement.create v1 requires verified image media', kind='unsupported_media')
+    row = ctx.state.occurrence(owner)
+    lane = (row.get('placement') or {}).get('track', row.get('track'))
+    if not isinstance(lane, str):
+        raise CommandError('placement requires a referenced lane', kind='unsupported_timing', ref=owner)
+    fps = rate(ctx.read('parent', ['config', 'output', 'fps']))
+    frame = clip_start_frame({'at': number(args['on'], 'on'), 'hold': 1}, float(fps))
+    at = float(Fraction(frame, 1) / fps) - occurrence_start(row)
+    clip = {'id': args['id'], 'clipType': 'image', 'asset': args['media']['asset'], 'track': lane,
+            'at': at, 'hold': args['hold']}
+    add_media(ctx, {'select': owner, 'args': {'row': clip, 'media': args['media'],
+                                                  'consumed': args.get('consumed', [])}})
+
+
+def placement_unplace(ctx, command):
+    """Remove one raw media expression; its exact row and registry binding survive undo."""
+    ref = command['select']
+    owner = ref.rsplit('/', 1)[0]
+    _explicit_occurrence(owner, command.get('intent', {}).get('ownership'))
+    _exclusive(ctx, owner)
+    if ref not in ctx.select('collection.clips', owner):
+        raise CommandError('placement target disappeared', kind='identity_conflict', ref=ref)
+    row = ctx.read(ref)
+    if row.get('clipType') not in ('media', 'image', 'video') or not isinstance(row.get('asset'), str):
+        raise CommandError('unplace requires one placed media clip', kind='unsupported_media', ref=ref)
+    if any(row.get(key) is not None for key in ('clips', 'children', 'time_map', 'timeMap')):
+        raise CommandError('unplace does not support nested or mapped clips', kind='unsupported_map', ref=ref)
+    # Guard the whole binding the removed expression pointed at, including ABA.
+    ctx.read(owner + '/source', ['registry', 'assets', str(row['asset'])])
+    _unreferenced(ctx)
+    ctx.clear(ref, [])
+
+
+def _explicit_occurrence(owner, ownership):
+    if ownership != 'occurrence' or not isinstance(owner, str) or re.fullmatch(r'occurrence:(?!.*::)[^/]+', owner) is None:
+        raise CommandError('placement requires explicit occurrence ownership', kind='unsupported_ownership')
+
+
+def _raw_clip_id(clip_id):
+    if not isinstance(clip_id, str) or not clip_id.strip() or '/' in clip_id or '::' in clip_id:
+        raise CommandError('placement requires a raw clip identity', kind='identity_conflict')
+    return clip_id
+
+
+def capture_placement_create(bundle, owner, clip_id, media, on, hold, *, ownership, verified_media,
+                             consumed=()):
+    """Caller reserves clip_id and supplies the exact five-field Runtime media selection."""
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    args = {'id': _raw_clip_id(clip_id), 'on': on, 'hold': hold, 'media': copy.deepcopy(media)}
+    if consumed:
+        args['consumed'] = list(consumed)
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.create', 'version': '1',
+                             'select': owner, 'args': args, 'intent': dict(PLACEMENT_INTENT)}], verified_media=verified_media).commands[0]
+
+
+def capture_placement_unplace(bundle, owner, clip_id, *, ownership):
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    return execute(bundle, [{'schema_version': 1, 'op': 'placement.unplace', 'version': '1',
+                             'select': owner + '/clip:' + _raw_clip_id(clip_id), 'args': {},
+                             'intent': dict(PLACEMENT_INTENT)}]).commands[0]
diff --git a/astrid/sdk/timeline/native_restructure.py b/astrid/sdk/timeline/native_restructure.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c012335947e81b10614ddf58b4e9ecfdd2a9c36
--- /dev/null
+++ b/astrid/sdk/timeline/native_restructure.py
@@ -0,0 +1,69 @@
+"""Chapter restructuring from the provider's authenticated current closure."""
+from __future__ import annotations
+
+import copy
+
+from ._command_state import ABSENT, CommandError, equal, present
+
+PARAMETERS = {'type': 'object', 'properties': {}, 'additionalProperties': False}
+
+
+def restructure(ctx, command):
+    from astrid.sdk.timeline.checkout import Checkout
+    from astrid.sdk.timeline_restructure import assert_equivalent, split
+
+    bundle = ctx.state.bundle
+    document = bundle.get('source_mapping', {}).get('_runtime_document')
+    pin = bundle['base_parent']
+    # The public pair loader retains publication provenance; Runtime checks
+    # that pair against the request/history. The immutable image pins content.
+    if (document is None or document['project_id'] != bundle['project_id']
+            or document['timeline_id'] != bundle['timeline_id']
+            or set(pin) not in ({'revision_id', 'content_digest'},
+                                {'revision_id', 'content_digest', 'publication_id'})
+            or ('publication_id' in pin and (not isinstance(pin['publication_id'], str)
+                                            or not pin['publication_id'].strip()))
+            or {key: document['parent_revision'][key] for key in ('revision_id', 'content_digest')}
+            != {key: pin[key] for key in ('revision_id', 'content_digest')}):
+        raise CommandError('restructure requires the authenticated current closure',
+                           kind='history_unavailable')
+    if command['select'] != 'parent':
+        raise CommandError('restructure requires parent ownership')
+    ctx.read('timeline')
+    working = Checkout(copy.deepcopy(bundle))
+    working._sync_film_length()
+    after = split(working.document())
+    assert_equivalent(working.bundle, after)
+    if equal(bundle['placements'], after['placements']):
+        raise CommandError('no chapter restructure is pending', kind='invalid_commands')
+    # The native recorder owns membership and allocation. No caller supplies
+    # child payloads, managed edges, or an alternate source document.
+    for identity in sorted(set(after['shots']) - set(bundle['shots'])):
+        shot = after['shots'][identity]
+        ctx.create_entity('shot:' + identity, kind='shot', owner=None,
+                          value={key: shot[key] for key in ('payload', 'internal_timeline')})
+    for identity in sorted(set(after['shots']) & set(bundle['shots'])):
+        ref = 'shot:' + identity
+        value = {key: after['shots'][identity][key] for key in ('payload', 'internal_timeline')}
+        if not equal(ctx.read(ref), value):
+            ctx.write(ref, [], value)
+    prior = {row['occurrence_id'] for row in bundle['placements']}
+    retained = {row['occurrence_id'] for row in after['placements']}
+    for row in list(bundle['placements']):
+        ctx.read('occurrence:' + row['occurrence_id'])
+        if row['occurrence_id'] not in retained:
+            ctx.clear('occurrence:' + row['occurrence_id'], [])
+    for row in after['placements']:
+        ref = 'occurrence:' + row['occurrence_id']
+        if row['occurrence_id'] in prior:
+            ctx.write(ref, [], row)
+        else:
+            ctx.create_entity(ref, kind='occurrence', owner='parent', value=row)
+    if not equal(ctx.read('parent', ['occurrences']), after['placements']):
+        ctx.write('parent', ['occurrences'], after['placements'])
+    parent = after['parent']
+    for key in sorted(set(bundle['parent']) | set(parent), key=lambda key: (key == 'config', key)):
+        ctx.read('parent', [key])
+        value = present(parent[key]) if key in parent else ABSENT
+        if not equal(ctx.state.get('parent', [key]), value):
+            ctx.assign('parent', [key], value)
diff --git a/astrid/sdk/timeline/native_shot_pool_commands.py b/astrid/sdk/timeline/native_shot_pool_commands.py
new file mode 100644
index 0000000000000000000000000000000000000000..442190bb76dc0ef32c339aea97504dd90ea3ffbb
--- /dev/null
+++ b/astrid/sdk/timeline/native_shot_pool_commands.py
@@ -0,0 +1,79 @@
+"""Shot pool membership: an ordered list of asset aliases the shot holds without a clip.
+
+The pool lives on the shot's internal timeline at app.astrid.pool. An absent list means
+pool membership was never authored here (a migrated group's legacy poolGenerationIds stay
+untouched in the occurrence provenance until they are adopted with explicit adds); an empty
+list is an authored empty pool. Removing the last member leaves [] and never clears the key.
+
+shot.pool add binds the exact media in the shot registry (as placement does) and appends its
+alias; remove drops the alias and keeps the binding. A member is never also a placed clip.
+Writes replace the whole list, so an inverse restores the exact order and position.
+"""
+from __future__ import annotations
+
+import copy
+
+from ._command_state import ABSENT, CommandError
+from ._media_inputs import _verified
+from .native_occurrence_media_commands import _registry
+from .native_placement_commands import _exclusive, _explicit_occurrence
+
+POOL_INTENT = {'ownership': 'occurrence'}
+POOL = ['app', 'astrid', 'pool']
+
+
+def _members(state):
+    if state == ABSENT:
+        return None
+    members = state.get('value')
+    if not isinstance(members, list) or any(not isinstance(item, str) for item in members):
+        raise CommandError('shot pool must be a list of asset aliases', kind='unsupported_pool')
+    return members
+
+
+def shot_pool(ctx, command):
+    owner = command['select']
+    ctx.read(owner, ['occurrence_id'])
+    ctx.read(owner + '/shot', ['shot_id'])
+    ctx.state.occurrence(owner)
+    ctx.bind('pool.owner', owner)
+    _exclusive(ctx, owner)
+    ctx.read('parent', ['config', 'pinnedShotGroups'])
+    action, pin = command['args']['action'], command['args']['media']
+    alias = pin['asset']
+    _, kind = _verified(ctx, pin)
+    source = owner + '/source'
+    ctx.read(source, POOL)
+    members = _members(ctx.state.get(source, POOL))
+    if action == 'add':
+        if members is not None and alias in members:
+            raise CommandError('media is already pooled', kind='identity_collision', ref=owner)
+        for ref in ctx.select('collection.clips', owner):
+            for key in ('asset', 'asset_id'):
+                ctx.read(ref, [key])
+            row = ctx.state.entity(ref)
+            if alias in (row.get('asset'), row.get('asset_id')):
+                raise CommandError('media is already placed in the shot', kind='identity_conflict', ref=ref)
+        # Unplace retains its binding, including opaque metadata. Reuse it rather
+        # than requiring equality with a newly constructed, narrower binding.
+        _registry(ctx, owner, pin, kind,
+                  create=ctx.state.get(owner + '/asset:' + alias, []) == ABSENT)
+        if members is None:
+            ctx.object(source, POOL[:1])
+            ctx.object(source, POOL[:2])
+        ctx.write(source, POOL, [*(members or []), alias])
+    else:
+        if members is None or alias not in members:
+            raise CommandError('media is not pooled', kind='identity_conflict', ref=owner)
+        _registry(ctx, owner, pin, kind)
+        ctx.write(source, POOL, [item for item in members if item != alias])
+
+
+def capture_shot_pool(bundle, owner, action, media, *, ownership, verified_media):
+    """Caller supplies the exact five-field Runtime selection; action is add or remove."""
+    from .commands import execute
+
+    _explicit_occurrence(owner, ownership)
+    return execute(bundle, [{'schema_version': 1, 'op': 'shot.pool', 'version': '1', 'select': owner,
+                             'args': {'action': action, 'media': copy.deepcopy(media)},
+                             'intent': dict(POOL_INTENT)}], verified_media=verified_media).commands[0]
diff --git a/astrid/sdk/timeline/native_source_inputs.py b/astrid/sdk/timeline/native_source_inputs.py
new file mode 100644
index 0000000000000000000000000000000000000000..5581b91a84724a7da3b52e7bb14a8b26a4bc263d
--- /dev/null
+++ b/astrid/sdk/timeline/native_source_inputs.py
@@ -0,0 +1,130 @@
+"""Exact retained source inputs for attached native timeline commands."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+from collections.abc import Mapping
+from typing import Any
+
+from astrid.sdk.media_transcript import SCHEMA, transcript_document_id
+
+from ._common import TimelineEditError
+
+
+def _canonical_digest(value: Any) -> str:
+    try:
+        encoded = json.dumps(value, sort_keys=True, separators=(",", ":"),
+                            ensure_ascii=False, allow_nan=False).encode("utf-8")
+    except (TypeError, ValueError, UnicodeEncodeError) as exc:
+        raise TimelineEditError("verified transcript content is not canonical JSON") from exc
+    return "sha256:" + hashlib.sha256(encoded).hexdigest()
+
+
+def _transcript_number(value: Any, label: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise TimelineEditError(f"verified transcript {label} must be a finite number")
+    if value < 0:
+        raise TimelineEditError(f"verified transcript {label} must not be negative")
+    return float(value)
+
+
+def _validate_transcript_v1(project: str, pin: Mapping[str, Any], document: Mapping[str, Any]) -> None:
+    content = document.get("content")
+    if (document.get("kind") != "media.transcript"
+            or not isinstance(content, Mapping)
+            or set(content) != {"schema", "media_id", "source_id", "segments"}):
+        raise TimelineEditError("verified document is not a canonical media.transcript/v1 document")
+    if content.get("schema") != SCHEMA or not isinstance(content.get("media_id"), str):
+        raise TimelineEditError("verified document is not a canonical media.transcript/v1 document")
+    source_id = content.get("source_id")
+    if not isinstance(source_id, str) or not source_id:
+        raise TimelineEditError("verified transcript source identity is invalid")
+    if document["document_id"] != transcript_document_id(project, content["media_id"], source_id):
+        raise TimelineEditError("verified transcript document identity does not match its source")
+    segments = content.get("segments")
+    if not isinstance(segments, list):
+        raise TimelineEditError("verified transcript segments must be an array")
+    segment_ids, word_ids = set(), set()
+    for segment in segments:
+        if (not isinstance(segment, dict)
+                or set(segment) - {"id", "start", "end", "text", "speaker", "words"}
+                or not {"id", "start", "end", "text"}.issubset(segment)):
+            raise TimelineEditError("verified transcript segment has an invalid shape")
+        segment_id = segment["id"]
+        if not isinstance(segment_id, str) or not segment_id or segment_id in segment_ids:
+            raise TimelineEditError("verified transcript segment identity is invalid or duplicated")
+        segment_ids.add(segment_id)
+        start, end = (_transcript_number(segment["start"], "segment start"),
+                      _transcript_number(segment["end"], "segment end"))
+        if end < start or not isinstance(segment["text"], str):
+            raise TimelineEditError("verified transcript segment interval or text is invalid")
+        if "speaker" in segment and segment["speaker"] is not None and not isinstance(segment["speaker"], str):
+            raise TimelineEditError("verified transcript speaker is invalid")
+        words = segment.get("words", [])
+        if not isinstance(words, list):
+            raise TimelineEditError("verified transcript words must be an array")
+        for word in words:
+            if not isinstance(word, dict) or set(word) != {"id", "start", "end", "text"}:
+                raise TimelineEditError("verified transcript word has an invalid shape")
+            word_id = word["id"]
+            if not isinstance(word_id, str) or not word_id or word_id in word_ids:
+                raise TimelineEditError("verified transcript word identity is invalid or duplicated")
+            word_ids.add(word_id)
+            word_start, word_end = (_transcript_number(word["start"], "word start"),
+                                    _transcript_number(word["end"], "word end"))
+            if (word_end < word_start or word_start < start or word_end > end
+                    or not isinstance(word["text"], str)):
+                raise TimelineEditError("verified transcript word interval or text is invalid")
+
+
+def read_verified_transcript(client: Any, project: str, pin: Mapping[str, Any]) -> dict[str, Any]:
+    """Read and validate one exact retained transcript pin through Runtime."""
+    if not isinstance(pin, Mapping) or set(pin) != {"document_id", "version", "content_digest"}:
+        raise TimelineEditError("word anchor requires an exact DocumentPin")
+    exact_pin = dict(pin)
+    try:
+        verified = client.get_project_verified_document(project, exact_pin)
+    except Exception as exc:
+        if getattr(exc, "code", None) == "not_found":
+            raise TimelineEditError("exact transcript pin is missing or unavailable") from exc
+        raise TimelineEditError(f"exact retained transcript read failed: {exc}") from exc
+    if not isinstance(verified, Mapping) or verified.get("pin") != exact_pin:
+        raise TimelineEditError("verified transcript read returned a different DocumentPin")
+    document = verified.get("document")
+    if not isinstance(document, Mapping):
+        raise TimelineEditError("verified transcript read did not return a document")
+    if (document.get("project_id") != project
+            or document.get("document_id") != exact_pin["document_id"]
+            or document.get("version") != exact_pin["version"]):
+        raise TimelineEditError("verified transcript document scope or version does not match its pin")
+    content = document.get("content")
+    if _canonical_digest(content) != exact_pin["content_digest"]:
+        raise TimelineEditError("verified transcript content bytes do not match its pin")
+    _validate_transcript_v1(project, exact_pin, document)
+    return {"pin": exact_pin, "document": copy.deepcopy(dict(document))}
+
+
+def materialize_transcript_inputs(bundle: dict[str, Any], commands: list[Mapping[str, Any]], *,
+                                  client: Any, project: str) -> dict[str, Any]:
+    """Hydrate exact transcript captures needed by pending or new anchors."""
+    pins: list[dict[str, Any]] = []
+    for command in commands:
+        if command.get("op") != "clip.anchor":
+            continue
+        choice = (command.get("args") or {}).get("choice")
+        if not isinstance(choice, Mapping):
+            continue
+        pin = choice.get("document")
+        if isinstance(pin, Mapping) and dict(pin) not in pins:
+            pins.append(dict(pin))
+    if not pins:
+        return bundle
+    mapping = bundle.setdefault("source_mapping", {})
+    captures = mapping.setdefault("pinned_documents", [])
+    for pin in pins:
+        capture = read_verified_transcript(client, project, pin)
+        captures[:] = [row for row in captures if not isinstance(row, Mapping) or row.get("pin") != pin]
+        captures.append(capture)
+    return bundle
diff --git a/astrid/sdk/timeline/native_text_binding.py b/astrid/sdk/timeline/native_text_binding.py
new file mode 100644
index 0000000000000000000000000000000000000000..4314cb7af62896a2a34df8e89985899dc01d671e
--- /dev/null
+++ b/astrid/sdk/timeline/native_text_binding.py
@@ -0,0 +1,80 @@
+"""Occurrence-owned immutable UTF-8 text bindings; live heads belong to Runtime."""
+from __future__ import annotations
+
+import copy
+import re
+
+from ._command_state import ABSENT, CommandError, equal
+
+TEXT_INTENT = {'ownership': 'occurrence'}
+TEXT_MEDIA_TYPE = 'text/plain; charset=utf-8'
+DERIVED_FIELDS = {'binding_id', 'project_id', 'shot_id', 'head', 'event_stream_id',
+                  'created_at', 'updated_at', 'text'}
+
+
+def binding_key(row):
+    kind, slot = row.get('kind'), row.get('slot')
+    if (kind not in ('prompt', 'voiceover_script', 'transcript')
+            or (slot is not None and (kind != 'prompt' or not isinstance(slot, str)
+                                     or not re.fullmatch(r'[a-z][a-z0-9-]{0,63}', slot)))):
+        raise CommandError('unsupported text binding identity', kind='unsupported_shape')
+    return kind + (':' + slot if slot is not None else '')
+
+
+def binding_rows(state, owner):
+    shot = state.occurrence(owner)['shot_id']
+    rows = state.bundle['shots'][shot]['payload'].get('text_bindings', [])
+    if not isinstance(rows, list) or any(not isinstance(row, dict) or not {
+            'kind', 'slot', 'media_id', 'content_hash', 'byte_size', 'mime_type'} <= row.keys() for row in rows):
+        raise CommandError('text bindings require immutable descriptors', kind='unsupported_shape')
+    keys = [binding_key(row) for row in rows]
+    if len(keys) != len(set(keys)):
+        raise CommandError('ambiguous text binding identity', kind='identity_conflict')
+    return rows
+
+
+def text_binding_set(ctx, command):
+    owner, args = command['select'], command['args']
+    if not isinstance(owner, str) or not re.fullmatch(r'occurrence:(?!.*::)[^/]+', owner):
+        raise CommandError('text binding requires explicit occurrence ownership')
+    ctx.read(owner, ['occurrence_id'])
+    ctx.read(owner + '/shot', ['shot_id'])
+    if ctx.select('text-binding.owners', owner) != [owner]:
+        raise CommandError('text binding requires an exclusive occurrence', kind='unsupported_ownership')
+    ref = owner + '/text-binding:' + binding_key(args['binding'])
+    old = ctx.read(ref)
+    if 'clear' in args:
+        if ctx.state.get(ref, []) == ABSENT:
+            raise CommandError('cannot clear an absent text binding', kind='absent_binding', ref=ref)
+        ctx.select('collection.text-bindings', owner)
+        ctx.clear(ref, [])
+        return
+    pin = args['text']
+    if pin['object_id'] != pin['digest']:
+        raise CommandError('text object id must equal its content digest', ref=ref)
+    if not any(equal(value, {**pin, 'utf8': True}) for value in ctx.verified_media):
+        raise CommandError('text binding requires exact Runtime-verified UTF-8 input', kind='dependency_changed')
+    if old is None:
+        path = ['payload', 'text_bindings']
+        if ctx.state.get(owner + '/shot', path) == ABSENT:
+            ctx.read(owner + '/shot', path)
+            ctx.write(owner + '/shot', path, [])
+        ctx.select('collection.text-bindings.append', owner)
+    ctx.dependency('text:' + pin['digest'], 'media', pin)
+    row = {key: copy.deepcopy(value) for key, value in (old or {}).items() if key not in DERIVED_FIELDS}
+    row.update(args['binding'], media_id=pin['object_id'], content_hash=pin['digest'],
+               byte_size=pin['size'], mime_type=pin['media_type'])
+    ctx.write(ref, [], row)
+
+
+def capture_text_binding_set(bundle, owner, binding, *, text=None, clear=False, verified_text=()):
+    from .commands import execute
+
+    args = {'binding': copy.deepcopy(binding)}
+    if text is not None:
+        args['text'] = copy.deepcopy(text)
+    if clear:
+        args['clear'] = True
+    return execute(bundle, [{'schema_version': 1, 'op': 'text-binding.set', 'version': '1',
+                             'select': owner, 'args': args, 'intent': TEXT_INTENT}],
+                   verified_media=verified_text).commands[0]
diff --git a/astrid/sdk/timeline/native_timeline_duplicate.py b/astrid/sdk/timeline/native_timeline_duplicate.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f3ff25caf8d2f165c83929c0ae4b386185d2376
--- /dev/null
+++ b/astrid/sdk/timeline/native_timeline_duplicate.py
@@ -0,0 +1,159 @@
+"""Copy one exact Runtime-authenticated source closure into an empty timeline."""
+from __future__ import annotations
+
+import copy
+
+from ._command_state import ABSENT, CommandError, equal, present
+
+SOURCE_REF = {
+    'type': 'object', 'additionalProperties': False,
+    'required': ['project_id', 'timeline_id', 'revision_id', 'publication_id', 'content_digest'],
+    'properties': {key: {'type': 'string', 'minLength': 1} for key in
+                   ('project_id', 'timeline_id', 'revision_id', 'publication_id', 'content_digest')},
+}
+PARAMETERS = {
+    'type': 'object', 'additionalProperties': False,
+    'required': ['source_ref', 'shots', 'occurrences'],
+    'properties': {'source_ref': SOURCE_REF, **{key: {
+        'type': 'object', 'additionalProperties': {'type': 'string', 'minLength': 1}}
+        for key in ('shots', 'occurrences')}},
+}
+
+
+def resolve_source(port, resolver):
+    """The private port, never command bytes, supplies the source image."""
+    def resolve(ctx):
+        inputs = resolver(ctx)
+        command = ctx.record['command']
+        if command['op'] != 'timeline.duplicate':
+            return inputs
+        from .commit import _hydrate, _require, bundle_from_document
+
+        ref = command['args']['source_ref']
+        document = port.revision_closure(copy.deepcopy(ref))
+        source = bundle_from_document(document)
+        image = document['parent_revision']
+        _require((document['project_id'], document['timeline_id'], image['revision_id'], image['content_digest']) ==
+                 (ref['project_id'], ref['timeline_id'], ref['revision_id'], ref['content_digest']),
+                 'Runtime returned a different source closure')
+        for pin in document['dependency_manifest']['media']:
+            port.raw_media_info(copy.deepcopy(pin))
+        for captured in _hydrate(port, source):
+            if captured not in inputs:
+                inputs.append(captured)
+        ctx.source_copy = source
+        return inputs
+    return resolve
+
+
+def duplicate(ctx, command):
+    from astrid.core.timeline.authoring_bundle import _copy_shot_for_placement
+
+    args = command['args']
+    source = getattr(ctx, 'source_copy', None)
+    if source is None:
+        raise CommandError('duplicate requires Runtime-authenticated source input', kind='dependency_changed')
+    target = ctx.state.bundle
+    ref = args['source_ref']
+    if (ref['project_id'] != target['project_id'] or ref['timeline_id'] == target['timeline_id']
+            or command['select'] != 'parent'):
+        raise CommandError('duplicate source and destination scopes disagree', kind='dependency_changed')
+    ctx.read('timeline')
+    ctx.dependency('copy.source', 'authority', ref)
+    if target['placements'] or target['shots']:
+        raise CommandError('duplicate requires an empty destination', kind='identity_collision')
+    document = source['source_mapping']['_runtime_document']
+    rows = document['parent_revision']['payload']['occurrences']
+    shots = {row['shot_id']: row for row in document['shot_revisions']}
+    if len(shots) != len(document['shot_revisions']):
+        raise CommandError('source has multiple revisions of one shot', kind='identity_conflict')
+    for key, identities in (('shots', set(shots)), ('occurrences', {row['occurrence_id'] for row in rows})):
+        mapping = args[key]
+        if (set(mapping) != identities or len(set(mapping.values())) != len(mapping)
+                or set(mapping.values()) & identities):
+            raise CommandError('copy requires complete fresh injective identity maps', kind='identity_collision')
+    internals = {row['revision_id']: row['payload'] for row in document['internal_timeline_revisions']}
+    parent = copy.deepcopy(document['parent_revision']['payload'])
+    parent.pop('occurrences')
+    # Config follows registry aliases so guarded aggregate inversion observes
+    # the exact authored config rather than synthesizing a registry mirror.
+    for key in sorted(set(target['parent']) | set(parent), key=lambda key: (key == 'config', key)):
+        before = ctx.state.get('parent', [key])
+        after = present(parent[key]) if key in parent else ABSENT
+        if not equal(before, after):
+            ctx.assign('parent', [key], after)
+    for identity, shot in sorted(shots.items()):
+        occurrence = next(row['occurrence_id'] for row in rows if row['shot_id'] == identity)
+        payload, _ = _copy_shot_for_placement(
+            shot['payload'], project_id=target['project_id'], timeline_id=target['timeline_id'],
+            occurrence_id=args['occurrences'][occurrence], authoring_shot_id=args['shots'][identity],
+            source_shot_id=identity)
+        payload.pop('internal_timeline_revision_id', None)
+        ctx.create_entity('shot:' + args['shots'][identity], kind='shot', owner=None,
+                          value={'payload': payload, 'internal_timeline': internals[shot['internal_timeline_revision_id']]})
+    for row in rows:
+        copied = copy.deepcopy(row)
+        copied.pop('shot_revision_id', None)
+        copied.pop('revision_id', None)
+        copied['shot_id'] = args['shots'][row['shot_id']]
+        copied['occurrence_id'] = args['occurrences'][row['occurrence_id']]
+        ctx.create_entity('occurrence:' + copied['occurrence_id'], kind='occurrence', owner='parent', value=copied)
+    if any('stable_deep_link' in row or 'output_identity' in row for row in rows):
+        from astrid.core.timeline.authoring_bundle import compile_authoring_candidate
+
+        compiled = compile_authoring_candidate(target).publication['parent_composition']['occurrences']
+        for row in compiled:
+            owner = 'occurrence:' + row['occurrence_id']
+            for key in ('stable_deep_link', 'output_identity'):
+                if key in row and not equal(ctx.state.get(owner, [key]), present(row[key])):
+                    ctx.write(owner, [key], row[key])
+    # Preserve retained inputs as well as those directly referenced by payloads.
+    mapping = target['source_mapping']
+    mapping['pinned_documents'] = copy.deepcopy(source['source_mapping'].get('pinned_documents', []))
+    mapping['_copy_manifest'] = copy.deepcopy(document['dependency_manifest'])
+    for pin in document['dependency_manifest']['media']:
+        ctx.dependency('copy.media:' + pin['media_id'], 'media', pin)
+    for capture in mapping['pinned_documents']:
+        kind = 'transcript' if capture['document']['kind'] == 'media.transcript' else 'source'
+        ctx.dependency('copy.document:' + capture['pin']['document_id'], kind, capture['pin'])
+
+
+def copy_command(source_ref, shots, occurrences):
+    """Reserve destination roots; Runtime/provider verify every submitted claim."""
+    return {'schema_version': 1, 'op': 'timeline.duplicate', 'version': '1', 'select': 'parent',
+            'args': {'source_ref': copy.deepcopy(source_ref), 'shots': dict(shots), 'occurrences': dict(occurrences)},
+            'created': [*('shot:' + shots[key] for key in sorted(shots)),
+                        *('occurrence:' + identity for identity in occurrences.values())]}
+
+
+def physical_content(bundle):
+    """Recover physical sharing from authenticated closure links, never alias equality."""
+    document = bundle.get('source_mapping', {}).get('_runtime_document')
+    if document is None:
+        return bundle
+    result = copy.deepcopy(bundle)
+    result['parent'] = copy.deepcopy(document['parent_revision']['payload'])
+    result['placements'] = result['parent'].pop('occurrences')
+    internals = {row['revision_id']: row for row in document['internal_timeline_revisions']}
+    result['shots'] = {}
+    result['source_mapping']['shots'] = {}
+    for image in document['shot_revisions']:
+        identity = image['shot_id']
+        internal = internals[image['internal_timeline_revision_id']]
+        result['source_mapping']['shots'][identity] = {
+            'shot_id': identity, 'revision_id': image['revision_id'],
+            'content_digest': image['content_digest'], 'internal_timeline_id': internal['timeline_id'],
+            'internal_timeline_revision_id': internal['revision_id'],
+            'internal_timeline_content_digest': internal['content_digest'], 'item_id_map': {}}
+        result['shots'][identity] = {
+            'shot_id': identity, 'payload': copy.deepcopy(image['payload']),
+            'base_payload': copy.deepcopy(image['payload']),
+            'internal_timeline': copy.deepcopy(internal['payload']),
+            'base_internal_timeline': copy.deepcopy(internal['payload'])}
+    for row in result['placements']:
+        row.pop('shot_revision_id', None)
+        row.pop('revision_id', None)
+    result['base_placements'] = {row['occurrence_id']: copy.deepcopy(row) for row in result['placements']}
+    result['source_mapping']['placements'] = copy.deepcopy(result['base_placements'])
+    result['base_parent_payload'] = copy.deepcopy(result['parent'])
+    return result
