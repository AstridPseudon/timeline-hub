+class RuntimeCommitService:
+    provider_id = "astrid-v1"
+    interface_version = 1
+
+    def __init__(self, contract_digest):
+        self.contract_digest = contract_digest
+
+    def capture_candidate_inputs(self, document, *, candidate):
