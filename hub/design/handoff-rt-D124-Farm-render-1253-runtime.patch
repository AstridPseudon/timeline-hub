+def test_upstream_v31_schema_migration_installs_empty_history_without_invented_baselines(tmp_path):
+    from runtime_protocol.upgrade import (
+        _apply_v31_to_v32,
+        _canonical_schema_identity,
+        migrate_canonical_to_current,
