+])
+def test_mutated_provider_allocations_refuse_without_writes(runtime, monkeypatch, mutation, declared):
+    accept = RequestCommitPort.accept
+    reached = []
+
+    def checked_accept(port, prepared):
+        value = copy.deepcopy(prepared)
