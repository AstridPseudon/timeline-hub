+def _full_v2_auth_body(edit):
+    change = {
+        "op": "set",
+        "ref": "parent",
+        "path": ["meta", "org.example.auth-probe"],
+        "before": {"state": "absent"},
+        "value": "must-not-write",
+    }
+    reads = [{"kind": "field", "ref": "parent", "path": change["path"],
+              "state": {"state": "absent"}}]
+    command = {
+        "schema_version": 1,
+        "op": "doc.patch",
+        "version": "1",
+        "select": None,
+        "args": {"changes": [copy.deepcopy(change)]},
+    }
+    body = edit.body([command])
+    body.update({
+        "label": "Door authorization probe",
+        "steps": [{
+            "id": "auth-probe",
+            "label": "Door authorization probe",
+            "intent": "Verify commit admission",
+            "tags": ["authorization"],
+            "command_ordinals": [0],
+            "patch": [change],
+            "reads": reads,
+        }],
+        "merge": "fields",
+        "reads": reads,
+    })
+    return body
+
