+    elif mutation == "absent":
+        write["after"] = {"state": "absent"}
+    elif mutation == "before":
+        write["before"]["value"][0]["gain"] = 99
+    elif mutation == "wrong-order":
+        rows.reverse()
+    elif mutation == "physical-pin":
