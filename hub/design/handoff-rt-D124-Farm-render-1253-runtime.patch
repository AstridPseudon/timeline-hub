+    def advance(seconds):
+        nonlocal wall, tick
+        wall += timedelta(seconds=seconds)
+        tick += seconds
+        return tick
+
+    for module in (idempotency, store, util):
+        monkeypatch.setattr(module, "datetime", Clock)
+    monkeypatch.setattr(store.time, "monotonic", lambda: tick)
+    return advance
+
