+"""Settled producer authority, captured only through a requesting commit port."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import re
+from typing import TypedDict
+
+from .cas import IO_CHUNK_BYTES
+from .errors import RuntimeErrorBase, ValidationError
+from .timeline_commit_port import command_leaves, refused
+
+
+class ProducerAdmittedTarget(TypedDict):
+    project_id: str
+    timeline_id: str
+    base_revision_id: str
+    base_publication_id: str
+
+
+class ProducerAttemptPin(TypedDict):
+    task_id: str
+    attempt_id: str
+    executor_id: str
+    fence: int
+    runtime_epoch: int
+    admitted_target: ProducerAdmittedTarget
+    proposal_digest: str
+
+
+class VerifiedProducerAttempt(TypedDict):
+    pin: ProducerAttemptPin
+
+
+_TARGET = {"project_id", "timeline_id", "base_revision_id", "base_publication_id"}
+_PRODUCER = {"task_id", "attempt_id", "executor_id", "fence", "runtime_epoch"}
+_PIN = _PRODUCER | {"admitted_target", "proposal_digest"}
+
+
+def validate_pin(pin):
+    if (not isinstance(pin, dict) or set(pin) != _PIN
+            or any(not isinstance(pin.get(key), str) or not pin[key].strip()
+                   for key in ("task_id", "attempt_id", "executor_id"))
+            or any(type(pin.get(key)) is not int or pin[key] <= 0 for key in ("fence", "runtime_epoch"))
+            or not isinstance(pin.get("proposal_digest"), str)
+            or not re.fullmatch(r"sha256:[0-9a-f]{64}", pin["proposal_digest"])):
+        raise ValidationError("invalid producer attempt pin")
+    target = pin["admitted_target"]
+    if (not isinstance(target, dict) or set(target) != _TARGET
+            or any(not isinstance(value, str) or not value.strip() for value in target.values())):
+        raise ValidationError("invalid producer admitted target")
+    try:
+        json.dumps(pin, ensure_ascii=False).encode("utf-8")
+    except UnicodeError as exc:
+        raise ValidationError("invalid producer attempt pin Unicode") from exc
+
+
+def value_equal(left, right):
+    """JSON recipe equality: numeric value, distinct booleans, exact structure."""
+    if type(left) in (int, float) and type(right) in (int, float):
+        return (type(left) is int or math.isfinite(left)) and (type(right) is int or math.isfinite(right)) and left == right
+    if type(left) is not type(right):
+        return False
+    if isinstance(left, dict):
+        return left.keys() == right.keys() and all(value_equal(value, right[key]) for key, value in left.items())
+    if isinstance(left, list):
+        return len(left) == len(right) and all(value_equal(a, b) for a, b in zip(left, right))
+    return left == right
+
+
+def request_pin(request):
+    commands = request["commands"]
+    leaves = list(command_leaves(commands))
+    guards = [item for item in leaves if item.get("op") == "producer.guard"]
+    if not guards:
+        return None
+    guard = commands[0]
+    if (len(guards) != 1 or guards[0] is not guard
+            or set(guard) != {"schema_version", "op", "version", "select", "args"}
+            or type(guard.get("schema_version")) is not int or guard["schema_version"] != 1
+            or guard.get("version") != "1" or guard.get("select") is not None
+            or not isinstance(guard.get("args"), dict) or set(guard["args"]) != {"pin"}
+            or len(commands) < 2
+            or any(item.get("op") in {"timeline.restore", "timeline.inverse"} for item in leaves)):
+        raise refused("producer_attempt_mismatch", "producer guard must precede only the proposed commands")
+    pin = guard["args"]["pin"]
+    validate_pin(pin)
+    return pin
+
+
+def _strict_json(raw):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError("duplicate JSON key")
+            result[key] = value
+        return result
+
+    def constant(value):
+        raise ValueError("nonfinite JSON number")
+
+    value = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs, parse_constant=constant)
+    # Also rejects escaped unpaired surrogates, overflowed floats, and surrogates in keys.
+    json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
+    return value
+
+
+def _mismatch():
+    return refused("producer_attempt_mismatch", "settled producer authority changed")
+
+
+def _unavailable():
+    return refused("producer_dependency_unavailable", "settled producer dependency is unavailable")
+
+
+def _current_attempt(task, attempt):
+    return (task["attempt_id"] == attempt["id"] and attempt["task_id"] == task["id"]
+            and task["executor_id"] == attempt["executor_id"]
+            and all(type(task[column]) is int and type(attempt[key]) is int
+                    and task[column] == attempt[key] and attempt[key] > 0
+                    for key, column in (("fence", "lease_fence"), ("runtime_epoch", "runtime_epoch"))))
+
+
+class ProducerReads:
+    def __init__(self, service):
+        self.service = service
+        self.store = service.store
+        self.conn = service.store.conn
+
+    def _output(self, task, attempt, project, output, *, read_bytes=False):
+        matches = [item for item in self.store.list_managed_outputs(task["id"])
+                   if item["attempt_id"] == attempt["id"]
+                   and self.store._generation_publish_output_key(output) == (
+                       item["output_port"], item["group_key"], item["variant_key"], item["ordinal"])]
+        if len(matches) != 1:
+            raise _unavailable()
+        association = matches[0]
+        if (association["project_id"] != project or output.get("kind") != "object"
+                or association["object_id"] != output.get("digest")
+                or type(output.get("size")) is not int or association["size"] != output["size"]
+                or association["media_type"] != output.get("media_type")
+                or association["role"] != output.get("role", "output")
+                or association["durability"] != "durable"
+                or association["lifecycle"]["state"] not in {"available", "promoted"}
+                or any(type(association["provenance"].get(key)) is not int
+                       for key in ("fence", "runtime_epoch"))
+                or any(association["provenance"].get(key) != value for key, value in (
+                    ("task_id", task["id"]), ("attempt_id", attempt["id"]),
+                    ("executor_id", attempt["executor_id"]), ("fence", attempt["fence"]),
+                    ("runtime_epoch", attempt["runtime_epoch"]), ("capability_id", task["capability"])))):
+            raise _unavailable()
+        digest = association["object_id"][7:]
+        obj = self.conn.execute("SELECT size, media_type FROM objects WHERE digest=?", (digest,)).fetchone()
+        if (not obj or obj["size"] != output["size"] or obj["media_type"] != output["media_type"]
+                or not self.conn.execute("SELECT 1 FROM project_objects WHERE project_id=? AND digest=? AND relation='managed'",
+                                         (project, digest)).fetchone()):
+            raise _unavailable()
+        if read_bytes and output["size"] > self.service.max_object_bytes:
+            raise _unavailable()
+        chunks = [] if read_bytes else None
+        size, hasher = 0, hashlib.sha256()
+        with self.service.cas.open(digest) as stream:
+            while chunk := stream.read(IO_CHUNK_BYTES):
+                size += len(chunk)
+                if size > output["size"]:
+                    raise _mismatch()
+                hasher.update(chunk)
+                if chunks is not None:
+                    chunks.append(chunk)
+        if size != output["size"] or hasher.hexdigest() != digest:
+            raise _mismatch()
+        return b"".join(chunks) if chunks is not None else None, association
+
+    def _continuation(self, task, spec, project):
+        deps = spec.get("runtime_dependencies", {})
+        rows = self.store._continuation_rows(task["id"])
+        admission = self.conn.execute("SELECT * FROM continuation_admissions WHERE continuation_task_id=?",
+                                      (task["id"],)).fetchone()
+        assembler = task["capability"] == "rendering.assemble_timeline"
+        if not rows and not admission and not deps.get("edges") and not assembler:
+            return None
+        if (not rows or not admission or (assembler and len(rows) != 2)
+                or deps.get("aggregation", {}).get("kind") != "ordered_cas_inputs"
+                or [item["task_id"] for item in rows] != [edge["from_task_id"] for edge in deps["edges"]]
+                or [item["ordinal"] for item in rows] != list(range(len(rows)))):
+            raise _unavailable()
+        children, inputs, captures, visuals = [], [], [], []
+        for row in rows:
+            child = self.conn.execute("SELECT t.*, r.project_id FROM tasks t JOIN runs r ON r.id=t.run_id WHERE t.id=?",
+                                      (row["task_id"],)).fetchone()
+            attempt = self.conn.execute("SELECT * FROM attempts WHERE id=?", (child["attempt_id"],)).fetchone()
+            if (child["project_id"] != project or child["status"] != "completed" or not attempt
+                    or not _current_attempt(child, attempt) or attempt["settled"] != 1):
+                raise _unavailable()
+            outputs = json.loads(child["result_json"])["outputs"]
+            for output in outputs:
+                if output["digest"] not in inputs:
+                    inputs.append(output["digest"])
+            selected = outputs
+            if assembler:
+                selected = [output for output in outputs if output.get("role") in {"primary", "primary_visual"}
+                            and output.get("is_primary") is not False
+                            and output.get("metadata", {}).get("status") != "superseded"]
+                if len(selected) != 1 or not selected[0].get("media_type", "").startswith("video/"):
+                    raise _unavailable()
+                visuals.append(selected[0]["digest"])
+            for output in selected:
+                _, association = self._output(child, attempt, project, output)
+                captures.append(association)
+            children.append({"task_id": child["id"], "ordinal": row["ordinal"], "outputs": outputs})
+        snapshot = {"children": children, "input_object_ids": inputs}
+        stored = self.store._spec(task)
+        if (json.loads(admission["dependency_snapshot_json"]) != snapshot
+                or deps.get("resolved_children") != children or stored.get("input_object_ids") != inputs):
+            raise _mismatch()
+        order = deps["aggregation"].get("order", deps["aggregation"].get("object_ids", inputs))
+        if assembler and order != visuals:
+            raise _mismatch()
+        return {"admission": dict(admission), "snapshot": snapshot, "associations": captures}
+
+    def capture(self, context, pin):
+        validate_pin(pin)
+        request = context["request"]
+        target = pin["admitted_target"]
+        if target != {key: request[key] for key in _TARGET}:
+            raise _unavailable()
+        try:
+            task = self.conn.execute("SELECT t.*, r.project_id FROM tasks t JOIN runs r ON r.id=t.run_id WHERE t.id=?",
+                                     (pin["task_id"],)).fetchone()
+            attempt = self.conn.execute("SELECT * FROM attempts WHERE id=?", (pin["attempt_id"],)).fetchone()
+            if (not task or task["project_id"] != request["project_id"] or not attempt
+                    or attempt["task_id"] != task["id"]):
+                raise _unavailable()
+            if (task["status"] != "completed" or not _current_attempt(task, attempt) or attempt["settled"] != 1
+                    or any(task[column] != pin[key] or attempt[key] != pin[key] for key, column in (
+                        ("executor_id", "executor_id"), ("fence", "lease_fence"), ("runtime_epoch", "runtime_epoch")))):
+                raise _mismatch()
+            stored = self.store._spec(task)
+            spec = stored["spec"]
+            publication = spec["runtime_dependencies"]["publication"]
+            if publication["admitted_target"] != target:
+                raise _unavailable()
+            declared = spec.get("outputs", {}).get("authoring_proposal")
+            if (not isinstance(declared, dict) or declared.get("type") != "file"
+                    or declared.get("artifact_type") != "timeline/authoring-proposal"
+                    or (publication.get("render") is not None and not isinstance(publication["render"], dict))):
+                raise _unavailable()
+            outputs = json.loads(task["result_json"])["outputs"]
+            matches = [item for item in outputs if item.get("name") == "authoring_proposal"]
+            if (len(matches) != 1 or matches[0].get("media_type") != "application/json"
+                    or matches[0].get("output_port", matches[0].get("name")) != "authoring_proposal"):
+                raise _unavailable()
+            output = matches[0]
+            raw, association = self._output(task, attempt, request["project_id"], output, read_bytes=True)
+            proposal = _strict_json(raw)
+            if (not isinstance(proposal, dict) or set(proposal) != {
+                    "schema_version", "producer", "admitted_target", "commands", "rationale", "proposal_digest"}
+                    or type(proposal["schema_version"]) is not int or proposal["schema_version"] != 1
+                    or not isinstance(proposal["producer"], dict) or set(proposal["producer"]) != _PRODUCER
+                    or not isinstance(proposal["commands"], list) or not proposal["commands"]
+                    or not isinstance(proposal["rationale"], str)):
+                raise _mismatch()
+            derived = {**proposal["producer"], "admitted_target": proposal["admitted_target"],
+                       "proposal_digest": proposal["proposal_digest"]}
+            validate_pin(derived)
+            unsigned = {key: value for key, value in proposal.items() if key != "proposal_digest"}
+            encoded = json.dumps(unsigned, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
+            if (derived != pin or "sha256:" + hashlib.sha256(encoded).hexdigest() != pin["proposal_digest"]
+                    or request_pin(request) != pin
+                    or not value_equal(request["commands"][1:], proposal["commands"])
+                    or not value_equal(request.get("rationale"), proposal["rationale"])):
+                raise _mismatch()
+            continuation = self._continuation(task, spec, request["project_id"])
+            run = self.conn.execute("SELECT * FROM runs WHERE id=?", (task["run_id"],)).fetchone()
+            return copy.deepcopy({"pin": pin, "proposal": proposal, "render_intent": publication.get("render"),
+                "artifact": {"descriptor": output, "association": association},
+                "identity": {**{key: context[key] for key in ("realm_id", "publisher", "idempotency_key", "request_hash")},
+                             "project_id": request["project_id"], "timeline_id": request["timeline_id"]},
+                "authority": {"task": dict(task), "attempt": dict(attempt), "run": dict(run), "spec": stored,
+                              "continuation": continuation}})
+        except (KeyError, TypeError, ValueError, UnicodeError, OSError, RecursionError, RuntimeErrorBase) as exc:
+            raise _unavailable() from exc
diff --git a/runtime_protocol/timeline_commit_producer_checkpoint.py b/runtime_protocol/timeline_commit_producer_checkpoint.py
new file mode 100644
index 0000000000000000000000000000000000000000..da5977dd9a560450a30ff03876393bf2d18b0fe3
--- /dev/null
+++ b/runtime_protocol/timeline_commit_producer_checkpoint.py
@@ -0,0 +1,163 @@
+"""One-shot producer consumption and its immutable receipt-to-render handoff.
+
+Authority is captured and verified by the request port. These helpers only run
+under the existing store mutex and acceptance/task-admission transactions.
+"""
+from __future__ import annotations
+
+import copy
+
+from .errors import ConflictError, ProtocolError, ValidationError
+from .timeline_commit_port import digest, refused
+from .util import canonical_json, now
+
+KIND = "timeline.producer.acceptance"
+VERSION = 1
+
+
+def _producer(row):
+    return row["prepared"].get("kind") == KIND and row["prepared"].get("version") == VERSION
+
+
+def check_producer_consumption(store, task_id):
+    """Read only; exact accepted ledger replay must be resolved before this."""
+    row = store.timeline_render_publication(task_id)
+    if row is None:
+        return
+    if _producer(row) and row["result"] and row["result"].get("accepted"):
+        raise refused("producer_proposal_consumed", "producer proposal has already been accepted")
+    raise refused("producer_dependency_unavailable", "producer publication checkpoint is unavailable")
+
+
+def _pending_render(task_id, render, selector):
+    if render is None:
+        return None
+    render = copy.deepcopy(render)
+    if not isinstance(render, dict) or render.get("capability_id") != "rendering.render":
+        raise ValidationError("producer render intent requires rendering.render")
+    spec = render.get("spec")
+    if not isinstance(spec, dict):
+        raise ValidationError("producer render intent requires a task spec")
+    params = spec.setdefault("params", {})
+    if not isinstance(params, dict):
+        raise ValidationError("producer render params must be an object")
+    inputs = spec.get("inputs", {})
+    if not isinstance(inputs, dict):
+        raise ValidationError("producer render inputs must be an object")
+    # The original admission can contain mutable expectations. The handoff
+    # selects the accepted image even when its first dispatch follows C.
+    for location in (params, inputs):
+        for field in ("expected_version", "canonical_head_revision_id", "canonical_occurrence_ids"):
+            location.pop(field, None)
+    params["timeline_ref"] = selector["timeline_id"]
+    params["canonical_revision"] = copy.deepcopy(selector)
+    return {"idempotency_key": "timeline-producer-render-" + task_id,
+            "body": {**render, "project": selector["project_id"], "input_object_ids": render.get("input_object_ids", [])}}
+
+
+def persist_producer_checkpoint(commit_store, context, captures, publication_id, revision_id):
+    if not captures:
+        return
+    store = commit_store.store
+    if not store.conn.in_transaction:
+        raise ProtocolError("producer checkpoint requires the acceptance transaction")
+    accepted = commit_store._lookup(context)
+    if accepted is None or accepted["receipt"]["receipt_id"] != publication_id:
+        raise ProtocolError("producer checkpoint requires its accepted receipt")
+    document = accepted["data"]["canonical_document"]
+    selector = {"project_id": document["project_id"], "timeline_id": document["timeline_id"],
+                "revision_id": revision_id, "publication_id": publication_id,
+                "content_digest": document["parent_revision"]["content_digest"]}
+    if document["parent_revision"]["revision_id"] != revision_id:
+        raise ProtocolError("producer checkpoint revision differs from acceptance")
+    for capture in captures:
+        pin = capture["pin"]
+        check_producer_consumption(store, pin["task_id"])
+        identity = {key: context[key] for key in ("realm_id", "publisher", "idempotency_key", "request_hash")}
+        identity.update({key: context["request"][key] for key in ("project_id", "timeline_id")})
+        if capture["identity"] != identity:
+            raise refused("producer_dependency_unavailable", "producer capture belongs to another request")
+        prepared = {"kind": KIND, "version": VERSION, "pin": pin, "proposal_digest": pin["proposal_digest"],
+                    "identity": identity, "render_intent": capture["render_intent"],
+                    "pending_render": _pending_render(pin["task_id"], capture["render_intent"], selector)}
+        store.prepare_timeline_render_publication(pin["task_id"], pin["attempt_id"], pin["fence"],
+                                                 pin["runtime_epoch"], digest(prepared), prepared)
+        timeline_version = store.conn.execute("SELECT version FROM timelines WHERE project_id=? AND id=?",
+                                              (selector["project_id"], selector["timeline_id"])).fetchone()[0]
+        store.conn.execute(
+            "UPDATE timeline_render_publications SET timeline_id=?, timeline_version=?, result_json=?, updated_at=? "
+            "WHERE authoring_task_id=? AND state='prepared'",
+            (selector["timeline_id"], timeline_version, canonical_json({"accepted": {"receipt": accepted["receipt"], **selector}}),
+             now(), pin["task_id"]),
+        )
+
+
+def validate_pending_render(store, project_id, capability, spec, key, effect, capability_digest, execution_request):
+    """Validate a reserved handoff identity before the freezer can publish CAS."""
+    if not isinstance(key, str) or not key.startswith("timeline-producer-render-"):
+        return None
+    task_id = key.removeprefix("timeline-producer-render-")
+    row = store.timeline_render_publication(task_id)
+    if row is None or not _producer(row) or not row["result"] or not row["result"].get("accepted"):
+        raise ConflictError("producer render checkpoint is unavailable")
+    if row["request_hash"] != digest(row["prepared"]):
+        raise ConflictError("producer render checkpoint identity is corrupt")
+    pending = row["prepared"]["pending_render"]
+    if pending is None:
+        raise ConflictError("producer acceptance has no approved render intent")
+    body = pending["body"]
+    selector = body["spec"]["params"]["canonical_revision"]
+    accepted = row["result"]["accepted"]
+    if ({key: accepted[key] for key in selector} != selector
+            or accepted["receipt"]["receipt_id"] != selector["publication_id"]):
+        raise ConflictError("producer render acceptance identity is corrupt")
+    expected_spec = {"input_object_ids": body.get("input_object_ids", []),
+                     "schema_version": body.get("schema_version", "1"),
+                     "capability_digest": body["capability_digest"], "spec": body["spec"]}
+    for field in ("required_facts", "storage_estimate"):
+        if field in body:
+            expected_spec[field] = body[field]
+    if (key != pending["idempotency_key"] or project_id != body["project"]
+            or capability != body["capability_id"] or capability_digest != body["capability_digest"]
+            or canonical_json(spec) != canonical_json(expected_spec)
+            or canonical_json(effect) != canonical_json(body.get("settlement_effect"))
+            or canonical_json(execution_request) != canonical_json(body.get("execution_request"))):
+        raise ConflictError("producer render admission identity changed")
+    return row
+
+
+def complete_pending_render(store, checkpoint, value, key):
+    if checkpoint is None:
+        return value
+    if not store.conn.in_transaction:
+        raise ProtocolError("producer render link requires the task admission transaction")
+    task, run = value["task"], value["run"]
+    selector = checkpoint["prepared"]["pending_render"]["body"]["spec"]["params"]["canonical_revision"]
+    authority = task["spec"]["spec"].get("inputs", {}).get("timeline_authority", {})
+    if any(authority.get(field) != selector[key] for field, key in (
+            ("project_id", "project_id"), ("timeline_id", "timeline_id"),
+            ("parent_revision_id", "revision_id"), ("publication_id", "publication_id"),
+            ("parent_content_digest", "content_digest"))):
+        raise ConflictError("producer render did not freeze its accepted revision")
+    receipt = store.conn.execute(
+        "SELECT * FROM command_idempotency WHERE command_kind='task.create' AND aggregate_id=? AND idempotency_key=?",
+        (run["project_id"], key),
+    ).fetchone()
+    if receipt is None or receipt["primary_stream_id"] != run["id"] or task["run_id"] != run["id"]:
+        raise ProtocolError("producer render admission receipt is unavailable")
+    locator = {"task_id": task["id"], "run_id": run["id"], "receipt_id": receipt["txn_id"],
+               "idempotency_key": key, "request_hash": receipt["request_hash"]}
+    result = copy.deepcopy(checkpoint["result"])
+    if checkpoint["state"] == "published":
+        if result.get("render") != locator:
+            raise ConflictError("producer render admission link changed")
+        return value
+    result["render"] = locator
+    pin = checkpoint["prepared"]["pin"]
+    store.complete_timeline_render_publication(
+        checkpoint["authoring_task_id"], attempt_id=pin["attempt_id"], fence=pin["fence"],
+        runtime_epoch=pin["runtime_epoch"], timeline_id=result["accepted"]["timeline_id"],
+        timeline_version=checkpoint["timeline_version"],
+        render_task_id=task["id"], render_run_id=run["id"], result=result,
+    )
+    return value
diff --git a/runtime_protocol/timeline_commit_provider.py b/runtime_protocol/timeline_commit_provider.py
new file mode 100644
index 0000000000000000000000000000000000000000..a05812e82ee2930f29e277f260f3329855378932
--- /dev/null
+++ b/runtime_protocol/timeline_commit_provider.py
@@ -0,0 +1,93 @@
+"""The fixed authoring-provider seam used by the Runtime door.
+
+The neutral Runtime deliberately has no dependency on Agent. This module only
+knows the small startup ABI; importing the selected provider is deferred until
+a daemon explicitly opts into the trusted ``astrid`` profile.
+"""
+
+from __future__ import annotations
+
+import importlib
+import inspect
+
+from .contract_metadata import SCHEMA_DIGEST
+from .errors import RuntimeErrorBase, ValidationError
+
+PROVIDER_ID = "astrid-v1"
+INTERFACE_VERSION = 1
+PROVIDER_FACTORY = "astrid.sdk.timeline.commit.create_runtime_commit_service"
+
+
+class TimelineCommitUnavailable(RuntimeErrorBase):
+    """The neutral runtime has no semantic commit provider installed."""
+
+    code = "not_ready"
+    status = 503
+
+    def __init__(self):
+        super().__init__(
+            "timeline commit provider is unavailable",
+            details={"reason": "runtime_unavailable"},
+        )
+
+
+def _synchronous_commit_signature(provider) -> bool:
+    method = getattr(provider, "commit", None)
+    if not callable(method) or inspect.iscoroutinefunction(method):
+        return False
+    try:
+        signature = inspect.signature(method)
+    except (TypeError, ValueError):
+        return False
+    parameters = tuple(signature.parameters.values())
+    if len(parameters) != 2:
+        return False
+    return all(
+        parameter.kind in (
+            inspect.Parameter.POSITIONAL_ONLY,
+            inspect.Parameter.POSITIONAL_OR_KEYWORD,
+        )
+        and parameter.default is inspect.Parameter.empty
+        for parameter in parameters
+    )
+
+
+def validate_timeline_commit_provider(provider):
+    """Validate the exact trusted ABI before authoring readiness is published."""
+    if (
+        type(getattr(provider, "provider_id", None)) is not str
+        or provider.provider_id != PROVIDER_ID
+        or type(getattr(provider, "interface_version", None)) is not int
+        or provider.interface_version != INTERFACE_VERSION
+        or type(getattr(provider, "contract_digest", None)) is not str
+        or provider.contract_digest != SCHEMA_DIGEST
+        or not _synchronous_commit_signature(provider)
+    ):
+        raise ValidationError("timeline commit provider interface/contract mismatch")
+    return provider
+
+
+def load_timeline_commit_provider(authoring_profile):
+    """Load the one trusted provider, or return ``None`` for neutral startup."""
+    if authoring_profile in (None, "neutral"):
+        return None
+    if authoring_profile != "astrid":
+        raise ValueError("unsupported authoring profile")
+
+    # Keep this import entirely behind the explicit profile choice. In
+    # particular, a neutral Runtime process must not import Agent transitively.
+    module = importlib.import_module("astrid.sdk.timeline.commit")
+    factory = getattr(module, "create_runtime_commit_service", None)
+    if not callable(factory) or inspect.iscoroutinefunction(factory):
+        raise ValidationError(f"authoring provider factory is unavailable: {PROVIDER_FACTORY}")
+    try:
+        factory_signature = inspect.signature(factory)
+    except (TypeError, ValueError) as exc:
+        raise ValidationError(f"authoring provider factory signature is unavailable: {PROVIDER_FACTORY}") from exc
+    if factory_signature.parameters:
+        raise ValidationError("authoring provider factory must be zero-argument")
+    try:
+        provider = factory()
+    except TypeError as exc:
+        raise ValidationError("authoring provider factory must be zero-argument") from exc
+    return validate_timeline_commit_provider(provider)
diff --git a/runtime_protocol/timeline_commit_reference_projection.py b/runtime_protocol/timeline_commit_reference_projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..66bdde298ec6ced5a6370f1649fa165c04bc56d0
--- /dev/null
+++ b/runtime_protocol/timeline_commit_reference_projection.py
@@ -0,0 +1,176 @@
+"""Projection of accepted, parent-owned unplaced timeline references.
+
+The Agent owns the namespaced parent carrier.  Runtime only derives the
+existing timeline reference read model after the normal closure has passed.
+"""
+from __future__ import annotations
+
+import json
+import re
+
+from .util import canonical_json, now
+
+_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
+
+
+class ReferenceProjectionError(Exception):
+    """A fail-closed projection refusal that is safe before persistence."""
+
+    def __init__(self, reason, message=None, *, status=409):
+        super().__init__(message or reason)
+        self.reason = reason
+        self.message = message or reason
+        self.status = status
+
+
+def _refuse(reason, message=None, *, status=409):
+    raise ReferenceProjectionError(reason, message, status=status)
+
+
+def _reference_map(document):
+    payload = document["parent_revision"]["payload"]
+    config = payload.get("config", {})
+    if not isinstance(config, dict):
+        _refuse("reference_projection_invalid", "parent config is not an object", status=422)
+    app = config.get("app", {})
+    if not isinstance(app, dict):
+        _refuse("reference_projection_invalid", "parent config app is not an object", status=422)
+    astrid = app.get("astrid", {})
+    if not isinstance(astrid, dict):
+        _refuse("reference_projection_invalid", "parent config astrid is not an object", status=422)
+    references = astrid.get("timeline_references", {})
+    if not isinstance(references, dict):
+        _refuse("reference_projection_invalid", "timeline references are not an object", status=422)
+    return references
+
+
+def _desired(document):
+    manifest = document["dependency_manifest"]["media"]
+    desired = {}
+    for key, value in _reference_map(document).items():
+        if (not isinstance(key, str) or not key or not isinstance(value, dict)
+                or set(value) != {"version", "reference_id", "role", "media"}
+                or type(value["version"]) is not int or value["version"] != 1
+                or value["reference_id"] != key or value["role"] != "source"
+                or not isinstance(value["media"], dict)
+                or set(value["media"]) != {"media_id", "content_digest"}):
+            _refuse("reference_projection_invalid", "timeline reference leaf is malformed", status=422)
+        media = value["media"]
+        if (not isinstance(media["media_id"], str) or not _DIGEST.fullmatch(media["media_id"])
+                or media["content_digest"] != media["media_id"]):
+            _refuse("reference_projection_invalid", "timeline reference media pin is malformed", status=422)
+        if sum(pin == media for pin in manifest) != 1:
+            _refuse("reference_projection_out_of_manifest", "timeline reference media is outside accepted custody")
+        desired[key] = {"reference_id": key, "object_id": media["media_id"], "role": "source"}
+    return desired
+
+
+def _live_rows(connection, project_id, timeline_id):
+    return {
+        row["id"]: {"reference_id": row["id"], "object_id": row["object_id"], "role": row["role"]}
+        for row in connection.execute(
+            "SELECT reference.id, reference.object_id, reference.role "
+            "FROM timeline_references reference JOIN timelines timeline "
+            "ON timeline.id=reference.timeline_id "
+            "WHERE reference.timeline_id=? AND timeline.project_id=?",
+            (timeline_id, project_id),
+        )
+    }
+
+
+def _global_row(connection, reference_id):
+    row = connection.execute(
+        "SELECT reference.timeline_id, timeline.project_id, reference.object_id, reference.role "
+        "FROM timeline_references reference JOIN timelines timeline "
+        "ON timeline.id=reference.timeline_id WHERE reference.id=?",
+        (reference_id,),
+    ).fetchone()
+    if row is None:
+        return None
+    return {"timeline_id": row["timeline_id"], "project_id": row["project_id"],
+            "object_id": row["object_id"], "role": row["role"]}
+
+
+def _same_row(left, right):
+    return left is not None and all(left[key] == right[key] for key in ("reference_id", "object_id", "role"))
+
+
+def prepare_reference_projection(connection, document, previous_document, *, next_version):
+    """Preflight a parent carrier against the previous accepted carrier.
+
+    No database writes occur here.  A previous carrier plus an exact live row
+    is the only ownership proof accepted for an occupied identity or removal.
+    """
+    project_id, timeline_id = document["project_id"], document["timeline_id"]
+    if (previous_document["project_id"], previous_document["timeline_id"]) != (project_id, timeline_id):
+        _refuse("history_unavailable")
+    desired = _desired(document)
+    previous = _desired(previous_document)
+    if not desired and not previous:
+        return None
+    live = _live_rows(connection, project_id, timeline_id)
+
+    for reference in desired.values():
+        reference_id = reference["reference_id"]
+        occupied = _global_row(connection, reference_id)
+        if occupied is None:
+            continue
+        if reference_id not in previous or not _same_row(live.get(reference_id), previous[reference_id]):
+            _refuse("reference_projection_occupied", "timeline reference identity is already occupied")
+        if (occupied["timeline_id"], occupied["project_id"], occupied["object_id"], occupied["role"]) != (
+                timeline_id, project_id, live[reference_id]["object_id"], live[reference_id]["role"]):
+            _refuse("reference_projection_occupied", "timeline reference identity is already occupied")
+
+    removed = sorted(set(previous) - set(desired))
+    for reference_id in removed:
+        current = live.get(reference_id)
+        if current is not None and not _same_row(current, previous[reference_id]):
+            _refuse("reference_projection_occupied", "timeline reference removal is not owned")
+
+    projected = dict(live)
+    for reference_id in removed:
+        projected.pop(reference_id, None)
+    projected.update(desired)
+    references = [projected[key] for key in sorted(projected)]
+    return {"project_id": project_id, "timeline_id": timeline_id, "version": next_version,
+            "desired": desired, "removed": removed, "previous": previous,
+            "references": references}
+
+
+def apply_reference_projection(connection, projection):
+    """Apply a preflighted projection inside the caller's transaction."""
+    project_id, timeline_id = projection["project_id"], projection["timeline_id"]
+    current = connection.execute(
+        "SELECT version FROM timelines WHERE id=? AND project_id=?", (timeline_id, project_id)
+    ).fetchone()
+    if current is None or int(current["version"]) != projection["version"]:
+        _refuse("history_unavailable")
+
+    for reference_id in projection["removed"]:
+        previous = projection["previous"][reference_id]
+        connection.execute(
+            "DELETE FROM timeline_reference_state WHERE id=? AND EXISTS ("
+            "SELECT 1 FROM timeline_references reference JOIN timelines timeline "
+            "ON timeline.id=reference.timeline_id WHERE reference.id=? "
+            "AND reference.timeline_id=? AND timeline.project_id=? "
+            "AND reference.object_id=? AND reference.role=?)",
+            (reference_id, reference_id, timeline_id, project_id, previous["object_id"], previous["role"]),
+        )
+        connection.execute(
+            "DELETE FROM timeline_references WHERE id=? AND timeline_id=? AND object_id=? AND role=?",
+            (reference_id, timeline_id, previous["object_id"], previous["role"]),
+        )
+
+    for reference in projection["desired"].values():
+        connection.execute(
+            "INSERT INTO timeline_references(id, timeline_id, object_id, role) VALUES (?, ?, ?, ?) "
+            "ON CONFLICT(id) DO UPDATE SET timeline_id=excluded.timeline_id, object_id=excluded.object_id, role=excluded.role",
+            (reference["reference_id"], timeline_id, reference["object_id"], reference["role"]),
+        )
+    shots = [{"shot_id": row["id"], "start_ms": row["start_ms"], "duration_ms": row["duration_ms"],
+              "reference_ids": json.loads(row["reference_ids_json"])}
+             for row in connection.execute("SELECT * FROM timeline_shots WHERE timeline_id=?", (timeline_id,))]
+    connection.execute(
+        "INSERT INTO timeline_revisions(timeline_id, version, shots_json, references_json, created_at) VALUES (?, ?, ?, ?, ?)",
+        (timeline_id, projection["version"], canonical_json(shots), canonical_json(projection["references"]), now()),
+    )
