+    guards = {"expected_head": accepted["data"]["accepted_revision_id"],
+              "expected_publication_id": accepted["receipt"]["receipt_id"]}
+    path = route_path(case.project, "tracked", f"composition-revisions/{initial['head_revision_id']}/restore")
+    def restore():
