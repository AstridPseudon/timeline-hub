+@pytest.fixture
+def http_case(tmp_path, actual_provider):
+    root = tmp_path / "realm"
+    service, cases = seed(root, actual_provider)
+    root = service.store.root
+    service.close()
+    daemon = RuntimeDaemon(root, support_root=tmp_path / "support", authoring_profile="astrid").start()
+    try:
