+class RouteHandler(RuntimeHandler):
+    def _identity(self, scope):
+        self.scopes_seen.append(scope)
+        return {"actor": self.identity_actor, "scopes": ["projects:write", "projects:read"]}
+
+    def _send(self, status, payload=None, **kwargs):
