+            lines = [json.loads(line) for line in raw.splitlines()]
+            if len(lines) >= expected_count:
+                return lines
+        if time.monotonic() >= deadline:
+            return [json.loads(line) for line in raw.splitlines()]
+        time.sleep(0.01)
+
