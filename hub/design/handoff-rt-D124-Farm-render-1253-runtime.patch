+    execution_target = {"kind": "machine", "id": "machine-1"}
+    request = {
+        "schema_version": 1,
+        "target": execution_target,
+        "inputs": [descriptor],
+    }
+    task_spec = {
+        "capability_id": CAPABILITY,
+        "kind": "executor",
+        "inputs": {"script": descriptor},
