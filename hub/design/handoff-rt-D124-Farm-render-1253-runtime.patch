+def test_competing_keys_serialize_once_per_task(producer):
+    _settle(producer)
+    barrier = Barrier(2)
+    def accept(key):
+        barrier.wait()
+        try:
+            try:
+                return _execute(producer, key=key)
+            except StaleHead:
