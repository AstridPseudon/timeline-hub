+        def read_object(digest):
+            return (duplicate / "cas" / digest[:2] / digest[2:]).read_bytes()
+        with sqlite3.connect(f"file:{duplicate / 'realm.sqlite3'}?mode=ro", uri=True) as connection:
+            connection.row_factory = sqlite3.Row
