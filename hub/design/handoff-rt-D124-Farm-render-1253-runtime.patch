+    writeFileSync(path.join(root, 'daemon-stdout.txt'), h.runtime.stdout);
+    writeFileSync(path.join(root, 'daemon-stderr.txt'), h.runtime.stderr);
+  }
+  await h.stopRuntime();
+}
