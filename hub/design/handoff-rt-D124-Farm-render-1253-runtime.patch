+    admission = {
+        "project": producer.project,
+        "capability_id": CAPABILITY,
+        "capability_digest": _digest(CAPABILITY.encode()),
+        "input_object_ids": [old_object_id],
+        "spec": task_spec,
+        "execution_request": request,
+        "idempotency_key": "voiceover-script-task",
