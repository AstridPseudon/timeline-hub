+def test_real_door_v2_invalid_patch_has_structured_failure_without_writes(film, agent, tmp_path):
+    world = _start_door(film, tmp_path)
+    try:
+        edit = Editing(world.daemon.service, film, agent)
+        body = _full_v2_auth_body(edit)
