+  bind(connection: OperationConnection): OperationHandle {
+    this.current?.retire();
+    this.current = undefined;
+    if (this.disposed) throw new OperationRetiredError();
+    const handle = new OperationHandle(connection);
+    this.current = handle;
+    return handle;
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    this.current?.retire();
+    this.current = undefined;
+  }
+}
