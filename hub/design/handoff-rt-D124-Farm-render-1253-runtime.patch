+            "SELECT o.digest, o.size, o.media_type FROM objects o "
+            "JOIN project_objects p ON p.digest=o.digest "
+            "WHERE p.project_id=? AND p.relation='managed' AND o.digest=?",
+            (project_id, bare),
+        ).fetchone()
