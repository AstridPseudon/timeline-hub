+def row_for(object_id, size, *, kind="voiceover_script", slot=None):
+    return {"kind": kind, "slot": slot, "media_id": object_id, "content_hash": object_id, "byte_size": size,
+            "mime_type": TEXT_MEDIA_TYPE}
