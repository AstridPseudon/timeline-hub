+        assert refused[0][1]["message"] == "invalid bearer credential"
+        assert refused[1][1]["message"] == "invalid bearer credential"
+        assert refused[2][1]["details"]["scopes"] == ["projects:write"]
+        assert refused[3][1]["details"]["scope"] == "projects:write"
