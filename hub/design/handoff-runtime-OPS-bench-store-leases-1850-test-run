#!/bin/bash
# test-run ID — called by dispatcher-daemon (outside the sandbox) for queue/pending/test-ID. Exit 0 = started in background or served
# from cache, 3 = wait (slot busy / identical run in flight / low disk), 1 = bad request. "test-run --run ID" is the background job.
# Caps: one heavy ("full*") suite at a time, plus up to 2 other runs. Cache key: repo + tree of the worktree (incl. uncommitted
# changes) + suite + files + command. Result: tests/ID/{status,exit,summary,log.txt}; status = queued|running|pass|fail|timeout|error.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
[ "$1" = --lease-body ] && { LEASED=1; RUN=1; shift; }; [ "$1" = --run ] && { RUN=1; shift; }; ID=$1; D=$O/tests/$ID; C=$O/tests/cache
bad() { echo "$*" > $D/summary; echo 1 > $D/exit; echo error > $D/status; echo "$*"; exit 1; }
alive() { for r in $O/tests/*/running; do [ -f "$r" ] && kill -0 $(cat $r) 2>/dev/null && [ "$1" = $( [ -f ${r%running}heavy ] && echo heavy || echo light) ] && echo x; done | wc -l; }
. $D/request 2>/dev/null && { [ -z "$RUN" ] || . $D/snap; } || { echo "no request for $ID"; exit 1; }
case $target in integration:*) W=/home/user/work/$repo;; *) W=$(sed -n 's/^worktree=//p' $O/workers/$target/meta);; esac
if [ ! -d "$W" ] && [ "${target#integration:}" = "$target" ]; then   # recycled worker: recreate a detached worktree from its branch
  git -C /home/user/work/$repo worktree add -q --detach "$W" "tl/$target" 2>/dev/null || git -C /home/user/work/$repo worktree add -q --detach "$W" "hub/tl/$target" 2>/dev/null; fi
[ -d "$W" ] || bad "worktree $W not found (and no tl/$target branch to recreate it from)"
CMD=$(awk -v r=$repo -v s=$suite '$1==r && $2==s {$1=$2=""; sub(/^ +/,""); print; exit}' $O/tests/suites.conf); [ -n "$CMD" ] || bad "suite $suite not in suites.conf for $repo"
BASE_CMD=$CMD
OK='^[A-Za-z0-9_.][]A-Za-z0-9_./@+=:,*?[-]*$' DOTS='(^|/)\.\.(/|$)'; set -f; for f in $files; do [[ $f =~ $OK && ! $f =~ $DOTS ]] || bad "bad file arg $f (relative path/glob/node-id, no ..)"; CMD+=" $f"; done; set +f
HV=light; case $suite in full*) HV=heavy;; esac
if [ -z "$RUN" ]; then
  IDX=$(mktemp); cp "$(git -C $W rev-parse --path-format=absolute --git-path index)" $IDX && GIT_INDEX_FILE=$IDX git -C $W add -A 2>/dev/null
  TREE=$(GIT_INDEX_FILE=$IDX git -C $W write-tree); rm -f $IDX; [ -n "$TREE" ] || bad "could not compute tree of $W"
  # cross-product suites (e2e, journeys, commit-integration, or a command naming another repo) also depend on the
  # other repos' integration code: add their tl/integration heads to the key so a stale pass is never reused
  EXT=""; case "$suite $CMD" in *e2e*|*integration*|*three-products*|*journey*) EXT=x;; esac
  for o in agent runtime app composition; do [ $o != $repo ] && echo "$CMD" | grep -q "/home/user/work/$o" && EXT=x; done
  [ -n "$EXT" ] && EXT=$(for o in agent runtime app composition; do [ $o = $repo ] || echo "$o=$(git -C /home/user/work/$o rev-parse tl/integration 2>/dev/null)"; done | tr '\n' ' ')
  KEY=$(echo "$repo $TREE $suite $files $CMD $EXT" | sha256sum | cut -c1-32); [ -n "$EXT" ] && echo "external=$EXT" >> $D/ext; printf 'tree=%s\nkey=%s\nworktree=%s\n' $TREE $KEY $W > $D/snap
  if [ $nocache = 0 ] && [ -f $C/$KEY ] && SRC=$O/tests/$(cat $C/$KEY) && [ -f $SRC/summary ]; then
    cp $SRC/exit $SRC/log.txt $D/; { echo "CACHE HIT: same tree $TREE already tested by $(basename $SRC); not re-run."; cat $SRC/summary; } > $D/summary
    basename $SRC > $D/cached_from; cp $SRC/status $D/status; echo "cache hit for $ID from $(basename $SRC)"; exit 0; fi
  [ -f $C/$KEY.running ] && kill -0 $(cat $O/tests/$(cat $C/$KEY.running)/running 2>/dev/null) 2>/dev/null && { echo "identical run $(cat $C/$KEY.running) in flight" | tee $D/why; exit 3; }
  [ $HV = heavy ] && [ $(alive heavy) -ge 1 ] && { echo "a full suite is already running" | tee $D/why; exit 3; }
  [ $HV = light ] && [ $(alive light) -ge 3 ] && { echo "3 targeted/named runs already running" | tee $D/why; exit 3; }
  FLOOR=5; [ $HV = heavy ] && FLOOR=8; [ $(df -BG --output=avail /home/user | tail -1 | tr -dc 0-9) -lt $FLOOR ] && { echo "low disk (<${FLOOR}G free; heavy runs need 8G so Runtime storage preflight does not cause false reds)" | tee $D/why; exit 3; }
  [ $HV = heavy ] && touch $D/heavy; echo $ID > $C/$KEY.running; echo running > $D/status; rm -f $D/why
  setsid $0 --run $ID > $D/runner.log 2>&1 < /dev/null & echo $! > $D/running; echo "started test $ID ($suite on $target, tree ${TREE:0:10})"; exit 0
fi
# BENCH-LEASE-BEGIN: acquire before snapshot setup; cache hits return above.
if [ -z "$LEASED" ] && { [ -e /home/user/work/bench-store ] || [ -L /home/user/work/bench-store ]; }; then
  echo $$ > $D/running; SNAP=/home/user/work/wt/.test-$ID; T0=$(date +%s)
  BENCH_RUNNER_PID=$$ python3 -I - "$O" /home/user/work/bench-store "$repo" "$suite" "$BASE_CMD" "$$" "$D/CANCELLED" bash "$0" --lease-body "$ID" <<'BENCH_LEASE_PY'
import ctypes
from contextlib import contextmanager
import importlib.util
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


@contextmanager
def suite_lease(store, repo, suite, command):
    names = store.names_for_suite(repo, suite, command)
    with store.acquire(names) as entries:
        yield entries, [entry['lease_fd'] for entry in entries]


def supervise(store, repo, suite, command, argv, cancelled, parent):
    # Subreaping keeps the lease until orphaned grandchildren finish as well.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        raise OSError(ctypes.get_errno(), "cannot enable child subreaper")
    stopping = False

    def stop(signum, frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if libc.prctl(1, signal.SIGTERM, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
        raise OSError(ctypes.get_errno(), "cannot watch runner death")
    if os.getppid() != parent:
        return 130

    with suite_lease(store, repo, suite, command) as (entries, fds):
        if stopping or cancelled.exists() or os.getppid() != parent:
            return 130
        if not entries:
            # Existing unregistered suites retain their direct-child semantics.
            os.execvpe(argv[0], argv, os.environ)
        read_fd, write_fd = os.pipe2(os.O_CLOEXEC | os.O_NONBLOCK)
        env = dict(os.environ, BENCH_CONTROL_FD=str(write_fd))
        child = subprocess.Popen(argv, env=env, pass_fds=tuple(fds) + (write_fd,), process_group=0)
        os.close(write_fd)
        groups = {child.pid}
        pending = b""
        result = None
        sent = None
        killed = False
        deadline = None
        timed_out = False
        try:
            while True:
                try:
                    pending += os.read(read_fd, 4096)
                except BlockingIOError:
                    pass
                while b"\n" in pending:
                    item, pending = pending.split(b"\n", 1)
                    pid = int(item)
                    if pid <= 1:
                        raise ValueError("bad suite process group")
                    groups.add(pid)
                    deadline = time.monotonic() + 90 * 60
                no_children = False
                while True:
                    try:
                        pid, status = os.waitpid(-1, os.WNOHANG)
                    except ChildProcessError:
                        no_children = True
                        break
                    if not pid:
                        break
                    if pid == child.pid:
                        result = os.waitstatus_to_exitcode(status)
                        child.returncode = result
                if no_children:
                    break
                now = time.monotonic()
                stopping = stopping or cancelled.exists() or os.getppid() != parent
                if deadline is not None and now >= deadline:
                    timed_out = True
                if (stopping or timed_out) and sent is None:
                    sent = now
                    for pgid in groups:
                        try:
                            os.killpg(pgid, signal.SIGTERM)
                        except ProcessLookupError:
                            pass
                if sent is not None and now - sent >= (5 if stopping else 60) and not killed:
                    killed = True
                    for pgid in groups:
                        try:
                            os.killpg(pgid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                time.sleep(0.02)
        finally:
            os.close(read_fd)
        if stopping:
            return 130
        if timed_out:
            return 124
        return result if result >= 0 else 128 - result


def main():
    orch, root, repo, suite, command, parent, cancelled, *argv = sys.argv[1:]
    spec = importlib.util.spec_from_file_location("bench_store", Path(orch) / "bin/bench_store.py")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    store = module.Store(root, Path(orch) / "tests")
    return supervise(store, repo, suite, command, argv, Path(cancelled), int(parent))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"BENCH-LEASE REFUSED: {exc}", file=sys.stderr)
        sys.exit(125)
BENCH_LEASE_PY
  RC=$?
  if [ "$RC" = 125 ]; then
    unlink "$D/running" 2>/dev/null; unlink "$C/$key.running" 2>/dev/null
    bad "managed bench lease refused; see runner.log"
  fi
  [ "$(cat "$D/status")" = error ] && exit "$RC"
else
echo ${BENCH_RUNNER_PID:-$$} > $D/running; SNAP=/home/user/work/wt/.test-$ID; T0=$(date +%s)
COMMIT=$(git -C $W commit-tree $tree -p HEAD -m "test snapshot $ID") && git -C $W worktree add -q --detach $SNAP $COMMIT || { echo 1 > $D/exit; echo error > $D/status; echo "snapshot failed" > $D/summary; rm -f $D/running $C/$key.running; exit 1; }
NM=$W/node_modules; [ -e $NM ] || NM=/home/user/work/app/node_modules; case $repo in app|composition) [ -e $SNAP/node_modules ] || ln -s "$(readlink -f $NM)" $SNAP/node_modules;; esac
# agent: link the worktree's installed Remotion runtime (remotion/node_modules), else the integration checkout's, read-only by convention
if [ $repo = agent ]; then RNM=$W/remotion/node_modules; [ -e $RNM ] || RNM=/home/user/work/agent/remotion/node_modules
  [ -e $RNM ] && [ ! -e $SNAP/remotion/node_modules ] && mkdir -p $SNAP/remotion && ln -s "$(readlink -f $RNM)" $SNAP/remotion/node_modules; fi
if [ -n "$BENCH_CONTROL_FD" ]; then
  ( exec {BENCH_CONTROL_FD}>&-; cd $SNAP && PYTHONPATH=$SNAP exec timeout -k 60 90m nice -n 5 bash -c "$CMD" ) > $D/log.txt 2>&1 < /dev/null &
  SUITE_PID=$!; printf '%s\n' "$SUITE_PID" >&"$BENCH_CONTROL_FD"; exec {BENCH_CONTROL_FD}>&-
  wait "$SUITE_PID"; RC=$?
else
( cd $SNAP && PYTHONPATH=$SNAP timeout -k 60 90m nice -n 5 bash -c "$CMD" ) > $D/log.txt 2>&1 < /dev/null; RC=$?
fi
[ -n "$LEASED" ] && exit "$RC"
fi
# BENCH-LEASE-END
git -C $W worktree remove --force $SNAP 2>/dev/null || { rm -rf $SNAP; git -C $W worktree prune; }
ST=fail; [ $RC = 0 ] && ST=pass; [ $RC = 124 -o $RC = 137 ] && ST=timeout
{ echo "test $ID: $ST exit=$RC in $(( $(date +%s) - T0 ))s — $suite on $target ($repo tree $tree)"; echo "cmd: $CMD"
  echo "counts: $(grep -aE '[0-9]+ (passed|failed)|Tests +[0-9]|^# (pass|fail) ' $D/log.txt | tail -3 | tr '\n' ' ')"; echo "--- last 60 lines of $D/log.txt ---"; tail -60 $D/log.txt; } > $D/summary
# zero executed tests is never a pass (2026-10-21 audit: "No tests found" runs)
[ $RC = 0 ] && grep -aqiE 'No tests found|No test files found|collected 0 items|^# tests 0$|Tests +0 passed \(0\)' $D/log.txt && { ST=fail; RC=1; sed -i "1i ZERO-TESTS: the runner executed no tests; recorded as fail." $D/summary; }
# exit/log mismatch (2026-10-21, false-green 4657): exit 0 but the runner's own summary reports failures. Flag it at the top of the
# summary and never cache it; the owner confirms it (an authorized expected-failure wrapper) or withdraws it (request-stop-test --withdraw).
MM=$([ $RC = 0 ] && grep -aoE '(^|[^0-9])[1-9][0-9]* failed\b|# fail [1-9][0-9]*' $D/log.txt | tail -1)
[ -n "$MM" ] && { echo "$(date -u +%FT%TZ) exit 0 but log reports: $MM" > $D/EXIT-MISMATCH; sed -i "1i EXIT-MISMATCH: exit 0 but the log reports '$MM'. Not cached. Confirm it is an authorized expected-failure run, or withdraw it." $D/summary; }
[ -f $D/CANCELLED ] && { ST=cancelled; RC=130; }   # stopped by request-stop-test: never a result, never cached
echo $RC > $D/exit; echo $ST > $D/status; [ $RC = 0 -o $RC = 1 ] && [ ! -f $D/EXIT-MISMATCH ] && echo $ID > $C/$key; rm -f $D/running $C/$key.running
