+class FailedHelper extends EventEmitter {
+  stdin = new PassThrough();
+  stdout = new PassThrough();
+  stderr = new PassThrough();
+  closed = false;
+
+  constructor() {
+    super();
+    this.stdin.on('finish', () => {
+      this.closed = true;
+      this.stdout.end();
+      this.stderr.end();
+      setImmediate(() => this.emit('close', 1));
+    });
+  }
+
+  kill(): boolean {
+    this.closed = true;
+    this.stdout.end();
+    this.stderr.end();
+    setImmediate(() => this.emit('close', null));
+    return true;
+  }
+}
