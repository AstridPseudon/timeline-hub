+def parse_extra(value):
+    """Parse one destination=source input for an existing delivery staging tree."""
+    destination, separator, source = value.partition("=")
+    if not separator or not destination or not source:
+        raise ValueError("--extra must be DESTINATION=SOURCE")
+    if "\\" in destination:
+        raise ValueError("--extra destination must use POSIX separators")
+    path = PurePosixPath(destination)
+    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
+        raise ValueError("--extra destination must stay below the delivery root")
+    source_path = os.path.expanduser(source)
+    if os.path.islink(source_path) or not os.path.isfile(source_path):
+        raise ValueError(f"--extra source must be a regular non-symlink file: {source}")
+    return path.as_posix(), os.path.realpath(source_path)
+
+
+def add_extras(staging, values):
+    """Copy explicitly named, regular files into the normal delivery staging tree."""
+    for value in values:
+        destination, source = parse_extra(value)
+        target = os.path.join(staging, *PurePosixPath(destination).parts)
+        if os.path.lexists(target):
+            raise ValueError(f"--extra destination already exists: {destination}")
+        os.makedirs(os.path.dirname(target), exist_ok=True)
+        shutil.copyfile(source, target)
+
+
