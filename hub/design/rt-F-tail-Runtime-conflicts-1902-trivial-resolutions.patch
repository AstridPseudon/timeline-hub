           cache: pip
       - run: python -m pip install -e '.[test]'
       - run: python -m pip install -e packages/python
+      - name: Enable native Windows filesystem qualification
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          fsutil 8dot3name set 0
+          if ($LASTEXITCODE -ne 0) { throw 'Cannot enable 8.3 aliases for qualification' }
+          $root = Join-Path $env:RUNNER_TEMP 'astrid-unc-qualification'
+          New-Item -ItemType Directory -Force -Path $root | Out-Null
+          $account = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
+          New-SmbShare -Name AstridRuntimeCI -Path $root -FullAccess $account | Out-Null
+          'ASTRID_TEST_UNC_ROOT=\\localhost\AstridRuntimeCI' >> $env:GITHUB_ENV
