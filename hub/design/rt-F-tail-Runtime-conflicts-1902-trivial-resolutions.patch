           tests/test_native_custody.py
           tests/test_portable_lifecycle.py
+      - name: Remove native Windows qualification share
+        if: always() && runner.os == 'Windows'
+        shell: pwsh
+        run: Remove-SmbShare -Name AstridRuntimeCI -Force -ErrorAction SilentlyContinue
+
+  windows-worker-handoff:
+    # Keep native IPC qualification independently required.
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+          cache: pip
+      - run: python -m pip install -e '.[test]'
+      - name: Qualify authenticated handoff and strict-network inherited channels
