@@ -0,0 +1,43 @@
+"""Pure path-budget checks for invocation-scoped Remotion scratch."""
+
+import os
+import stat
+import tempfile
+from pathlib import Path
+
+from astrid.packs.rendering.rendering.renderers.remotion.root_preparation import (
+    _render_temp_parent,
+)
+
+
+def test_private_tmpdir_bounds_chrome_singleton_socket_without_changing_attempt_parent(
+    tmp_path: Path, monkeypatch,
+) -> None:
+    with tempfile.TemporaryDirectory(prefix="tl-", dir="/tmp") as private_text:
+        private_tmp = Path(private_text)
+        private_tmp.chmod(0o700)
+        staging_parent = tmp_path / ("attempt-" + "x" * 120)
+        staging_parent.mkdir()
+        monkeypatch.setenv("TMPDIR", str(private_tmp))
+
+        selected = _render_temp_parent(staging_parent)
+        socket_path = (
+            selected / ".remotion-runtime-9x9u2k0m"
+            / "com.google.Chrome.12345678901234567890" / "SingletonSocket"
+        )
+
+        assert selected == private_tmp
+        assert len(os.fsencode(socket_path)) < 108
+        assert staging_parent.is_dir()
+        assert stat.S_IMODE(private_tmp.stat().st_mode) & 0o077 == 0
+
+
+def test_shared_tmpdir_falls_back_to_attempt_parent(tmp_path: Path, monkeypatch) -> None:
+    shared_tmp = tmp_path / "shared"
+    shared_tmp.mkdir(mode=0o777)
+    shared_tmp.chmod(0o1777)
+    staging_parent = tmp_path / "attempt"
+    staging_parent.mkdir()
+    monkeypatch.setenv("TMPDIR", str(shared_tmp))
+
+    assert _render_temp_parent(staging_parent) == staging_parent
