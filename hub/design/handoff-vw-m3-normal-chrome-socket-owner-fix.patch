+def _render_temp_parent(staging_parent: Path) -> Path:
+    """Select an admitted private parent for browser-backed render scratch.
+
+    The task's ``TMPDIR`` is already part of the host-selected Node
+    environment.  A private directory there keeps Chromium's Unix socket
+    below its platform path limit without moving outputs or authority out of
+    the assigned attempt.  Unqualified, symlinked, foreign-owned, and shared
+    temporary directories retain the existing attempt-local behavior.
+    """
+    raw = os.environ.get("TMPDIR")
+    if not raw:
+        return staging_parent
+    candidate = Path(raw).expanduser()
+    if not candidate.is_absolute() or candidate.is_symlink():
+        return staging_parent
+    try:
+        resolved = candidate.resolve(strict=True)
+        facts = resolved.stat()
+    except OSError:
+        return staging_parent
+    mode = stat.S_IMODE(facts.st_mode)
+    if (resolved != candidate or not resolved.is_dir()
+            or facts.st_uid != os.getuid() or mode & 0o077):
+        return staging_parent
+    return resolved
+
