-  const height = numberOrUndefined(clip.height);
-  const hasBounds =
-    x !== undefined || y !== undefined || width !== undefined || height !== undefined;
-  const fontSize = numberOrUndefined(params.fontSize) ?? (hasBounds ? 32 : 64);
