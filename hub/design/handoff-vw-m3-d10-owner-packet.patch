-};
-
-const numberOrUndefined = (value: unknown): number | undefined => {
-  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;
-};
-
-const clamp01 = (value: number): number => Math.max(0, Math.min(1, value));
