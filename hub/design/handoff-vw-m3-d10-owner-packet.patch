-  const clip = props.clip as {
-    x?: unknown;
-    y?: unknown;
-    width?: unknown;
-    height?: unknown;
-    hold?: unknown;
-    from?: unknown;
-    to?: unknown;
-    speed?: unknown;
-  };
-  const x = numberOrUndefined(clip.x);
