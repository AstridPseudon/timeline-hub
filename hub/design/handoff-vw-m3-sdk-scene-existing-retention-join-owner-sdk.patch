+                raise ValueError("scene check requires the normal Timeline Root")
+            profile = backend._canonical_profile(timeline, backend._load_registry_mapping(assets), settings.theme_path)
+            fps = profile.fps_rational[0] / profile.fps_rational[1]
+            if fps != self.fps:
