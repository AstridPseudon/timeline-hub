+"""Unapplied owner proposal with real compiler, materializer, Root and public Node.
+
+Runtime admission/read transport and renderer admission/port selection are doubles;
+no pixels, sockets, publication or live Runtime qualification is claimed.
+"""
+import copy
+import hashlib
+import json
+from dataclasses import replace
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from astrid.core.execution.generic_host import GenericPackHost
+from astrid.core.rendering.contracts import RenderRequest
+from astrid.core.rendering.verified_source import SOURCE_ENV
+from astrid.core.timeline import scene_answers
+from astrid.core.timeline.authoring_bundle import (
+    _digest,
+    open_authoring_bundle,
+    preview_authoring_candidate,
+)
+from astrid.packs.rendering.rendering.renderers.remotion import run
+from astrid.sdk.timeline_checkout import Checkout
+from astrid.sdk.timeline_filmstrip import prepare_filmstrip
+from tests.packs.rendering import test_scene_host as host_fixture
+from tests.packs.rendering.test_scene_source_carry import Revisions
+
+host_project = host_fixture.host_project
+native_host = host_fixture.native_host
+
+
+def source(tmp_path, monkeypatch, project, *, working=False):
+    from astrid.packs.rendering.actions.render import managed_timeline
+    # Empty media registry: no media admission or loopback server is necessary.
+    monkeypatch.setattr(managed_timeline, '_runtime_snapshot_registry', lambda registry, **kwargs: registry)
+    client = Revisions('text-card')
+    client.list_timelines = lambda *a, **kw: [[{'project_id': 'p', 'timeline_id': 'tl', 'slug': 'cut', 'head_revision_id': 'late-head'}], None]
+    client.internal['payload']['clips'] = client.internal['payload']['clips'][:1]
+    client.internal['content_digest'] = _digest(client.internal['payload'])
+    original_parent = client.get_project_parent_composition_revision
+    original_shot = client.get_project_shot_revision
+
+    def parent(*args):
+        row = original_parent(*args)
+        row['payload']['occurrences'] = row['payload']['occurrences'][:1]
+        row['content_digest'] = _digest(row['payload'])
+        return row
+
+    def shot(*args):
+        row = original_shot(*args)
+        row['project_id'] = 'p'
+        row['content_digest'] = _digest(row['payload'])
+        return row
+
+    client.get_project_parent_composition_revision = parent
+    client.get_project_shot_revision = shot
+    bundle = open_authoring_bundle(parent('p', 'tl', 'parent:old'),
+        shot_revisions=[shot('p', 's', 'shot:old')], internal_timeline_revisions=[client.internal])
+    canonical = copy.deepcopy(bundle)
+    reads = []
+
+    def open_bundle(project, timeline, *, revision_id):
+        reads.append((project, timeline, revision_id))
+        assert (project, timeline, revision_id) == ('p', 'tl', 'parent:old')
+        return SimpleNamespace(ok=True, data={'bundle': copy.deepcopy(canonical)})
+
+    client.timelines = SimpleNamespace(open_bundle=open_bundle)
+    checkout = Checkout(bundle)
+    if working:
+        checkout.clips()[0].data['params']['content'] = 'Unpublished retained title'
+    checkout.resolve()
+    inputs = {'composed_capture': True, 'timeline_ref': 'tl'}
+    if working:
+        inputs['authoring_preview'] = preview_authoring_candidate(checkout.stored_document())
+    else:
+        inputs['revision_id'] = 'parent:old'
+    snapshot = prepare_filmstrip(inputs, project='p', client=client)['capture_snapshot']
+    authority = snapshot['metadata']['capture_authority']
+    ref = {'source_kind': 'working_copy' if working else 'revision', 'project_id': 'p', 'timeline_id': 'tl',
+           'revision_id': authority['parent_revision_id'], 'revision_digest': authority['parent_content_digest']}
+    if working:
+        marker = snapshot['metadata']['working_copy']
+        ref.update(revision_digest=marker['candidate_digest'], working_copy={
+            'candidate_digest': marker['candidate_digest'], 'publication_digest': marker['publication_digest'],
+            'base_revision_id': marker['base_parent']['revision_id'],
+            'base_revision_digest': marker['base_parent']['content_digest']})
+    payload = json.dumps(snapshot, sort_keys=True, separators=(',', ':')).encode()
+    digest = hashlib.sha256(payload).hexdigest()
+    ref['digest'] = 'sha256:' + digest
+    claim = {'input_object_ids': [digest], 'authority_context': {'capture_snapshot_ref': ref},
+             'spec': {'inputs': {'filmstrip_authority': json.dumps({'capture_snapshot_ref': ref})}}}
+    host = GenericPackHost(pack_roots=[tmp_path], client=SimpleNamespace(get_object=lambda key: payload if key == digest else None))
+    workspace = tmp_path / 'attempt'
+    retained = host._materialize_inputs(claim, workspace)
+    env = {}
+    retained.handoff_source(retained, env)
+    monkeypatch.setenv(SOURCE_ENV, env[SOURCE_ENV])
+    request = RenderRequest(schema_version=1, timeline_path=retained['timeline'],
+        assets_registry_path=retained['assets_registry'], output_name='unused.mp4',
+        backend_config={'rendering.remotion': {'project_dir': str(project)}})
+    checkout._scene_inputs = (request, workspace, client)
+    return checkout, request, workspace, snapshot, reads
