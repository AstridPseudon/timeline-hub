+                    timeline, assets, range(end), staged_video=scratch / "unused.mp4",
+                    provenance_out_path=scratch / "unused.json", project_dir=settings.project_dir,
+                    composition_id=settings.composition_id, theme_path=settings.theme_path,
+                    min_free_gb=settings.min_free_gb, frame_output_dir=scratch / "frames",
+                    materialized_root=Path(request.materialized_root) if request.materialized_root else None,
+                    materialized_objects=request.materialized_objects, staging_parent=scratch,
+                    review=json.loads(request.metadata["review"]) if "review" in request.metadata else None,
+                )
