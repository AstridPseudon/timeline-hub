+@pytest.mark.parametrize('working', [False, True])
+def test_public_check_queries_registered_node_inside_exact_root(tmp_path, monkeypatch, root, working):
+    checkout, request, workspace, snapshot, reads = source(tmp_path, monkeypatch, root, working=working)
+    adapted = segment_request(request, workspace)
+    assert adapted.timeline_path != request.timeline_path and adapted.window is None
+    from contextlib import contextmanager
+
+    from astrid.packs.rendering.rendering.renderers.remotion import root_preparation
+    prepare = root_preparation._prepared_remotion_root
+    query = scene_answers.host_frames_at
+    observed = []
+    active = []
+
+    @contextmanager
+    def retained_root(*args, **kwargs):
+        assert args[:2] == (Path(request.timeline_path), Path(request.assets_registry_path))
+        with prepare(*args, **kwargs) as prepared:
+            active.append(prepared)
+            yield prepared
+            active.pop()
+        assert not prepared[1].exists()
+        assert not prepared[9].exists()
+
+    def observe(props, basis, frames):
+        assert active and props is active[0][0]
+        assert active[0][1].is_file()
+        assert props['timeline']['clips'][0]['id'] == snapshot['config']['clips'][0]['id']
+        answers = query(props, basis, frames)
+        observed.append((copy.deepcopy(props), answers))
+        return answers
+
+    monkeypatch.setattr(root_preparation, '_prepared_remotion_root', retained_root)
+    monkeypatch.setattr(scene_answers, 'host_frames_at', observe)
+    report = checkout.check()
+    assert observed, report.problems
+    props, answers = observed[0]
+    assert props['theme']['visual']['canvas']['width'] == 200
+    assert [row['frame'] for row in answers] == list(range(24))
+    assert answers[0]['layers'][0]['clipId'] == 'opaque:occ:A:opaque:source:title'
+    assert answers[0]['layers'][0]['role'] == 'content'
+    assert not any('UNAVAILABLE' in line for line in report.problems)
+    assert any('UNKNOWN' in line for line in report.problems)
+    assert report.valid and not report.blocking
+    assert bool(reads) == (not working)
+    assert not list(workspace.glob('scene-check-*'))
+
