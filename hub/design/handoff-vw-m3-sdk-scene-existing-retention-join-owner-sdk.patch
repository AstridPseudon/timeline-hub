+def segment_request(request, workspace):
+    from astrid.core.rendering.contracts import FrameWindow
+    from astrid.core.rendering.service import RenderService
+
+    adapted, _ = RenderService._segment_request(object.__new__(RenderService), request,
+        candidate=SimpleNamespace(id='fixture', manifest=SimpleNamespace(capabilities={'supports_windows': False})),
+        segment=SimpleNamespace(window=FrameWindow(start_frame=6, end_frame=18, fps_rational=(24, 1)), layer=None),
+        index=0, workspace=workspace)
+    return adapted
