+        request = replace(request, window=FrameWindow(start_frame=0, end_frame=12, fps_rational=(24, 1)))
+    checkout._scene_inputs = (request, workspace, checkout._scene_inputs[2])
+    monkeypatch.setattr(scene_answers, 'host_frames_at', lambda *a: pytest.fail('unbound query'))
+    report = checkout.check()
+    assert any('UNAVAILABLE' in line for line in report.problems), report.problems
+    assert not any('picture ' in line or 'EMPTY' in line for line in report.problems)
