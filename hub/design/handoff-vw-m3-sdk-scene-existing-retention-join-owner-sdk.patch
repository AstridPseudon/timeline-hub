+        from astrid.packs.rendering.rendering.renderers.remotion import run as backend
+        from astrid.sdk.timeline_filmstrip import prepare_filmstrip
+
+        end = int(round(self.duration * self.fps))
+        try:
+            # Keep the original service request: a segment/layer derivative is
+            # not the full revision that this Checkout diagnoses.
+            if request.window is not None or request.profile is not None:
+                raise ValueError("scene check requires the original full composition request")
+            timeline = backend._input_path(request.timeline_path, workspace)
+            assets = backend._input_path(request.assets_registry_path, workspace)
+            source = inherited_source(timeline, assets)
+            if source is None:
+                raise ValueError("exact retained Runtime source required")
+            ref = source.read()["ref"]
+            if (ref["project_id"], ref["timeline_id"]) != (self.bundle["project_id"], self.bundle["timeline_id"]):
+                raise ValueError("checkout scope differs from retained source")
+            inputs = {"composed_capture": True, "timeline_ref": ref["timeline_id"]}
+            if ref["source_kind"] == "working_copy":
+                preview = preview_authoring_candidate(self.stored_document())
+                if (preview["candidate_digest"] != ref["working_copy"]["candidate_digest"]
+                        or preview["publication_digest"] != ref["working_copy"]["publication_digest"]):
+                    raise ValueError("checkout candidate differs from retained source")
+                inputs["authoring_preview"] = preview
+            else:
+                saved = type(self).open(ref["project_id"], ref["timeline_id"],
+                                        revision_id=ref["revision_id"], client=client)
+                saved.resolve()
+                if _digest(self.stored_document()) != _digest(saved.stored_document()):
+                    raise ValueError("checkout differs from exact Runtime saved closure")
+                inputs["revision_id"] = ref["revision_id"]
+            snapshot = prepare_filmstrip(inputs, project=ref["project_id"], client=client)["capture_snapshot"]
+            source.validate_snapshot(snapshot)
