+@pytest.mark.parametrize('damage', ['candidate', 'saved-edit', 'saved-base-forgery', 'timeline', 'registry',
+                                  'binding', 'equal-path', 'missing-source', 'foreign', 'window', 'segment'])
+def test_stale_or_forged_source_is_advisory_and_never_queries(tmp_path, monkeypatch, root, damage):
+    working = damage == 'candidate'
+    checkout, request, workspace, _, _ = source(tmp_path, monkeypatch, root, working=working)
+    if damage in {'candidate', 'saved-edit', 'saved-base-forgery'}:
+        checkout.clips()[0].data['params']['content'] = 'later title'
+        if damage == 'saved-base-forgery':
+            for shot in checkout.bundle['shots'].values():
+                shot['base_internal_timeline'] = copy.deepcopy(shot['internal_timeline'])
+    elif damage in {'timeline', 'registry'}:
+        Path(request.timeline_path if damage == 'timeline' else request.assets_registry_path).write_text('{}')
+    elif damage == 'binding':
+        import os
+        Path(json.loads(os.environ[SOURCE_ENV])[0]).write_text('{}')
+    elif damage == 'missing-source':
+        monkeypatch.delenv(SOURCE_ENV)
+    elif damage == 'equal-path':
+        other = workspace / 'same-bytes.json'
+        other.write_bytes(Path(request.timeline_path).read_bytes())
