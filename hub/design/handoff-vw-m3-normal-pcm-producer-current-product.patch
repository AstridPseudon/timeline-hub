+++ b/astrid/packs/rendering/rendering/renderers/remotion/normal_audio.py
@@ -0,0 +1,114 @@
+"""Inactive PCM preparation inside the existing render lock/asset lifetime.
+
+The source owner must validate the actual compiled input pair before calling.
+This module neither admits a source nor activates the normal rendering path.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+from astrid.core.rendering.assets import AssetMaterializer, AssetURLResolver
+from astrid.core.rendering.remotion_runtime import RemotionRuntimeTools, probe_context
+
+
+def prepare_normal_audio_sources(
+    props: Mapping[str, Any], *, materializer: AssetMaterializer,
+    asset_server: AssetURLResolver, attempt_directory: Path,
+    project_dir: Path, runtime_tools: RemotionRuntimeTools,
+    original_clips: Mapping[str, Mapping[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """Copy Root props and prepare each audio clip from its managed original.
+
+    ``original_clips`` maps current clip IDs to original compiled occurrences,
+    retained by the trusted source owner before a window/track transform. It is
+    internal input, not authority. Never construct it from caller app metadata.
+    The owner must thread this seam through source validation and serialization
+    before activating window/layer rendering. Omitting it is for unsliced input.
+
+    The caller owns an attempt directory under materializer.serving_root and
+    keeps it and the server alive through consumption, usually via ExitStack.
+    Successful WAVs live there until caller cleanup; failed batches remove only
+    their own directory. Authored files and the original registry are untouched.
+    """
+    def encode(value: Any) -> str:
+        return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+    expected = materializer.resolved_registry(asset_server)
+    if encode(props["assets"]) != encode(expected):
+        raise ValueError("audio Root registry differs from materialized source")
+    tracks = {row["id"] for row in props["timeline"]["tracks"] if row["kind"] == "audio"}
+    indexed = []
+    for index, clip in enumerate(props["timeline"]["clips"]):
+        if "render_source" in (clip.get("audio") or {}):
+            raise ValueError("audio source already prepared")
+        if clip.get("track") in tracks:
+            indexed.append((index, clip))
+    if not indexed:
+        return copy.deepcopy(dict(props))
+    project = project_dir.resolve(strict=True)
+    helper = (project / "normal-audio-sources.mjs").resolve(strict=True)
+    helper.relative_to(project)
+    attempt = attempt_directory.resolve(strict=True)
+    attempt.relative_to(materializer.serving_root)
+    clips = []
+    for _, clip in indexed:
+        asset = materializer.assets[clip["asset"]]
+        if asset.local_path is None:
+            raise ValueError("audio source has no verified materialized path")
+        # Recheck the selected bytes, including reused runtime materializations.
+        metadata = asset.metadata
+        digest = (metadata.get("digest") or metadata.get("content_sha256")
+                  or metadata.get("sha256") or metadata.get("hash"))
+        with asset.local_path.open("rb") as source:
+            if hashlib.file_digest(source, "sha256").hexdigest() != digest.removeprefix("sha256:"):
+                raise ValueError("audio managed source failed integrity check")
+        row = {"clip": clip, "source": str(asset.local_path)}
+        if original_clips is not None:
+            row["originalClip"] = original_clips[clip["id"]]
+        clips.append(row)
+    environment = probe_context(environment=os.environ, python_executable=sys.executable)["node_env"]
+    directory = Path(tempfile.mkdtemp(prefix="normal-audio-", dir=attempt))
+    try:
+        result = subprocess.run(
+            [str(runtime_tools.node_executable), str(helper)],
+            input=json.dumps({"clips": clips, "fps": props["compiledTransitions"]["fps"],
+                              "attemptDirectory": str(directory)}, allow_nan=False),
+            cwd=project, env=environment, capture_output=True, text=True, timeout=30, check=False,
+        )
+        if result.returncode:
+            raise RuntimeError(result.stderr.strip() or "audio PCM preparation unavailable")
+        prepared = json.loads(result.stdout)
+        if not isinstance(prepared, list) or len(prepared) != len(indexed):
+            raise ValueError("invalid audio PCM preparation response")
+        output = copy.deepcopy(dict(props))
+        for (index, _), row in zip(indexed, prepared):
+            if row is None:
+                continue
+            if set(row) != {"path", "envelope_key", "source_from", "playback_rate", "envelope"}:
+                raise ValueError("invalid audio PCM preparation fields")
+            path = Path(row["path"]).resolve(strict=True)
+            path.relative_to(directory)
+            clip = output["timeline"]["clips"][index]
+            audio = clip.setdefault("audio", {})
+            audio["envelope"] = row["envelope"]
+            audio["render_source"] = {
+                "file": asset_server.local_url(path),
+                **{key: row[key] for key in ("envelope_key", "source_from", "playback_rate")},
+            }
+        if not any(row is not None for row in prepared):
+            shutil.rmtree(directory)
+        return output
+    except BaseException:
+        shutil.rmtree(directory)
+        raise
diff --git a/remotion/attempt-envelope-pcm.mjs b/remotion/attempt-envelope-pcm.mjs
new file mode 100644
index 000000000..4c99b9e6e
--- /dev/null
+++ b/remotion/attempt-envelope-pcm.mjs
@@ -0,0 +1,114 @@
+import {execFileSync} from 'node:child_process';
+import {closeSync, mkdtempSync, openSync, readSync, rmSync, statSync, writeFileSync} from 'node:fs';
+import path from 'node:path';
+import {
+  applyAudioEnvelope, audioEnvelopeWav, compileAudioEnvelope,
+} from '@banodoco/timeline-composition/evaluation';
+
+// Inactive preparation kernel. The caller supplies the compiled clip's public
+// source clock, using compiledAudioSourceClock from the public trim/rate helpers.
+// Never pass a previously prepared source or persist these results as authored data.
+export const prepareAttemptEnvelopePcm = ({
+  clip, fps, source, attemptDirectory, sourceClock,
+}) => {
+  if (clip.audio?.render_source !== undefined) throw new Error('source already prepared');
+  const envelope = compileAudioEnvelope(clip, fps);
+  if (!envelope) return undefined;
+  if (!sourceClock || !Number.isFinite(sourceClock.source_from)
+    || sourceClock.source_from < 0 || !Number.isFinite(sourceClock.playback_rate)
+    || sourceClock.playback_rate <= 0) throw new Error('public source clock required');
+  if (!path.isAbsolute(source) || !statSync(source).isFile()
+    || !path.isAbsolute(attemptDirectory) || !statSync(attemptDirectory).isDirectory()) {
+    throw new Error('local source and attempt directory required');
+  }
+  const run = (program, args, maxBuffer) => execFileSync(program, args, {
+    maxBuffer, timeout: 30000, stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  const probe = JSON.parse(run('ffprobe', [
+    '-v', 'error', '-protocol_whitelist', 'file,pipe', '-select_streams', 'a:0',
+    '-show_entries', 'format=format_name,start_time:stream=codec_name,sample_rate,channels,time_base,start_pts,start_time', '-of', 'json', source,
+  ], 64 * 1024).toString());
+  const stream = probe.streams?.[0];
+  const sampleRate = Number(stream?.sample_rate), count = stream?.channels;
+  if (!Number.isSafeInteger(sampleRate) || sampleRate <= 0
+    || !Number.isSafeInteger(count) || count <= 0) {
+    throw new Error('source PCM clock cannot be retained');
+  }
+  if (stream.start_time !== undefined && Number(stream.start_time) !== 0) {
+    // MP3 demuxer start includes encoder/decoder priming, already removed by
+    // native FFmpeg. Require packet skip + exact presentation ticks, not a
+    // codec name or rounded decimal start alone. No sample/clock adjustment.
+    let gaplessOrigin = false;
+    if (stream.codec_name === 'mp3' && probe.format?.format_name === 'mp3') {
+      const packets = JSON.parse(run('ffprobe', [
+        '-v', 'error', '-protocol_whitelist', 'file,pipe', '-select_streams', 'a:0',
+        '-read_intervals', '%+#1', '-show_packets', '-show_entries',
+        'packet=pts,dts:packet_side_data=side_data_type,skip_samples,discard_padding,skip_reason,discard_reason',
+        '-of', 'json', source,
+      ], 64 * 1024).toString());
+      const packet = packets.packets?.[0];
+      const skip = packet?.side_data_list?.find(data => data.side_data_type === 'Skip Samples');
+      const base = /^(\d+)\/(\d+)$/.exec(stream.time_base ?? '');
+      if (packet?.pts === 0 && packet.dts === 0
+        && Number.isSafeInteger(skip?.skip_samples) && skip.skip_samples > 0
+        && skip.skip_reason === 0 && skip.discard_reason === 0
+        && skip.discard_padding === 0
+        && Number.isSafeInteger(stream.start_pts) && stream.start_pts > 0
+        && base && BigInt(base[1]) > 0n && BigInt(base[2]) > 0n) {
+        gaplessOrigin = BigInt(stream.start_pts) * BigInt(base[1]) * BigInt(sampleRate)
+          === BigInt(skip.skip_samples) * BigInt(base[2]);
+      }
+    }
+    if (!gaplessOrigin) throw new Error('source PCM clock cannot be retained');
+  }
+  const directory = mkdtempSync(path.join(attemptDirectory, 'envelope-'));
+  try {
+    // File-backed subprocess stdout avoids retaining/capping the decoded pipe.
+    // Public apply/WAV still need whole-source arrays: this is NOT bounded RAM.
+    const decoded = path.join(directory, 'decoded.f32');
+    const fd = openSync(decoded, 'wx+');
+    let channels;
+    try {
+      execFileSync('ffmpeg', [
+        '-v', 'error', '-nostdin', '-protocol_whitelist', 'file,pipe', '-i', source,
+        '-map', '0:a:0', '-threads', '1', '-c:a', 'pcm_f32le', '-f', 'f32le', 'pipe:1',
+      ], {maxBuffer: 64 * 1024, timeout: 30000, stdio: ['ignore', fd, 'pipe']});
+      const bytes = statSync(decoded).size, frameBytes = count * 4;
+      if (!bytes || bytes % frameBytes !== 0) throw new Error('invalid decoded PCM');
+      const samples = bytes / frameBytes;
+      channels = Array.from({length: count}, () => new Float32Array(samples));
+      const block = Buffer.alloc(Math.max(1, Math.floor(64 * 1024 / frameBytes)) * frameBytes);
+      for (let position = 0; position < bytes;) {
+        const wanted = Math.min(block.length, bytes - position);
+        let received = 0;
+        while (received < wanted) {
+          const length = readSync(fd, block, received, wanted - received, position + received);
+          if (!length) throw new Error('incomplete decoded PCM');
+          received += length;
+        }
+        for (let offset = 0; offset < wanted; offset += frameBytes) {
+          for (let channel = 0; channel < count; channel++) {
+            const value = block.readFloatLE(offset + channel * 4);
+            if (!Number.isFinite(value)) throw new Error('non-finite source PCM');
+            channels[channel][(position + offset) / frameBytes] = value;
+          }
+        }
+        position += wanted;
+      }
+    } finally {
+      closeSync(fd);
+    }
+    rmSync(decoded);
+    applyAudioEnvelope(channels, sampleRate, envelope,
+      sourceClock.source_from, sourceClock.playback_rate);
+    const output = path.join(directory, 'source.wav');
+    writeFileSync(output, Buffer.from(audioEnvelopeWav(channels, sampleRate)), {flag: 'wx'});
+    // The existing consumer parses JSON before comparing its canonical key.
+    // Only the later asset-stage owner can attach the attempt's HTTP file URL.
+    return {path: output, envelope_key: JSON.stringify(envelope),
+      source_from: sourceClock.source_from, playback_rate: sourceClock.playback_rate};
+  } catch (error) {
+    rmSync(directory, {recursive: true, force: true});
+    throw error;
+  }
+};
diff --git a/remotion/compiled-audio-source-clock.mjs b/remotion/compiled-audio-source-clock.mjs
new file mode 100644
index 000000000..badc39f42
--- /dev/null
+++ b/remotion/compiled-audio-source-clock.mjs
@@ -0,0 +1,13 @@
+import {
+  computeMediaTrim, getSanitizedPlaybackRate,
+} from '@banodoco/timeline-composition/evaluation';
+
+// Input must be the ONE Agent compiler's output. Occurrence offsets and speed
+// inheritance belong to that compiler; this adapter only reads its media clock.
+export const compiledAudioSourceClock = (compiledClip, fps) => {
+  if (!Number.isFinite(fps) || fps <= 0) throw new Error('resolved fps required');
+  return {
+    source_from: computeMediaTrim(compiledClip, fps).trimBefore / fps,
+    playback_rate: getSanitizedPlaybackRate(compiledClip.speed),
+  };
+};
diff --git a/remotion/normal-audio-sources.mjs b/remotion/normal-audio-sources.mjs
new file mode 100644
index 000000000..c4f16ff61
--- /dev/null
+++ b/remotion/normal-audio-sources.mjs
@@ -0,0 +1,57 @@
+import {readFileSync, rmSync} from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {compileAudioEnvelope} from '@banodoco/timeline-composition/evaluation';
+import {prepareAttemptEnvelopePcm} from './attempt-envelope-pcm.mjs';
+import {compiledAudioSourceClock} from './compiled-audio-source-clock.mjs';
+
+const translate = (envelope, delta) => ({
+  ...envelope,
+  ...(envelope.keyframes && {
+    keyframes: envelope.keyframes.map(point => ({...point, at: point.at - delta})),
+  }),
+  ...(envelope.multiply && {multiply: envelope.multiply.map(child => translate(child, delta))}),
+  ...(envelope.minimum && {minimum: envelope.minimum.map(child => translate(child, delta))}),
+});
+
+// Private subprocess data from the existing asset/source owner, never a grant.
+// originalClip must be retained before slicing, not reconstructed from app data.
+export const prepareNormalAudioSources = ({clips, fps, attemptDirectory}) => {
+  const prepared = [];
+  try {
+    for (const {clip, source, originalClip} of clips) {
+      if (clip.audio?.render_source !== undefined || originalClip?.audio?.render_source !== undefined) {
+        throw new Error('source already prepared');
+      }
+      const sourceClock = compiledAudioSourceClock(clip, fps);
+      let derived = clip;
+      if (originalClip) {
+        const originalClock = compiledAudioSourceClock(originalClip, fps);
+        if (originalClip.asset !== clip.asset || originalClip.track !== clip.track
+          || originalClock.playback_rate !== sourceClock.playback_rate) {
+          throw new Error('original compiled clip does not match sliced source');
+        }
+        const envelope = compileAudioEnvelope(originalClip, fps);
+        if (envelope) {
+          const delta = (sourceClock.source_from - originalClock.source_from) / sourceClock.playback_rate;
+          derived = {...clip, audio: {...clip.audio, envelope: translate(envelope, delta)}};
+        }
+      }
+      const row = prepareAttemptEnvelopePcm({clip: derived, fps, source, attemptDirectory, sourceClock});
+      prepared.push(row ? {...row, envelope: JSON.parse(row.envelope_key)} : null);
+    }
+    return prepared;
+  } catch (error) {
+    for (const row of prepared) if (row) rmSync(path.dirname(row.path), {recursive: true, force: true});
+    throw error;
+  }
+};
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    process.stdout.write(JSON.stringify(prepareNormalAudioSources(JSON.parse(readFileSync(0, 'utf8')))));
+  } catch (error) {
+    process.stderr.write(`${error.message}\n`);
+    process.exitCode = 1;
+  }
+}
diff --git a/remotion/tests/gapless-mp3-source-origin.test.mjs b/remotion/tests/gapless-mp3-source-origin.test.mjs
new file mode 100644
index 000000000..70c471e59
--- /dev/null
+++ b/remotion/tests/gapless-mp3-source-origin.test.mjs
@@ -0,0 +1,192 @@
+import assert from 'node:assert/strict';
+import {execFileSync} from 'node:child_process';
+import {createHash} from 'node:crypto';
+import {mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync} from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {after, before, test} from 'node:test';
+import {applyAudioEnvelope, audioEnvelopeWav, compileAudioEnvelope} from '@banodoco/timeline-composition/evaluation';
+import {prepareAttemptEnvelopePcm} from '../attempt-envelope-pcm.mjs';
+import {compiledAudioSourceClock} from '../compiled-audio-source-clock.mjs';
+
+const sampleRate = 48000, frames = 86400, count = 2, fps = 30000 / 1001;
+const run = (program, args) => execFileSync(program, args, {
+  stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, maxBuffer: 2 * 1024 * 1024,
+});
+const encode = args => run('ffmpeg', ['-v', 'error', '-nostdin', '-filter_threads', '1',
+  ...args.slice(0, -1), '-threads', '1', args.at(-1)]);
+const decode = file => run('ffmpeg', ['-v', 'error', '-nostdin', '-i', file,
+  '-map', '0:a:0', '-threads', '1', '-c:a', 'pcm_f32le', '-f', 'f32le', 'pipe:1']);
+const probe = file => JSON.parse(run('ffprobe', ['-v', 'error', '-select_streams', 'a:0',
+  '-show_entries', 'format=format_name,start_time:stream=codec_name,sample_rate,channels,time_base,start_pts,start_time,duration_ts',
+  '-of', 'json', file]).toString());
+const packets = file => JSON.parse(run('ffprobe', ['-v', 'error', '-select_streams', 'a:0',
+  '-show_packets', '-show_entries', 'packet=pts,dts,duration:packet_side_data=side_data_type,skip_samples,discard_padding,skip_reason,discard_reason',
+  '-of', 'json', file]).toString()).packets;
+const skip = packet => packet.side_data_list?.find(data => data.side_data_type === 'Skip Samples');
+const planar = pcm => {
+  assert.equal(pcm.length % 8, 0);
+  const channels = Array.from({length: count}, () => new Float32Array(pcm.length / 8));
+  for (let i = 0; i < channels[0].length; i++) for (let channel = 0; channel < count; channel++) {
+    channels[channel][i] = pcm.readFloatLE(i * 8 + channel * 4);
+  }
+  return channels;
+};
+const onsets = pcm => planar(pcm).map(channel => channel.findIndex(value => Math.abs(value) > 0.03));
+const digest = bytes => createHash('sha256').update(bytes).digest('hex');
+const referenceWav = (pcm, clip, clock) => {
+  const channels = planar(pcm);
+  applyAudioEnvelope(channels, sampleRate, compileAudioEnvelope(clip, fps),
+    clock.source_from, clock.playback_rate);
+  return Buffer.from(audioEnvelopeWav(channels, sampleRate));
+};
+const wavHeader = wav => {
+  assert.equal(wav.toString('ascii', 0, 4), 'RIFF');
+  assert.equal(wav.readUInt16LE(20), 3);
+  assert.equal(wav.readUInt16LE(22), count);
+  assert.equal(wav.readUInt32LE(24), sampleRate);
+  assert.equal(wav.readUInt16LE(34), 32);
+  assert.equal(wav.readUInt32LE(40), frames * count * 4);
+  assert.equal(wav.length, 44 + frames * count * 4);
+};
+const unityClip = {
+  id: 'music', asset: 'music', track: 'A1', at: 5, from: 0, to: 1.8, volume: 7,
+  audio: {envelope: {keyframes: [{at: 0, value: 1}]}},
+};
+let scratch, source, mp3, attemptDirectory, reference, native;
+const observed = {};
+
+before(() => {
+  scratch = mkdtempSync(path.join(os.tmpdir(), 'gapless-mp3-origin-'));
+  attemptDirectory = path.join(scratch, 'attempt');
+  mkdirSync(attemptDirectory);
+  writeFileSync(path.join(attemptDirectory, 'unrelated'), 'keep');
+  source = path.join(scratch, 'source.wav');
+  // Independent PCM16 source. Unequal delayed tones expose priming on both
+  // channels; the original reference is never trimmed, shifted or aligned.
+  const bytes = Buffer.alloc(44 + frames * 4);
+  bytes.write('RIFF'); bytes.writeUInt32LE(bytes.length - 8, 4); bytes.write('WAVEfmt ', 8);
+  bytes.writeUInt32LE(16, 16); bytes.writeUInt16LE(1, 20); bytes.writeUInt16LE(count, 22);
+  bytes.writeUInt32LE(sampleRate, 24); bytes.writeUInt32LE(sampleRate * 4, 28);
+  bytes.writeUInt16LE(4, 32); bytes.writeUInt16LE(16, 34);
+  bytes.write('data', 36); bytes.writeUInt32LE(frames * 4, 40);
+  for (let i = 0; i < frames; i++) {
+    bytes.writeInt16LE(i < 9600 ? 0 : Math.round(32768 * 0.1 * Math.sin(2 * Math.PI * 440 * (i - 9600) / sampleRate)), 44 + i * 4);
+    bytes.writeInt16LE(i < 14400 ? 0 : Math.round(-32768 * 0.075 * Math.sin(2 * Math.PI * 660 * (i - 14400) / sampleRate)), 46 + i * 4);
+  }
+  writeFileSync(source, bytes);
+  mp3 = path.join(scratch, 'source.mp3');
+  encode(['-i', source, '-c:a', 'libmp3lame', '-b:a', '128k', mp3]);
+  encode(['-i', source, '-c:a', 'libmp3lame', '-b:a', '128k', '-write_xing', '0', path.join(scratch, 'unknown.mp3')]);
+  encode(['-i', source, '-c:a', 'aac', '-b:a', '128k', '-f', 'adts', path.join(scratch, 'unknown.aac')]);
+  encode(['-i', source, '-c:a', 'aac', '-b:a', '128k', path.join(scratch, 'source.m4a')]);
+  encode(['-itsoffset', '0.125', '-i', path.join(scratch, 'source.m4a'), '-c', 'copy', path.join(scratch, 'offset-aac.mka')]);
+  encode(['-i', mp3, '-c', 'copy', '-output_ts_offset', '0.125', path.join(scratch, 'offset-mp3.mka')]);
+  reference = decode(source);
+  native = decode(mp3);
+  for (const name of ['source.mp3', 'unknown.mp3', 'unknown.aac', 'source.m4a', 'offset-aac.mka', 'offset-mp3.mka']) {
+    const file = path.join(scratch, name), metadata = probe(file), packetList = packets(file), pcm = decode(file);
+    observed[name] = {stream: metadata.streams[0], format: metadata.format,
+      first: packetList[0], last: packetList.at(-1),
+      frames: pcm.length / 8, onset: onsets(pcm), pcm};
+  }
+});
+after(() => rmSync(scratch, {recursive: true, force: true}));
+
+test('ordinary gapless MP3 decodes through public apply into a full native-source WAV', () => {
+  const metadata = observed['source.mp3'];
+  assert.equal(reference.length / 8, frames);
+  assert.deepEqual(onsets(reference), [9606, 14405]);
+  assert.equal(metadata.stream.start_time, '0.023021');
+  assert.equal(metadata.format.start_time, '0.023021');
+  assert.equal(metadata.stream.time_base, '1/14112000');
+  assert.equal(metadata.stream.start_pts, 324870);
+  assert.equal(metadata.first.pts, 0);
+  assert.equal(skip(metadata.first).skip_samples, 1105);
+  assert.equal(skip(metadata.last).discard_padding, 47);
+  assert.equal(metadata.frames, frames);
+  const delta = metadata.onset.map((value, channel) => value - onsets(reference)[channel]);
+  assert.deepEqual(delta, [0, 1]); // Codec waveform difference, no fitted alignment.
+  const packetSamples = packets(mp3).reduce((sum, packet) => sum + packet.duration / 294, 0);
+  assert.equal(packetSamples - skip(metadata.first).skip_samples - skip(metadata.last).discard_padding, frames);
+  const before = digest(readFileSync(mp3)), graph = JSON.stringify(unityClip);
+  const sourceClock = compiledAudioSourceClock(unityClip, fps);
+  const prepared = prepareAttemptEnvelopePcm({clip: unityClip, fps, source: mp3, attemptDirectory, sourceClock});
+  const wav = readFileSync(prepared.path);
+  wavHeader(wav);
+  assert.equal(wav.subarray(44).equals(native), true); // Every raw native decoded sample, both channels.
+  assert.equal(wav.equals(referenceWav(native, unityClip, sourceClock)), true);
+  assert.equal(decode(prepared.path).equals(native), true);
+  assert.equal(prepared.source_from, 0);
+  assert.equal(prepared.playback_rate, 1);
+  assert.equal(prepared.envelope_key, JSON.stringify(compileAudioEnvelope(unityClip, fps)));
+  assert.deepEqual(readdirSync(path.dirname(prepared.path)), ['source.wav']);
+  assert.equal(digest(readFileSync(mp3)), before);
+  assert.equal(JSON.stringify(unityClip), graph);
+  console.log(JSON.stringify({positive: 'gapless MP3', frames, onsetDelta: delta,
+    skip: 1105, discard: 47, wavSha256: digest(wav)}));
+});
+
+test('rational public trim and child speed retain the full source and expose a wrong decoder origin', () => {
+  const clip = {...unityClip, from: 0.051, to: 1.401, speed: 1.5, hold: 0.8,
+    params: {fadeIn: 0.2, fadeInCurve: 'equal-power', fadeOut: 0.15}, audio: undefined};
+  const graph = JSON.stringify(clip), sourceClock = compiledAudioSourceClock(clip, fps);
+  assert.deepEqual(sourceClock, {source_from: 2 / fps, playback_rate: 1.5});
+  assert.notEqual(sourceClock.source_from, clip.from);
+  const prepared = prepareAttemptEnvelopePcm({clip, fps, source: mp3, attemptDirectory, sourceClock});
+  const actual = readFileSync(prepared.path), expected = referenceWav(native, clip, sourceClock);
+  wavHeader(actual);
+  assert.equal(actual.equals(expected), true, 'all full-source public WAV bytes');
+  assert.equal(decode(prepared.path).equals(actual.subarray(44)), true, 'native float WAV readback');
+  // A priming debt accidentally added to the public origin must fail exact
+  // whole-source comparison. Never fit or correct it per clip to get a pass.
+  const wrong = referenceWav(native, clip, {...sourceClock,
+    source_from: sourceClock.source_from + 1105 / sampleRate});
+  assert.notEqual(digest(actual), digest(wrong));
+  assert.equal(actual.equals(wrong), false);
+  assert.equal(prepared.source_from, sourceClock.source_from);
+  assert.equal(prepared.playback_rate, sourceClock.playback_rate);
+  assert.equal(JSON.stringify(clip), graph);
+  console.log(JSON.stringify({positive: 'rational trim + child speed', sourceClock,
+    wavSha256: digest(actual), wrongOriginSha256: digest(wrong)}));
+});
+
+test('a source-backed timestamped MP3 without skip metadata cannot use the relaxation', () => {
+  const bad = observed['offset-mp3.mka'];
+  assert.equal(bad.stream.codec_name, 'mp3');
+  assert.notEqual(Number(bad.stream.start_time), 0);
+  assert.equal(skip(bad.first), undefined);
+  assert.notEqual(bad.frames, frames);
+  assert.ok(bad.onset.every((value, channel) => value - onsets(reference)[channel] > 1000));
+  const before = readdirSync(attemptDirectory);
+  assert.throws(() => prepareAttemptEnvelopePcm({clip: unityClip, fps,
+    source: path.join(scratch, 'offset-mp3.mka'), attemptDirectory,
+    sourceClock: compiledAudioSourceClock(unityClip, fps)}), /source PCM clock cannot be retained/);
+  assert.deepEqual(readdirSync(attemptDirectory), before);
+  assert.equal(readFileSync(path.join(attemptDirectory, 'unrelated'), 'utf8'), 'keep');
+});
+
+test('direct unknown-origin evidence retains zero-start MP3 and absent-start/offset AAC debt', () => {
+  const unknown = observed['unknown.mp3'], adts = observed['unknown.aac'];
+  const m4a = observed['source.m4a'], offset = observed['offset-aac.mka'];
+  assert.equal(Number(unknown.stream.start_time), 0);
+  assert.equal(skip(unknown.first), undefined);
+  assert.notEqual(unknown.frames, frames);
+  assert.ok(unknown.onset.every((value, channel) => value - onsets(reference)[channel] > 1000));
+  assert.equal(adts.stream.start_time, undefined);
+  assert.equal(adts.format.start_time, undefined);
+  assert.equal(skip(adts.first), undefined);
+  assert.equal(adts.frames, 88064);
+  assert.deepEqual(adts.onset.map((value, channel) => value - onsets(reference)[channel]), [1024, 1024]);
+  assert.equal(skip(m4a.first).skip_samples, 1024);
+  assert.equal(m4a.frames, 87040); // Onset preserved, 640 trailing frames: unresolved count policy.
+  assert.deepEqual(m4a.onset, onsets(reference));
+  assert.notEqual(Number(offset.stream.start_time), 0);
+  assert.equal(skip(offset.first), undefined);
+  assert.equal(offset.frames, 88064);
+  assert.deepEqual(offset.onset.map((value, channel) => value - onsets(reference)[channel]), [1024, 1024]);
+  for (const [name, {pcm, ...data}] of Object.entries(observed)) {
+    console.log(JSON.stringify({characterization: name, ...data,
+      onsetDelta: data.onset.map((value, channel) => value - onsets(reference)[channel])}));
+  }
+});
diff --git a/remotion/tests/long-audio-source.test.mjs b/remotion/tests/long-audio-source.test.mjs
new file mode 100644
index 000000000..7d65d8b65
--- /dev/null
+++ b/remotion/tests/long-audio-source.test.mjs
@@ -0,0 +1,133 @@
+import assert from 'node:assert/strict';
+import {execFileSync} from 'node:child_process';
+import {createHash} from 'node:crypto';
+import {closeSync, mkdirSync, mkdtempSync, openSync, readSync, readdirSync, rmSync, statSync, writeFileSync, writeSync} from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {test} from 'node:test';
+import {applyAudioEnvelope, audioEnvelopeWav} from '@banodoco/timeline-composition/evaluation';
+import {prepareAttemptEnvelopePcm} from '../attempt-envelope-pcm.mjs';
+import {compiledAudioSourceClock} from '../compiled-audio-source-clock.mjs';
+
+const sampleRate = 48000, channels = 2, frames = 8388609;
+const decodedBytes = frames * channels * 4; // 64 MiB plus one stereo frame.
+const fps = 30000 / 1001;
+const clip = {
+  id: 'long-music', track: 'A1', asset: 'music', at: 0, from: 0.051,
+  to: frames / sampleRate, speed: 1.5, volume: 7,
+  audio: {envelope: {keyframes: [
+    {at: 0, value: 0, curve: 'equal-power'}, {at: 0.2, value: 1},
+    {at: 60, value: 1, curve: 's-curve'}, {at: 90, value: 0.5},
+  ]}},
+};
+const digest = file => {
+  const hash = createHash('sha256'), fd = openSync(file, 'r'), block = Buffer.alloc(64 * 1024);
+  try {
+    let length;
+    while ((length = readSync(fd, block))) hash.update(block.subarray(0, length));
+    return hash.digest('hex');
+  } finally { closeSync(fd); }
+};
+const read = (file, at, length) => {
+  const fd = openSync(file, 'r'), result = Buffer.alloc(length);
+  try { assert.equal(readSync(fd, result, 0, length, at), length); return result; }
+  finally { closeSync(fd); }
+};
+// Independent native-rate stereo float WAV, written in bounded blocks. Unequal
+// channels and edge impulses expose truncation, clipping and interleaving loss.
+const sourceWav = (file, count = frames, nonfinite = false) => {
+  const header = Buffer.alloc(44), bytes = count * 8;
+  header.write('RIFF'); header.writeUInt32LE(bytes + 36, 4); header.write('WAVEfmt ', 8);
+  header.writeUInt32LE(16, 16); header.writeUInt16LE(3, 20); header.writeUInt16LE(2, 22);
+  header.writeUInt32LE(sampleRate, 24); header.writeUInt32LE(sampleRate * 8, 28);
+  header.writeUInt16LE(8, 32); header.writeUInt16LE(32, 34);
+  header.write('data', 36); header.writeUInt32LE(bytes, 40);
+  const fd = openSync(file, 'wx'), block = Buffer.alloc(64 * 1024);
+  try {
+    writeSync(fd, header);
+    for (let start = 0; start < count; start += block.length / 8) {
+      const size = Math.min(block.length / 8, count - start);
+      for (let i = 0; i < size; i++) {
+        block.writeFloatLE(nonfinite ? Infinity : start + i === count - 1 ? 3 : 0.25, i * 8);
+        block.writeFloatLE(start + i === count - 2 ? -2 : -0.125, i * 8 + 4);
+      }
+      writeSync(fd, block.subarray(0, size * 8));
+    }
+  } finally { closeSync(fd); }
+};
+
+test('ordinary long source exceeds the old stdout cap and retains full-source public WAV bytes', () => {
+  assert.equal(process.env.TIMELINE_HEAVY, '1', 'run with the explicitly authorized heavy flag');
+  const scratch = mkdtempSync(path.join(os.tmpdir(), 'long-envelope-'));
+  try {
+    const source = path.join(scratch, 'music.wav'), attemptDirectory = path.join(scratch, 'attempt');
+    mkdirSync(attemptDirectory);
+    sourceWav(source);
+    const before = digest(source), graph = JSON.stringify(clip);
+    const sourceClock = compiledAudioSourceClock(clip, fps);
+    assert.deepEqual(sourceClock, {source_from: 2 / fps, playback_rate: 1.5});
+    const args = {clip, fps, source, attemptDirectory, sourceClock};
+    assert.equal(decodedBytes, 64 * 1024 * 1024 + 8);
+    // Independent whole-source channels and unchanged public apply/WAV are the
+    // oracle. No chunk-origin arithmetic or replacement gain policy is used.
+    const referenceDigest = () => {
+      const reference = [new Float32Array(frames).fill(0.25), new Float32Array(frames).fill(-0.125)];
+      reference[0][frames - 1] = 3;
+      reference[1][frames - 2] = -2;
+      applyAudioEnvelope(reference, sampleRate, clip.audio.envelope,
+        sourceClock.source_from, sourceClock.playback_rate);
+      return createHash('sha256').update(Buffer.from(audioEnvelopeWav(reference, sampleRate))).digest('hex');
+    };
+    const expected = referenceDigest();
+    global.gc?.();
+    const prepared = prepareAttemptEnvelopePcm(args);
+    assert.equal(digest(prepared.path), expected);
+    assert.equal(statSync(prepared.path).size, decodedBytes + 44);
+    assert.deepEqual(readdirSync(path.dirname(prepared.path)), ['source.wav']);
+    const header = read(prepared.path, 0, 44);
+    assert.equal(header.toString('ascii', 0, 4), 'RIFF');
+    assert.equal(header.readUInt16LE(20), 3);
+    assert.equal(header.readUInt16LE(22), channels);
+    assert.equal(header.readUInt32LE(24), sampleRate);
+    assert.equal(header.readUInt32LE(40), decodedBytes);
+    assert.equal(read(prepared.path, 44, 8).readFloatLE(0), 0);
+    // Far beyond the former limit: no truncation, gain baking or clipping.
+    assert.equal(read(prepared.path, 44 + (frames - 1) * 8, 8).readFloatLE(0), 1.5);
+    assert.equal(read(prepared.path, 44 + (frames - 2) * 8, 8).readFloatLE(4), -1);
+    assert.equal(prepared.source_from, sourceClock.source_from);
+    assert.equal(prepared.playback_rate, sourceClock.playback_rate);
+    assert.equal(prepared.envelope_key, JSON.stringify(clip.audio.envelope));
+    const decoded = path.join(scratch, 'readback.f32'), fd = openSync(decoded, 'wx');
+    try {
+      execFileSync('ffmpeg', ['-v', 'error', '-nostdin', '-i', prepared.path,
+        '-map', '0:a:0', '-threads', '1', '-c:a', 'pcm_f32le', '-f', 'f32le', 'pipe:1'],
+      {stdio: ['ignore', fd, 'pipe'], timeout: 30000, maxBuffer: 64 * 1024});
+    } finally { closeSync(fd); }
+    assert.equal(statSync(decoded).size, decodedBytes);
+    assert.equal(read(decoded, (frames - 1) * 8, 8).readFloatLE(0), 1.5);
+    assert.equal(digest(source), before);
+    assert.equal(JSON.stringify(clip), graph);
+    console.log(JSON.stringify({frames, sampleRate, channels, decodedBytes, seconds: frames / sampleRate,
+      sourceClock, wavSha256: expected, maxRssKiB: process.resourceUsage().maxRSS}));
+  } finally { rmSync(scratch, {recursive: true, force: true}); }
+});
+
+test('file-backed proposal cleans its own scratch on nonfinite PCM and decoder failure', () => {
+  const scratch = mkdtempSync(path.join(os.tmpdir(), 'long-envelope-errors-'));
+  try {
+    const source = path.join(scratch, 'bad.wav'), attemptDirectory = path.join(scratch, 'attempt');
+    mkdirSync(attemptDirectory);
+    const sentinel = path.join(attemptDirectory, 'unrelated');
+    writeFileSync(sentinel, 'keep');
+    sourceWav(source, 100, true);
+    const args = {clip, fps, source, attemptDirectory, sourceClock: compiledAudioSourceClock(clip, fps)};
+    assert.throws(() => prepareAttemptEnvelopePcm(args), /non-finite source PCM/);
+    assert.deepEqual(readdirSync(attemptDirectory), ['unrelated']);
+    // Valid WAV header but no sample frames: ffprobe succeeds, ffmpeg produces
+    // no PCM (or fails), and preparation never publishes a partial source.wav.
+    writeFileSync(source, read(source, 0, 44));
+    assert.throws(() => prepareAttemptEnvelopePcm(args));
+    assert.deepEqual(readdirSync(attemptDirectory), ['unrelated']);
+    assert.equal(digest(sentinel), createHash('sha256').update('keep').digest('hex'));
+  } finally { rmSync(scratch, {recursive: true, force: true}); }
+});
