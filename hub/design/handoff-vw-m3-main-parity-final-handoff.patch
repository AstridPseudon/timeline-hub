diff --git a/tests/e2e/timeline/viewing-parity/admission.test.ts b/tests/e2e/timeline/viewing-parity/admission.test.ts
new file mode 100644
index 000000000..0df75c4ef
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/admission.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { test } from 'node:test';
+import type { Page, Response } from '@playwright/test';
+import { waitForRenderAdmission } from './admission';
+
+const url = 'http://127.0.0.1:17340/api/astrid/v1/tasks';
+
+function mountedPage() {
+  const events = new EventEmitter();
+  let error: string | null = null;
+  const page = Object.assign(events, {
+    locator: () => ({ isVisible: async () => error !== null, textContent: async () => error }),
+  }) as unknown as Page;
+  return { page, events, refuse: (message: string) => { error = message; } };
+}
+
+function response(method = 'POST', target = url, status = 201) {
+  return { request: () => ({ method: () => method }), url: () => target, status: () => status } as Response;
+}
+
+test('observes the exact POST even when admission completes during the click', async () => {
+  const { page, events } = mountedPage();
+  const admitted = response();
+  assert.equal(await waitForRenderAdmission(page, url, async () => {
+    events.emit('response', response('GET'));
+    events.emit('response', response('POST', `${url}/other`));
+    events.emit('response', admitted);
+  }), admitted);
+  assert.equal(events.listenerCount('response'), 0);
+});
+
+test('fails on a visible catalog admission refusal without waiting for a task response', async () => {
+  const { page, events, refuse } = mountedPage();
+  await assert.rejects(waitForRenderAdmission(page, url, async () => {
+    refuse('Astrid render admission failed: capability catalog failed (404)');
+  }), /refused admission: Astrid render admission failed: capability catalog failed \(404\)/);
+  assert.equal(events.listenerCount('response'), 0);
+});
+
+test('returns an actual rejected POST so the caller still checks admission status', async () => {
+  const { page, events } = mountedPage();
+  const rejected = response('POST', url, 403);
+  assert.equal((await waitForRenderAdmission(page, url, async () => {
+    events.emit('response', rejected);
+  })).status(), 403);
+});
+
+test('observes an admission error that becomes visible after the click returns', async () => {
+  const { page, events, refuse } = mountedPage();
+  const timer = setTimeout(() => refuse('Astrid render admission failed: catalog unavailable'), 5);
+  try {
+    await assert.rejects(waitForRenderAdmission(page, url, async () => {},
+      { timeoutMs: 1_000, pollIntervalMs: 1 }), /refused admission: Astrid render admission failed/);
+    assert.equal(events.listenerCount('response'), 0);
+  } finally { clearTimeout(timer); }
+});
+
+test('bounds missing admission and removes its observer after click failure', async () => {
+  const { page, events } = mountedPage();
+  await assert.rejects(waitForRenderAdmission(page, url, async () => {},
+    { timeoutMs: 5, pollIntervalMs: 1 }), /did not POST a task/);
+  assert.equal(events.listenerCount('response'), 0);
+  await assert.rejects(waitForRenderAdmission(page, url, async () => { throw new Error('click failed'); }), /click failed/);
+  assert.equal(events.listenerCount('response'), 0);
+});
diff --git a/tests/e2e/timeline/viewing-parity/admission.ts b/tests/e2e/timeline/viewing-parity/admission.ts
new file mode 100644
index 000000000..576b98c75
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/admission.ts
@@ -0,0 +1,31 @@
+import type { Page, Response } from '@playwright/test';
+
+/** Observe the actual admission, stopping promptly when the mounted UI refuses it. */
+export async function waitForRenderAdmission(
+  page: Page,
+  admissionUrl: string,
+  render: () => Promise<unknown>,
+  { timeoutMs = 30_000, pollIntervalMs = 100 } = {},
+): Promise<Response> {
+  let admitted: Response | undefined;
+  const onResponse = (response: Response) => {
+    if (response.request().method() === 'POST' && response.url() === admissionUrl) admitted ??= response;
+  };
+  const blocker = page.locator('[data-video-editor-render-blocker="true"]');
+  const deadline = performance.now() + timeoutMs;
+  page.on('response', onResponse);
+  try {
+    await render();
+    for (;;) {
+      if (admitted) return admitted;
+      if (await blocker.isVisible()) {
+        const error = (await blocker.textContent())?.trim();
+        if (error) throw new Error(`mounted App Render action refused admission: ${error}`);
+      }
+      if (performance.now() >= deadline) throw new Error('mounted App Render action did not POST a task within the admission deadline');
+      await new Promise(resolve => setTimeout(resolve, pollIntervalMs));
+    }
+  } finally {
+    page.off('response', onResponse);
+  }
+}
diff --git a/tests/e2e/timeline/viewing-parity/authority.test.ts b/tests/e2e/timeline/viewing-parity/authority.test.ts
new file mode 100644
index 000000000..8b3c0a83c
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/authority.test.ts
@@ -0,0 +1,65 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import type { Task } from '../../../../src/integrations/runtime/generated';
+import { assertTaskAuthority } from './authority';
+import type { FrameParityFixture } from './fixture';
+
+const digest = (letter: string) => `sha256:${letter.repeat(64)}`;
+const fixture: FrameParityFixture = {
+  projectId: 'project', timelineId: 'timeline', headRevisionId: 'parent', shotId: 'shot', occurrenceId: 'occurrence',
+  shotRevisionId: 'shot-revision', internalRevisionId: 'internal-revision',
+  parent: { revision_id: 'parent', content_digest: 'parent-digest', payload: {} },
+  shot: { revision_id: 'shot-revision', content_digest: 'shot-digest', payload: {} },
+  internal: { revision_id: 'internal-revision', content_digest: 'internal-digest', payload: {} },
+  media: [{ objectId: digest('a'), digest: digest('a') }], sourceVideoMediaId: digest('a'),
+  sourceVideoMetadata: { streams: [], frames: [], format: { duration: '1.5' } },
+};
+
+function admittedTask() {
+  const task = {
+    task_id: 'task', run_id: 'run', project_id: 'project', state: 'queued', version: 1, capability_id: 'rendering.render',
+    capability_digest: digest('c'), idempotency_key: 'render-operation', created_at: '', updated_at: '', runtime_epoch: 1,
+    input_object_ids: [digest('a'), digest('b')],
+    spec: { spec: { inputs: { selector: 'rendering.remotion', timeline_authority: {
+      authority: 'kernel', project_id: 'project', timeline_id: 'timeline', parent_revision_id: 'parent',
+      parent_content_digest: 'parent-digest', snapshot_digest: digest('b'), input_object_ids: [digest('a')],
+      managed_media_admissions: { [digest('a')]: digest('a') },
+      dependency_digests: [
+        { dependency_kind: 'shot_revision', dependency_id: 'shot-revision', content_digest: 'shot-digest' },
+        { dependency_kind: 'internal_timeline_revision', dependency_id: 'internal-revision', content_digest: 'internal-digest' },
+        { dependency_kind: 'media', dependency_id: digest('a'), content_digest: digest('a') },
+      ],
+    } }, timeline_snapshot_ref: { digest: digest('b'), project_id: 'project', timeline_id: 'timeline',
+      revision_id: 'parent', revision_digest: 'parent-digest', source_kind: 'revision' } } },
+  } satisfies Task;
+  return task;
+}
+
+test('authority comparison accepts public pins independent of dependency ordering', () => {
+  const task = admittedTask();
+  const spec = task.spec.spec;
+  spec.inputs.timeline_authority.dependency_digests.reverse();
+  assertTaskAuthority(task, fixture, digest('c'));
+});
+
+test('authority comparison refuses a different project, head, child pin, media, snapshot or capability', () => {
+  const mutations: Array<(task: ReturnType<typeof admittedTask>) => void> = [
+    task => { task.project_id = 'other'; },
+    task => { task.capability_digest = digest('d'); },
+    task => { task.spec.spec.inputs.selector = 'other-renderer'; },
+    task => { task.spec.spec.inputs.timeline_authority.parent_revision_id = 'new-head'; },
+    task => { task.spec.spec.inputs.timeline_authority.parent_content_digest = 'new-digest'; },
+    task => { task.spec.spec.inputs.timeline_authority.dependency_digests[0].dependency_id = 'other-shot'; },
+    task => { task.spec.spec.inputs.timeline_authority.dependency_digests[1].content_digest = 'other-internal'; },
+    task => { delete task.spec.spec.inputs.timeline_authority.managed_media_admissions[digest('a')]; },
+    task => { task.spec.spec.inputs.timeline_authority.input_object_ids = []; },
+    task => { task.spec.spec.timeline_snapshot_ref.source_kind = 'cas'; },
+    task => { task.spec.spec.timeline_snapshot_ref.digest = digest('d'); },
+    task => { task.input_object_ids = [digest('a')]; },
+  ];
+  for (const mutate of mutations) {
+    const task = admittedTask();
+    mutate(task);
+    assert.throws(() => assertTaskAuthority(task, fixture, digest('c')), { name: 'AssertionError' });
+  }
+});
diff --git a/tests/e2e/timeline/viewing-parity/authority.ts b/tests/e2e/timeline/viewing-parity/authority.ts
new file mode 100644
index 000000000..001d6e6fc
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/authority.ts
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import type { Task } from '../../../../src/integrations/runtime/generated';
+import type { FrameParityFixture } from './fixture';
+
+export function record(value: unknown): Record<string, unknown> {
+  assert.ok(value && typeof value === 'object' && !Array.isArray(value), 'expected public object');
+  return value as Record<string, unknown>;
+}
+
+/** Compare only public Runtime authority; never construct an admission in the test. */
+export function assertTaskAuthority(task: Task, fixture: FrameParityFixture, capabilityDigest: string) {
+  assert.equal(task.project_id, fixture.projectId);
+  assert.equal(task.capability_id, 'rendering.render');
+  assert.equal(task.capability_digest, capabilityDigest);
+  const spec = record(task.spec.spec);
+  const inputs = record(spec.inputs);
+  assert.equal(inputs.selector, 'rendering.remotion');
+  const authority = record(inputs.timeline_authority);
+  assert.equal(authority.authority, 'kernel');
+  assert.equal(authority.project_id, fixture.projectId);
+  assert.equal(authority.timeline_id, fixture.timelineId);
+  assert.equal(authority.parent_revision_id, fixture.headRevisionId);
+  assert.equal(authority.parent_content_digest, fixture.parent.content_digest);
+  const expectedDependencies = [
+    { dependency_kind: 'shot_revision', dependency_id: fixture.shotRevisionId, content_digest: fixture.shot.content_digest },
+    { dependency_kind: 'internal_timeline_revision', dependency_id: fixture.internalRevisionId, content_digest: fixture.internal.content_digest },
+    ...fixture.media.map(pin => ({ dependency_kind: 'media', dependency_id: pin.objectId, content_digest: pin.digest })),
+  ];
+  const sorted = (items: unknown) => {
+    assert.ok(Array.isArray(items));
+    return [...items].sort((a, b) => String(record(a).dependency_id).localeCompare(String(record(b).dependency_id)));
+  };
+  assert.deepEqual(sorted(authority.dependency_digests), sorted(expectedDependencies));
+  assert.deepEqual(authority.managed_media_admissions, Object.fromEntries(fixture.media.map(pin => [pin.objectId, pin.digest])));
+  assert.deepEqual(new Set(authority.input_object_ids as string[]), new Set(fixture.media.map(pin => pin.objectId)));
+  const snapshot = record(spec.timeline_snapshot_ref);
+  assert.equal(snapshot.project_id, fixture.projectId);
+  assert.equal(snapshot.timeline_id, fixture.timelineId);
+  assert.equal(snapshot.revision_id, fixture.headRevisionId);
+  assert.equal(snapshot.revision_digest, fixture.parent.content_digest);
+  assert.equal(snapshot.source_kind, 'revision');
+  assert.match(String(snapshot.digest), /^sha256:[0-9a-f]{64}$/);
+  assert.equal(authority.snapshot_digest, snapshot.digest);
+  assert.deepEqual(new Set(task.input_object_ids), new Set([String(snapshot.digest), ...fixture.media.map(pin => pin.objectId)]),
+    'task must pin exactly the fixture media and frozen CAS snapshot');
+  return { authority, snapshot };
+}
diff --git a/tests/e2e/timeline/viewing-parity/bootstrap.ts b/tests/e2e/timeline/viewing-parity/bootstrap.ts
new file mode 100644
index 000000000..33fb8ef8c
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/bootstrap.ts
@@ -0,0 +1,177 @@
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
+import { stat } from 'node:fs/promises';
+import { delimiter, isAbsolute, join } from 'node:path';
+import type { DirectHarness } from '../../local/support/harness';
+
+export interface PackHostSession {
+  stop(): Promise<void>;
+}
+
+interface BootstrapOptions {
+  env?: NodeJS.ProcessEnv;
+  spawn?: typeof spawn;
+  signal?: AbortSignal;
+  startupTimeoutMs?: number;
+  stopTimeoutMs?: number;
+}
+
+/** Requires an owner-approved helper in the parent's frozen ASTRID_CHECKOUT.
+ * The Agent owns launch authority and host cleanup, including SIGTERM cleanup.
+ * This adapter owns only its direct helper child, never a reported host PID.
+ */
+export async function startRealPackHost(
+  harness: Pick<DirectHarness, 'tmp' | 'realmDir' | 'supportDir' | 'runtimeInstanceId'>,
+  checkReady: () => Promise<unknown>,
+  options: BootstrapOptions = {},
+): Promise<PackHostSession> {
+  const env: NodeJS.ProcessEnv = { ...(options.env ?? process.env), PYTHONDONTWRITEBYTECODE: '1', PYTHONUNBUFFERED: '1' };
+  const runtime = env.ASTRID_RUNTIME_CHECKOUT;
+  if (!runtime || !isAbsolute(runtime)) throw new Error('Pack-host bootstrap requires frozen absolute ASTRID_RUNTIME_CHECKOUT');
+  const source = env.ASTRID_CHECKOUT;
+  const python = env.ASTRID_PYTHON;
+  if (!source || !isAbsolute(source) || !python || !isAbsolute(python)) {
+    throw new Error('Pack-host bootstrap requires frozen absolute ASTRID_CHECKOUT and ASTRID_PYTHON');
+  }
+  const helper = join(source, 'tests/packs/rendering/real_pack_host.py');
+  if (!(await stat(helper).catch(() => null))?.isFile()) {
+    throw new Error('Approved Agent pack-host helper is absent from frozen ASTRID_CHECKOUT');
+  }
+  if (options.signal?.aborted) throw new Error('Pack-host startup aborted');
+  env.PYTHONPATH = [runtime, source, env.PYTHONPATH].filter(Boolean).join(delimiter);
+  const startupDeadline = performance.now() + (options.startupTimeoutMs ?? 210_000);
+  let child: ChildProcessWithoutNullStreams;
+  try {
+    child = (options.spawn ?? spawn)(python, ['-m', 'tests.packs.rendering.real_pack_host',
+      '--realm-dir', harness.realmDir, '--support-dir', harness.supportDir,
+      '--discovery-file', join(harness.supportDir, 'discovery.json'),
+      '--source-checkout', source, '--runtime-instance-id', harness.runtimeInstanceId,
+    ], { cwd: source, env, stdio: 'pipe', detached: false }) as ChildProcessWithoutNullStreams;
+  } catch {
+    throw new Error('Pack-host helper could not be spawned');
+  }
+
+  const stopTimeout = options.stopTimeoutMs ?? 30_000;
+  const changed = new Set<() => void>();
+  const notify = () => { for (const wake of changed) wake(); };
+  let failure: Error | undefined;
+  let protocolFailure = false;
+  let ready = false;
+  let stopped = false;
+  let closed = false;
+  let exitCode: number | null = null;
+  let hostPid: number | undefined;
+  let buffer = '';
+  let bytes = 0;
+  let stopping: Promise<void> | undefined;
+  const fail = (message: string, protocol = true) => {
+    failure ??= new Error(message);
+    protocolFailure ||= protocol;
+    notify();
+  };
+  const aborted = () => fail('Pack-host startup aborted', false);
+  options.signal?.addEventListener('abort', aborted, { once: true });
+  // Abort could have arrived between the pre-spawn check and listener setup.
+  if (options.signal?.aborted) aborted();
+
+  child.on('error', () => fail('Pack-host helper process failed'));
+  child.stdin.on('error', () => fail('Pack-host helper input failed'));
+  child.stdout.on('error', () => fail('Pack-host helper output failed'));
+  child.stderr.on('error', () => fail('Pack-host helper diagnostics failed'));
+  child.stderr.resume(); // Drain without retaining or exposing credential-bearing diagnostics.
+  child.stdout.setEncoding('utf8');
+  child.stdout.on('data', (chunk: string) => {
+    bytes += Buffer.byteLength(chunk);
+    if (bytes > 65_536) { fail('Pack-host helper output exceeded limit'); return; }
+    buffer += chunk;
+    let newline: number;
+    while ((newline = buffer.indexOf('\n')) >= 0) {
+      const line = buffer.slice(0, newline);
+      buffer = buffer.slice(newline + 1);
+      try {
+        if (Buffer.byteLength(line) > 16_384) throw new Error();
+        const value: unknown = JSON.parse(line);
+        if (!value || typeof value !== 'object') throw new Error();
+        const message = value as Record<string, unknown>;
+        if (message.status === 'ready' && !ready && !stopped
+          && Number.isSafeInteger(message.host_pid) && Number(message.host_pid) > 0
+          && message.host_status === 'ready' && Array.isArray(message.host_ready_capabilities)
+          && message.host_ready_capabilities.includes('rendering.render')) {
+          hostPid = Number(message.host_pid);
+          ready = true;
+        } else if (message.status === 'stopped' && !stopped && message.host_pid === hostPid && ready) {
+          stopped = true;
+        } else {
+          fail(message.status === 'failed' ? 'Pack-host helper reported failure' : 'Invalid pack-host helper status');
+        }
+      } catch {
+        fail('Malformed pack-host helper output');
+      }
+      notify();
+    }
+    if (buffer.length > 16_384) fail('Pack-host helper line exceeded limit');
+  });
+  child.stdout.on('end', () => {
+    if (buffer || !stopped) fail('Pack-host helper output ended before stopped acknowledgement');
+  });
+  child.once('close', (code: number | null) => {
+    closed = true;
+    exitCode = code;
+    if (!ready) fail('Pack-host helper exited before ready');
+    notify();
+  });
+
+  function waitUntil(done: () => boolean, deadline: number, label: string, checkFailure = true): Promise<void> {
+    return new Promise((resolve, reject) => {
+      const finish = (error?: Error) => {
+        clearTimeout(timer);
+        changed.delete(wake);
+        if (error) reject(error); else resolve();
+      };
+      const wake = () => {
+        if (checkFailure && failure) finish(failure);
+        else if (performance.now() >= deadline) finish(new Error(label));
+        else if (done()) finish();
+        else if (checkFailure && closed) finish(new Error('Pack-host helper exited during startup'));
+      };
+      const timer = setTimeout(() => finish(new Error(label)), Math.max(0, deadline - performance.now()));
+      changed.add(wake);
+      wake();
+    });
+  }
+
+  function stop(): Promise<void> {
+    stopping ??= (async () => {
+      options.signal?.removeEventListener('abort', aborted);
+      if (!closed) {
+        try { child.stdin.end('stop\n'); } catch { fail('Pack-host helper input failed'); }
+        try {
+          await waitUntil(() => closed, performance.now() + stopTimeout, 'Pack-host helper cleanup timed out', false);
+        } catch {
+          // Only the direct helper receives this signal. The approved Agent
+          // helper must clean its owned host on SIGTERM, including during launch.
+          child.kill('SIGTERM');
+          await waitUntil(() => closed, performance.now() + stopTimeout, 'Pack-host helper did not exit after SIGTERM', false);
+          throw new Error('Pack-host helper cleanup timed out; SIGTERM was required');
+        }
+      }
+      if (protocolFailure || !stopped || exitCode !== 0) throw new Error('Pack-host helper cleanup failed');
+    })();
+    return stopping;
+  }
+
+  try {
+    await waitUntil(() => ready, startupDeadline, 'Pack-host helper readiness timed out');
+    let catalogReady = false;
+    void Promise.resolve().then(checkReady).then(() => { catalogReady = true; notify(); },
+      () => fail('Runtime rendering capability readiness check failed', false));
+    await waitUntil(() => catalogReady, startupDeadline, 'Runtime rendering capability readiness timed out');
+    if (stopped || closed) throw new Error('Pack-host helper stopped during startup');
+    options.signal?.removeEventListener('abort', aborted);
+    return { stop };
+  } catch (error) {
+    try { await stop(); } catch {
+      throw new Error(`${(error as Error).message}; pack-host startup cleanup failed`);
+    }
+    throw error;
+  }
+}
