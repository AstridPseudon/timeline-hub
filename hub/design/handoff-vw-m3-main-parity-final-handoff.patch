@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { execFile } from 'node:child_process';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { promisify } from 'node:util';
+import type { Page, TestInfo } from '@playwright/test';
+import { capturePlayerFrame, decodeExportFrame, decodePlayerCapture } from './frames';
+import { assertFrameWithinBound, compareRgbFrames } from './compare';
+import { NORMAL_PROFILE_NATIVE1920 } from './canvas';
+import { PARITY_HEIGHT, PARITY_WIDTH } from './media';
+
+const exec = promisify(execFile);
+const NATIVE_WIDTH = 1920;
+const NATIVE_HEIGHT = 1080;
+
+// Stop at the existing Player-ref inspection: these tests exercise capture
+// preparation only, without a browser, replacement pixels or decoder stubs.
+const playerInspection = new Error('actual Player-ref inspection reached');
+
+test('decodes generated native-size PNG and lossless video before comparator rejects oversized frames', async () => {
+  const directory = await mkdtemp(join(tmpdir(), 'frame-parity-native-decode-test-'));
+  const png = join(directory, 'native.png');
+  const video = join(directory, 'native-lossless.mkv');
+  try {
+    await exec('ffmpeg', [
+      '-v', 'error', '-y', '-f', 'lavfi', '-i', `testsrc2=size=${NATIVE_WIDTH}x${NATIVE_HEIGHT}:rate=1`,
+      '-frames:v', '1', png,
+    ]);
+    await exec('ffmpeg', [
+      '-v', 'error', '-y', '-loop', '1', '-i', png, '-frames:v', '1',
+      '-c:v', 'ffv1', '-pix_fmt', 'rgb24', video,
+    ]);
+
+    const player = await decodePlayerCapture(png);
+    const exported = await decodeExportFrame(video, 0);
+    assert.deepEqual({ width: player.width, height: player.height }, { width: NATIVE_WIDTH, height: NATIVE_HEIGHT });
+    assert.deepEqual({ width: exported.width, height: exported.height }, { width: NATIVE_WIDTH, height: NATIVE_HEIGHT });
+    assert.equal(player.bytes.length, NATIVE_WIDTH * NATIVE_HEIGHT * 3);
+    assert.deepEqual(player.bytes, exported.bytes);
+    assertFrameWithinBound(compareRgbFrames(player, exported, 0, NORMAL_PROFILE_NATIVE1920), NORMAL_PROFILE_NATIVE1920);
+
+    const parityFrame = { width: PARITY_WIDTH, height: PARITY_HEIGHT, bytes: Buffer.alloc(PARITY_WIDTH * PARITY_HEIGHT * 3) };
+    assert.throws(() => compareRgbFrames(player, parityFrame, 0), /invalid Player RGB frame dimensions\/bytes/);
+    assert.throws(() => compareRgbFrames(parityFrame, exported, 0), /invalid export RGB frame dimensions\/bytes/);
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+function pageWithRenderResult({ open = true, closeFailure = false, lingeringBackdrop = false } = {}) {
+  const events: string[] = [];
+  let backdrop = open;
+  const dialog = {
+    isVisible: async () => open,
+    getByRole: (role: string, options: unknown) => {
+      assert.equal(role, 'button');
+      assert.deepEqual(options, { name: 'Close', exact: true });
+      return { click: async () => {
+        events.push('close');
+        if (closeFailure) throw new Error('Close failed');
+        open = false;
+        backdrop = lingeringBackdrop;
+      } };
+    },
+    waitFor: async (options: unknown) => {
+      assert.deepEqual(options, { state: 'detached' });
+      assert.equal(open, false);
+      events.push('dialog detached');
+    },
+  };
+  const page = {
+    getByRole: (role: string, options: unknown) => {
+      assert.equal(role, 'dialog');
+      assert.deepEqual(options, { name: 'Rendered film', exact: true });
+      return dialog;
+    },
+    locator: (selector: string) => {
+      assert.equal(selector, '[data-dialog-backdrop]');
+      return { waitFor: async (options: unknown) => {
+        assert.deepEqual(options, { state: 'detached' });
+        if (backdrop) throw new Error('Backdrop still covers Player');
+        events.push('backdrop detached');
+      } };
+    },
+    evaluate: async () => {
+      if (open || backdrop) throw new Error('Rendered film obscures actual Player');
+      events.push('inspect Player');
+      throw playerInspection;
+    },
+  } as unknown as Page;
+  return { page, events };
+}
+
+test('dismisses the completed render and waits for its backdrop before inspecting the actual Player', async () => {
+  const { page, events } = pageWithRenderResult();
+  await assert.rejects(capturePlayerFrame(page, 0, {} as TestInfo, 'positive'), error => error === playerInspection);
+  assert.deepEqual(events, ['close', 'dialog detached', 'backdrop detached', 'inspect Player']);
+});
+
+test('keeps fixture-only captures on the existing Player path when no result dialog is open', async () => {
+  const { page, events } = pageWithRenderResult({ open: false });
+  await assert.rejects(capturePlayerFrame(page, 0, {} as TestInfo, 'fixture'), error => error === playerInspection);
+  assert.deepEqual(events, ['backdrop detached', 'inspect Player']);
+});
+
+test('does not inspect or capture the Player if normal dialog dismissal fails', async () => {
+  const { page, events } = pageWithRenderResult({ closeFailure: true });
+  await assert.rejects(capturePlayerFrame(page, 0, {} as TestInfo, 'positive'), /Close failed/);
+  assert.deepEqual(events, ['close']);
+});
+
+test('does not inspect or capture the Player while the closing backdrop remains', async () => {
+  const { page, events } = pageWithRenderResult({ lingeringBackdrop: true });
+  await assert.rejects(capturePlayerFrame(page, 0, {} as TestInfo, 'positive'), /Backdrop still covers Player/);
+  assert.deepEqual(events, ['close', 'dialog detached']);
+});
+
+test('propagates a failed native probe instead of accepting partial frame bytes', async () => {
+  await assert.rejects(decodePlayerCapture('/no-such-parity-input.png'), /ffprobe/);
+});
diff --git a/tests/e2e/timeline/viewing-parity/download.test.ts b/tests/e2e/timeline/viewing-parity/download.test.ts
new file mode 100644
index 000000000..dc4f098a5
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/download.test.ts
@@ -0,0 +1,214 @@
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { test } from 'node:test';
+import type { Page } from '@playwright/test';
+import type { ManagedOutput } from '../../../../src/integrations/runtime/generated';
+import { assertDownloadTransfer, observeDownloadTransfer, type DownloadTransfer } from './download';
+import { mediaHash } from './media';
+
+const pageOrigin = 'http://127.0.0.1:17340';
+const runtimeBase = 'http://127.0.0.1:17341/api/runtime';
+const projectId = 'same project';
+const bytes = Buffer.from('synthetic transfer proof, not an MP4');
+const video = { object_id: mediaHash(bytes), digest: mediaHash(bytes), size: bytes.length } as ManagedOutput;
+const blobUrl = `blob:${pageOrigin}/unit-download`;
+function transfer(): DownloadTransfer {
+  const read = { method: 'GET', resourceType: 'fetch', status: 200, origin: pageOrigin, redirected: false };
+  return { runtimeBase, pageOrigin,
+    location: { ...read, url: `${runtimeBase}/v1/projects/${encodeURIComponent(projectId)}/objects/${encodeURIComponent(video.object_id)}/location`,
+      objectId: video.object_id, digest: video.digest, size: video.size },
+    object: { ...read, url: `${runtimeBase}/v1/objects/${encodeURIComponent(video.object_id)}`, bytes: Buffer.from(bytes) } };
+}
+const validate = (proof: DownloadTransfer, saved = bytes, url = blobUrl) =>
+  assertDownloadTransfer(proof, runtimeBase, projectId, video, saved, url, pageOrigin);
+
+test('binds the actual Runtime alias, same-project location and full bytes to the native same-page blob', () => {
+  validate(transfer());
+  assert.throws(() => validate(transfer(), Buffer.from('wrong saved bytes')));
+  for (const url of [transfer().object.url, `blob:${runtimeBase}/other`, `blob:${pageOrigin}/`,
+    `${blobUrl}?redirect=1`, `${blobUrl}#other`]) assert.throws(() => validate(transfer(), bytes, url));
+});
+
+for (const target of ['location', 'object'] as const) {
+  for (const [field, value] of Object.entries({ method: 'HEAD', resourceType: 'media', status: 206,
+    range: 'bytes=0-', origin: 'http://localhost:17340', redirected: true })) {
+    test(`refuses ${target} ${field} mismatch`, () => {
+      const proof = transfer();
+      Object.assign(proof[target], { [field]: value });
+      assert.throws(() => validate(proof));
+    });
+  }
+  for (const status of [403, 401, 500]) {
+    test(`refuses ${target} HTTP ${status}`, () => {
+      const proof = transfer(); proof[target].status = status;
+      assert.throws(() => validate(proof));
+    });
+  }
+  for (const field of ['origin', 'method', 'status', 'resourceType', 'redirected'] as const) {
+    test(`requires concrete ${target} ${field}`, () => {
+      const proof = transfer(); delete (proof[target] as Partial<typeof proof[typeof target]>)[field];
+      assert.throws(() => validate(proof));
+    });
+  }
+  for (const suffix of ['?other=1', '/other']) {
+    test(`refuses ${target} URL suffix ${suffix}`, () => {
+      const proof = transfer(); proof[target].url += suffix;
+      assert.throws(() => validate(proof));
+    });
+  }
+}
+for (const [name, mutate] of Object.entries({
+  'other project': (p: DownloadTransfer) => { p.location.url = p.location.url.replace('same%20project', 'other'); },
+  'other alias': (p: DownloadTransfer) => { p.object.url = p.object.url.replace('/api/runtime/', '/api/astrid/'); },
+  'other object': (p: DownloadTransfer) => { p.location.objectId = 'other'; },
+  'wrong digest': (p: DownloadTransfer) => { p.location.digest = 'other'; },
+  'wrong size': (p: DownloadTransfer) => { p.location.size++; },
+  'truncation': (p: DownloadTransfer) => { p.object.bytes = p.object.bytes.subarray(1); },
+  'corruption': (p: DownloadTransfer) => { p.object.bytes[0] ^= 255; },
+  'other Runtime': (p: DownloadTransfer) => { p.runtimeBase += '/other'; },
+  'other page': (p: DownloadTransfer) => { p.pageOrigin += '/other'; },
+})) {
+  test(`refuses ${name}`, () => { const proof = transfer(); mutate(proof); assert.throws(() => validate(proof)); });
+}
+
+function mockPage() {
+  return Object.assign(new EventEmitter(), { url: () => `${pageOrigin}/tools/video-editor` });
+}
+function emit(page: EventEmitter, proof: DownloadTransfer, type: 'location' | 'object', options: {
+  resourceType?: string; body?: () => Promise<Buffer>; allHeaders?: () => Promise<Record<string, string | undefined>>;
+} = {}) {
+  const read = proof[type];
+  page.emit('response', { url: () => read.url, status: () => read.status,
+    request: () => ({ method: () => read.method, resourceType: () => options.resourceType ?? read.resourceType,
+      headers: () => { assert.fail('provisional request headers must not be used'); },
+      allHeaders: options.allHeaders ?? (async () => ({ origin: read.origin, range: read.range,
+        authorization: 'must never be retained' })),
+      redirectedFrom: () => read.redirected ? {} : null }),
+    body: options.body ?? (async () => type === 'object' ? proof.object.bytes
+      : Buffer.from(JSON.stringify({ object_id: proof.location.objectId, digest: proof.location.digest,
+        size: proof.location.size, local_path: 'must never be retained' }))) });
+}
+
+test('collector observes responses without intercepting and retains no private location or credentials', async () => {
+  const page = mockPage(); const proof = transfer();
+  const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+  try {
+    emit(page, proof, 'location');
+    emit(page, proof, 'object', { resourceType: 'media', body: async () => { assert.fail('media belongs to strict diagnostics'); } });
+    emit(page, proof, 'object');
+    const observed = await observer.finish();
+    validate(observed);
+    assert.doesNotMatch(JSON.stringify(observed), /must never|authorization|local_path/);
+  } finally { observer.stop(); }
+  assert.deepEqual(page.eventNames(), []);
+});
+test('collector awaits complete headers and bodies while preserving response arrival order', async () => {
+  const page = mockPage(); const proof = transfer();
+  const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+  let resolveHeaders!: (headers: Record<string, string>) => void;
+  let resolveBody!: (bytes: Buffer) => void;
+  const headers = new Promise<Record<string, string>>(resolve => { resolveHeaders = resolve; });
+  const body = new Promise<Buffer>(resolve => { resolveBody = resolve; });
+  try {
+    emit(page, proof, 'location', { allHeaders: () => headers });
+    emit(page, proof, 'object', { body: () => body });
+    let finished = false;
+    const finishing = observer.finish().then(result => { finished = true; return result; });
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(finished, false);
+    resolveBody(bytes);
+    await new Promise(resolve => setImmediate(resolve));
+    assert.equal(finished, false);
+    resolveHeaders({ origin: pageOrigin, authorization: 'must never be retained' });
+    const observed = await finishing;
+    validate(observed);
+    assert.doesNotMatch(JSON.stringify(observed), /must never|authorization|local_path/);
+  } finally { observer.stop(); }
+});
+for (const target of ['location', 'object'] as const) {
+  test(`collector propagates failed ${target} complete headers without an unhandled rejection`, async () => {
+    const page = mockPage(); const proof = transfer();
+    const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+    const failure = new Error('complete headers failed');
+    try {
+      for (const type of ['location', 'object'] as const) emit(page, proof, type, type === target
+        ? { allHeaders: async () => { throw failure; } } : {});
+      await new Promise(resolve => setImmediate(resolve));
+      await assert.rejects(observer.finish(), error => error === failure);
+    } finally { observer.stop(); }
+  });
+  for (const origin of [undefined, 'https://wrong.test']) {
+    test(`collector refuses ${target} complete Origin ${origin ?? 'missing'}`, async () => {
+      const page = mockPage(); const proof = transfer();
+      const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+      try {
+        for (const type of ['location', 'object'] as const) emit(page, proof, type, type === target
+          ? { allHeaders: async () => ({ origin }) } : {});
+        const observed = await observer.finish();
+        assert.equal(observed[target].origin, origin);
+        assert.throws(() => validate(observed));
+      } finally { observer.stop(); }
+    });
+  }
+  test(`collector retains and refuses ${target} complete Range`, async () => {
+    const page = mockPage(); const proof = transfer();
+    const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+    try {
+      for (const type of ['location', 'object'] as const) emit(page, proof, type, type === target
+        ? { allHeaders: async () => ({ origin: pageOrigin, range: 'bytes=0-' }) } : {});
+      const observed = await observer.finish();
+      assert.equal(observed[target].range, 'bytes=0-');
+      assert.throws(() => validate(observed));
+    } finally { observer.stop(); }
+  });
+}
+for (const kind of ['missing location', 'missing object', 'repeated location', 'repeated object', 'reversed order', 'failed body'] as const) {
+  test(`collector refuses ${kind}`, async () => {
+    const page = mockPage(); const proof = transfer();
+    const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video);
+    try {
+      if (kind === 'reversed order') emit(page, proof, 'object');
+      if (kind !== 'missing location') emit(page, proof, 'location', kind === 'failed body'
+        ? { body: async () => { throw new Error('body failed'); } } : {});
+      if (kind !== 'missing object') emit(page, proof, 'object');
+      if (kind === 'repeated location') emit(page, proof, 'location');
+      if (kind === 'repeated object') emit(page, proof, 'object');
+      await assert.rejects(observer.finish());
+    } finally { observer.stop(); }
+  });
+}
+
+test('main button observes a complete managed-object fetch without a location preflight', async () => {
+  const page = mockPage(); const proof = transfer();
+  const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video, 'direct');
+  try {
+    emit(page, proof, 'object', { resourceType: 'media', body: async () => { assert.fail('preview media is not the download'); } });
+    emit(page, proof, 'object');
+    const observed = await observer.finish();
+    assertDownloadTransfer(observed, runtimeBase, projectId, video, bytes, blobUrl, pageOrigin);
+    assert.equal(Object.hasOwn(observed, 'location'), false);
+    assert.doesNotMatch(JSON.stringify(observed), /must never|authorization|local_path/);
+    for (const bad of [
+      { ...observed, object: { ...observed.object, bytes: bytes.subarray(1) } },
+      { ...observed, object: { ...observed.object, status: 206 } },
+      { ...observed, object: { ...observed.object, origin: undefined } },
+      { ...observed, object: { ...observed.object, range: 'bytes=0-' } },
+    ]) assert.throws(() => assertDownloadTransfer(bad, runtimeBase, projectId, video, bytes, blobUrl, pageOrigin));
+  } finally { observer.stop(); }
+  assert.deepEqual(page.eventNames(), []);
+});
+
+for (const kind of ['missing', 'repeated', 'failed headers', 'failed body'] as const) {
+  test(`main download collector refuses ${kind} object fetch`, async () => {
+    const page = mockPage(); const proof = transfer();
+    const observer = observeDownloadTransfer(page as unknown as Page, runtimeBase, projectId, video, 'direct');
+    try {
+      if (kind !== 'missing') emit(page, proof, 'object', kind === 'failed headers'
+        ? { allHeaders: async () => { throw new Error('headers failed'); } }
+        : kind === 'failed body' ? { body: async () => { throw new Error('body failed'); } } : {});
+      if (kind === 'repeated') emit(page, proof, 'object');
+      await new Promise(resolve => setImmediate(resolve));
+      await assert.rejects(observer.finish());
+    } finally { observer.stop(); }
+  });
+}
diff --git a/tests/e2e/timeline/viewing-parity/download.ts b/tests/e2e/timeline/viewing-parity/download.ts
new file mode 100644
index 000000000..ab8188310
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/download.ts
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import type { Page, Response } from '@playwright/test';
+import type { ManagedOutput, ObjectLocation } from '../../../../src/integrations/runtime/generated';
+import { mediaHash } from './media';
+
+interface FetchRead {
+  url: string; method: string; resourceType: string; status: number;
+  range?: string; origin?: string; redirected: boolean;
+}
+
+export interface DownloadTransfer {
+  runtimeBase: string; pageOrigin: string;
+  location: FetchRead & { objectId: string; digest: string; size: number };
+  object: FetchRead & { bytes: Uint8Array };
+}
+
+export type ManagedDownloadTransfer = Omit<DownloadTransfer, 'location'>;
+
+export function assertDownloadTransfer(transfer: DownloadTransfer | ManagedDownloadTransfer, runtimeBase: string, projectId: string,
+  video: ManagedOutput, savedBytes: Uint8Array, downloadUrl: string, pageOrigin: string): void {
+  assert.equal(transfer.runtimeBase, runtimeBase);
+  assert.equal(transfer.pageOrigin, pageOrigin);
+  const base = runtimeBase.replace(/\/$/, '');
+  const objectId = encodeURIComponent(video.object_id);
+  if ('location' in transfer) {
+    assert.equal(transfer.location.url, `${base}/v1/projects/${encodeURIComponent(projectId)}/objects/${objectId}/location`);
+    assert.equal(transfer.location.objectId, video.object_id);
+    assert.equal(transfer.location.digest, video.digest);
+    assert.equal(transfer.location.size, video.size);
+  }
+  assert.equal(transfer.object.url, `${base}/v1/objects/${objectId}`);
+  for (const read of ['location' in transfer ? transfer.location : null, transfer.object].filter(read => read !== null)) {
+    assert.equal(read.method, 'GET');
+    assert.equal(read.resourceType, 'fetch');
+    assert.equal(read.status, 200);
+    assert.equal(read.range, undefined);
+    assert.equal(read.origin, pageOrigin);
+    assert.equal(read.redirected, false);
+  }
+  assert.equal(transfer.object.bytes.length, video.size);
+  assert.equal(mediaHash(transfer.object.bytes), video.digest);
+  assert.deepEqual(Buffer.from(savedBytes), Buffer.from(transfer.object.bytes));
+  assert.ok(downloadUrl.startsWith(`blob:${pageOrigin}/`), 'native download must use a same-page blob');
+  const blob = new URL(downloadUrl.slice(5));
+  assert.equal(blob.origin, pageOrigin);
+  assert.ok(blob.pathname.length > 1);
+  assert.equal(blob.search, '');
+  assert.equal(blob.hash, '');
+}
+
+interface TransferObserver<T> { finish(): Promise<T>; stop(): void }
+
+/** Observe the normal App fetch without intercepting or replacing its bytes. */
+export function observeDownloadTransfer(page: Page, runtimeBase: string, projectId: string, video: ManagedOutput, mode: 'direct'): TransferObserver<ManagedDownloadTransfer>;
+export function observeDownloadTransfer(page: Page, runtimeBase: string, projectId: string, video: ManagedOutput): TransferObserver<DownloadTransfer>;
+export function observeDownloadTransfer(page: Page, runtimeBase: string, projectId: string, video: ManagedOutput, mode: 'direct' | 'location' = 'location') {
+  const pageOrigin = new URL(page.url()).origin;
+  const objectUrl = `${runtimeBase.replace(/\/$/, '')}/v1/objects/${encodeURIComponent(video.object_id)}`;
+  const locationUrl = `${runtimeBase.replace(/\/$/, '')}/v1/projects/${encodeURIComponent(projectId)}/objects/${encodeURIComponent(video.object_id)}/location`;
+  const reads: Array<Promise<{ read: FetchRead; bytes: Buffer }>> = [];
+  const onResponse = (response: Response) => {
+    if (!(mode === 'direct' ? [objectUrl] : [objectUrl, locationUrl]).includes(response.url())) return;
+    const request = response.request();
+    if (request.resourceType() === 'media') return;
+    const read: FetchRead = { url: response.url(), method: request.method(), resourceType: request.resourceType(),
+      status: response.status(), redirected: request.redirectedFrom() !== null };
+    // headers() is provisional; await the same raw headers used by Playwright's trace recorder.
+    const reading = Promise.all([request.allHeaders(), response.body()]).then(([headers, bytes]) => ({
+      read: { ...read, range: headers.range, origin: headers.origin }, bytes,
+    }));
+    // Keep a failed header/body read for finish(), without an unhandled rejection in the interim.
+    void reading.catch(() => {});
+    reads.push(reading);
+  };
+  page.on('response', onResponse);
+  return {
+    async finish(): Promise<DownloadTransfer | ManagedDownloadTransfer> {
+      const results = await Promise.all(reads);
+      const locations = results.filter(item => item.read.url === locationUrl);
+      const objects = results.filter(item => item.read.url === objectUrl && item.read.resourceType !== 'media');
+      if (mode === 'location') assert.equal(locations.length, 1, 'click must read exactly one same-project object location');
+      assert.equal(objects.length, 1, 'click must fetch exactly one full generated-client object');
+      if (mode === 'direct') return { runtimeBase, pageOrigin, object: { ...objects[0].read, bytes: objects[0].bytes } };
+      assert.ok(results.indexOf(locations[0]) < results.indexOf(objects[0]), 'location must precede object fetch');
+      const location = JSON.parse(locations[0].bytes.toString('utf8')) as Pick<ObjectLocation, 'object_id' | 'digest' | 'size'>;
+      // ObjectLocation contains a private local path: retain only identity and length.
+      return { runtimeBase, pageOrigin, location: { ...locations[0].read,
+        objectId: location.object_id, digest: location.digest, size: location.size },
+      object: { ...objects[0].read, bytes: objects[0].bytes } };
+    },
+    stop() { page.off('response', onResponse); },
+  };
+}
diff --git a/tests/e2e/timeline/viewing-parity/fixture.ts b/tests/e2e/timeline/viewing-parity/fixture.ts
new file mode 100644
index 000000000..f645c27c4
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/fixture.ts
@@ -0,0 +1,158 @@
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { randomUUID } from 'node:crypto';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { promisify } from 'node:util';
+import { compositionPublication, type DirectHarness } from '../../local/support/harness';
+import { generatePlayableVideo, mediaHash, PARITY_FPS } from './media';
+import { ORIGINAL_640, type ParityCanvas } from './canvas';
+
+export { PARITY_FPS, PARITY_HEIGHT, PARITY_WIDTH } from './media';
+export const PARITY_FRAMES = [0, 37, 44, 45, 52, 89, 90, 120, 121, 135, 143, 164] as const;
+const exec = promisify(execFile);
+
+interface Revision {
+  revision_id: string;
+  content_digest: string;
+  payload: Record<string, unknown>;
+  internal_timeline_revision_id?: string;
+}
+interface MediaPin { objectId: string; digest: string }
+export interface FrameParityFixture {
+  projectId: string;
+  timelineId: string;
+  headRevisionId: string;
+  shotId: string;
+  occurrenceId: string;
+  shotRevisionId: string;
+  internalRevisionId: string;
+  parent: Revision;
+  shot: Revision;
+  internal: Revision;
+  media: MediaPin[];
+  sourceVideoMediaId: string;
+  sourceVideoMetadata: Awaited<ReturnType<typeof generatePlayableVideo>>['metadata'];
+}
+
+export async function readRuntimeJson<T>(harness: DirectHarness, path: string): Promise<T> {
+  const response = await harness.runtimeJson<T>('GET', path);
+  assert.equal(response.status, 200, `GET ${path}: ${JSON.stringify(response.body)}`);
+  return response.body;
+}
+
+export function timelineBase(fixture: Pick<FrameParityFixture, 'projectId' | 'timelineId'>): string {
+  return `/v1/projects/${fixture.projectId}/timelines/${fixture.timelineId}`;
+}
+
+async function readClosure(harness: DirectHarness, fixture: Pick<FrameParityFixture,
+  'projectId' | 'timelineId' | 'headRevisionId' | 'shotId' | 'shotRevisionId' | 'internalRevisionId'>) {
+  type PublicRevision = Revision & { project_id: string; timeline_id?: string; shot_id?: string };
+  const [parent, shot, internal] = await Promise.all([
+    readRuntimeJson<PublicRevision>(harness, `${timelineBase(fixture)}/composition-revisions/${fixture.headRevisionId}`),
+    readRuntimeJson<PublicRevision>(harness, `/v1/projects/${fixture.projectId}/shots/${fixture.shotId}/revisions/${fixture.shotRevisionId}`),
+    readRuntimeJson<PublicRevision>(harness, `${timelineBase(fixture)}/revisions/${fixture.internalRevisionId}`),
+  ]);
+  for (const revision of [parent, shot, internal]) assert.equal(revision.project_id, fixture.projectId);
+  assert.equal(parent.timeline_id, fixture.timelineId);
+  assert.equal(shot.shot_id, fixture.shotId);
+  assert.equal(internal.timeline_id, fixture.timelineId);
+  // Authoring startup may add a verified baseline manifest to read metadata;
+  // compare immutable identity/payload rather than that derived read decoration.
+  const immutable = (revision: Revision): Revision => ({
+    revision_id: revision.revision_id, content_digest: revision.content_digest, payload: revision.payload,
+    ...(revision.internal_timeline_revision_id ? { internal_timeline_revision_id: revision.internal_timeline_revision_id } : {}),
+  });
+  return { parent: immutable(parent), shot: immutable(shot), internal: immutable(internal) };
+}
+
+/** Existing M1 fixture setup before authoring/Render; not an authoring-path proof. */
+export async function prepareFrameParityFixture(harness: DirectHarness, canvas: ParityCanvas = ORIGINAL_640): Promise<FrameParityFixture> {
+  const directory = await mkdtemp(join(tmpdir(), 'real-frame-parity-'));
+  try {
+    const source = await generatePlayableVideo(directory);
+    const audioPath = join(directory, 'tone.wav');
+    await exec('ffmpeg', ['-v', 'error', '-y', '-f', 'lavfi', '-i', 'sine=frequency=440:sample_rate=44100:duration=1',
+      '-ac', '2', '-c:a', 'pcm_s16le', '-threads', '1', audioPath]);
+    const ingest = async (bytes: Buffer, type: string, filename: string): Promise<MediaPin> => {
+      const response = await harness.runtimeFetch(`/v1/projects/${harness.seed.projectId}/objects`, {
+        method: 'POST', headers: { 'Content-Type': type, 'Idempotency-Key': randomUUID(), 'X-Original-Name': filename },
+        body: new Uint8Array(bytes),
+      });
+      assert.ok([200, 201].includes(response.status), `ingest ${filename}: ${response.status}`);
+      const { data } = await response.json();
+      assert.equal(data.digest, mediaHash(bytes));
+      assert.equal(data.object_id, data.digest);
+      return { objectId: data.object_id, digest: data.digest };
+    };
+    const video = await ingest(source.bytes, 'video/webm', 'frame-marked.webm');
+    const audio = await ingest(await readFile(audioPath), 'audio/wav', 'tone.wav');
+    const { projectId, timelineId, headRevisionId: expectedHead, image } = harness.seed;
+    const shotId = 'frame-parity-shot';
+    const occurrenceId = 'frame-parity-occurrence';
+    const shotRevisionId = randomUUID();
+    const internalRevisionId = randomUUID();
+    const publication = compositionPublication(harness.seed, expectedHead, 'Ordinary media frame parity', PARITY_FPS);
+    const asset = (pin: MediaPin, type: string, duration?: number) => ({
+      media_id: pin.objectId, content_sha256: pin.digest, type, ...(duration === undefined ? {} : { duration }),
+    });
+    // One canonical occurrence bounds the picture at 165 exclusive. No
+    // transition policy is exercised here; the original c16 fixture is held
+    // for the separate incoming-transition requirement, with its expectations.
+    const clips = [
+      { id: 'parity-image', track: 'V1', at: 0, clipType: 'media', hold: 4, asset: 'still' },
+      { id: 'parity-video', track: 'V1', at: 4, clipType: 'media', hold: 1.5, asset: 'video', from: 0, to: 1.5, speed: 1 },
+      { id: 'parity-audio', track: 'A1', at: 0.25, clipType: 'media', asset: 'audio', from: 0.05, to: 0.55,
+        speed: 1, volume: 0.8, effects: [{ fade_in: 0.1, fade_out: 0.1 }] },
+    ];
+    Object.assign(publication.parent_composition, {
+      config: { output: { resolution: `${canvas.width}x${canvas.height}`, fps: PARITY_FPS, file: 'frame-parity.mp4' },
+        tracks: [{ id: 'S1', kind: 'visual', label: 'S1' }], clips: [] },
+      occurrences: [{ occurrence_id: occurrenceId, shot_id: shotId, shot_revision_id: shotRevisionId,
+        placement: { start_ms: 0 }, source_offset: 0, duration_ms: 5500, speed: 1, track: 'S1',
+        transform: {}, gain: 1, muted: false, provenance: {} }],
+    });
+    Object.assign(publication, {
+      internal_timeline_revisions: [{ timeline_id: timelineId, revision_id: internalRevisionId, payload: {
+        tracks: [{ id: 'V1', kind: 'visual', label: 'V1' }, { id: 'A1', kind: 'audio', label: 'A1' }],
+        clips, effects: [], audio: [], layout: {}, assets: [],
+        registry: { assets: { still: asset(image, 'image/png'), video: asset(video, 'video/webm', 1.5), audio: asset(audio, 'audio/wav', 1) } },
+      } }],
+      shot_revisions: [{ shot_id: shotId, revision_id: shotRevisionId, internal_timeline_revision_id: internalRevisionId,
+        payload: { metadata: { title: 'Ordinary media' }, items: [], pools: [], selected_variants: {}, provenance: {},
+          generation_inputs: {}, audio_bindings: [], text_bindings: [] } }],
+    });
+    const response = await harness.runtimeJson<{ data: { new_head: string; content_digests: Record<string, string> } }>('POST',
+      `${timelineBase(harness.seed)}/composition-revisions`, publication);
+    assert.equal(response.status, 200, JSON.stringify(response.body));
+    assert.equal(response.body.data.new_head, publication.parent_revision_id);
+    const pins = { projectId, timelineId, headRevisionId: response.body.data.new_head, shotId, occurrenceId, shotRevisionId, internalRevisionId };
+    const closure = await readClosure(harness, pins);
+    assert.equal(closure.parent.revision_id, pins.headRevisionId);
+    assert.equal(closure.shot.revision_id, shotRevisionId);
+    assert.equal(closure.internal.revision_id, internalRevisionId);
+    assert.equal(closure.shot.internal_timeline_revision_id, internalRevisionId);
+    assert.equal(closure.parent.content_digest, response.body.data.content_digests.parent);
+    assert.equal(closure.shot.content_digest, response.body.data.content_digests[shotRevisionId]);
+    assert.equal(closure.internal.content_digest, response.body.data.content_digests[internalRevisionId]);
+    assert.deepEqual(closure.parent.payload.occurrences, publication.parent_composition.occurrences);
+    const fixture = { ...pins, ...closure, media: [image, video, audio], sourceVideoMediaId: video.objectId, sourceVideoMetadata: source.metadata };
+    await assertPinnedFrameParityFixture(harness, fixture);
+    return fixture;
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+
+export async function assertPinnedFrameParityFixture(harness: DirectHarness, fixture: FrameParityFixture): Promise<void> {
+  const head = await readRuntimeJson<{ items: Array<{ revision_id: string; is_current_head: boolean }> }>(harness,
+    `${timelineBase(fixture)}/composition-revisions?limit=1`);
+  assert.equal(head.items.find(item => item.is_current_head)?.revision_id, fixture.headRevisionId, 'fixture parent head changed');
+  assert.deepEqual(await readClosure(harness, fixture), { parent: fixture.parent, shot: fixture.shot, internal: fixture.internal });
+  for (const pin of fixture.media) {
+    const response = await harness.runtimeFetch(`/v1/objects/${encodeURIComponent(pin.objectId)}`);
+    assert.equal(response.status, 200);
+    assert.equal(mediaHash(new Uint8Array(await response.arrayBuffer())), pin.digest, 'fixture media bytes changed');
+  }
+}
diff --git a/tests/e2e/timeline/viewing-parity/frames.ts b/tests/e2e/timeline/viewing-parity/frames.ts
new file mode 100644
index 000000000..97675623f
--- /dev/null
+++ b/tests/e2e/timeline/viewing-parity/frames.ts
@@ -0,0 +1,180 @@
+import { execFile } from 'node:child_process';
+import { mkdir } from 'node:fs/promises';
+import type { PlayerRef } from '@remotion/player';
+import { readFrameMarker, VIDEO_START_FRAME } from './media';
+import { promisify } from 'node:util';
+import { expect, type Page, type TestInfo } from '@playwright/test';
+import { ORIGINAL_640, type ParityCanvas } from './canvas';
+import { type RgbFrame } from './compare';
+export { assertFrameWithinBound, compareRgbFrames, type FrameComparison, type RgbFrame } from './compare';
+
+const execFileAsync = promisify(execFile);
+const PREVIEW_SURFACE = '[data-testid="video-editor-preview-surface"]';
+const PLAYER_COMPOSITION = `${PREVIEW_SURFACE} .__remotion-player`;
+
+const RGB_BYTES_PER_PIXEL = 3;
+const DECODE_BUFFER_OVERHEAD = 1024;
+const MAX_DECODE_BYTES = 256 * 1024 * 1024;
+
+async function ffprobeDimensions(path: string): Promise<{ width: number; height: number }> {
+  const { stdout } = await execFileAsync('ffprobe', [
+    '-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height', '-of', 'json', path,
+  ]);
+  const stream = (JSON.parse(stdout) as { streams?: Array<{ width?: number; height?: number }> }).streams?.[0];
+  if (!stream?.width || !stream.height) throw new Error(`could not read image dimensions for ${path}`);
+  return { width: stream.width, height: stream.height };
+}
+
+async function decodeRgb(path: string, args: string[]): Promise<RgbFrame> {
+  const dimensions = await ffprobeDimensions(path);
+  if (!Number.isSafeInteger(dimensions.width) || !Number.isSafeInteger(dimensions.height)
+    || dimensions.width < 1 || dimensions.height < 1) {
+    throw new Error(`invalid decoded frame dimensions for ${path}: ${dimensions.width}x${dimensions.height}`);
+  }
+  const frameBytes = dimensions.width * dimensions.height * RGB_BYTES_PER_PIXEL;
+  if (!Number.isSafeInteger(frameBytes) || frameBytes > MAX_DECODE_BYTES) {
+    throw new Error(`decoded frame exceeds ${MAX_DECODE_BYTES} byte limit for ${path}: ${dimensions.width}x${dimensions.height}`);
+  }
+  const { stdout } = await execFileAsync('ffmpeg', [
+    '-v', 'error', '-i', path, ...args, '-frames:v', '1', '-f', 'rawvideo', '-pix_fmt', 'rgb24', 'pipe:1',
+  ], { encoding: 'buffer', maxBuffer: frameBytes + DECODE_BUFFER_OVERHEAD });
+  const bytes = Buffer.isBuffer(stdout) ? stdout : Buffer.from(stdout);
+  expect(bytes).toHaveLength(frameBytes);
+  return { ...dimensions, bytes };
+}
+
+export async function decodeExportFrame(exportPath: string, frame: number): Promise<RgbFrame> {
+  return decodeRgb(exportPath, ['-map', '0:v:0', '-an', '-vf', `select=eq(n\\,${frame})`]);
+}
+
+export async function decodePlayerCapture(path: string): Promise<RgbFrame> {
+  return decodeRgb(path, []);
+}
+
+declare global {
+  interface Window { __frameParityPlayer: PlayerRef }
+}
+
+export async function seekPlayerFrame(page: Page, frame: number): Promise<void> {
+  // Reuse the audio harness's test-only React-ref inspection. These are methods
+  // on the mounted actual Player; no product debug API or ruler assumptions.
+  await page.evaluate((requested) => {
+    type Hook = { memoizedState?: { current?: PlayerRef }; next?: Hook };
+    type Fiber = { return?: Fiber; memoizedState?: Hook };
+    const label = document.querySelector('[data-testid="preview-revision-label"]');
+    if (!label) throw new Error('Missing actual Player preview');
+    const key = Object.keys(label).find(key => key.startsWith('__reactFiber$'));
+    let fiber = key ? (label as unknown as Record<string, Fiber>)[key] : undefined;
+    for (let depth = 0; fiber && depth < 100; depth++, fiber = fiber.return) {
+      let hook = fiber.memoizedState;
+      for (let index = 0; hook && index < 100; index++, hook = hook.next) {
+        const ref = hook.memoizedState?.current;
+        if (ref && typeof ref.seekTo === 'function' && typeof ref.setVolume === 'function') {
+          window.__frameParityPlayer = ref;
+          ref.pause();
+          ref.seekTo(requested);
+          return;
+        }
+      }
+    }
+    throw new Error('Mounted Remotion PlayerRef not found');
+  }, frame);
+  await expect.poll(() => page.evaluate(() => ({
+    frame: window.__frameParityPlayer.getCurrentFrame(),
+    playing: window.__frameParityPlayer.isPlaying(),
+  })), { timeout: 10_000 }).toEqual({ frame, playing: false });
+}
+
+async function waitForRequestedMedia(page: Page, frame: number, canvas: ParityCanvas): Promise<void> {
+  await page.evaluate(() => document.fonts.ready);
+  await expect.poll(() => page.locator(PLAYER_COMPOSITION).evaluate((element) =>
+    Array.from(element.querySelectorAll('img')).every(image => image.complete && image.naturalWidth > 0),
+  ), { timeout: 10_000, message: `frame ${frame}: image decode readiness` }).toBe(true);
+  if (frame >= VIDEO_START_FRAME) {
+    // A prior onVideoFrame/ready attribute is insufficient after a seek. Poll
+    // the real managed decoder's canvas (or native fallback) for the exact six
+    // bit source-frame marker. Bound: 10 seconds, then fail; never use this
+    // source readback as the Player/export screenshot comparator.
+    await expect.poll(async () => {
+      const bytes = await page.locator(PLAYER_COMPOSITION).evaluate((element, dimensions) => {
+        const media = Array.from(element.querySelectorAll('canvas, video')).find(node => {
+          const box = node.getBoundingClientRect();
+          return box.width === dimensions.width && box.height === dimensions.height && getComputedStyle(node).visibility !== 'hidden';
+        }) as HTMLCanvasElement | HTMLVideoElement | undefined;
+        if (!media) return [];
+        if (media instanceof HTMLVideoElement && (media.readyState < 2 || media.seeking)) return [];
+        const probe = document.createElement('canvas');
+        probe.width = 640;
+        probe.height = 360;
+        const context = probe.getContext('2d');
+        if (!context) throw new Error('Cannot inspect decoded media marker');
+        context.drawImage(media, 0, 0);
+        return Array.from(context.getImageData(0, 0, 640, 48).data);
+      }, canvas);
+      // Canvas readback is RGBA; marker inspection uses the RGB source domain.
+      const rgb = new Uint8Array(bytes.length / 4 * 3);
+      for (let i = 0; i < bytes.length / 4; i++) rgb.set(bytes.slice(i * 4, i * 4 + 3), i * 3);
+      return readFrameMarker(rgb);
+    }, { timeout: 10_000, message: `frame ${frame}: managed media must decode source frame ${frame - VIDEO_START_FRAME}` })
+      .toBe(frame - VIDEO_START_FRAME);
+  }
+  await expect(page.getByTestId('preview-loading-placeholder')).toHaveCount(0);
+  await expect(page.getByTestId('preview-first-frame-cover')).toHaveCSS('opacity', '0');
+  await page.evaluate(() => new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve()))));
+  expect(await page.evaluate(() => window.__frameParityPlayer.getCurrentFrame())).toBe(frame);
+  await expect(page.getByTestId('preview-media-error')).toHaveCount(0);
+}
+
+/** Capture only the native composition viewport after exact Player/media seek. */
+export async function capturePlayerFrame(page: Page, frame: number, testInfo: TestInfo, name: string, canvas: ParityCanvas = ORIGINAL_640): Promise<RgbFrame> {
+  // Render completion opens a modal above the mounted Player. A locator
+  // screenshot includes that modal/backdrop even when the Player is ready.
+  const resultDialog = page.getByRole('dialog', { name: 'Rendered film', exact: true });
+  if (await resultDialog.isVisible()) {
+    await resultDialog.getByRole('button', { name: 'Close', exact: true }).click();
+    await resultDialog.waitFor({ state: 'detached' });
+  }
+  await page.locator('[data-dialog-backdrop]').waitFor({ state: 'detached' });
+  await seekPlayerFrame(page, frame);
+  const composition = page.locator(PLAYER_COMPOSITION).first();
+  await expect(composition).toBeVisible();
+  // The production Player fits itself to the editor panel. Constrain only the
+  // test host to the composition's native box. A fixed, raised host escapes
+  // the editor panel's overflow clipping and sibling chrome; sizing alone can
+  // capture those siblings over an otherwise ready decoded frame.
+  await page.evaluate((dimensions) => {
+    const host = window.__frameParityPlayer.getContainerNode();
+    if (!host) throw new Error('Mounted Player has no container');
+    host.dataset.frameParityNativeHost = 'true';
+    if (document.getElementById('frame-parity-native-size')) return;
+    const style = document.createElement('style');
+    style.id = 'frame-parity-native-size';
+    style.textContent = `[data-frame-parity-native-host="true"] {
+      position: fixed !important; left: 32px !important; top: 32px !important;
+      z-index: 2147483647 !important;
+      width: ${dimensions.width}px !important; height: ${dimensions.height}px !important;
+      min-width: ${dimensions.width}px !important; min-height: ${dimensions.height}px !important;
+      flex: 0 0 ${dimensions.width}px !important;
+    }`;
+    document.head.appendChild(style);
+  }, canvas);
+  await expect.poll(async () => {
+    const box = await composition.boundingBox();
+    return box ? [box.width, box.height] : null;
+  }, { timeout: 5_000 }).toEqual([canvas.width, canvas.height]);
+
+  expect(await page.evaluate(() => window.__frameParityPlayer.getScale())).toBe(1);
+  await waitForRequestedMedia(page, frame, canvas);
+  expect(await page.evaluate(() => window.devicePixelRatio)).toBe(1);
+  const output = playerCapturePath(testInfo, frame, name);
+  await mkdir(testInfo.outputPath('viewing-parity'), { recursive: true });
+  await composition.screenshot({ path: output, animations: 'disabled' });
+  const decoded = await decodePlayerCapture(output);
+  expect(decoded.width).toBe(canvas.width);
+  expect(decoded.height).toBe(canvas.height);
+  return decoded;
+}
+
+export function playerCapturePath(testInfo: TestInfo, frame: number, name: string): string {
+  return testInfo.outputPath(`viewing-parity/player-frame-${String(frame).padStart(3, '0')}-${name}.png`);
+}
