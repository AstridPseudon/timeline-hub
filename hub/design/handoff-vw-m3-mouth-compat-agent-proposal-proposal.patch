+
+// Legacy inspection padding around the actual drawing rectangle, not occupied
+// pixels. Require explicit anchors unchanged by the drawing's normalization;
+// omitted, partial and raw-invalid anchors have different legacy defaults.
+export const mouthInspectionRect = (raw: unknown): PixelRect | null => {
+  const value = narrowParams<{mouth?: unknown}>(raw).mouth;
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  const m = value as Record<string, unknown>;
+  const anchor = mouthAnchor(raw);
+  if (m.x !== anchor.x || m.y !== anchor.y || m.w !== anchor.w) return null;
+  const r = mouthEraseRect(anchor);
+  return {x: r.x - 1, y: r.y - 2, w: r.w + 2, h: r.h + 4};
+};
 
