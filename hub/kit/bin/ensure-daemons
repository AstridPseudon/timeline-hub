#!/bin/bash
# ensure-daemons AREA: idempotent machine recovery, safe to run any time and after every container restart.
# Starts hub-syncd, dispatcher-daemon and run-manager AREA if they are not running, and marks workers that died
# (a `running` marker but no process using their worktree) as dead, queueing a re-dispatch note in the manager's INBOX.
# Prints one status line. AREA: runtime (main machine) | agent | app | app2 | viewing | farm.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
A=$1; [ -n "$A" ] && [ -d $O/managers/$A ] || { echo "usage: ensure-daemons AREA"; exit 2; }
M=$A; [ $A = runtime ] && M=main          # hub-sync machine name
case "${TMPDIR:-}" in /tmp/w-*) echo "ensure-daemons: refused inside a worker sandbox (TMPDIR=$TMPDIR); only the lead runs this on the host (09:25Z agent: a sandboxed run marked live workers dead)"; exit 3;; esac
# one run at a time: overlapping runs (keepalive loop + hourly check) would stop the same dead worker twice
exec 9>$O/.ensure-daemons.$A.lock
flock -n 9 || { echo "$(date -u +%FT%TZ) ensure-daemons $A: started: none; dead workers: none (another run in progress)"; exit 0; }
has(){ ps -eo args | awk -v p="$1" -v a="$2" '$1=="/bin/bash" && $2 ~ ("bin/" p "$") && (a=="" || $3==a) {f=1} END{exit !f}'; }
started=""
has hub-syncd "$M" || { nohup setsid $O/bin/hub-syncd $M >> $O/hub-sync.log 2>&1 < /dev/null 9>&- & started="$started hub-syncd"; }
has dispatcher-daemon "" || { nohup setsid $O/bin/dispatcher-daemon >> $O/dispatcher.log 2>&1 < /dev/null 9>&- & started="$started dispatcher"; }
# a manager round (codex or claude) still running counts as alive even if its run-manager loop died: its -o/tee path names the area
mgr_alive(){ has run-manager "$A" || ps -eo args | grep -F -- "managers/$A/rounds/" | grep -qv grep; }
if ! mgr_alive && [ ! -f $O/managers/$A/STOP ]; then
  rm -f $O/managers/$A/running
  if [ $A = farm ]; then nohup setsid $O/bin/run-manager farm claude-sonnet-5-5 >/dev/null 2>&1 </dev/null 9>&-; else nohup setsid $O/bin/run-manager $A >/dev/null 2>&1 </dev/null 9>&-; fi   # setsid: never in the caller's process group (a Monitor expiry killed the loop but not its codex child: duplicate managers, 05:04Z app2)
  started="$started run-manager"
fi
# a manager whose rounds keep failing at once (e.g. Codex input_too_large, 04:13Z agent) looks alive but does nothing
mgr=""; fails=$(find $O/managers/$A/rounds -name "*.exit" -mmin -10 2>/dev/null | xargs -r grep -LxF 0 2>/dev/null | wc -l)
if [ "$fails" -ge 3 ]; then last=$(ls -t $O/managers/$A/rounds/*.log 2>/dev/null | head -1); mgr=" MANAGER FAILING: $fails failed rounds in 10 min; last: $(grep -iE "error|too_large|denied|limit" "$last" 2>/dev/null | tail -1 | cut -c1-160)"; fi
hbage=$(( $(date +%s) - $(stat -c %Y $O/dispatcher.heartbeat 2>/dev/null || echo 0) ))
[ $hbage -gt 600 ] && mgr="$mgr DISPATCHER STALE: heartbeat ${hbage}s old (process may be wedged; check dispatcher.log, restart it by PID)"
mail=""; for f in $O/design/peer-*-to-$A-lead-*.md; do [ -f "$f" ] || continue; b=$(basename "$f"); grep -qxF "$b" $O/.lead-mail-seen-$A 2>/dev/null && continue
  mail="$mail $b"; echo "$b" >> $O/.lead-mail-seen-$A; done
[ -n "$mail" ] && mgr="$mgr LEAD MAIL (read in \$ORCH/design/):$mail"
# hourly read-only upstream fetch (01:45Z, LOOPS #39): lanes need origin/main current for U-drafts and D32 pre-existing checks. Fetch only; never push.
if [ -z "$(find $O/.upstream-fetch-$A -mmin -60 2>/dev/null)" ]; then touch $O/.upstream-fetch-$A
  for r in agent runtime app composition; do [ -d /home/user/work/$r/.git ] || [ -f /home/user/work/$r/.git ] || continue
    ( timeout 90 git -C /home/user/work/$r fetch -q origin main >/dev/null 2>&1 & ) ; done; fi
dead=""; fin=""
for d in $O/workers/*/; do
  [ -f $d/running ] && [ -f $d/meta ] || continue
  [ -f $d/ended ] || [ -f $d/exit ] && continue   # finished, but its running marker not yet cleared: not a death (18:42Z farm)
  w=$(basename $d); wt=$(sed -n 's/^worktree=//p' $d/meta)
  [ -n "$wt" ] || continue
  ps -eo args | grep -F -- "$wt" | grep -qv grep && continue          # a live process still uses the worktree
  [ $(( $(date +%s) - $(stat -c %Y $d/running) )) -lt 300 ] && continue  # just launched; give it time
  if [ -f $d/DONE ] || [ -f $d/BLOCKED ]; then   # worker finished (wrote DONE/BLOCKED) but its wrapper died before writing exit/ended (00:57Z app): finalize, not a death
    $O/bin/stop-worker $w "finished; wrapper ended before its exit marker (ensure-daemons)" >/dev/null 2>&1; fin="$fin $w"; continue; fi
  $O/bin/stop-worker $w "died in container restart (ensure-daemons)" >/dev/null 2>&1   # finalizes the orphan: commits WIP to tl/<worker>
  dead="$dead $w"
done
if [ -n "$dead" ]; then
  if grep -qE "^MERGE-ONLY lanes:.*\b$A\b" $O/design/BOARD-HEADER.md 2>/dev/null; then   # lane machine cannot keep workers alive (07:20Z app): failover lane owns them
    printf '\n## ensure-daemons %s: workers died (container restart)\nThis lane is MERGE-ONLY (BOARD-HEADER): do NOT re-dispatch these here. The failover lane owns them (resume from tl/<worker>):%s\n' "$(date -u +%FT%TZ)" "$dead" >> $O/managers/$A/INBOX.md
  else
    printf '\n## ensure-daemons %s: workers died (container restart)\nRe-dispatch fresh (on the same branch with `--base tl/<worker>` if it has commits):%s\n' "$(date -u +%FT%TZ)" "$dead" >> $O/managers/$A/INBOX.md
  fi
fi
[ -n "$fin" ] && mgr="$mgr FINALIZED (finished, wrapper left no exit marker; not a death, do not re-dispatch):$fin"
echo "$(date -u +%FT%TZ) ensure-daemons $A: uptime $(awk '{printf "%d", $1/60}' /proc/uptime)m; started:${started:- none}; dead workers:${dead:- none}; disk $(df -BG --output=avail /home/user | tail -1 | tr -d ' ')$mgr"
