#!/bin/bash
# recycle WORKER... — remove the worktree of merged/abandoned workers (branch kept). Run by the orchestrator.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
for N in "$@"; do . $O/workers/$N/meta || continue; [ -f $O/workers/$N/running ] && { echo "$N still running"; continue; }
  git -C /home/user/work/$repo worktree remove --force $worktree && echo "recycled $N" && touch $O/workers/$N/recycled; done
