#!/bin/bash
# checkpoint-worker WORKER — host dispatcher only. Commits WORKER's worktree (git add -A) to tl/WORKER. Refuses for ended workers.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch; N=$1; D=$O/workers/$N
[ -f $D/meta ] && [ ! -f $D/ended ] || { echo "REFUSED: $N is not a running worker"; exit 1; }
WT=$(sed -n 's/^worktree=//p' $D/meta); [ -d "$WT" ] || { echo "REFUSED: no worktree for $N"; exit 1; }
[ -n "$(git -C $WT status --porcelain)" ] || { echo "nothing to commit; tl/$N at $(git -C $WT rev-parse --short HEAD)"; exit 0; }
MSG=$(head -1 $D/checkpoint-msg 2>/dev/null); [ -n "$MSG" ] || MSG="tl/$N: checkpoint"
git -C $WT add -A && git -C $WT commit -q -m "$MSG" && echo "checkpointed tl/$N at $(git -C $WT rev-parse --short HEAD)" && echo "$(date -u +%FT%TZ) $N $(git -C $WT rev-parse --short HEAD)" >> $D/checkpoints
