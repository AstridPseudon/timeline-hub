#!/bin/bash
# workers [MANAGER-PREFIX]  — table of workers: name, state, exit, age, commits ahead of base, report present
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
for d in $O/workers/${1}*/; do [ -f $d/meta ] || continue; . $d/meta
 st=done; [ -f $d/running ] && st=running; ex=$(cat $d/exit 2>/dev/null || echo -)
 ahead=$(git -C $worktree rev-list --count $base_sha..HEAD 2>/dev/null || echo ?)
 printf '%-34s %-8s exit=%-4s commits=%-3s report=%s started=%s\n' $name $st $ex $ahead $([ -s $d/report.md ] && echo yes || echo no) $started
done
