#!/bin/bash
# recycle WORKER... — remove the worktree of finished workers (branch kept). Refuses running, dirty, KEEP-marked or leased (named in managers/*/notes/*.lease or *ACTIVE*) worktrees (never --force).
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
for N in "$@"; do
  repo=$(sed -n 's/^repo=//p' $O/workers/$N/meta 2>/dev/null); worktree=$(sed -n 's/^worktree=//p' $O/workers/$N/meta 2>/dev/null)
  [ -n "$repo" ] || { echo "$N: no meta"; continue; }
  mkdir -p "$O/tests/.worker-leases/.locks" "$O/tests/.worker-leases/$N"
  exec 8>"$O/tests/.worker-leases/.locks/$N.lock"; flock -x 8
  LEASE_TEST=$(find "$O/tests/.worker-leases/$N" -maxdepth 1 -type f -print -quit 2>/dev/null)
  if [ -n "$LEASE_TEST" ]; then
    LEASE_STATUS=$(cat "$O/tests/${LEASE_TEST##*/}/status" 2>/dev/null)
    case $LEASE_STATUS in queued|running) echo "$N: queued test lease, refused"; continue;; esac
  fi
  [ -f "$O/workers/$N/running" ] && { echo "$N still running"; continue; }
  [ -f $O/workers/$N/KEEP ] && { echo "$N: KEEP marker, refused"; continue; }
  grep -lqsw -- "$N" $O/managers/*/notes/*.lease $O/managers/*/notes/*ACTIVE* 2>/dev/null && { echo "$N: leased (managers/*/notes), refused"; continue; }
  [ -d "$worktree" ] || { echo "$N: no worktree"; touch $O/workers/$N/recycled; continue; }
  [ -n "$(git -C $worktree status --porcelain 2>/dev/null | head -1)" ] && { echo "$N: DIRTY, refused"; continue; }
  git -C /home/user/work/$repo worktree remove $worktree && echo "recycled $N" && touch $O/workers/$N/recycled
done
