#!/bin/bash
# Runs outside any sandbox. Launches queued worker requests via bin/dispatch, merges via bin/merge, test runs via bin/test-run; refused requests retry next pass unless the error is permanent.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
ME=$(readlink -f "$0"); MT=$(stat -c %Y "$ME")   # self-reload: when hub-sync installs a new version, exec it between passes
echo $$ > $O/dispatcher.pid; trap 'STOP=1' TERM INT   # on kill: finish the current item, then exit (queued work stays in pending/)
while true; do
  # FIFO (2026-10-20): oldest request first by mtime, name as tie-break, so no area starves behind newer alphabetically-earlier names.
  for f in $(cd $O/queue/pending && ls -1tr --time=mtime 2>/dev/null | sed "s#^#$O/queue/pending/#"); do [ -e "$f" ] || continue; n=$(basename $f); [ -n "$STOP" ] && break
    if head -c5 "$f" | grep -q '^TEST '; then out=$($O/bin/test-run $(sed 's/^TEST //' "$f") 2>&1); rc=$?   # starts in background; never blocks
    elif head -c9 "$f" | grep -q '^CHECKOUT '; then out=$($O/bin/make-checkout $(sed 's/^CHECKOUT //' "$f") 2>&1); rc=$?
    elif head -c5 "$f" | grep -q '^STOP '; then out=$($O/bin/stop-worker $(sed 's/^STOP //' "$f") 2>&1); rc=$?
    elif head -c6 "$f" | grep -q '^MERGE '; then out=$($O/bin/merge $(sed 's/^MERGE //' "$f") 2>&1); rc=$?; [ $rc = 3 ] || rc=$([ $rc = 0 ] && echo 0 || echo 1)
    else out=$(eval "$O/bin/dispatch $(cat $f)" 2>&1); rc=$?; fi
    if [ $rc = 0 ]; then echo "$out" > $O/queue/done/$n; rm -f $f
    elif [ $rc = 3 ]; then echo "$(date -u +%FT%TZ) waiting: $out" > $O/queue/pending/.$n.why   # resource limit: retry later
    else echo "$out" > $O/queue/refused/$n; rm -f $f; fi
  done
  # reap: managers' finished rounds
  [ -n "$STOP" ] && exit 0; date -u +%FT%TZ > $O/dispatcher.heartbeat
  [ "$(stat -c %Y "$ME" 2>/dev/null)" != "$MT" ] && bash -n "$ME" && exec "$ME"
  sleep 15
done
