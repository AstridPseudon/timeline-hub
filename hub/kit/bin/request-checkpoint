#!/bin/bash
# request-checkpoint WORKER — (30 Oct) a coordinator asks the dispatcher (outside the sandbox) to commit its worktree's current
# changes to its own branch tl/WORKER, so its Luna sub-workers' merges into that branch can proceed. Commit message: the first
# line of $ORCH/workers/WORKER/checkpoint-msg if present. Result in $ORCH/queue/done|refused/checkpoint-WORKER-<ts>.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
N=$1; [ -n "$N" ] && [ -f $O/workers/$N/meta ] || { echo "usage: request-checkpoint WORKER (no such worker)"; exit 2; }
F=checkpoint-$N-$(date -u +%H%M%S); echo "CHECKPOINT $N" > $O/queue/pending/$F; echo "checkpoint of $N queued; result in $O/queue/done/$F (or refused/$F)"
