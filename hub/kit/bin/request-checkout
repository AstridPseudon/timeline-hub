#!/bin/bash
# request-checkout REPO SHA "reason" — ask the dispatcher for a KEEP detached checkout of an exact commit at
# /home/user/work/wt/<pfx>-pin-<sha8> (pfx agt|rt|app|vw). Result in $ORCH/queue/done/checkout-<repo>-<sha>. No escalation needed.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
[ -n "$2" ] || { echo "usage: request-checkout REPO SHA reason"; exit 2; }
echo "CHECKOUT $*" > $O/queue/pending/checkout-$1-$2; echo "checkout of $1 $2 queued; result in $O/queue/done/checkout-$1-$2"
