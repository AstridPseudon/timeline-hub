#!/bin/bash
# request-runtime NAME AGENT_SHA [LOCK_SHA256] — ask the dispatcher to build a new read-only Remotion runtime
# /home/user/work/runtimes/NAME (agent-remotion-<version>) from the Agent remotion/ dir at AGENT_SHA. Result in
# $ORCH/queue/done/runtime-NAME. Runtimes are immutable: a new version gets a new NAME. No escalation needed.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
[ -n "$2" ] || { echo "usage: request-runtime agent-remotion-<ver> AGENT_SHA [LOCK_SHA256]"; exit 2; }
echo "RUNTIME $*" > $O/queue/pending/runtime-$1; echo "runtime $1 queued; result in $O/queue/done/runtime-$1"
