#!/usr/bin/env bash
# progress-json: builds the JSON datasets for the Timeline Foundation Tracker.
# Read-only on the orchestrator tree; writes only to $ORCH/delivery/progress/.
# (The one outside side effect is the hub fetch the spec asks for, which updates FETCH_HEAD in the hub clone.)
set -euo pipefail
ORCH="${ORCH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OUT="$ORCH/delivery/progress"
mkdir -p "$OUT"
export ORCH OUT
export GIT_TERMINAL_PROMPT=0
HUB=/home/user/timeline-hub
# Spec'd hub fetch; failure is tolerated (falls back to the last known origin/main).
if [ -d "$HUB/.git" ]; then
  timeout 60 git -C "$HUB" fetch -q origin main >/dev/null 2>&1 && HUB_REF=FETCH_HEAD || HUB_REF=origin/main
else
  HUB_REF=none
fi
export HUB HUB_REF
exec python3 -I - <<'PY'
import os, re, sys, json, glob, subprocess, time
from datetime import datetime, timezone, timedelta

ORCH = os.environ["ORCH"]; OUT = os.environ["OUT"]
HUB = os.environ["HUB"]; HUB_REF = os.environ["HUB_REF"]
NOW = datetime.now(timezone.utc)
TODAY = NOW.strftime("%Y-%m-%d")
MIDNIGHT = TODAY + "T00:00:00Z"
CHART_HOURS = 12  # rolling window: the last 12 hours, so the chart survives midnight
CHART_START = (NOW - timedelta(hours=CHART_HOURS)).replace(minute=0, second=0, microsecond=0)

def rd(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""

# ---- redaction: this is status data only, never secrets or local paths ----
SECRET = re.compile(r"(?i)(sk-[A-Za-z0-9_\-]{10,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[abp]-[A-Za-z0-9\-]{10,}|AKIA[0-9A-Z]{12,}|Bearer\s+\S+|(?:api[_-]?key|token|secret|password|passwd)\s*[=:]\s*\S+)")
PATH = re.compile(r"(?<![\w.])/(?:tmp|home|root|var|opt|usr|etc)/[^\s,;)\]]*")
def clean(s):
    if not isinstance(s, str):
        return s
    s = SECRET.sub("[redacted]", s)
    s = PATH.sub("[path]", s)
    return s.replace("\x00", "").strip()

def cleanrows(rows):
    return [{k: clean(v) for k, v in r.items()} for r in rows]

def write(name, rows):
    rows = cleanrows(rows)
    tmp = os.path.join(OUT, "." + name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(rows, f, indent=1, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, os.path.join(OUT, name))

def git(repo, *args, timeout=60):
    try:
        r = subprocess.run(["git", "--no-optional-locks", "-C", repo, *args], capture_output=True,
                           text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""

# ---------------------------------------------------------------- inputs
PLAN = rd(f"{ORCH}/PLAN.md")
STATE = rd(f"{ORCH}/STATE.md")
STATUS = {a: rd(f"{ORCH}/managers/{a}/STATUS.md") for a in ("runtime", "agent", "app", "viewing")}
AREAS = [  # area, machine, worker prefix, repo for merges
    ("runtime", "main", "rt", "runtime"),
    ("agent", "main", "agt", "agent"),
    ("app", "app", "app", "app"),
    ("viewing", "viewing", "vw", "composition"),
]

def section(text, start_re, end_re=r"^## "):
    m = re.search(start_re, text, re.M)
    if not m:
        return ""
    rest = text[m.end():]
    e = re.search(end_re, rest, re.M)
    return rest[:e.start()] if e else rest

def first_line(a):
    for ln in STATUS[a].splitlines():
        if ln.strip() and not ln.lstrip().startswith("<!--"):
            return ln.strip().lstrip("# ").strip()
    return ""

# ---------------------------------------------------------------- merges (shared by several outputs)
def parse_merges_log():
    rows = []
    for ln in rd(f"{ORCH}/merges.log").splitlines():
        p = ln.split()
        if len(p) < 3:
            continue
        try:
            t = datetime.strptime(p[0], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        except ValueError:
            continue
        rows.append({"t": t, "repo": p[1], "branch": re.sub(r"^tl/", "", p[2])})
    return rows

def hub_merges(repo):
    d = f"/home/user/work/{repo}"
    out = git(d, "log", f"--since={min(MIDNIGHT, CHART_START.strftime('%Y-%m-%dT%H:%M:%SZ'))}", "--merges", "--format=%cI|%s", "hub/tl/integration")
    rows = []
    for ln in out.splitlines():
        iso, _, subj = ln.partition("|")
        m = re.match(r"Merge tl/(\S+)", subj)
        if not m:
            continue
        try:
            t = datetime.fromisoformat(iso).astimezone(timezone.utc)
        except ValueError:
            continue
        rows.append({"t": t, "repo": repo, "branch": m.group(1)})
    return rows

log_rows = [r for r in parse_merges_log() if r["t"].strftime("%Y-%m-%d") == TODAY]
hub_rows = {repo: [r for r in hub_merges(repo) if r["t"].strftime("%Y-%m-%d") == TODAY] for repo in ("app", "composition")}

# ---------------------------------------------------------------- 0. milestone status from the PLAN.md "## Gate record"
# A line starting "- M<n> " that contains **RECORDED** marks that milestone done; "Checkpoint A ... APPROVED" marks M0 done.
# The current milestone is the first one that is not recorded.
order = ["M0", "M1", "M2", "M3", "M4"]
gate_rec = section(PLAN, r"^## Gate record.*$", r"\Z")
cpa = None
cpa_line = re.search(r"^-\s*Checkpoint A[^\n]*APPROVED[^\n]*", gate_rec, re.M)
if cpa_line:
    cpa = re.search(r"APPROVED\**\s+(\d{4}-\d{2}-\d{2})\s*~?\s*(\d{2}:\d{2}Z)", cpa_line.group(0)) or True
recorded = {}  # "M1" -> "2026-10-20 ~03:55Z" (or "" when the line has no stamp)
for ln in gate_rec.splitlines():
    m = re.match(r"-\s*(M\d)\b", ln)
    if m and re.search(r"\*\*RECORDED\b", ln):
        t = re.search(r"RECORDED\**\s+(\d{4}-\d{2}-\d{2})\s*~?\s*(\d{2}:\d{2}Z)", ln)
        recorded[m.group(1)] = f"{t.group(1)} ~{t.group(2)}" if t else ""
hard = re.search(r"Hard stop[^\n]*?:\s*\*{0,2}\s*([A-Z][A-Z ]+)", gate_rec)
done = {k: k in recorded for k in order}
done["M0"] = bool(cpa)
if hard and hard.group(1).strip().upper().startswith("DONE"):
    done["M4"] = True
CURRENT = next((k for k in order if not done[k]), None)

# ---------------------------------------------------------------- deletion ledger rows (exit items from M2 on)
def ledger_rows():
    """Rows of design/deletion-ledger.<area>.md (these hold every row; the generated combined view lists only D-prefixed ids).
    Falls back to the combined view when no per-area file exists."""
    files = sorted(glob.glob(f"{ORCH}/design/deletion-ledger.*.md"))
    per = [f for f in files if os.path.basename(f) != "deletion-ledger.md"]
    rows, seen_ids = [], set()
    for f in (per or files):
        for ln in rd(f).splitlines():
            if not ln.startswith("|"):
                continue
            c = [x.strip() for x in ln.strip().strip("|").split("|")]
            if len(c) < 7 or c[0].lower() == "id" or set(c[0]) <= set("-: ") or c[0] in seen_ids:
                continue
            seen_ids.add(c[0])
            rows.append({"id": c[0], "what": c[1], "owner": c[4], "ms": c[5], "status": c[6]})
    return rows

def ledger_exit(ms):
    out = []
    for r in ledger_rows():
        if ms not in re.findall(r"M\d", r["ms"]):
            continue
        stl = re.sub(r"[^A-Za-z-]", "", r["status"]).lower()
        if stl == "keep":  # retention decisions are not deletions, so they are not exit items
            continue
        st = "done" if stl == "deleted" else ("partial" if stl == "in-progress" else "pending")
        what = re.sub(r"\s+", " ", r["what"])
        out.append({"item": f"{r['id']}: {what}"[:140], "status": st, "owner": r["owner"] or "unassigned"})
    return out

# ---------------------------------------------------------------- 1. exit items of the CURRENT milestone (dataset file name stays m1_exit.json)
DEC = re.search(r"M1 exit\s*=\s*(.+)", PLAN)
def split_top(s):
    parts, depth, cur = [], 0, ""
    i = 0
    while i < len(s):
        ch = s[i]
        if ch == "(": depth += 1
        elif ch == ")": depth -= 1
        if depth == 0 and s[i:i+3] == " + ":
            parts.append(cur.strip()); cur = ""; i += 3; continue
        cur += ch; i += 1
    parts.append(cur.strip())
    return [p.rstrip(". ").strip() for p in parts if p.strip()]

items_txt = split_top(DEC.group(1)) if DEC else []
ALLSTAT = "\n".join(STATUS.values())
LOG = section(STATE, r"^## Log\s*$")

def exit_state(i, text):
    low = text.lower()
    if "e2e-m1-gesture" in low:
        ok = bool(re.search(r"M1 real[^\n]{0,60}\d\s*PASS|MAIN\s*\d\s*PASS|e2e-m1-gesture[^\n]{0,40}PASS", STATUS["runtime"] + STATUS["agent"], re.I))
        return ("done" if ok else "pending"), "runtime"
    if "restored" in low:
        ok = bool(re.search(r"restored[^\n]{0,80}PASS|ALL\s*5\s*journeys\s*PASS", STATUS["app"], re.I))
        return ("done" if ok else "pending"), "app"
    if "restore preservation" in low:
        rt_ok = bool(re.search(r"restore\s*7[^\n]{0,30}(preserved|pass)|restore API preservation PASS", STATUS["runtime"] + STATUS["agent"], re.I))
        app_pending = bool(re.search(r"In flight:[^\n]*restore[-\s]?head[-\s]?pair|restoreHistory[^\n]{0,80}(fix|bug)[^\n]{0,40}(in flight|pending)", STATUS["app"], re.I))
        if rt_ok and not app_pending: return "done", "app"
        if rt_ok or not app_pending: return "partial", "app"
        return "pending", "app"
    if "full-suite" in low or "full suite" in low:
        newf = bool(re.search(r"(FOUR|\d+)\s*NEW\s*(consumer|full)|new agent full failures", ALLSTAT + LOG, re.I))
        return ("pending" if newf else "done"), "agent and viewing"
    if "audit" in low:
        latest = sorted(glob.glob(f"{ORCH}/audits/*.md"))
        verdict = rd(latest[-1]).strip().split("\n")[0] if latest else ""
        recorded = bool(re.search(r"M1 (recorded|closed)", LOG, re.I))
        clear = bool(re.match(r"\W*(APPROVE|CLEAR|PASS|NO BLOCKING)", verdict, re.I))
        return ("done" if (clear or recorded) else "pending"), "orchestrator"
    return "pending", "orchestrator"

PLAIN = {
    "e2e-m1-gesture": "End-to-end clip move test passes on the central machine",
    "restored": "App journeys restored and passing",
    "restore preservation": "Restore keeps all earlier edits (Runtime and Agent done; App restore-history fix pending)",
    "full-suite": "Every new failure in the full test suites is explained",
    "audit": "Deep audit finds nothing that blocks",
}
m1_exit = []
if CURRENT == "M1":
    for i, t in enumerate(items_txt):
        st, owner = exit_state(i, t)
        label = next((v for k, v in PLAIN.items() if k in t.lower()), t)
        if "restore preservation" in t.lower():
            label = "Restore keeps earlier work intact" + (" (App fix still pending)" if st != "done" else "")
        m1_exit.append({"item": label[:200], "status": st, "owner": owner})
elif CURRENT:
    m1_exit = ledger_exit(CURRENT)
write("m1_exit.json", m1_exit)
exit_total = len(m1_exit)
exit_done = sum(1 for r in m1_exit if r["status"] == "done")
exit_partial = sum(1 for r in m1_exit if r["status"] == "partial")

# ---------------------------------------------------------------- 2. milestones
names = {}
for m in re.finditer(r"^\|\s*\*\*(M\d)\*\*\s*\|\s*\*\*(.+?)\*\*", section(PLAN, r"^## 5\. Milestones"), re.M):
    names[m.group(1)] = m.group(2).strip()
status = {}
seen_next = False
for k in order:
    if done[k]: status[k] = "done"
    elif k == CURRENT: status[k] = "active"
    elif not seen_next: status[k] = "next"; seen_next = True
    else: status[k] = "later"
status["M5"] = "later"
CHIP = {"done": "Done", "active": "In progress", "next": "Next", "later": "Later"}
notes = {}
def rec_note(k, label):
    return f"{label} {recorded[k]}".strip() if recorded.get(k) is not None else ""
if isinstance(cpa, re.Match):
    notes["M0"] = f"Checkpoint A approved {cpa.group(1)} ~{cpa.group(2)}"
else:
    notes["M0"] = "Checkpoint A approved" if cpa else "Design checkpoint not yet approved"
exit_text = (f"{exit_done} of {exit_total} exit items done" + (f", {exit_partial} partly done" if exit_partial else "")) if exit_total else "Exit list not found"
if CURRENT == "M2":
    exit_text = f"{exit_done} of {exit_total} deletion rows deleted" + (f", {exit_partial} in progress" if exit_partial else "")
m3_run = bool(re.search(r"M3\s*active", STATUS["viewing"], re.I))
for k in ("M1", "M2", "M3", "M4"):
    if done[k]:
        notes[k] = rec_note(k, "Recorded") or "Recorded"
    elif k == CURRENT:
        notes[k] = exit_text
    elif k == "M3":
        notes[k] = "Viewing is already building the shared package; closes after M2" if m3_run else "Not started"
    else:
        notes[k] = "Not started"
if not done["M4"]:
    notes["M4"] = "Ends at the owner hard stop" + (f" (status: {hard.group(1).strip().lower()})" if hard else "")
notes["M5"] = "After owner go-ahead; nothing starts before the hard stop"
milestones = []
for k in order + ["M5"]:
    cur = (k == CURRENT)
    # exit_done/exit_total describe the exit dataset (m1_exit.json), i.e. the CURRENT (active) milestone's items;
    # other milestones carry null (their own counts are not kept once they are recorded).
    show = cur
    r = {"id": k, "name": names.get(k, k), "status": status[k], "chip": "After owner go-ahead" if k == "M5" else CHIP[status[k]],
         "exit_done": exit_done if show else None, "exit_total": exit_total if show else None, "note": notes[k]}
    milestones.append(r)
write("milestones.json", milestones)

# ---------------------------------------------------------------- 3. gates
gnames = {}
for m in re.finditer(r"^(\d)\.\s+\*\*(.+?)\*\*", section(PLAN, r"^## 6\. The seven gates"), re.M):
    gnames[int(m.group(1))] = m.group(2).strip()
NEEDS = {
    1: "full editing coverage across CLI, Python and sheet (M2)",
    2: "crash, retry and concurrent-commit cases across the whole edit set (M2)",
    3: "all three clients and an honest preview message when the renderer is off",
    4: "the full set of Runtime door authorization and generated-client checks",
    5: "the same journey on fresh main at delivery (M4)",
    6: "every App writer on the one path, plus a planted picture/audio mismatch caught (M2 and M3)",
    7: "green repository gates, real build, ZIP applies to fresh main, owner film viewing (M4)",
}
claims = {n: [] for n in range(1, 8)}  # n -> [(area, kind)]
for a, body in STATUS.items():
    for ln in body.splitlines():
        if not ln.startswith("Gates:"):
            continue
        txt = ln[len("Gates:"):]
        for seg in txt.split(";"):
            seg = seg.strip()
            m = re.match(r"([1-7])(?!\d)\s*(.*)", seg)
            if m:
                n, rest = int(m.group(1)), m.group(2)
                p, o = "PASS" in rest, "OPEN" in rest
                if p and o: kind = "partial"
                elif p: kind = "partial" if re.search(r"M1|subset|focused|slice|only|move", rest, re.I) else "proven"
                elif o: kind = "open"
                else: continue
                claims[n].append((a, kind))
            for sm in re.finditer(r"slices?\s*((?:[1-7]/?)+)\s*PASS", seg):
                for d in re.findall(r"[1-7]", sm.group(1)):
                    claims[int(d)].append((a, "partial"))
            for gm in re.finditer(r"gate\s*([1-7])[^;.]*?OPEN", seg, re.I):
                claims[int(gm.group(1))].append((a, "open"))
gates = []
for n in range(1, 8):
    kinds = {k for _, k in claims[n]}
    if not kinds or kinds == {"open"}: st = "open"
    elif kinds == {"proven"}: st = "proven"
    else: st = "partial"
    passing = sorted({a for a, k in claims[n] if k in ("partial", "proven")})
    need = NEEDS.get(n, "")
    if st == "proven":
        ev = "Reported passing by " + ", ".join(passing) + "."
    elif st == "partial":
        ev = "Early slice passing (" + ", ".join(passing) + "). Still to prove: " + need + "."
    else:
        ev = "Nothing proven yet. Needs: " + need + "."
    gates.append({"id": n, "name": gnames.get(n, f"Gate {n}"), "status": st, "evidence": ev})
write("gates.json", gates)

# ---------------------------------------------------------------- 4. areas
def live_main_worktrees():
    """Worktree paths of live main-machine workers: `codex exec` command lines (-C <worktree>) and the cwd of live `claude` processes."""
    cmds, cwds = [], []
    for pd in glob.glob("/proc/[0-9]*"):
        try:
            argv = [x for x in open(pd + "/cmdline", "rb").read().decode("utf-8", "replace").split("\0") if x]
        except OSError:
            continue
        if not argv:
            continue
        names_ = [os.path.basename(x) for x in argv[:2]]
        if "codex" in names_ and "exec" in argv[1:3]:
            cmds.append(" ".join(argv))
        elif names_[0] == "claude":
            try:
                cwds.append(os.readlink(pd + "/cwd"))
            except OSError:
                pass
    return cmds, cwds

LIVE_CMDS, LIVE_CWDS = live_main_worktrees()

def worktree_of(d):
    for ln in rd(os.path.join(d, "meta")).splitlines():
        if ln.startswith("worktree="):
            return ln.split("=", 1)[1].strip()
    return ""

def worker_live(d):
    wt = worktree_of(d).rstrip("/")
    if not wt:
        return False
    pat = re.compile(re.escape(wt) + r"(?![\w./-])")
    return any(pat.search(c) for c in LIVE_CMDS) or any(c == wt or c.startswith(wt + "/") for c in LIVE_CWDS)

def running_dirs(prefix):
    return [d for d in glob.glob(f"{ORCH}/workers/{prefix}-*") if os.path.isfile(os.path.join(d, "running"))]

def running_workers(prefix):
    return len(running_dirs(prefix))

def live_workers(prefix):
    return sum(1 for d in running_dirs(prefix) if worker_live(d))

def in_flight_count(a):
    for ln in STATUS[a].splitlines():
        if ln.lower().startswith("in flight:"):
            return len(set(re.findall(r"\b(?:app|vw|agt|rt)-[a-z0-9]+(?:-[a-z0-9]+)+", ln)))
    return 0

def sync_age(machine):
    if HUB_REF == "none":
        return None
    out = git(HUB, "log", HUB_REF, "-1", "--format=%ct", f"--grep=hub-sync {machine}").strip()
    if not out.isdigit():
        return None
    return max(0, int((NOW.timestamp() - int(out)) // 60))

areas = []
for a, machine, prefix, repo in AREAS:
    ml = ""
    for ln in STATUS[a].splitlines():
        if ln.startswith("Milestone:"):
            ml = ln.strip(); break
    ml = ml[:160]
    if os.path.exists(f"{ORCH}/managers/{a}/REMOTE"):
        # REMOTE area: workers run on another machine, so only the synced folders and the status line are visible. Approximate.
        w = wd = running_workers(prefix)
        basis = "worker folders, approximate"
        fl = in_flight_count(a)
        if fl > wd:
            w, basis = fl, "status line, approximate"
    else:
        # main machine: a worker counts only if its worktree is held by a live `codex exec` or `claude` process
        w = live_workers(prefix)
        basis = "live processes"
    if a in ("runtime", "agent"):
        merges = sum(1 for r in log_rows if r["repo"] == repo)
    else:
        merges = len(hub_rows[repo])
    areas.append({"area": a, "machine": machine, "milestone_line": ml, "workers_running": w, "workers_basis": basis,
                  "merges_today": merges, "last_sync_minutes": sync_age(machine)})
write("areas.json", areas)

# ---------------------------------------------------------------- 5. merges by hour
start = CHART_START
repos = ["agent", "runtime", "app", "composition"]
seen = set(); evs = []
for r in log_rows + hub_rows["app"] + hub_rows["composition"]:
    key = (r["repo"], r["branch"])
    if key in seen or r["t"] < start:
        continue
    seen.add(key); evs.append(r)
counts = {}
for r in evs:
    h = r["t"].replace(minute=0, second=0, microsecond=0)
    counts[(h, r["repo"])] = counts.get((h, r["repo"]), 0) + 1
hours = []
h = start
cur = NOW.replace(minute=0, second=0, microsecond=0)
while h <= cur:
    hours.append(h); h += timedelta(hours=1)
extra = sorted({r["repo"] for r in evs} - set(repos))
mbh = [{"hour": h.strftime("%Y-%m-%dT%H:00:00Z"), "repo": rp, "count": counts.get((h, rp), 0)} for h in hours for rp in repos + extra]
write("merges_by_hour.json", mbh)

# ---------------------------------------------------------------- 6. blockers
bl = []
for f in sorted(glob.glob(f"{ORCH}/escalations/*.md")):
    base = os.path.basename(f)
    title = ""
    for ln in rd(f).splitlines():
        if ln.startswith("#"):
            title = ln.lstrip("# ").strip(); break
    title = re.sub(r"\s+[—-]\s+\d{4}-\d{2}-\d{2}T[\d:]+Z?\s*$", "", title) or base
    owner = base.split("-", 1)[0]
    m = re.search(r"(\d{8})T(\d{4,6})Z", base)
    if m:
        d, t = m.group(1), m.group(2).ljust(6, "0")
        since = f"{d[:4]}-{d[4:6]}-{d[6:]}T{t[:2]}:{t[2:4]}:{t[4:]}Z"
    else:
        since = datetime.fromtimestamp(os.path.getmtime(f), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    bl.append({"what": title, "owner": owner, "since": since, "source": "escalation"})
try:
    man = json.loads(rd(f"{OUT}/blockers-manual.json") or "[]")
    for r in man if isinstance(man, list) else []:
        if isinstance(r, dict) and r.get("what"):
            bl.append({"what": str(r["what"]), "owner": str(r.get("owner", "")), "since": str(r.get("since", "")), "source": "manual"})
except ValueError:
    pass
write("blockers.json", bl)
print("progress-json: wrote 6 files to", OUT)
PY
