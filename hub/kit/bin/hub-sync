#!/bin/bash
# hub-sync MACHINE  (main | app | viewing | app2): one sync cycle with the hub (see $ORCH/COMMS.md).
set -u
M=$1
ORCH=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
HUBURL=https://github.com/AstridPseudon/timeline-hub
H=/home/user/timeline-hub
W=/home/user/work
# Handover: an area moves to its remote machine only after a handshake.
#   remote writes hub/status/<area>.READY -> main stops its local manager, publishes final STATUS/INBOX,
#   marks $ORCH/managers/<area>/REMOTE and writes hub/status/<area>.HANDOVER -> remote starts its manager.
# Until then main keeps the area (and its home repo) local.
declare -A REPO_OF=( [app]=app [viewing]=composition [app2]=app [agent]=agent )
case $M in
  main)    AREAS="runtime"; HOME_REPOS="runtime"; REMOTE_AREAS=""
           for a in agent app viewing app2; do
             [ $a = app2 ] && [ ! -e $ORCH/managers/app2/REMOTE ] && continue   # app2 only ever runs remotely
             if [ -e $ORCH/managers/$a/REMOTE ]; then REMOTE_AREAS="$REMOTE_AREAS $a"
             else AREAS="$AREAS $a"; HOME_REPOS="$HOME_REPOS ${REPO_OF[$a]}"; fi
           done;;
  app)     AREAS="app";           HOME_REPOS="app";           REMOTE_AREAS="";;
  viewing) AREAS="viewing";       HOME_REPOS="composition";   REMOTE_AREAS="";;
  agent)   AREAS="agent";         HOME_REPOS="agent";         REMOTE_AREAS="";;   # Agent's own machine (2026-10-20), via the normal handover
  # app2: a second App machine (2026-10-20). Owns NO repo: its app branches merge through the App home via merge requests. No handover.
  app2)    AREAS="app2";          HOME_REPOS="";              REMOTE_AREAS=""; mkdir -p $ORCH/managers/app2; touch $ORCH/managers/app2/HANDOVER_DONE;;
  *) echo "usage: hub-sync main|app|viewing|app2|agent"; exit 2;;
esac
# on a remote machine, home repos count as mine only once the handover arrived
[ $M != main ] && [ ! -e $ORCH/managers/$AREAS/HANDOVER_DONE ] && HOME_REPOS=""
[ $M = app2 ] && HOME_REPOS=""
exec 8>$ORCH/.hub-sync.lock; flock -w 300 8 || exit 0   # never race hub-syncd
now=$(date -u +%FT%TZ)
retry(){ local d=2; for i in 1 2 3 4 5; do "$@" && return 0; sleep $d; d=$((d*2)); done; return 1; }

# --- files checkout (branch timeline-hub) ---
if [ ! -d $H/.git ]; then
  git clone -q $HUBURL $H 2>/dev/null || { mkdir -p $H; git -C $H init -q; git -C $H remote add origin $HUBURL; }
  git -C $H fetch -q origin main 2>/dev/null && git -C $H checkout -q -B main origin/main || git -C $H checkout -q -B main
fi
cd $H
# self-heal: a sync killed mid-rebase leaves the clone stuck and every later files push rejected
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then git rebase --abort 2>/dev/null || rm -rf .git/rebase-merge .git/rebase-apply; echo "$(date -u +%FT%TZ) hub-sync: aborted stuck rebase" >&2; fi
git pull -q --rebase origin main 2>/dev/null || { git rebase --abort 2>/dev/null; git pull -q --no-rebase -X theirs origin main 2>/dev/null; }
mkdir -p hub/status hub/escalations/closed hub/inbox hub/design hub/merge-requests hub/merge-results $ORCH/escalations/closed $ORCH/design $ORCH/queue/pending $ORCH/queue/done $ORCH/queue/refused

# --- handover handshake ---
if [ $M = main ]; then
  for a in agent app viewing; do
    [ -e $ORCH/managers/$a/REMOTE ] && continue
    [ -e hub/status/$a.READY ] || continue
    p=$(pgrep -f "bin/run-manager $a" | head -1)
    [ -n "$p" ] && { pg=$(ps -o pgid= -p $p | tr -d " "); kill -TERM -- -$pg 2>/dev/null || kill -TERM $p; }; # timeout(1) gives codex its own process group: also kill every process running this manager's prompt
    for q in $(pgrep -f "codex exec"); do tr '\0' '\n' < /proc/$q/cmdline 2>/dev/null | grep -q "managers/$a/rounds" && kill -TERM -- -$(ps -o pgid= -p $q | tr -d " ") 2>/dev/null; done
    sleep 5; rm -f $ORCH/managers/$a/running
    { echo "<!-- main | $now | handed over -->"; cat $ORCH/managers/$a/STATUS.md; } > hub/status/$a.md
    cp $ORCH/managers/$a/INBOX.md hub/inbox/$a.md
    # publish the area's home repo integration one last time, so the new home starts from the true tip
    retry git -C $W/${REPO_OF[$a]} push -q hub refs/heads/tl/integration:refs/heads/timeline/${REPO_OF[$a]}/tl/integration
    touch $ORCH/managers/$a/REMOTE; echo "$now" > hub/status/$a.HANDOVER
    echo "- $now handover: $a manager stopped on main; area now runs on the $a machine" >> $ORCH/STATE.md
    AREAS=$(echo " $AREAS " | sed "s/ $a / /"); REMOTE_AREAS="$REMOTE_AREAS $a"
    HOME_REPOS=$(echo " $HOME_REPOS " | sed "s/ ${REPO_OF[$a]} / /")
  done
elif [ ! -e $ORCH/managers/$AREAS/HANDOVER_DONE ]; then
  a=$AREAS
  [ -e $ORCH/managers/$a/READY ] && [ ! -e hub/status/$a.READY ] && echo "$now" > hub/status/$a.READY
  if [ -e hub/status/$a.HANDOVER ]; then
    tail -n +2 hub/status/$a.md > $ORCH/managers/$a/STATUS.md; cp hub/inbox/$a.md $ORCH/managers/$a/INBOX.md
    R=$W/${REPO_OF[$a]}; git -C $R fetch -q hub "+refs/heads/timeline/${REPO_OF[$a]}/*:refs/remotes/hub/*" && { [ "$(git -C $R symbolic-ref -q --short HEAD)" = tl/integration ] && git -C $R merge -q --ff-only hub/tl/integration || git -C $R branch -f tl/integration hub/tl/integration; }
    touch $ORCH/managers/$a/HANDOVER_DONE; HOME_REPOS=${REPO_OF[$a]}
  else AREAS=""; fi   # not mine yet: publish nothing about the area
fi

hb=$(( $(date +%s) - $(stat -c %Y $ORCH/dispatcher.heartbeat 2>/dev/null || echo 0) ))
declare -A WPFX=( [agent]=agt [runtime]=rt [app]=app [viewing]=vw [app2]=ap2 )
for a in $AREAS; do
  # measured, not self-reported: live workers with a running marker, their models, and how old the manager's STATUS.md is
  live=0; sol=0; luna=0; other=0; for d in $ORCH/workers/${WPFX[$a]}-*/; do [ -f $d/running ] && [ ! -e $d/IMPORTED ] || continue; live=$((live+1))
    case $(sed -n 's/^model=//p' $d/meta 2>/dev/null) in *sol*) sol=$((sol+1));; *luna*) luna=$((luna+1));; *) other=$((other+1));; esac; done
  busy=0; cut=$(( $(date +%s) - 1800 )); for d in $ORCH/workers/${WPFX[$a]}-*/; do [ -e $d/IMPORTED ] && continue
    { [ -f $d/running ] || [ $(stat -c %Y $d/ended 2>/dev/null || echo 0) -ge $cut ]; } && busy=$((busy+1)); done   # running now or finished in the last 30 min
  sage=$(( ($(date +%s) - $(stat -c %Y $ORCH/managers/$a/STATUS.md 2>/dev/null || date +%s)) / 60 ))
  { echo "<!-- $M | $now | dispatcher heartbeat ${hb}s | live $live (sol $sol, luna $luna, other $other) | busy30 $busy | status age ${sage}m -->"; cat $ORCH/managers/$a/STATUS.md 2>/dev/null; } > hub/status/$a.md
  for f in $ORCH/escalations/$a-*.md; do [ -e "$f" ] && cp -n "$f" hub/escalations/; done
  # closed escalations of my own areas: if the orchestrator closed them on the hub, close locally too
  for f in hub/escalations/closed/$a-*.md; do [ -e "$f" ] && [ -e $ORCH/escalations/$(basename $f) ] && mv $ORCH/escalations/$(basename $f) $ORCH/escalations/closed/; done
  # inbox in (remote machines): append hub items not yet in the local inbox
  if [ $M != main ] && [ -f hub/inbox/$a.md ]; then
    python3 -I $ORCH/bin/inbox-merge hub/inbox/$a.md $ORCH/managers/$a/INBOX.md   # append new sections; keeps local lead notes
  fi
done
# peer messages written to $ORCH/hub/inbox/<area>.md (a path managers reach for, but which never syncs) are delivered into that
# area's real INBOX, then renamed. Main forwards to every area; remote machines forward what is addressed to their own areas.
for f in $ORCH/hub/inbox/*.md; do [ -f "$f" ] || continue; a=$(basename $f .md); [ -d $ORCH/managers/$a ] || a=${a%%-*}; [ -d $ORCH/managers/$a ] || continue   # <area>.md or <area>-<slug>.md
  { echo; echo "## $now — DELIVERED PEER MESSAGES (from \$ORCH/hub/inbox/$a.md)"; cat $f; } >> $ORCH/managers/$a/INBOX.md; mv $f $f.delivered-$(date +%s); done
if [ $M = main ]; then
  for a in $REMOTE_AREAS; do
    [ -f hub/status/$a.md ] && cp hub/status/$a.md $ORCH/managers/$a/STATUS.md
    for f in hub/escalations/$a-*.md; do [ -e "$f" ] || continue; b=$(basename $f)
      if [ -e $ORCH/escalations/closed/$b ]; then git mv -f $f hub/escalations/closed/$b 2>/dev/null || mv $f hub/escalations/closed/$b
      elif [ ! -e $ORCH/escalations/$b ]; then cp $f $ORCH/escalations/$b; fi; done
    [ -f $ORCH/managers/$a/INBOX.md ] && cp $ORCH/managers/$a/INBOX.md hub/inbox/$a.md
  done
fi
# shared kit: main publishes tools and rules; remote machines take them (PLAN changes and tool fixes propagate)
KIT="PLAN.md COMMON.md MANAGER-COMMON.md MODELS.md COMMS.md AREA-LEAD.md LEAD.md"
if [ $M = main ]; then mkdir -p hub/kit/bin; cp -p $ORCH/bin/* hub/kit/bin/ 2>/dev/null; rm -f hub/kit/bin/*.bak; for f in $KIT; do cp -p $ORCH/$f hub/kit/; done
else [ -d hub/kit ] && { for f in $KIT; do [ -f hub/kit/$f ] && cp -p hub/kit/$f $ORCH/$f; done; for f in hub/kit/bin/*; do b=$(basename $f); [ $b = hub-sync ] && continue; cmp -s $f $ORCH/bin/$b || { cp -p $f $ORCH/bin/.$b.new && mv $ORCH/bin/.$b.new $ORCH/bin/$b; }; done   # atomic: never rewrite a running script in place
  cmp -s hub/kit/bin/hub-sync $ORCH/bin/hub-sync || cp -p hub/kit/bin/hub-sync $ORCH/bin/hub-sync.next; }   # applied by hub-syncd between cycles
fi

# worker evidence for handed-over areas: main publishes its workers' report/meta/exit/commit.log + log tail and
# the area's test-service results; the remote machine copies them into its $ORCH/workers and $ORCH/tests (no overwrite)
declare -A PFX=( [app]=app [viewing]=vw [app2]=ap2 [agent]=agt )
declare -A TREPO=( [app]=app [viewing]=composition [app2]=app [agent]=agent )
if [ $M = main ]; then
  for a in $REMOTE_AREAS; do
    for d in $ORCH/workers/${PFX[$a]}-*; do [ -d "$d" ] || continue; w=$(basename $d); mkdir -p hub/workers/$w
      for f in report.md meta exit commit.log; do [ -f $d/$f ] && cp -p $d/$f hub/workers/$w/; done
      [ -f $d/log.txt ] && tail -n 400 $d/log.txt > hub/workers/$w/log-tail.txt; [ -f $d/running ] && touch hub/workers/$w/running || rm -f hub/workers/$w/running; done
    for d in $ORCH/tests/${TREPO[$a]}-*; do [ -d "$d" ] || continue; t=$(basename $d); mkdir -p hub/tests/$t
      for f in status exit summary ext snap; do [ -f $d/$f ] && cp -p $d/$f hub/tests/$t/; done; done
  done
else
  for d in hub/workers/*; do [ -d "$d" ] || continue; w=$(basename $d); mkdir -p $ORCH/workers/$w; touch $ORCH/workers/$w/IMPORTED
    for f in $d/*; do b=$(basename $f); [ $b = running ] && continue; cp -p $f $ORCH/workers/$w/$b; done
    [ -e $d/running ] && echo "$w is still running on MAIN" > $ORCH/workers/$w/ON-MAIN || rm -f $ORCH/workers/$w/ON-MAIN; done
  for d in hub/tests/*; do [ -d "$d" ] && [ ! -d $ORCH/tests/$(basename $d) ] && cp -rp $d $ORCH/tests/; done
fi

# immutable package artifacts (*.tgz <= 20 MB) both ways: a published file name is write-once; each carries a .sha256 sidecar.
# Never overwrite an existing name, whether hub or local; a digest mismatch is reported to stderr and the file left alone.
mkdir -p hub/artifacts $ORCH/artifacts
for f in $ORCH/artifacts/*.tgz; do [ -f "$f" ] || continue; b=$(basename $f); [ $(stat -c %s $f) -le 20971520 ] || continue
  [ -e hub/artifacts/$b ] || { cp -p $f hub/artifacts/$b; sha256sum $f | awk '{print $1}' > hub/artifacts/$b.sha256; }; done
for f in hub/artifacts/*.tgz; do [ -f "$f" ] || continue; b=$(basename $f); want=$(cat $f.sha256 2>/dev/null)
  [ -n "$want" ] && [ "$(sha256sum $f | awk '{print $1}')" != "$want" ] && { echo "hub-sync: artifact $b digest mismatch, skipped" >&2; continue; }
  [ -e $ORCH/artifacts/$b ] || cp -p $f $ORCH/artifacts/$b; done

# deletion ledger: per-area files sync like any design doc; main regenerates the combined read-only view after the sync-in
# design docs both ways, newer wins
for f in $ORCH/design/*; do [ -f "$f" ] || continue; b=$(basename "$f"); [ $(stat -c %s "$f") -le 52428800 ] || { echo "hub-sync: design/$b is over 50 MB, not published (keep big archives in a worker folder)" >&2; continue; }; [ ! -e "hub/design/$b" ] || [ "$f" -nt "hub/design/$b" ] && cp -p "$f" "hub/design/$b"; done
for f in hub/design/*; do [ -f "$f" ] || continue; b=$(basename "$f"); [ ! -e "$ORCH/design/$b" ] || [ "$f" -nt "$ORCH/design/$b" ] && cp -p "$f" "$ORCH/design/$b"; done
# cross-machine peer messages (design/peer-<from>-to-<area>-*.md, synced above): main delivers each new one into <area>'s INBOX once
if [ $M = main ]; then for f in $ORCH/design/peer-*-to-*.md; do [ -f "$f" ] || continue; b=$(basename "$f"); a=$(echo "$b" | sed -n 's/^peer-.*-to-\([a-z0-9]*\)-.*/\1/p')
  [ -n "$a" ] && [ -d $ORCH/managers/$a ] && ! grep -qxF "$b" $ORCH/.peer-delivered 2>/dev/null || continue
  { echo; echo "## $now — PEER MESSAGE ($b)"; cat "$f"; } >> $ORCH/managers/$a/INBOX.md; echo "$b" >> $ORCH/.peer-delivered; done; fi
[ $M = main ] && { $ORCH/bin/ledger-index; cp -p $ORCH/design/deletion-ledger.md hub/design/deletion-ledger.md; }

# --- code ---
for r in agent runtime app composition; do
  R=$W/$r; [ -d $R ] || continue
  git -C $R remote get-url hub >/dev/null 2>&1 || git -C $R remote add hub $HUBURL
  refs=""
  for b in $(git -C $R for-each-ref --format='%(refname:short)' 'refs/heads/tl/*'); do
    [ $b = tl/integration ] && ! echo " $HOME_REPOS " | grep -q " $r " && continue
    # a worker branch is published only by the machine that ran the worker (never by one that imported it)
    if [ $b != tl/integration ]; then w=${b#tl/}; [ -f $ORCH/workers/$w/meta ] && [ ! -e $ORCH/workers/$w/IMPORTED ] || continue; fi
    if [ $b = tl/integration ]; then refs="$refs refs/heads/$b:refs/heads/timeline/$r/$b"; else refs="$refs +refs/heads/$b:refs/heads/timeline/$r/$b"; fi   # integration: fast-forward only
  done
  [ -n "$refs" ] && retry git -C $R push -q hub $refs
  git -C $R fetch -q hub "+refs/heads/timeline/$r/*:refs/remotes/hub/*" 2>/dev/null
  if ! echo " $HOME_REPOS " | grep -q " $r "; then   # non-home: follow the hub's integration read-only
    git -C $R rev-parse -q --verify refs/remotes/hub/tl/integration >/dev/null && \
      git -C $R merge-base --is-ancestor tl/integration hub/tl/integration 2>/dev/null && \
      { [ "$(git -C $R symbolic-ref -q --short HEAD)" = tl/integration ] && git -C $R merge -q --ff-only hub/tl/integration || git -C $R branch -f tl/integration hub/tl/integration; }
  fi
done

# --- main only: log merges done on remote machines (hub/tl/integration first-parent "Merge tl/<name>") into merges.log ---
# $ORCH/.merges-imported-<repo> holds the last imported tip sha (idempotent); first run backfills from 2026-10-19T20:06Z; a sha already logged is never logged twice.
import_merges(){
  local r=$1 tip last out="" h ct subj name R mk
  R=$W/$r; mk=$ORCH/.merges-imported-$r
  tip=$(git -C $R rev-parse -q --verify 'refs/remotes/hub/tl/integration^{commit}') || return 0
  last=$(cat $mk 2>/dev/null)
  if [ -n "$last" ] && git -C $R merge-base --is-ancestor $last $tip 2>/dev/null; then set -- "$last..$tip"; else set -- --since=2026-10-19T20:06:00Z "$tip"; fi
  while read -r h ct subj; do
    [[ $subj =~ ^Merge\ tl/([^\ ]+) ]] || continue; name=${BASH_REMATCH[1]}
    awk -v r=$r -v h=$h '$2==r && $4==h {f=1} END{exit !f}' $ORCH/merges.log && continue
    out="$out$(date -u -d @$ct +%FT%TZ) $r $name $h"$'\n'
  done < <(git -C $R log --first-parent --merges --reverse --format='%h %ct %s' "$@" 2>/dev/null)
  [ -n "$out" ] && { printf '%s' "$out" >> $ORCH/merges.log || return 0; }
  echo $tip > $mk
  return 0
}
if [ $M = main ]; then for r in $(for a in $REMOTE_AREAS; do echo ${REPO_OF[$a]}; done | sort -u); do import_merges $r || true; done; fi

# repair old metas whose remote_request= value was written unquoted (breaks `. meta`)
for m in $ORCH/workers/*/meta; do grep -q "^remote_request=[^'\"$]" "$m" 2>/dev/null && python3 -I -c "import sys,shlex;p=sys.argv[1];L=open(p).read().splitlines();open(p,'w').write(chr(10).join([('remote_request='+shlex.quote(l.split('=',1)[1])) if l.startswith('remote_request=') and not l.split('=',1)[1][:1] in ('\\'','\"','\$') else l for l in L])+chr(10))" "$m"; done
# --- merge requests addressed to my home repos ---
# A remote request is NOT merged automatically: hub-sync fetches the branch, creates the worker record bin/merge needs,
# and asks the repo's owning manager (INBOX) to review it and run bin/request-merge. A request whose sha changed
# (re-sent after fixes) clears the old result and is offered again.
declare -A OWNER=( [agent]=agent [runtime]=runtime [app]=app [composition]=viewing )
for r in $HOME_REPOS; do
  for f in hub/merge-requests/$r/*; do [ -e "$f" ] || continue; w=$(basename $f); sha=$(awk '{print $2}' $f)
    seen=$ORCH/queue/.remote-$r-$w; [ "$(cat $seen 2>/dev/null)" = "$sha" ] || {
      rm -f hub/merge-results/$r/$w $ORCH/queue/done/merge-$w $ORCH/queue/refused/merge-$w
      if git -C $W/$r fetch -q hub "+refs/heads/timeline/$r/tl/$w:refs/heads/tl/$w"; then
        mkdir -p $ORCH/workers/$w; [ -f $ORCH/workers/$w/meta ] || printf 'name=%s\nrepo=%s\nbase=tl/integration\nbase_sha=%s\nremote_request=%q\n' $w $r $(git -C $W/$r merge-base tl/integration tl/$w) "$(cat $f)" > $ORCH/workers/$w/meta
        printf '\n## %s — REMOTE MERGE REQUEST (hub-sync)\n%s\nBranch tl/%s is fetched locally (sha %s). Review the diff (`git -C %s diff $(git -C %s merge-base tl/integration tl/%s)..tl/%s`); if good, run `$ORCH/bin/request-merge %s`. If not, write your reasons to the requester via design/ or an escalation.\n' "$now" "$(cat $f)" $w $sha $W/$r $W/$r $w $w $w >> $ORCH/managers/${OWNER[$r]}/INBOX.md
        echo $sha > $seen
        # app2's branches are already reviewed by the app2 manager: queue the merge straight away (bin/merge refuses on conflict);
        # the App manager is told and may still object. Merge latency was the critical path (2026-10-20).
        case "$w" in ap2-*) [ -e $ORCH/queue/done/merge-$w ] || echo "MERGE $w" > $ORCH/queue/pending/merge-$w;; esac
      fi; }
    mkdir -p hub/merge-results/$r
    [ -e $ORCH/queue/done/merge-$w ] && echo "MERGED $(git -C $W/$r rev-parse --short tl/integration)" > hub/merge-results/$r/$w
    [ -e $ORCH/queue/refused/merge-$w ] && { echo -n "REFUSED "; tail -1 $ORCH/queue/refused/merge-$w; } > hub/merge-results/$r/$w
    [ -e hub/merge-results/$r/$w ] || echo "PENDING owner review ($sha)" > hub/merge-results/$r/$w
  done
done

git add -A hub >/dev/null 2>&1
git diff --cached --quiet || git commit -qm "hub-sync $M $now

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NCfFG4UM2PAWDGuSNXfJtu"
retry sh -c "git pull -q --rebase origin main 2>/dev/null || { git rebase --abort 2>/dev/null; false; }; git push -q origin HEAD:main" && date -u +%FT%TZ > $ORCH/hub-push.ok
date -u +%FT%TZ > $ORCH/hub-sync.heartbeat
