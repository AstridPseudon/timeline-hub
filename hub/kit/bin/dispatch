#!/bin/bash
# dispatch NAME --repo agent|runtime|app|composition --base BRANCH --model M --effort E [--net] [--heavy] [--timeout MIN] [--merge-parent SHA] --brief FILE
# Starts a Codex worker in its own worktree /home/user/work/wt/NAME on branch tl/NAME (from --base, default tl/integration).
# Refuses if free disk < 5 GB, or if --heavy and >=2 heavy jobs (heavy workers + running full test suites) are already running.
set -e
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
N=$1; shift; REPO=; BASE=tl/integration; M=gpt-5.6-luna; E=high; NET=0; HEAVY=0; TMO=180; BRIEF=; MPARENT=
while [ $# -gt 0 ]; do case $1 in
 --repo) REPO=$2; shift 2;; --base) BASE=$2; shift 2;; --model) M=$2; shift 2;; --effort) E=$2; shift 2;;
 --merge-parent) MPARENT=$2; shift 2;;
 --net) NET=1; shift;; --heavy) HEAVY=1; shift;; --timeout) TMO=$2; shift 2;; --brief) BRIEF=$2; shift 2;;
 *) echo "unknown arg $1"; exit 2;; esac; done
# Owner rule 2026-10-20: Sol only for xhard tasks; Luna for all other code work. Sol below xhigh is downgraded to Luna.
case $M in *sol*) [ "$E" = xhigh ] || { echo "$(date -u +%FT%TZ) $N: $M/$E -> gpt-5.6-luna/$E (Sol only for xhigh)" >> $O/model-downgrades.log; M=gpt-5.6-luna; };; esac
. $O/bin/claude-perms.sh; M=$(codex_fallback $M)   # CODEX_UNAVAILABLE -> Claude fallback
[ -n "$REPO" ] && [ -f "$BRIEF" ] || { echo "need --repo and --brief FILE"; exit 2; }
D=$O/workers/$N; [ -e $D ] && { echo "worker $N already exists"; exit 2; }
FREE=$(df -BG --output=avail /home/user | tail -1 | tr -dc 0-9); [ "$FREE" -lt 5 ] && { echo "REFUSED: only ${FREE}G free"; exit 3; }
if [ $HEAVY = 1 ]; then H=$(grep -l '^heavy=1' $O/workers/*/meta 2>/dev/null | while read f; do d=$(dirname $f); [ -f $d/running ] && echo x; done | wc -l); T=$(for r in $O/tests/*/running; do [ -f ${r%running}heavy ] && kill -0 $(cat $r) 2>/dev/null && echo x; done | wc -l); H=$((H+T)); [ "$H" -ge 2 ] && { echo "REFUSED: $H heavy jobs running ($T full test suites)"; exit 3; }; fi
WT=/home/user/work/wt/$N; git -C /home/user/work/$REPO worktree add -q -b tl/$N $WT $BASE
mkdir -p $D; cp $BRIEF $D/brief.md; [ -n "$MPARENT" ] && echo "$MPARENT" > $D/merge-parent
printf 'name=%s\nrepo=%s\nbase=%s\nbase_sha=%s\nmodel=%s\neffort=%s\nheavy=%s\nworktree=%s\nstarted=%s\n' $N $REPO $BASE $(git -C $WT rev-parse --short HEAD) $M $E $HEAVY $WT $(date -u +%FT%TZ) > $D/meta
[ -d /home/user/work/app/node_modules ] && [ $REPO = app ] && [ ! -e $WT/node_modules ] && ln -s /home/user/work/app/node_modules $WT/node_modules
NETCFG=(); [ $NET = 1 ] && NETCFG=(-c sandbox_workspace_write.network_access=true)
touch $D/running
( { cat $O/COMMON.md; echo; echo "YOUR WORKTREE: $WT (branch tl/$N, repo $REPO). Do NOT run git commit/merge/checkout (.git is read-only to you). When done, write a conventional commit message (subject line + body) to $D/commit-msg; the harness commits all your worktree changes when you exit. Leave no build output or temp files in the worktree. When the WHOLE task is complete, create the empty file $D/DONE; if genuinely blocked, write the reason to $D/BLOCKED."; echo; echo "YOUR TASK ($N):"; cat $D/brief.md; } | \
  if [[ $M == claude-* ]]; then   # MODELS.md fallback: Claude instead of Codex
    # claude -p ends after one turn: resume the same session until DONE/BLOCKED, the time budget, or 15 resumes.
    SID=$(cat /proc/sys/kernel/random/uuid); echo $SID > $D/session; END=$(( $(date +%s) + TMO*60 ))
    CL=(claude -p --model "$M" --permission-mode acceptEdits "${CLAUDE_PERMS[@]}" --add-dir /home/user/work --add-dir /home/user/peteromallet --add-dir /home/user/banodoco --add-dir $O --output-format text)
    (cd $WT && timeout $((TMO*60)) "${CL[@]}" --session-id $SID) 2>>$D/log.txt | tee $D/report.md >> $D/log.txt; RC=${PIPESTATUS[0]}; K=0
    while [ ! -f $D/DONE ] && [ ! -f $D/BLOCKED ] && [ $K -lt 15 ] && [ $(date +%s) -lt $END ]; do K=$((K+1)); echo "=== resume $K $(date -u +%FT%TZ)" >> $D/log.txt
      echo "Continue YOUR TASK from where you stopped. Do not stop at a plan or a list of next steps: do them. That includes targeted tests through the central test service (bin/request-test, then bin/wait-test; if a wait is long, end the turn and check again on resume). When the WHOLE task is complete, give your final report as your answer, write $D/commit-msg and create $D/DONE. If genuinely blocked, write the reason to $D/BLOCKED." | \
        (cd $WT && timeout $(( END - $(date +%s) )) "${CL[@]}" --resume $SID) 2>>$D/log.txt | tee $D/report.md >> $D/log.txt; RC=${PIPESTATUS[0]}; done
    echo $RC > $D/exit
  else
  timeout $((TMO*60)) codex exec -m "$M" -c model_reasoning_effort="$E" -s workspace-write "${NETCFG[@]}" -C $WT --skip-git-repo-check \
   --add-dir /home/user/work --add-dir /home/user/peteromallet --add-dir /home/user/banodoco --add-dir $O -o $D/report.md - > $D/log.txt 2>&1; echo $? > $D/exit
  fi
  # merge ancestry (2026-10-20): if the manager/worker wrote workers/<N>/merge-parent (a commit sha, e.g. origin/main's tip), the final
  # commit becomes a true two-parent merge (HEAD + that sha) with the worker's resolved tree. Sandboxed workers cannot write .git themselves.
  MP=; [ -s $D/merge-parent ] && MP=$(tr -d ' \n' < $D/merge-parent); if [ -n "$MP" ] && git -C $WT rev-parse -q --verify "$MP^{commit}" >/dev/null; then git -C $WT rev-parse "$MP^{commit}" > "$(git -C $WT rev-parse --path-format=absolute --git-path MERGE_HEAD)"; echo "merge-parent $MP recorded" >> $D/commit.log; fi
  if [ -n "$(git -C $WT status --porcelain)" ] || [ -n "$MP" ]; then git -C $WT add -A && { [ -s $D/commit-msg ] && git -C $WT commit -q -F $D/commit-msg || git -C $WT commit -q -m "tl/$N: $(head -1 $D/brief.md | cut -c1-70)"; } >> $D/commit.log 2>&1; fi
  rm -f $D/running; date -u +%FT%TZ > $D/ended
  # recycle-on-finish (owner disk rule 2026-10-20): drop a finished, clean worktree; the branch tl/$N and the reports stay, managers review by branch, test-run recreates it if needed. Skip KEEP/leased.
  [ -f $D/KEEP ] || grep -lqsw -- "$N" $O/managers/*/notes/*.lease $O/managers/*/notes/*ACTIVE* 2>/dev/null || { [ -z "$(git -C $WT status --porcelain 2>/dev/null | head -1)" ] && git -C /home/user/work/$REPO worktree remove $WT 2>/dev/null && touch $D/recycled; } ) >/dev/null 2>&1 &
echo "dispatched $N in $WT (base $BASE)"
