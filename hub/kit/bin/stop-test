#!/bin/bash
# stop-test ID [reason] | stop-test ID --withdraw REASON — run by the dispatcher. Cancels a running central test: marks tests/ID/CANCELLED and terminates the
# test's processes (everything in the runner's process group except the runner itself), so the runner still cleans up its
# snapshot and records status=cancelled (never cached, never a result).
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch; ID=$1; shift; D=$O/tests/$ID
# --withdraw REASON (2026-10-21): withdraw a COMPLETED result that is invalid (example: exit 0 but the log shows a failure).
# Status becomes "withdrawn" (never a pass, never a cache hit); the original status/exit/log are kept as orig-* plus the reason.
if [ "$1" = --withdraw ]; then shift; [ -n "$*" ] || { echo "withdraw needs a reason"; exit 1; }; [ -f $D/running ] && { echo "test $ID is still running: cancel it instead"; exit 1; }
  [ -f $D/status ] || { echo "test $ID has no result"; exit 1; }; [ -f $D/WITHDRAWN ] && { echo "test $ID already withdrawn"; exit 0; }
  cp -p $D/status $D/orig-status; cp -p $D/exit $D/orig-exit 2>/dev/null; echo "$(date -u +%FT%TZ) withdrawn: $*" > $D/WITHDRAWN
  echo withdrawn > $D/status; sed -i "1i WITHDRAWN $(date -u +%FT%TZ): $* (original status $(cat $D/orig-status))" $D/summary
  for c in $O/tests/cache/*; do [ -f "$c" ] && [ "$(cat $c)" = "$ID" ] && rm -f "$c"; done
  for t in $O/tests/*/cached_from; do [ "$(cat $t 2>/dev/null)" = "$ID" ] && echo "  note: $(basename $(dirname $t)) reused this result from cache; treat it as withdrawn too"; done
  echo "withdrew test $ID (was $(cat $D/orig-status)); cache entries removed"; exit 0; fi
[ -f $D/running ] || { echo "test $ID is not running"; exit 0; }; R=$(cat $D/running); kill -0 $R 2>/dev/null || { echo "runner $R gone"; exit 0; }
echo "$(date -u +%FT%TZ) cancelled by request: $*" > $D/CANCELLED
P=$(ps -o pid= -g $R | tr -d ' ' | grep -vx "$R"); [ -n "$P" ] && kill -TERM $P 2>/dev/null; sleep 5; P=$(ps -o pid= -g $R | tr -d ' ' | grep -vx "$R"); [ -n "$P" ] && kill -KILL $P 2>/dev/null
echo "cancelled test $ID (runner $R finishes cleanup; status will read cancelled)"
