#!/bin/bash
# run-manager NAME [MODEL] [EFFORT] — start a long-running manager session (up to 7 days; restart it if it exits) (run by the orchestrator, outside sandbox, detached).
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
N=$1; M=${2:-gpt-6.1-sol}; E=${3:-high}; D=$O/managers/$N; mkdir -p $D/rounds
. $O/bin/claude-perms.sh; M=$(codex_fallback $M)   # CODEX_UNAVAILABLE -> Claude fallback
[ -f $D/running ] && { echo "$N already running"; exit 2; }
mkprompt(){ { cat $O/MANAGER-COMMON.md; echo; echo "=== YOUR BRIEF ($N) ==="; cat $D/BRIEF.md; echo; echo "=== YOUR NAME: $N   STATUS: $D/STATUS.md   INBOX: $D/INBOX.md   BRIEFS DIR: $D/briefs ==="; echo "=== YOUR STATUS.md (from your last session) ==="; cat $D/STATUS.md 2>/dev/null || echo "(first session)"; echo "=== YOUR INBOX.md ==="; inbox_tail; }; }
# Codex rejects prompts over 1,048,576 chars (input_too_large: every round died at once, 04:13Z agent). Send only the newest
# 200 KB of INBOX, cut at a section header; the full file stays on disk for the manager to read if it needs older items.
inbox_tail(){ local n; n=$(wc -c < $D/INBOX.md); if [ "$n" -le 200000 ]; then cat $D/INBOX.md; else echo "(INBOX is $n bytes; only the newest ~200 KB follows. Older items: $D/INBOX.md)"; tail -c 200000 $D/INBOX.md | awk 'f||/^## /{f=1; print}'; fi; }
mkdir -p /home/user/timeline-hub; R=$(date -u +%Y%m%dT%H%MZ); touch $D/running; touch $D/INBOX.md
SELF_MT=$(stat -c %Y $O/bin/run-manager)   # 02:50Z LOOPS #44: re-exec at a round boundary when the kit replaces this script
( mkprompt | \
  if [[ $M == claude-* ]]; then   # MODELS.md fallback: Claude instead of Codex
    # claude -p ends after one turn, so keep ONE session alive by resuming it every 10 min (context kept, auto-compacted) until STOP, 7 days, or Codex is back.
    SID=$(cat /proc/sys/kernel/random/uuid); echo $SID > $D/rounds/$R.session; END=$(( $(date +%s) + 7*86400 ))
    CL=(claude -p --model "$M" --permission-mode acceptEdits "${CLAUDE_PERMS[@]}" --add-dir /home/user/work --add-dir /home/user/peteromallet --add-dir /home/user/banodoco --add-dir /home/user/timeline-hub --add-dir $O --output-format text)
    (cd /home/user/work && AREA=$N timeout 6h "${CL[@]}" --session-id $SID) 2>>$D/rounds/$R.log | tee -a $D/rounds/$R.md >> $D/rounds/$R.log; echo ${PIPESTATUS[0]} > $D/rounds/$R.exit
    while [ $(date +%s) -lt $END ] && [ ! -f $D/STOP ] && { [ -f $O/CODEX_UNAVAILABLE ] || [ -f $O/MANAGERS_ON_CLAUDE ]; }; do sleep 300; [ -f $D/STOP ] && break
      echo "$(date -u +%FT%TZ) resume" >> $D/rounds/$R.log
      echo "Manager check-in ($(date -u +%FT%TZ)). Run your loop from MANAGER-COMMON.md: read NEW items at the end of $D/INBOX.md; check workers (bin/workers); for each finished task dispatch a Codex review worker, then merge clean reviewed work with bin/merge or dispatch a Codex merge worker for conflicts; dispatch EVERY ready task on your board whose dependencies are met; update your board in $D/STATUS.md. You never edit product code, tests, generated files or pins yourself. Then end this turn; you are resumed every 5 minutes. Never wait inside a turn." | (cd /home/user/work && AREA=$N timeout 6h "${CL[@]}" --resume $SID) 2>>$D/rounds/$R.log | tee -a $D/rounds/$R.md >> $D/rounds/$R.log; echo ${PIPESTATUS[0]} > $D/rounds/$R.exit
    done
  else
    # Codex: bounded rounds (2026-10-20). A single 7-day session drifted for hours without re-reading its inbox, so each round
    # is at most 90 min (was 3 h; shortened 2026-10-21 so kit rule changes and capacity refills reach the manager sooner); a fresh round then starts from the CURRENT STATUS.md and INBOX.md, until STOP.
    cat > /dev/null; first=1
    while [ ! -f $D/STOP ] && [ ! -f $O/CODEX_UNAVAILABLE ]; do [ $first = 1 ] || R=$(date -u +%Y%m%dT%H%MZ); first=0
      mkprompt | AREA=$N timeout 35m codex exec --ephemeral -m "$M" -c model_reasoning_effort="$E" -s workspace-write -C /home/user/work --skip-git-repo-check \
        --add-dir /home/user/peteromallet --add-dir /home/user/banodoco --add-dir /home/user/timeline-hub --add-dir $O -o $D/rounds/$R.md - > $D/rounds/$R.log 2>&1; echo $? > $D/rounds/$R.exit
      [ -f $D/STOP ] && break; [ "$(stat -c %Y $O/bin/run-manager)" != "$SELF_MT" ] && { touch $D/rounds/.reexec; break; }; sleep 20; done
  fi; rm -f $D/running
  [ -f $D/rounds/.reexec ] && { rm -f $D/rounds/.reexec; exec $O/bin/run-manager $N $M $E; }
  # automatic model switching at round boundaries: Codex limit -> Claude (Sonnet) manager; Codex back -> Codex manager again
  [ -f $D/STOP ] || [ -f $O/MANAGERS_ON_CLAUDE ] || { if [ -f $O/CODEX_UNAVAILABLE ] && [[ $M != claude-* ]]; then exec $O/bin/run-manager $N gpt-6.1-sol $E; elif [ ! -f $O/CODEX_UNAVAILABLE ] && [[ $M == claude-* ]]; then exec $O/bin/run-manager $N gpt-6.1-sol $E; fi; } ) >/dev/null 2>&1 &
echo "manager $N round $R started"
