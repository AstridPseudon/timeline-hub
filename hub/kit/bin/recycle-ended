#!/usr/bin/env python3
# recycle-ended — 27 Oct: remove worktrees of ENDED, clean workers (no running, no KEEP, no queued/running test on them) with non-force
# `git worktree remove`; branches stay. Run by the keepalive when disk is low. Logs each removal to design/deletion-ledger.md.
import os, subprocess, datetime
O='/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch'
busy=set()
for t in os.listdir(O+'/tests'):
    st=f'{O}/tests/{t}/status'
    try:
        if open(st).read().strip() in ('running','queued'):
            busy|={l.split('=',1)[1].strip() for l in open(f'{O}/tests/{t}/request') if l.startswith('target=')}
    except OSError: pass
done=[]
for n in sorted(os.listdir('/home/user/work/wt')):
    wd=f'{O}/workers/{n}'; wt=f'/home/user/work/wt/{n}'
    if n.startswith('.') or not os.path.exists(wd+'/meta') or not os.path.exists(wd+'/ended') or any(os.path.exists(wd+'/'+f) for f in ('running','KEEP')) or n in busy: continue
    repo=[l.split('=',1)[1].strip() for l in open(wd+'/meta') if l.startswith('repo=')][0]
    if subprocess.run(['git','-C',f'/home/user/work/{repo}','worktree','remove',wt],capture_output=True).returncode==0:
        open(wd+'/recycled','a').close(); done.append(wt)
if done:
    open(O+'/design/deletion-ledger.md','a').write(f"- {datetime.datetime.now(datetime.UTC):%Y-%m-%dT%H:%MZ} recycle-ended (keepalive, low disk): git worktree remove (non-force) " + ", ".join(done) + "\n")
print(len(done))
