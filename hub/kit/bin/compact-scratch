#!/bin/bash
# compact-scratch [MIN_MB] — global, safe disk relief (orchestrator/lead tool). In FINISHED workers (ended over 1 h ago,
# not running, not KEEP, not leased, not named in tests/suites.conf, tests/*.env or any manager STATUS.md), every scratch
# directory larger than MIN_MB (default 50) inside the worker's record folder is packed into <dir>.tgz and the directory
# removed. Nothing is lost (unpack with tar xzf). Worktrees are never touched (use bin/recycle for those).
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch; MIN=${1:-50}; cut=$(date -d '-1 hour' +%s)
B=$(df -BM --output=avail /home/user | tail -1 | tr -d ' M'); n=0
REF=$(cat $O/tests/suites.conf $O/tests/*.env $O/managers/*/STATUS.md 2>/dev/null)
for d in $O/workers/*/; do w=$(basename $d)
  [ -f $d/running ] || [ -f $d/KEEP ] && continue; [ -f $d/ended ] && [ $(stat -c %Y $d/ended) -lt $cut ] || continue
  grep -lqsw -- "$w" $O/managers/*/notes/*.lease $O/managers/*/notes/*ACTIVE* 2>/dev/null && continue
  grep -qw -- "$w" <<< "$REF" && continue
  for s in $(find $d -mindepth 1 -maxdepth 2 -type d 2>/dev/null); do [ -d "$s" ] || continue
    [ $(du -sm "$s" | cut -f1) -gt $MIN ] || continue
    tar czf "$s.tgz" -C "$(dirname "$s")" "$(basename "$s")" && rm -rf "$s" && n=$((n+1)); done; done
# lossless (2026-10-21): gzip Codex session transcripts untouched for 2 h (gunzip restores them); they reached 1.8 GB on main
find /root/.codex/sessions -type f -name '*.jsonl' -mmin +120 -print0 2>/dev/null | xargs -0 -r gzip -q 2>/dev/null
echo "packed $n scratch dirs; free ${B}M -> $(df -BM --output=avail /home/user | tail -1 | tr -d ' ')"

# worker logs over 1 MB in workers finished (ended, recycled or INTERRUPTED) over 6 h ago and not running/KEEP: gzip in place
# (lossless; read with zcat). 05:40Z: 1.6 GB of mostly v1 logs on main.
old=$(date -d '-6 hour' +%s); g=0
for d in $O/workers/*/; do [ -f $d/running ] || [ -f $d/KEEP ] && continue; f=""; for m in ended recycled INTERRUPTED; do [ -f $d/$m ] && f=$d/$m; done
  [ -n "$f" ] && [ $(stat -c %Y $f) -lt $old ] || continue
  for l in $d/log.txt $d/*.log; do [ -f "$l" ] && [ $(stat -c %s "$l") -gt 1048576 ] && gzip -f "$l" && g=$((g+1)); done; done
echo "gzipped $g old worker logs; free now $(df -BM --output=avail /home/user | tail -1 | tr -d ' ')"

# finished test-run output (18:05Z, 24 Oct; D74 root fix, lossless): in tests/<run>/ whose status is not "running", with no
# live runner pid, whose exit marker is over 1 h old and that no manager STATUS.md, suites.conf or tests/*.env names, every
# subdirectory over MIN_MB is packed into <dir>.tgz and every file over 5 MB is gzipped in place. Unpack with tar xzf/gunzip.
tp=0
for t in $O/tests/*/; do r=$(basename $t); [ -f $t/exit ] || continue; [ "$(cat $t/status 2>/dev/null)" = running ] && continue
  [ -f $t/running ] && kill -0 "$(cat $t/running 2>/dev/null)" 2>/dev/null && continue
  [ $(stat -c %Y $t/exit) -lt $(date -d "-15 min" +%s) ] || continue; grep -qw -- "$r" <<< "$REF" && continue   # 01:35Z 25 Oct: 15 min, not 1 h (Agent disk +1.1 GB per 30 min)
  for s in $(find $t -mindepth 1 -maxdepth 2 -type d 2>/dev/null); do [ -d "$s" ] || continue
    [ $(du -sm "$s" | cut -f1) -gt $MIN ] || continue
    tar czf "$s.tgz" -C "$(dirname "$s")" "$(basename "$s")" && rm -rf "$s" && tp=$((tp+1)); done
  find $t -type f -size +5M ! -name '*.gz' ! -name '*.tgz' -print0 2>/dev/null | xargs -0 -r gzip -q 2>/dev/null; done
echo "packed $tp finished test-run dirs; free now $(df -BM --output=avail /home/user | tail -1 | tr -d ' ')"
