#!/usr/bin/env python3
# recycle-ended — 27 Oct: remove worktrees of ENDED, clean workers (no running, no KEEP, no queued/running test on them) with non-force
# `git worktree remove`; branches stay. Run by the keepalive when disk is low. Logs each removal to design/deletion-ledger.md.
import os, subprocess, datetime
O='/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch'
busy=set()
for t in os.listdir(O+'/tests'):
    st=f'{O}/tests/{t}/status'
    try:
        if open(st).read().strip() in ('running','queued'):
            busy|={l.split('=',1)[1].strip() for l in open(f'{O}/tests/{t}/request') if l.startswith('target=')}
    except OSError: pass
done=[]
for n in sorted(os.listdir('/home/user/work/wt')):
    wd=f'{O}/workers/{n}'; wt=f'/home/user/work/wt/{n}'
    if n.startswith('.') or not os.path.exists(wd+'/meta') or not os.path.exists(wd+'/ended') or any(os.path.exists(wd+'/'+f) for f in ('running','KEEP')) or n in busy: continue
    repo=[l.split('=',1)[1].strip() for l in open(wd+'/meta') if l.startswith('repo=')][0]
    if subprocess.run(['git','-C',f'/home/user/work/{repo}','worktree','remove',wt],capture_output=True).returncode==0:
        open(wd+'/recycled','a').close(); done.append(wt)
# 27 Oct 20:20Z: also drop idle detached lane checkouts in /home/user/work/wt-int (agent-<sha>, runtime-<sha>); test-run recreates them on demand
import re
inuse=set()
for pid in os.listdir('/proc'):
    if not pid.isdigit(): continue
    try:
        inuse.add(os.readlink(f'/proc/{pid}/cwd'))
        for f in ('cmdline','environ'):
            inuse.update(re.findall(r'/home/user/work/wt-int/[A-Za-z0-9._-]+', open(f'/proc/{pid}/{f}','rb').read().replace(b'\0',b' ').decode(errors='ignore')))
    except Exception: pass
W='/home/user/work/wt-int'
# 31 Oct: never remove pinned checkouts listed in design/keep-wt-int.txt (the Agent lock's Runtime: removing it broke test runs mid-flight)
try: keep={l.strip() for l in open(O+'/design/keep-wt-int.txt') if l.strip()}
except OSError: keep=set()
for n in sorted(os.listdir(W)) if os.path.isdir(W) else []:
    if n in keep: continue
    # 31 Oct: integration worktrees of finished coordinator branches (<repo>-tl-<worker>): non-force removal once that worker ended
    m=re.fullmatch(r'(agent|runtime|app|composition)-tl-(.+)', n)
    if m and os.path.isfile(f'{O}/workers/{m.group(2)}/ended') and not any(u==f'{W}/{n}' or u.startswith(f'{W}/{n}/') for u in inuse):
        if subprocess.run(['git','-C',f'/home/user/work/{m.group(1)}','worktree','remove',f'{W}/{n}'],capture_output=True).returncode==0: done.append(f'{W}/{n}')
        continue
    if not re.fullmatch(r'(agent|runtime|app)-[0-9a-f]{12}', n): continue
    if any(u==f'{W}/{n}' or u.startswith(f'{W}/{n}/') for u in inuse): continue
    if subprocess.run(['git','-C',f'/home/user/work/{n.split("-")[0]}','worktree','remove','--force',f'{W}/{n}'],capture_output=True).returncode==0: done.append(f'{W}/{n}')
if done:
    open(O+'/design/deletion-ledger.md','a').write(f"- {datetime.datetime.now(datetime.UTC):%Y-%m-%dT%H:%MZ} recycle-ended (keepalive, low disk): git worktree remove (non-force) " + ", ".join(done) + "\n")
print(len(done))
