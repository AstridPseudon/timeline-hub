#!/bin/bash
# stop-worker WORKER [reason] — run by the dispatcher. Terminates only the worker's own `timeout ... -C <its worktree>` process
# (timeout forwards TERM to codex/claude); the dispatch subshell then finalizes (commit WIP, exit, ended) as usual.
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
N=$1; shift; D=$O/workers/$N; [ -f $D/meta ] || { echo "no such worker $N"; exit 1; }
[ -f $D/running ] || { echo "$N is not running"; exit 0; }
WT=/home/user/work/wt/$N; P=""
for p in $(pgrep -x timeout); do tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -qE -- "(-C $WT |cd $WT)" && P="$P $p"; done
for p in $(pgrep -f "claude -p"); do [ "$(readlink /proc/$p/cwd 2>/dev/null)" = "$WT" ] && P="$P $p"; done
if [ -z "$P" ]; then   # orphan: the process is already gone but the harness never finalized; finalize it the same way dispatch does
  echo "$(date -u +%FT%TZ) orphan finalized by request: $*" > $D/STOPPED; [ -f $D/exit ] || echo 143 > $D/exit
  if [ -n "$(git -C $WT status --porcelain 2>/dev/null)" ]; then git -C $WT add -A && { [ -s $D/commit-msg ] && git -C $WT commit -q -F $D/commit-msg || git -C $WT commit -q -m "tl/$N: WIP (stopped): $(head -1 $D/brief.md | cut -c1-60)"; } >> $D/commit.log 2>&1; fi
  rm -f $D/running; date -u +%FT%TZ > $D/ended; echo "finalized orphan $N (no live process); WIP committed: $(git -C $WT log -1 --format='%h %s' 2>/dev/null)"; exit 0; fi
echo "$(date -u +%FT%TZ) stopped by request: $*" > $D/STOPPED; kill -TERM $P; echo "stopped $N (pids$P); harness finalization will commit its WIP"
