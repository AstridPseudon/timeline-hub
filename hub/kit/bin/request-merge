#!/bin/bash
# request-merge WORKER — queue a merge of tl/WORKER into tl/integration (done by the dispatcher outside the sandbox). Result in queue/done/merge-WORKER or queue/refused/merge-WORKER (conflict).
O=/tmp/claude-0/-home-user-repo/7dc61be1-7066-52e0-a5d0-94f90e61430a/scratchpad/orch
echo "MERGE $1" > $O/queue/pending/merge-$1; echo "merge of $1 queued"
