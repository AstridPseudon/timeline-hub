#!/bin/bash
# request-runtime NAME AGENT_SHA [LOCK_SHA256] — ask the dispatcher to build or
# reuse a read-only Remotion runtime. The maker performs the authenticated
# tree-only lookup after toolchain validation and before build work.
# /home/user/work/runtimes/NAME (agent-remotion-<version>) from the Agent remotion/ dir at AGENT_SHA. Result in
# $ORCH/queue/done/runtime-NAME. Runtimes are immutable: a new version gets a new NAME. No escalation needed.
# The installed caller's location selects its queue; inherited environment does
# not confer authority to redirect a recovery request.
O=$(CDPATH= cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P) || exit 2
[[ "$O" = /* && "$O" != *[!a-zA-Z0-9_./-]* && "/$O/" != */../* && "/$O/" != */./* ]] || {
  echo 'REFUSED: ORCH root must be a safe absolute path' >&2; exit 2;
}
[[ -d "$O/queue/pending" && -w "$O/queue/pending" ]] || {
  echo 'REFUSED: pending queue is unavailable' >&2; exit 2;
}
# Recovery has no target/adoption argument: only the store journal can confer
# deletion authority. An absent or legacy store is never initialized here.
if [ "${1:-}" = --recover-store ]; then
  [ "$#" -eq 1 ] || { echo 'REFUSED: --recover-store takes no arguments' >&2; exit 2; }
  if ! /usr/bin/python3 -I - "$O" <<'PY'
import os
import stat
import sys

fds = []
try:
    # Open each component without following links, retaining the actual queue
    # descriptor for creation. A later pathname substitution cannot redirect it.
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fds.append(fd)
    parts = sys.argv[1].strip('/').split('/') + ['queue', 'pending']
    for ordinal, part in enumerate(parts):
        fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        fds.append(fd)
        info = os.fstat(fd)
        if ordinal >= len(parts) - 3:
            if info.st_uid != os.getuid() or info.st_mode & 0o022:
                raise ValueError('unsafe queue directory owner/mode')
        elif info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX:
            raise ValueError('unsafe queue ancestor mode')
    def verify_chain():
        for ordinal, part in enumerate(parts):
            current = os.stat(part, dir_fd=fds[ordinal], follow_symlinks=False)
            opened = os.fstat(fds[ordinal + 1])
            if (current.st_dev, current.st_ino) != (opened.st_dev, opened.st_ino):
                raise ValueError('queue directory replaced')
    verify_chain()
    # Verify the descriptor's mode again immediately before the write. The
    # owner UID remains the trust boundary; its processes can change permissions.
    info = os.fstat(fd)
    if info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError('unsafe queue directory owner/mode')
    leaf = os.open('bench-store-recovery', os.O_WRONLY | os.O_CREAT | os.O_EXCL
                   | os.O_NOFOLLOW, 0o600, dir_fd=fd)
    fds.append(leaf)
    with os.fdopen(leaf, 'wb', closefd=False) as stream:
        stream.write(b'BENCHRECOVER\n')
        stream.flush()
        os.fsync(leaf)
    os.fsync(fd)
    verify_chain()
except (OSError, ValueError) as exc:
    print('REFUSED: ' + str(exc), file=sys.stderr)
    sys.exit(2)
finally:
    for fd in reversed(fds):
        os.close(fd)
PY
  then
    echo 'REFUSED: store recovery is already queued or queue is unsafe' >&2; exit 2
  fi
  echo "store recovery queued; result in $O/queue/done/bench-store-recovery"
  exit 0
fi
case $# in
  2|3|7|8) ;;
  *) echo "usage: request-runtime NAME AGENT_SHA [LOCK_SHA256] [AGENT_CHECKOUT RUNTIME_CHECKOUT RUNTIME_SHA TEMPLATE_SUITE [NODE_BIN]]" >&2; exit 2 ;;
esac
[[ "$1" =~ ^agent-remotion-[0-9a-z][0-9a-z-]*$ && "$2" =~ ^[0-9a-f]{40}$ ]] || { echo 'REFUSED: invalid runtime name or Agent SHA' >&2; exit 2; }
if [ "$#" -ge 3 ]; then [[ "$3" =~ ^[0-9a-f]{64}$ ]] || { echo 'REFUSED: invalid lock SHA-256' >&2; exit 2; }; fi
if [ "$#" = 7 ]; then
  for path in "$4" "$5"; do [[ "$path" = /* && "$path" != *[!a-zA-Z0-9_./-]* && "/$path/" != */../* && "/$path/" != */./* ]] || { echo 'REFUSED: unsafe source checkout' >&2; exit 2; }; done
  [[ "$6" =~ ^[0-9a-f]{40}$ ]] || { echo 'REFUSED: invalid Runtime SHA' >&2; exit 2; }
  [[ "$7" = agent-remotion-0013-nodes || "$7" = remotion-env-nodes ]] || { echo 'REFUSED: unapproved registration template' >&2; exit 2; }
fi
if [ "$#" = 8 ]; then
  for key in RUNTIME_AGENT_CHECKOUT RUNTIME_RUNTIME_CHECKOUT RUNTIME_RUNTIME_SHA RUNTIME_TEMPLATE_SUITE RUNTIME_NODE_BIN; do
    if [[ -v "$key" ]]; then
      echo "REFUSED: ambiguous positional and inherited source/toolchain: $key" >&2; exit 2
    fi
  done
  for path in "$4" "$5" "$8"; do [[ "$path" = /* && "$path" != *[!a-zA-Z0-9_./-]* && "/$path/" != */../* && "/$path/" != */./* && "$path" != */ ]] || {
    echo 'REFUSED: unsafe source/toolchain path' >&2; exit 2;
  }; done
  [[ "$3" =~ ^[0-9a-f]{64}$ ]] || { echo 'REFUSED: invalid lock SHA-256' >&2; exit 2; }
  [[ "$6" =~ ^[0-9a-f]{40}$ ]] || { echo 'REFUSED: invalid Runtime SHA' >&2; exit 2; }
  [[ "$7" = agent-remotion-0013-nodes || "$7" = remotion-env-nodes ]] || { echo 'REFUSED: unapproved registration template' >&2; exit 2; }
fi
{ printf 'RUNTIME'; printf ' %s' "$@"; printf '\n'; } > "$O/queue/pending/runtime-$1"
echo "runtime $1 queued; maker will return reuse or build receipt in $O/queue/done/runtime-$1"
