{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TimelineConfig",
  "definitions": {
    "TimelineConfig": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineClip"
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "visual",
                  "audio"
                ]
              },
              "label": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "output",
                  "source"
                ],
                "default": "output"
              },
              "scale": {
                "type": "number"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "cover",
                  "contain",
                  "manual"
                ]
              },
              "opacity": {
                "type": "number"
              },
              "volume": {
                "type": "number"
              },
              "muted": {
                "type": "boolean"
              },
              "blendMode": {
                "type": "string",
                "enum": [
                  "normal",
                  "multiply",
                  "screen",
                  "overlay",
                  "darken",
                  "lighten",
                  "soft-light",
                  "hard-light"
                ]
              },
              "app": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "kind",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "pinnedShotGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shotId": {
                "type": "string"
              },
              "trackId": {
                "type": "string"
              },
              "clipIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "type": "string",
                "enum": [
                  "images",
                  "video"
                ]
              },
              "videoAssetKey": {
                "type": "string"
              },
              "imageClipSnapshot": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            },
            "additionalProperties": false
          }
        },
        "theme_overrides": {
          "$ref": "#/definitions/ThemeOverrides"
        },
        "generation_defaults": {
          "type": "object",
          "additionalProperties": {}
        },
        "app": {
          "type": "object",
          "additionalProperties": {}
        },
        "output": {
          "$ref": "#/definitions/TimelineOutput"
        }
      },
      "required": [
        "clips",
        "tracks"
      ],
      "additionalProperties": false
    },
    "TimelineClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "number"
        },
        "track": {
          "type": "string"
        },
        "source_uuid": {
          "type": "string"
        },
        "clipType": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "hold": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "cropTop": {
          "type": "number"
        },
        "cropBottom": {
          "type": "number"
        },
        "cropLeft": {
          "type": "number"
        },
        "cropRight": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        },
        "text": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "fontFamily": {
              "type": "string"
            },
            "fontSize": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "entrance": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "duration": {
              "type": "number"
            },
            "intensity": {
              "type": "number"
            },
            "params": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "exit": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "duration": {
              "type": "number"
            },
            "intensity": {
              "type": "number"
            },
            "params": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "continuous": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "intensity": {
              "type": "number"
            },
            "params": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "transition": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "duration": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "duration"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "duration": {
                  "type": "number"
                },
                "durationFrames": {
                  "type": "number"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "additionalProperties": false
            },
            {
              "type": "string"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fade_in": {
                    "type": "number"
                  },
                  "fade_out": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineClipModifier"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {}
        },
        "generation": {
          "type": "object",
          "additionalProperties": {}
        },
        "app": {
          "type": "object",
          "additionalProperties": {}
        },
        "label": {
          "type": "string"
        },
        "pool_id": {
          "type": "string"
        },
        "clip_order": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "keyframes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ClipKeyframe"
            }
          }
        },
        "derived_output": {
          "type": "object",
          "additionalProperties": {}
        },
        "audio": {
          "$ref": "#/definitions/AuthoredClipAudio"
        }
      },
      "required": [
        "id",
        "at",
        "track"
      ],
      "additionalProperties": false
    },
    "ClipKeyframe": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear",
            "hold"
          ]
        },
        "easing": {
          "type": "string",
          "description": "Optional named easing; absence preserves the prior interpolation behavior."
        }
      },
      "required": [
        "time",
        "value",
        "interpolation"
      ],
      "additionalProperties": {}
    },
    "TimelineClipModifier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "element",
        "params"
      ],
      "additionalProperties": false
    },
    "Theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "visual": {
          "type": "object",
          "additionalProperties": {}
        },
        "generation": {
          "type": "object",
          "additionalProperties": {}
        },
        "voice": {
          "type": "object",
          "additionalProperties": {}
        },
        "audio": {
          "type": "object",
          "additionalProperties": {}
        },
        "pacing": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "ThemeOverrides": {
      "type": "object",
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": {}
        },
        "generation": {
          "type": "object",
          "additionalProperties": {}
        },
        "voice": {
          "type": "object",
          "additionalProperties": {}
        },
        "audio": {
          "type": "object",
          "additionalProperties": {}
        },
        "pacing": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "TimelineOutput": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "string"
        },
        "fps": {
          "type": "number"
        },
        "file": {
          "type": "string"
        },
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "background_scale": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "resolution",
        "fps",
        "file"
      ],
      "additionalProperties": false
    },
    "AssetEntry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "etag": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "url_expires_at": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "resolution": {
          "type": "string"
        },
        "fps": {
          "type": "number"
        },
        "generationId": {
          "type": "string"
        },
        "variantId": {
          "type": "string"
        },
        "thumbnailUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AudioEnvelopeKeyframe": {
      "type": "object",
      "properties": {
        "at": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.7976931348623157e+308
        },
        "curve": {
          "type": "string",
          "enum": [
            "equal-power",
            "exponential-fast",
            "exponential-moderate",
            "exponential-slow",
            "linear",
            "s-curve"
          ],
          "default": "linear"
        }
      },
      "required": [
        "at",
        "value"
      ],
      "additionalProperties": false
    },
    "AudioEnvelope": {
      "description": "Authored clip-local linear gain. Keys must be finite and strictly increasing (checked by the shared envelope consumers). Derived narration/occurrence projections are transient.",
      "type": "object",
      "properties": {
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/AudioEnvelopeKeyframe"
          }
        },
        "multiply": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AudioEnvelope"
          }
        },
        "minimum": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AudioEnvelope"
          }
        },
        "duck": {
          "type": "boolean"
        }
      },
      "required": [
        "keyframes"
      ],
      "additionalProperties": false
    },
    "AuthoredClipAudio": {
      "type": "object",
      "properties": {
        "envelope": {
          "$ref": "#/definitions/AudioEnvelope"
        }
      },
      "required": [
        "envelope"
      ],
      "additionalProperties": false
    }
  }
}
