{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/generation.json",
  "title": "Minimal neutral generation and variant records",
  "type": "object", "additionalProperties": false,
  "definitions": {
    "ThumbnailDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "source_object_id", "recipe_version"],
      "properties": {
        "object_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_object_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "recipe_version": { "type": "integer", "const": 1 },
        "selection": {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["variant", "source_frame"] },
            "source_time_seconds": { "type": "number", "minimum": 0, "maximum": 4000000000, "multipleOf": 0.000001 }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "source_frame" } }, "required": ["kind"] }, "then": { "required": ["source_time_seconds"] } },
            { "if": { "properties": { "kind": { "const": "variant" } }, "required": ["kind"] }, "then": { "not": { "required": ["source_time_seconds"] } } }
          ]
        }
      }
    },
    "DuplicateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "project-media-selection.json"
        }
      }
    },
    "DuplicateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "variant",
        "entry",
        "selection"
      ],
      "properties": {
        "generation": {
          "$ref": "#"
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variant_id",
            "generation_id",
            "object_id",
            "variant_type",
            "metadata",
            "created_at"
          ],
          "properties": {
            "variant_id": {
              "type": "string",
              "minLength": 1
            },
            "generation_id": {
              "type": "string",
              "minLength": 1
            },
            "object_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "variant_type": {
              "type": "string"
            },
            "metadata": {
              "type": "object"
            },
            "created_at": {
              "type": "string"
            },
            "viewed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "thumbnail": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ThumbnailDescriptor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_id",
            "media_type",
            "size",
            "filename"
          ],
          "properties": {
            "object_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "selection": {
          "$ref": "project-media-selection.json"
        }
      }
    },
    "CopyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm_id",
        "project_id",
        "source"
      ],
      "properties": {
        "realm_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "project-media-selection.json"
        }
      }
    }
  },
  "required": ["generation_id", "project_id", "type", "status", "metadata", "version", "created_at", "updated_at"],
  "properties": {
    "generation_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "source_task_id": { "type": ["string", "null"] },
    "type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "thumbnail": { "$ref": "#/definitions/ThumbnailDescriptor" },
        "runtime_metadata_copy": { "$ref": "#/definitions/CopyLineage" }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
