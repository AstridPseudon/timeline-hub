+    samples[index * 2 + 1] = CONTROLLED_AUDIO.channelAmplitude
+      * Math.sin(2 * Math.PI * CONTROLLED_AUDIO.rightFrequency * index / sampleRate);
+  }
+  const result = assertStereoTones(samples, {
